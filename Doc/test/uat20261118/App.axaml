<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="UatAvalonia.App" RequestedThemeVariant="Light">
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
    <Style Selector="Button"><Setter Property="MinHeight" Value="34" /></Style>
    <Style Selector="TextBox"><Setter Property="MinHeight" Value="34" /></Style>
    <Style Selector="Border.card">
      <Setter Property="BorderBrush" Value="#8B8B98" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="12" />
    </Style>
    <Style Selector="TextBlock.label"><Setter Property="VerticalAlignment" Value="Center" /></Style>
    <Style Selector="Button.primary"><Setter Property="Background" Value="#5B3D91" /><Setter Property="Foreground" Value="White" /></Style>
    <Style Selector="Border.toolbar Button">
      <Setter Property="Background" Value="#F1EDF7" /><Setter Property="Foreground" Value="#241335" />
    </Style>
  </Application.Styles>
</Application>
