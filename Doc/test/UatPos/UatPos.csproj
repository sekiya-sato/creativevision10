<Project Sdk="Microsoft.NET.Sdk">
  <!--
    POS（CvWpfpos）のVM駆動UATハーネス。CvWpfposの実ViewModel・PosGrpcClientを使い、
    専用DBと専用CvServerに対して売上・返品・取消・精算を無人実行する。
    slnx には収録しない（Doc/test/UatVm と同じ扱い）。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\CvWpfpos\CvWpfpos.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- CvServerの起動・正規停止はUatVmと同じ実装を使う -->
    <Compile Include="..\UatVm\CvServerProcess.cs" Link="CvServerProcess.cs" />
  </ItemGroup>
</Project>
