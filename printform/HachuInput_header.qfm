				<text id="ValSu"><position x="27" y="4" width="18" height="4"/><data calctype="item" datasrc="item9"/><decode datatype="string" format=""/><font size="62"/></text>
				<text id="ValKingaku"><position x="45" y="4" width="24" height="4"/><data calctype="item" datasrc="item10"/><decode datatype="string" format=""/><font size="62"/></text>
				<text id="ValTax"><position x="69" y="4" width="20" height="4"/><data calctype="item" datasrc="item11"/><decode datatype="string" format=""/><font size="62"/></text>
				<text id="ValTotal"><position x="89" y="4" width="24" height="4"/><data calctype="item" datasrc="item12"/><decode datatype="string" format=""/><font size="62"/></text>
				<text id="ValJodai"><position x="113" y="4" width="18" height="4"/><data calctype="item" datasrc="item13"/><decode datatype="string" format=""/><font size="62"/></text>
				<text id="ValGedai"><position x="131" y="4" width="19" height="4"/><data calctype="item" datasrc="item14"/><decode datatype="string" format=""/><font size="62"/></text>
