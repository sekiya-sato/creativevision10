				<text id="ValShain"><position x="125" y="0" width="25" height="4"/><data calctype="item" datasrc="item6"/><decode datatype="string" format=""/><font size="62"/></text>
				<text id="ValRelate"><position x="0" y="4" width="15" height="4"/><data calctype="item" datasrc="item7"/><decode datatype="string" format=""/><font size="62"/></text>
