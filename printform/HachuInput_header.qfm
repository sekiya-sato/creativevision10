			<item id="item14"/>
			<item id="item15"/>
		</datarecord>
		<file>
			<path datatype="csv" target="data.txt"/>
		</file>
	</datadesc>
	<page orientation="portrait" cpi="10" lpi="6" compatibility="3.0.0" id="Form1" tree="1">
		<position x="8" y="8" width="156" height="272"/>
		<region id="Rgn01" direction="0" tree="1">
			<position x="0" y="10" width="150" height="248"/>
			<color transparent="1"/>
			<record id="RecTitle" recordtype="1" tree="1">
				<position x="0" y="0" width="150" height="8"/>
				<color transparent="1"/>
				<text id="Title">
					<position x="0" y="0" width="90" height="5"/>
					<color transparent="1"/>
					<data calctype="static">発注一覧</data>
					<decode datatype="string" format=""/>
					<font size="120"/>
				</text>
				<text id="PrintDate">
					<position x="90" y="1" width="40" height="4"/>
					<color transparent="1"/>
					<data calctype="date"/>
					<decode datatype="date" format="&quot;出力 &quot;YYYY/MM/DD HH24:MI"/>
					<font size="62"/>
				</text>
				<text id="PageNo">
					<position x="132" y="1" width="18" height="4"/>
					<color transparent="1"/>
					<data calctype="page"/>
					<decode datatype="number" format="&quot;P.&quot;0999"/>
					<font size="62"/>
				</text>
			</record>
			<record id="RecHeader" recordtype="1" tree="1">
				<position x="0" y="8" width="150" height="12"/>
				<color base="c8ffc8" transparent="0"/>
				<border left="1" right="1" top="1" bottom="1"/>
				<text id="HdrId"><position x="0" y="0" width="15" height="4"/><data calctype="static">発注No</data><decode datatype="string" format=""/><font size="62"/></text>
				<text id="HdrDenDay"><position x="15" y="0" width="18" height="4"/><data calctype="static">発注日</data><decode datatype="string" format=""/><font size="62"/></text>
				<text id="HdrKubun"><position x="33" y="0" width="14" height="4"/><data calctype="static">区分</data><decode datatype="string" format=""/><font size="62"/></text>
				<text id="HdrShiire"><position x="47" y="0" width="48" height="4"/><data calctype="static">仕入先</data><decode datatype="string" format=""/><font size="62"/></text>
				<text id="HdrSoko"><position x="95" y="0" width="30" height="4"/><data calctype="static">倉庫</data><decode datatype="string" format=""/><font size="62"/></text>
				<text id="HdrShain"><position x="125" y="0" width="25" height="4"/><data calctype="static">入力者</data><decode datatype="string" format=""/><font size="62"/></text>
				<text id="HdrRelate"><position x="0" y="4" width="15" height="4"/><data calctype="static">関連No</data><decode datatype="string" format=""/><font size="62"/></text>
				<text id="HdrRate"><position x="15" y="4" width="12" height="4"/><data calctype="static">掛率</data><decode datatype="string" format=""/><font size="62"/></text>
				<text id="HdrSu"><position x="27" y="4" width="18" height="4"/><data calctype="static">数量計</data><decode datatype="string" format=""/><font size="62"/></text>
				<text id="HdrKingaku"><position x="45" y="4" width="24" height="4"/><data calctype="static">金額計</data><decode datatype="string" format=""/><font size="62"/></text>
				<text id="HdrTax"><position x="69" y="4" width="20" height="4"/><data calctype="static">消費税</data><decode datatype="string" format=""/><font size="62"/></text>
				<text id="HdrTotal"><position x="89" y="4" width="24" height="4"/><data calctype="static">総合計</data><decode datatype="string" format=""/><font size="62"/></text>
				<text id="HdrJodai"><position x="113" y="4" width="18" height="4"/><data calctype="static">上代計</data><decode datatype="string" format=""/><font size="62"/></text>
				<text id="HdrGedai"><position x="131" y="4" width="19" height="4"/><data calctype="static">下代計</data><decode datatype="string" format=""/><font size="62"/></text>
				<text id="HdrMemo"><position x="0" y="8" width="150" height="4"/><data calctype="static">メモ</data><decode datatype="string" format=""/><font size="62"/></text>
			</record>
			<record id="RecData" tree="1">
				<position x="0" y="20" width="150" height="12"/>
				<color transparent="1"/>
				<border left="1" right="1" bottom="10"/>
				<text id="ValId"><position x="0" y="0" width="15" height="4"/><data calctype="item" datasrc="item1"/><decode datatype="string" format=""/><font size="62"/></text>
				<text id="ValDenDay"><position x="15" y="0" width="18" height="4"/><data calctype="item" datasrc="item2"/><decode datatype="string" format="S0.4&quot;/&quot;S4.2&quot;/&quot;S6.2"/><font size="62"/></text>
				<text id="ValKubun"><position x="33" y="0" width="14" height="4"/><data calctype="item" datasrc="item3"/><decode datatype="string" format=""/><font size="62"/></text>
