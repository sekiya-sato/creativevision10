<?xml version="1.0" encoding="SHIFT_JIS"?>

<printstream version="3.0">
	<datadesc src="file">
		<datarecord>
			<item id="item1"/>
			<item id="item2"/>
			<item id="item3"/>
			<item id="item4"/>
			<item id="item5"/>
			<item id="item6"/>
