<?xml version="1.0" encoding="SHIFT_JIS"?>

<printstream version="3.0">
	<script language="JavaScript">//////////////////////////////////////////////////////////////////////
// PrintStream FormEditor Generated Script
//////////////////////////////////////////////////////////////////////

//////////////////////////////////////////////////////////////////////
// QFM object
// このオブジェクトがフォームファイルを示します。フォームファイルに定義され
// る情報は、すべてこのオブジェクトを基点にして取得、設定を行います。
var qfm	= GetQfm();

//////////////////////////////////////////////////////////////////////
// Cursor object
// カーソルはFormEditorで指定した印刷データに対してオープンされ、１件目の
// レコードに位置付けられています。
// このカーソルは印刷データの種類や形式によらず、同じように利用できます。
var cursor	= qfm.GetCursor();

//////////////////////////////////////////////////////////////////////
// Cursor members
// カーソルに含まれる列に対応する変数です。この変数はカーソルオブジェクトか
// らGetValue()メソッドにより印刷データの値を取得する領域として利用
// されます。
var dtitem1;
var dtitem2;
var dtitem3;
var dtitem4;
var dtitem5;
var dtitem6;
var dtitem7;
var dtitem8;
var dtitem9;
var dtitem10;
var dtitem11;
var dtitem12;
var dtitem13;
var dtitem14;
var dtitem15;

//////////////////////////////////////////////////////////////////////
// Parameter value
// 実行パラメータの値が格納されます。この値はFormEditorで設定したデフォルト
// 値、またはFormWriterのコマンドラインで指定した値となります。

//////////////////////////////////////////////////////////////////////
// Field object
// 各フィールドを示すオブジェクトです。オブジェクトのプロパティを操作するこ
// とによりさまざまな表現を動的に指定する事ができます。
var page	= qfm.GetPage();
var fdRgn01	= page.GetField(&quot;Rgn01&quot;);
var fdRec01	= page.GetField(&quot;Rec01&quot;);
var fdRec02	= page.GetField(&quot;Rec02&quot;);
var fdcp_date	= page.GetField(&quot;cp_date&quot;);
var fdcp_page	= page.GetField(&quot;cp_page&quot;);
var fdcp_title	= page.GetField(&quot;cp_title&quot;);
var fdTxt02	= page.GetField(&quot;Txt02&quot;);
var fdTxt03	= page.GetField(&quot;Txt03&quot;);
var fdTxt08	= page.GetField(&quot;Txt08&quot;);
var fdTxt09	= page.GetField(&quot;Txt09&quot;);
var fdBar01	= page.GetField(&quot;Bar01&quot;);
var fdBar02	= page.GetField(&quot;Bar02&quot;);
var fdTxt25	= page.GetField(&quot;Txt25&quot;);
var fdTxt26	= page.GetField(&quot;Txt26&quot;);
var fdTxt27	= page.GetField(&quot;Txt27&quot;);
var fdTxt28	= page.GetField(&quot;Txt28&quot;);
var fdTxt29	= page.GetField(&quot;Txt29&quot;);
var fdTxt30	= page.GetField(&quot;Txt30&quot;);
var fdTxt31	= page.GetField(&quot;Txt31&quot;);
var fdTxt12	= page.GetField(&quot;Txt12&quot;);
var fdTxt14	= page.GetField(&quot;Txt14&quot;);

//////////////////////////////////////////////////////////////////////
// OnFetch()関数は、印刷データを1件読み込むごとに、FormWriterエンジンより
// 呼び出されます。この関数では、直前に読み取った印刷データが1件含まれる
// カーソルオブジェクトcursorを受け取ります。cursorの内容を変更すると、変
// 更後の内容で印刷されキーブレーク判定が行われます。
// OnFetch()関数は、主に印刷データのフィルタとして利用します。
function OnFetch() {

	// 印刷データの取得
	dtitem1	= cursor.GetValue(&quot;item1&quot;);
	dtitem2	= cursor.GetValue(&quot;item2&quot;);
	dtitem3	= cursor.GetValue(&quot;item3&quot;);
	dtitem4	= cursor.GetValue(&quot;item4&quot;);
	dtitem5	= cursor.GetValue(&quot;item5&quot;);
	dtitem6	= cursor.GetValue(&quot;item6&quot;);
	dtitem7	= cursor.GetValue(&quot;item7&quot;);
	dtitem8	= cursor.GetValue(&quot;item8&quot;);
	dtitem9	= cursor.GetValue(&quot;item9&quot;);
	dtitem10	= cursor.GetValue(&quot;item10&quot;);
	dtitem11	= cursor.GetValue(&quot;item11&quot;);
	dtitem12	= cursor.GetValue(&quot;item12&quot;);
	dtitem13	= cursor.GetValue(&quot;item13&quot;);
	dtitem14	= cursor.GetValue(&quot;item14&quot;);
	dtitem15	= cursor.GetValue(&quot;item15&quot;);
	//page.GetField(&quot;Txt15&quot;).visible = 0;
	//page.GetField(&quot;Txt25&quot;).visible = 0;
	/*
	dtitem18	= cursor.GetValue(&quot;item18&quot;);
	if (dtitem18 == &quot;&quot;|| dtitem18==&quot;.&quot; || dtitem18==&quot; &quot;){
		page.GetField(&quot;Txt37&quot;).visible = 0;
		page.GetField(&quot;Txt38&quot;).visible = 0;
		page.GetField(&quot;Txt39&quot;).visible = 0;
	}
	else{
		page.GetField(&quot;Txt37&quot;).visible = 1;
		page.GetField(&quot;Txt38&quot;).visible = 1;
		page.GetField(&quot;Txt39&quot;).visible = 1;
	}
	*/
// カーソルオブジェクトの操作例
//	if( dtitem1.length == 0 ) {
//		cursor.SetValue(&quot;item1&quot;, &quot;(未設定)&quot;);
//	}

// フィールドプロパティの操作例
//	if( dtitem1.length &lt; 5 ) {
//		fdcp_title.font.color = &quot;#ff0000&quot;;
//	} else {
//		fdcp_title.font.color = &quot;#000000&quot;;
//	}

	if( dtitem1==&quot;移動明細書&quot; ) {
		page.GetField(&quot;Txt53&quot;).visible = 0;
		page.GetField(&quot;Bar02&quot;).visible = 0;
	}else{
		page.GetField(&quot;Txt114&quot;).visible = 0;
		page.GetField(&quot;Bar01&quot;).visible = 0;
	}
}
</script>
