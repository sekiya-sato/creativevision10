	dtitem38	= cursor.GetValue(&quot;item38&quot;);
	dtitem39	= cursor.GetValue(&quot;item39&quot;);
	dtitem42	= cursor.GetValue(&quot;item42&quot;);
	dtitem43	= cursor.GetValue(&quot;item43&quot;);
	dtitem44	= cursor.GetValue(&quot;item44&quot;);
	dtitem45	= cursor.GetValue(&quot;item45&quot;);
	dtitem46	= cursor.GetValue(&quot;item46&quot;);
	dtitem47	= cursor.GetValue(&quot;item47&quot;);
	dtitem48	= cursor.GetValue(&quot;item48&quot;);
	dtitem49	= cursor.GetValue(&quot;item49&quot;);
	dtitem50	= cursor.GetValue(&quot;item50&quot;);
	dtitem51	= cursor.GetValue(&quot;item51&quot;);
	dtitem52	= cursor.GetValue(&quot;item52&quot;);
	dtitem53	= cursor.GetValue(&quot;item53&quot;);
	dtitem54	= cursor.GetValue(&quot;item54&quot;);
	dtitem55	= cursor.GetValue(&quot;item55&quot;);
	dtitem56	= cursor.GetValue(&quot;item56&quot;);
	dtitem57	= cursor.GetValue(&quot;item57&quot;);
	dtitem58	= cursor.GetValue(&quot;item58&quot;);
	dtitem59	= cursor.GetValue(&quot;item59&quot;);

	if( dtitem15==&quot;&quot; ) {
		fd伝票日付.font.color = &quot;#ffffff&quot;;
	} else {
		fd伝票日付.font.color = &quot;#000000&quot;;
	}
	//０非表示 20070219
	if( dtitem13 == 0 ) {
		fd伝票番号.font.color = &quot;#ffffff&quot;;
	} else {
		fd伝票番号.font.color = &quot;#000000&quot;;
	}
	if( dtitem18 == 0 ) {
		fd数量.font.color = &quot;#ffffff&quot;;
	} else {
		fd数量.font.color = &quot;#000000&quot;;
	}
	if( dtitem19 == 0 ) {
		fd金額.font.color = &quot;#ffffff&quot;;
	} else {
		fd金額.font.color = &quot;#000000&quot;;
	}
	if( dtitem20 == 0 ) {
		fd明細消費税.font.color = &quot;#ffffff&quot;;
	} else {
		fd明細消費税.font.color = &quot;#000000&quot;;
	}
	if( dtitem24 == 0 ) {
		fd入金.font.color = &quot;#ffffff&quot;;
	} else {
		fd入金.font.color = &quot;#000000&quot;;
	}
	
	if ((dtitem14*1)==6){
		//print(dtitem14,&quot;OK&quot;);
		page.GetField(&quot;数量&quot;).value=&quot;&quot;;
		page.GetField(&quot;金額&quot;).value=&quot;&quot;;
		page.GetField(&quot;入金&quot;).value=cursor.GetValue(&quot;item24&quot;);
		page.GetField(&quot;明細消費税&quot;).value=&quot;&quot;;
	}
	// 消費税金額表示対応 20061011
	else if ((dtitem16*1)==99){
		page.GetField(&quot;数量&quot;).value=&quot;&quot;;
		page.GetField(&quot;金額&quot;).value=&quot;&quot;;
		page.GetField(&quot;入金&quot;).value=&quot;&quot;;
		page.GetField(&quot;明細消費税&quot;).value=cursor.GetValue(&quot;item20&quot;);
	}
	else{
		page.GetField(&quot;数量&quot;).value=cursor.GetValue(&quot;item18&quot;);
		page.GetField(&quot;金額&quot;).value=cursor.GetValue(&quot;item19&quot;);
		page.GetField(&quot;入金&quot;).value=&quot;&quot;;
		page.GetField(&quot;明細消費税&quot;).value=cursor.GetValue(&quot;item20&quot;);
	}
	
	//fdTxt102.visible = 0;
	//fdTxt99.visible = 0;
}

