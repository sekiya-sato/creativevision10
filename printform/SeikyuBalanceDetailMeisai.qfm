	dtitem23	= cursor.GetValue(&quot;item23&quot;);
	dtitem24	= cursor.GetValue(&quot;item24&quot;);
	dtitem25	= cursor.GetValue(&quot;item25&quot;);
	dtitem26	= cursor.GetValue(&quot;item26&quot;);
	dtitem27	= cursor.GetValue(&quot;item27&quot;);
	dtitem28	= cursor.GetValue(&quot;item28&quot;);
	dtitem29	= cursor.GetValue(&quot;item29&quot;);
	dtitem30	= cursor.GetValue(&quot;item30&quot;);
	dtitem31	= cursor.GetValue(&quot;item31&quot;);
