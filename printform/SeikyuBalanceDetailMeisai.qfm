//////////////////////////////////////////////////////////////////////
// OnFormLoad()関数は、フォームファイルをロードして印刷準備が整ったときに、
// FormWriterエンジンより1回だけ呼び出されます。この関数には、フォームの初
// 期値を変更するなど、アプリケーション固有の初期化を記述します。また、独自
// にcursorをループさせて、すべての印刷処理を記述する事もできます。
function OnFormLoad() {
	
// 初期設定例
//	fd伝票日付.value	= &quot;固有の初期値&quot;;

	var recs	= 0;	// レコードカウンタ
	while( !cursor.IsEod() ) {

		// 印刷データの取得
		dtitem1	= cursor.GetValue(&quot;item1&quot;);
		dtitem2	= cursor.GetValue(&quot;item2&quot;);
		dtitem3	= cursor.GetValue(&quot;item3&quot;);
		dtitem4	= cursor.GetValue(&quot;item4&quot;);
		dtitem5	= cursor.GetValue(&quot;item5&quot;);
		dtitem6	= cursor.GetValue(&quot;item6&quot;);
		dtitem7	= cursor.GetValue(&quot;item7&quot;);
		dtitem8	= cursor.GetValue(&quot;item8&quot;);
		dtitem9	= cursor.GetValue(&quot;item9&quot;);
		dtitem10	= cursor.GetValue(&quot;item10&quot;);
		dtitem11	= cursor.GetValue(&quot;item11&quot;);
		dtitem12	= cursor.GetValue(&quot;item12&quot;);
		dtitem13	= cursor.GetValue(&quot;item13&quot;);
		dtitem14	= cursor.GetValue(&quot;item14&quot;);
		dtitem15	= cursor.GetValue(&quot;item15&quot;);
		dtitem16	= cursor.GetValue(&quot;item16&quot;);
		dtitem17	= cursor.GetValue(&quot;item17&quot;);
		dtitem18	= cursor.GetValue(&quot;item18&quot;);
		dtitem19	= cursor.GetValue(&quot;item19&quot;);
		dtitem20	= cursor.GetValue(&quot;item20&quot;);
		dtitem21	= cursor.GetValue(&quot;item21&quot;);
		dtitem22	= cursor.GetValue(&quot;item22&quot;);
		dtitem23	= cursor.GetValue(&quot;item23&quot;);
		dtitem24	= cursor.GetValue(&quot;item24&quot;);
		dtitem25	= cursor.GetValue(&quot;item25&quot;);
		dtitem26	= cursor.GetValue(&quot;item26&quot;);
		dtitem27	= cursor.GetValue(&quot;item27&quot;);
		dtitem28	= cursor.GetValue(&quot;item28&quot;);
		dtitem29	= cursor.GetValue(&quot;item29&quot;);
		dtitem30	= cursor.GetValue(&quot;item30&quot;);
		dtitem31	= cursor.GetValue(&quot;item31&quot;);
		dtitem32	= cursor.GetValue(&quot;item32&quot;);
		dtitem33	= cursor.GetValue(&quot;item33&quot;);
		dtitem34	= cursor.GetValue(&quot;item34&quot;);
		dtitem35	= cursor.GetValue(&quot;item35&quot;);
		dtitem36	= cursor.GetValue(&quot;item36&quot;);
		dtitem37	= cursor.GetValue(&quot;item37&quot;);
		dtitem38	= cursor.GetValue(&quot;item38&quot;);
		dtitem39	= cursor.GetValue(&quot;item39&quot;);
		dtitem42	= cursor.GetValue(&quot;item42&quot;);
		dtitem43	= cursor.GetValue(&quot;item43&quot;);
		dtitem44	= cursor.GetValue(&quot;item44&quot;);
		dtitem45	= cursor.GetValue(&quot;item45&quot;);
		dtitem46	= cursor.GetValue(&quot;item46&quot;);
		dtitem47	= cursor.GetValue(&quot;item47&quot;);
		dtitem48	= cursor.GetValue(&quot;item48&quot;);
		dtitem49	= cursor.GetValue(&quot;item49&quot;);
		dtitem50	= cursor.GetValue(&quot;item50&quot;);
		dtitem51	= cursor.GetValue(&quot;item51&quot;);
		dtitem52	= cursor.GetValue(&quot;item52&quot;);
		dtitem53	= cursor.GetValue(&quot;item53&quot;);
		dtitem54	= cursor.GetValue(&quot;item54&quot;);
		dtitem55	= cursor.GetValue(&quot;item55&quot;);
		dtitem56	= cursor.GetValue(&quot;item56&quot;);
		dtitem57	= cursor.GetValue(&quot;item57&quot;);
		dtitem58	= cursor.GetValue(&quot;item58&quot;);
		dtitem59	= cursor.GetValue(&quot;item59&quot;);

		// キーブレイク処理
		cursor.PrepareKeyBreak();

		// グループの後に行う処理
		if( recs &gt; 0 ) {
			// 各レベルのキーブレイクに応じて必要なレコード出力を行う
			switch( cursor.keyBreakLevel ) {
			case 1:
				fdTxt89.value = suryou;
				fdTxt90.value = kingaku;
				fdTxt98.value = shouhizei;
				fdTxt91.value = nyukingaku;
				fdRec04.Write();
				suryou = 0;
				kingaku = 0;
				shouhizei = 0;
				nyukingaku = 0;
				break;
			}
			// キーブレイクに改ページ指定がある場合の処理
			if( cursor.pageBreak ) {
				page.PageChange();
			}
		}

		// 集計処理を行う
		recs++;
		cursor.CalculateTotal();

// フィールドオブジェクトの操作例(1)
		// フォームの指定に従いカーソルデータを一括転送する
		page.AssignData();
/*
// フィールドオブジェクトの操作例(2)
		// 各フィールドを個別に処理する
		fd伝票日付.value	= dtitem15;
		fd伝票番号.value	= dtitem59;
		fd取引区分.value	= dtitem17;
		fd単価.value	= dtitem22;
		fdTxt107.value	= dtitem57;
		fdTxt100.value	= dtitem56;
		fdTxt105.value	= dtitem58;
		fd前回御請求額.value	= dtitem9;
		fd御入金額.value	= dtitem4;
		fd今回相殺額.value	= dtitem37;
		fd繰越金額.value	= dtitem43;
		fd御買上額.value	= dtitem52;
		fd今回御請求額.value	= dtitem44;
		fd得意先郵便番号.value	= dtitem46;
		fd得意先住所１.value	= dtitem47;
		fd得意先住所２.value	= dtitem48;
		fd得意先コード.value	= dtitem11;
		fd得意先名.value	= dtitem44;
		fd自社郵便番号.value	= dtitem28;
		fd住所.value	= dtitem29;
		fd住所２.value	= dtitem30;
		fd自社名.value	= dtitem27;
		fd消費税計.value	= dtitem8;
		fd当月買上合計.value	= dtitem53;
		fd支払日.value	= dtitem2;
		fdTEL.value	= dtitem32;
		fdTxt73.value	= dtitem33;
		fdTxt78.value	= dtitem49;
		fdTxt80.value	= dtitem31;
		fd請求月.value	= dtitem2;
		fd振込先１.value	= dtitem34;
		fd振込先2.value	= dtitem35;
		fd振込先3.value	= dtitem36;
		fd担当者.value	= dtitem51;
		fdTxt99.value	= dtitem55;
*/
		// レコードオブジェクトの出力
		//if (cursor.keyBreakLevel==1 || cursor.keyBreakLevel==3) {
		// 2014.03.07 #11227対応（取引区分にもkeyBreakLevelを設定）
		//if (cursor.keyBreakLevel==1 || cursor.keyBreakLevel==3 || cursor.keyBreakLevel==4) {
		//if (cursor.keyBreakLevel==1 || cursor.keyBreakLevel==3 || cursor.keyBreakLevel==4 || sv_gyoNO != dtitem23) {
		/*if (cursor.keyBreakLevel==1 || cursor.keyBreakLevel==3 || cursor.keyBreakLevel==4 || sv_gyoNO != dtitem23) {
			fdRec09.Write();
			suryou += new Number(fd数量.value);
			kingaku += new Number(fd金額.value);
			shouhizei += new Number(fd明細消費税.value);
			nyukingaku += new Number(fd入金.value);
		}*/
		fdRec09.Write();
		suryou += new Number(fd数量.value);
		kingaku += new Number(fd金額.value);
		shouhizei += new Number(fd明細消費税.value);
		nyukingaku += new Number(fd入金.value);
		
		//if (fdTxt85.value != 0) fdRec05.Write();
		fdRec05.Write();

		// 行NOを保存しておく（入金伝票NO内で同一取引区分への対応）
		sv_gyoNO = dtitem23;

		// カーソルを次のレコードに移動
		cursor.MoveNext();
	}

	// ループ終了後に最後のキーブレイク処理を行う
	if( recs &gt; 0 ) {
		fdTxt89.value = suryou;
		fdTxt90.value = kingaku;
		fdTxt98.value = shouhizei;
		fdTxt91.value = nyukingaku;
		fdRec04.Write();
		page.PageChange();
	}
	qfm.End();	// End()メソッドにより印刷処理は停止します。
}

//////////////////////////////////////////////////////////////////////
// OnFetch()関数は、印刷データを1件読み込むごとに、FormWriterエンジンより
// 呼び出されます。この関数では、直前に読み取った印刷データが1件含まれる
// カーソルオブジェクトcursorを受け取ります。cursorの内容を変更すると、変
// 更後の内容で印刷されキーブレーク判定が行われます。
// OnFetch()関数は、主に印刷データのフィルタとして利用します。
function OnFetch() {

	// 印刷データの取得
	dtitem1	= cursor.GetValue(&quot;item1&quot;);
	dtitem2	= cursor.GetValue(&quot;item2&quot;);
	dtitem3	= cursor.GetValue(&quot;item3&quot;);
