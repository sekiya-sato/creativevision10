		page.GetField(&quot;金額&quot;).value=cursor.GetValue(&quot;item19&quot;);
		page.GetField(&quot;入金&quot;).value=&quot;&quot;;
		page.GetField(&quot;明細消費税&quot;).value=cursor.GetValue(&quot;item20&quot;);
