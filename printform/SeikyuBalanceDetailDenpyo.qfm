//////////////////////////////////////////////////////////////////////
// Cursor members
// カーソルに含まれる列に対応する変数です。この変数はカーソルオブジェクトか
// らGetValue()メソッドにより印刷データの値を取得する領域として利用
// されます。
var dtitem1;
var dtitem2;
var dtitem3;
var dtitem4;
var dtitem5;
var dtitem6;
var dtitem7;
var dtitem8;
