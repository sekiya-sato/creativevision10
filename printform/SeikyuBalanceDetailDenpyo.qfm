	dtitem24	= cursor.GetValue(&quot;item24&quot;);
	dtitem25	= cursor.GetValue(&quot;item25&quot;);
	dtitem26	= cursor.GetValue(&quot;item26&quot;);
	dtitem27	= cursor.GetValue(&quot;item27&quot;);
