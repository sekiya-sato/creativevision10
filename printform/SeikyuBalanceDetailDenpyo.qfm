//	}
//	else {
//		page.GetField(&quot;単価&quot;).value=&quot;&quot;;
//	}
	
// カーソルオブジェクトの操作例
//	if( dtitem1.length == 0 ) {
//		cursor.SetValue(&quot;item1&quot;, &quot;(未設定)&quot;);
//	}

// フィールドプロパティの操作例
//	if( dtitem15.length &lt; 5 ) {
//		fd伝票日付.font.color = &quot;#ff0000&quot;;
//	} else {
