		if( recs &gt; 0 ) {
			// キーブレイクに改ページ指定がある場合の処理
			if( cursor.pageBreak ) {
				page.PageChange();
			}
		}

		// 集計処理を行う
		recs++;
		cursor.CalculateTotal();

// フィールドオブジェクトの操作例(1)
