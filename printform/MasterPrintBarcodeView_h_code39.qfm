				</text>
				<text id="Txt21" halign="center">
					<position x="100" y="4" width="50" height="4"/>
					<color transparent="1"/>
					<border bottom="1"/>
					<data calctype="item" datasrc="item7"/>
					<decode datatype="string" format=""/>
					<font size="80"/>
				</text>
			</record>
			<record id="Rec02" recordtype="1" tree="1">
				<position x="0" y="0" width="150" height="8"/>
				<color base="c8ffc8" transparent="0"/>
				<border left="1" right="1" top="1"/>
				<text id="Txt28" valign="middle">
					<position x="0" y="0" width="70" height="4"/>
					<color base="c8ffc8" transparent="0"/>
					<data calctype="static">商品CD:</data>
					<decode datatype="string" format=""/>
					<font size="80"/>
				</text>
				<text id="Txt17" valign="middle">
					<position x="70" y="0" width="40" height="4"/>
					<color base="c8ffc8" transparent="0"/>
					<data calctype="static">色:</data>
					<decode datatype="string" format=""/>
					<font size="80"/>
				</text>
				<text id="Txt23" valign="middle">
					<position x="110" y="0" width="40" height="4"/>
					<color base="c8ffc8" transparent="0"/>
