<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- PrintEnable の既定を true にする/印刷機能を使わない場合には false に設定 -->
    <PrintEnable>true</PrintEnable>
  </PropertyGroup>

  <PropertyGroup Condition="'$(PrintEnable)' == 'true'">
    <DefineConstants>$(DefineConstants);PRINT_ENABLE</DefineConstants>
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);IKVM0100;IKVM0103;IKVM0109</MSBuildWarningsAsMessages>
	  <!-- 古いjava XML標準形クラスとの重複エラー、SecuritySupport12エラー、xml見つからないエラー -->
  </PropertyGroup>

  <ItemGroup Condition="'$(PrintEnable)' == 'true'">
    <PackageReference Include="IKVM" />
  </ItemGroup>
  <!-- PrintStream なしの構成は data.txt を確認用の一覧PDFにする（SimpleListPdfWriter） -->
  <ItemGroup Condition="'$(PrintEnable)' != 'true'">
    <PackageReference Include="PDFsharp" />
    <!-- PDFsharp が推移的に要求する Pkcs 8.0.1 の脆弱性対応（Directory.Packages.props の注記を参照） -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
    <EmbeddedResource Include="Fonts\ipag.ttf" LogicalName="CvPrints.Fonts.ipag.ttf" />
    <None Include="Fonts\IPA_Font_License_Agreement_v1.0.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\CvAsset\CvAsset.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(PrintEnable)' == 'true'">
    <IkvmReference Include="printstream.jar">
      <AssemblyName>printstream</AssemblyName>
      <AssemblyVersion>1.0.0.0</AssemblyVersion>
      <AssemblyFileVersion>1.0.0.0</AssemblyFileVersion>
    </IkvmReference>
  </ItemGroup>
</Project>
