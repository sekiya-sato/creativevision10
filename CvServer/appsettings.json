{
	"ConnectionStrings": {
		"sqlite": "server-dev.db" // 必須変更: DBファイル名
	},
	"PrintServer": {
		"UsePrint": true, // 印刷機能を使用するかどうか
		"PrintBaseDir": "..",
		"PrintFormDir": "printform",
		"PrintOutputDir": "CvServer/wrk"
	},
	"ServerVersion": "0.8.13", // サーバーバージョン
	"WebAuthJwt": {
		"SecretKey": "Initial-LongSecretkey-you-need-longer-keystring", // 必須変更:JWT署名用のシークレットキー用文字列 ある程度の長さが必要
		"Issuer": "CreativeVision10", // JWT発行者
		"Audience": "Wpfclient", // JWT使用者
		"Lifetime": "120", // 有効期限 120分
		"Refreshtime": "1440" // refresh後有効期限 1日=1440分
	},
	"Application": {
		"OpenWeatherApiKey": "取得したAPIキー", //必須変更: OpenWeatherMapのAPIキー
		"OpenWeatherCount": 40 // 件数(16=48時間,40=5日間)
	},
	"JapanPostBiz": {
		"ClientId": "取得したClientId", // 必須変更: 日本郵便ビジネスAPIのClientId
		"SecretKey": "取得したAPIキー" // 必須変更: 日本郵便ビジネスAPIのSecretKey
	},
	"AllowedHosts": "*",
	"Kestrel": {
		"EndpointDefaults": {
			"Protocols": "Http2"
		},
		"Endpoints": {
			"Http": {
				"Url": "http://*:5002" // 必須変更: HTTPリスニングURLとポート
			},
			"HttpsDefaultCert": {
				"Url": "https://*:5012" // 必須変更: HTTPSリスニングURLとポート (証明書はデフォルトのものを使用)
			}
		}
	},
	"NCrontab.Scheduler": {
		"DateTimeKind": "Local"
	},
	"Logging": {
		// NLog が全て制御するので、MEL 側のフィルターは最小限にするか削除可
		"LogLevel": {
			"Default": "Debug"
		}
	},
	"NLog": {
		"autoReload": true,
		"throwConfigExceptions": true,

		// レイアウトを変数化
		"variables": {
			"fileLayout": "${longdate}|${level:uppercase=true}|${logger}|${message} ${exception:format=tostring}",
			"consoleLayout": "${time}|${level:uppercase=true}|${logger:shortName=true}|${message} ${exception:format=tostring}"
		},

		"targets": {
			"async": true,
			"logfile": {
				"type": "File",
				"fileName": "${basedir}/logs/server.log",
				"layout": "${var:fileLayout}",
				"createDirs": true,
				"archiveFileName": "${basedir}/logs/archives/server-{###}.log",
				"archiveAboveSize": 2048000,
				"archiveNumbering": "Sequence",
				"maxArchiveFiles": 100,
				"encoding": "UTF-8"
			},
			"logconsole": {
				"type": "Console",
				"layout": "${var:consoleLayout}"
			}
		},

		"rules": [
			// --- ノイズ抑制（Debug/Trace のみ落とし、Info 以上は後続のルールへ） ---
			{
				"logger": "Microsoft.*",
				"maxLevel": "Debug",
				"final": true
			},
			{
				"logger": "System.*",
				"maxLevel": "Debug",
				"final": true
			},
			{
				"logger": "Grpc.AspNetCore.Server.Model.Internal.*",
				"maxLevel": "Debug",
				"final": true
			},

			// --- 出力 ---
			// ファイルには Debug 以上を全部出す
			{
				"logger": "*",
				"minLevel": "Debug",
				"writeTo": "logfile"
			},
			// コンソールには Info 以上だけ出す（起動時の DEBUG ノイズを抑える）
			{
				"logger": "*",
				"minLevel": "Info",
				"writeTo": "logconsole"
			}
		]
	}
}
