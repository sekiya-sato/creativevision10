<Application x:Class="CvWpfpos.App"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:helpers="clr-namespace:CvWpfpos.Helpers" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
	<Application.Resources>
		<ResourceDictionary>
			<!--  ConverterがあればApp.xamlで定義する  -->
			<helpers:InverseBooleanConverter x:Key="InverseBooleanConverter" />
			<helpers:StringIsNotEmptyToVisibilityConverter x:Key="StringIsNotEmptyToVisibilityConverter" />
			<helpers:KubunToPsConverter x:Key="KubunToPsConverter" />
			<helpers:AmountDiffToBrushConverter x:Key="AmountDiffToBrushConverter" />
			<helpers:PosKubunMultiConverter x:Key="PosKubunMultiConverter" />
			<BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="/Resources/UIColors.xaml" />
				<ResourceDictionary Source="/Resources/UICommon.xaml" />
				<materialDesign:BundledTheme BaseTheme="Light" PrimaryColor="DeepPurple" SecondaryColor="Green" />
				<ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
				<ResourceDictionary Source="/Resources/UIFormStyles.xaml" />
				<ResourceDictionary Source="/Resources/UIPos.xaml" />
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</Application.Resources>
</Application>
