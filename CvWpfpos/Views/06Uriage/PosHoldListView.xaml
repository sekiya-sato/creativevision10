<helpers:BaseWindow x:Class="CvWpfpos.Views._06Uriage.PosHoldListView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:helpers="clr-namespace:CvWpfpos.Helpers" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:vm="clr-namespace:CvWpfpos.ViewModels._06Uriage"
	Title="保留一覧"
	Width="600" Height="500" MinWidth="500" MinHeight="400"
	Background="{DynamicResource AppCommonBackgroundBrush}"
	Foreground="{DynamicResource MaterialDesignBody}"
	ResizeMode="NoResize" TextOptions.TextFormattingMode="Display"
	mc:Ignorable="d">

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<!--  ヘッダー  -->
		<materialDesign:ColorZone Grid.Row="0"
			Padding="12,8"
			materialDesign:ElevationAssist.Elevation="Dp4" Mode="PrimaryMid">
			<StackPanel Orientation="Horizontal">
				<materialDesign:PackIcon Width="28" Height="28"
					VerticalAlignment="Center"
					Kind="PauseCircle" />
				<TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
					FontSize="20" FontWeight="SemiBold" Text="保留一覧" />
			</StackPanel>
		</materialDesign:ColorZone>

		<!--  リスト  -->
		<materialDesign:Card Grid.Row="1"
			Margin="16" Padding="0"
			materialDesign:ElevationAssist.Elevation="Dp1" UniformCornerRadius="8">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="*" />
				</Grid.RowDefinitions>
				<Border Grid.Row="0"
					Padding="12,8"
					Background="{DynamicResource MaterialDesignToolBarBackground}"
					CornerRadius="8,8,0,0">
					<TextBlock FontWeight="SemiBold" Text="保留中の売上" />
				</Border>
				<ListView Grid.Row="1"
					ItemsSource="{Binding HoldList}"
					SelectedItem="{Binding SelectedEntry}">
					<ListView.View>
						<GridView>
							<GridViewColumn Width="160"
								DisplayMemberBinding="{Binding HeldAt, StringFormat=yyyy/MM/dd HH:mm}"
								Header="保留日時" />
							<GridViewColumn Width="100"
								DisplayMemberBinding="{Binding ItemCount, StringFormat={}{0}件}"
								Header="明細数" />
							<GridViewColumn Width="120"
								DisplayMemberBinding="{Binding TotalAmount, StringFormat={}{0:N0}円}"
								Header="合計金額" />
						</GridView>
					</ListView.View>
				</ListView>
			</Grid>
		</materialDesign:Card>

		<!--  フッター  -->
		<StackPanel Grid.Row="2"
			Margin="16" Orientation="Horizontal">
			<TextBlock VerticalAlignment="Center"
				Style="{StaticResource StatusTextBlockStyle}"
				Text="{Binding StatusMessage}" />
			<Button Margin="16,0,0,0"
				Command="{Binding ResumeCommand}"
				Content="復元"
				IsDefault="True"
				Style="{StaticResource PosPrimaryButton}" />
		</StackPanel>
	</Grid>
</helpers:BaseWindow>
