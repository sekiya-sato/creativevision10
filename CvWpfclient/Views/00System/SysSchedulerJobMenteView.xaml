<helpers:BaseWindow x:Class="CvWpfclient.Views._00System.SysSchedulerJobMenteView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:helpers="clr-namespace:CvWpfclient.Helpers" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:vm="clr-namespace:CvWpfclient.ViewModels._00System"
	Title="{Binding Title}"
	Width="1244" Height="900"
	Background="{DynamicResource AppCommonBackgroundBrush}"
	FontSize="19"
	Foreground="{DynamicResource MaterialDesignBody}"
	TextOptions.TextFormattingMode="Display"
	mc:Ignorable="d">
	<helpers:BaseWindow.DataContext>
		<vm:SysSchedulerJobMenteViewModel />
	</helpers:BaseWindow.DataContext>

	<helpers:BaseWindow.InputBindings>
		<KeyBinding Command="{Binding LoadTasksCommand}"
			Gesture="F5" />
	</helpers:BaseWindow.InputBindings>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<!--  ヘッダー: ColorZone ツールバー  -->
		<materialDesign:ColorZone Grid.Row="0"
			Padding="12,8"
			materialDesign:ElevationAssist.Elevation="Dp4" Mode="PrimaryMid">
			<DockPanel>
				<StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
					<Button Margin="4,0"
						Command="{Binding OpenHistoryCommand}"
						Style="{StaticResource ToolCommandButton}"
						ToolTip="実行履歴">
						<StackPanel Orientation="Horizontal">
							<materialDesign:PackIcon VerticalAlignment="Center"
								Kind="History" />
							<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
								Text="自動実行履歴" />
						</StackPanel>
					</Button>
				</StackPanel>

				<StackPanel Orientation="Horizontal">
					<Button Margin="0,0,8,0"
						Command="{Binding ExitCommand}"
						Style="{StaticResource ToolCommandButton}"
						ToolTip="閉じる (Esc)">
						<materialDesign:PackIcon Kind="ArrowLeft" />
					</Button>
					<materialDesign:PackIcon Width="28" Height="28"
						VerticalAlignment="Center"
						Kind="CalendarClock" />
					<TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
						FontSize="20" FontWeight="SemiBold"
						Text="{Binding Title}" />
					<Rectangle Width="1"
						Margin="16,4"
						Fill="{DynamicResource PrimaryHueMidForegroundBrush}"
						Opacity="0.3" />
					<Button Command="{Binding LoadTasksCommand}"
						Style="{StaticResource ToolCommandButton}"
						ToolTip="一覧更新 (F5)">
						<StackPanel Orientation="Horizontal">
							<materialDesign:PackIcon VerticalAlignment="Center"
								Kind="Refresh" />
							<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
								Text="一覧更新" />
						</StackPanel>
					</Button>
				</StackPanel>
			</DockPanel>
		</materialDesign:ColorZone>

		<!--  操作ボタン  -->
		<StackPanel Grid.Row="1"
			Margin="12,8"
			Orientation="Horizontal">
			<Button Margin="20,0,8,0"
				Command="{Binding EditCronCommand}"
				Content="起動時間変更"
				Style="{StaticResource MaterialDesignFlatMidBgButton}" />
			<Button Margin="20,0,8,0"
				Background="{DynamicResource MaterialDesignValidationErrorBrush}"
				Command="{Binding DeleteTaskCommand}"
				Content="削除"
				Foreground="{DynamicResource MaterialDesignPaper}"
				Style="{StaticResource MaterialDesignFlatButton}" />
		</StackPanel>

		<!--  DataGrid  -->
		<materialDesign:Card Grid.Row="2"
			Margin="12,0,12,12" Padding="0"
			materialDesign:ElevationAssist.Elevation="Dp2" UniformCornerRadius="8">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="*" />
				</Grid.RowDefinitions>

				<Border Grid.Row="0"
					Padding="12,8"
					Background="{DynamicResource MaterialDesignToolBarBackground}"
					CornerRadius="8,8,0,0">
					<DockPanel>
						<TextBlock VerticalAlignment="Center"
							DockPanel.Dock="Right" FontSize="13"
							Foreground="{DynamicResource MaterialDesignBodyLight}"
							Text="{Binding Tasks.Count, StringFormat={}件数: {0:N0}}" />
						<TextBlock VerticalAlignment="Center"
							FontSize="13"
							Foreground="{DynamicResource MaterialDesignBodyLight}"
							Text="{Binding Message}"
							TextTrimming="CharacterEllipsis" />
					</DockPanel>
				</Border>

				<DataGrid x:Name="TaskGrid"
					Grid.Row="1"
					d:ItemsSource="{d:SampleData ItemCount=5}"
					helpers:DataGridSelectionBehavior.AutoScrollToSelectedItem="True" materialDesign:DataGridAssist.CellPadding="12,6" materialDesign:DataGridAssist.ColumnHeaderPadding="12,8"
					AutoGenerateColumns="False" EnableRowVirtualization="True" FrozenColumnCount="1" GridLinesVisibility="Horizontal"
					HorizontalGridLinesBrush="{DynamicResource MaterialDesignDivider}"
					IsReadOnly="True" IsSynchronizedWithCurrentItem="True"
					ItemsSource="{Binding Tasks}"
					SelectedItem="{Binding SelectedTask}"
					Style="{StaticResource MaterialDesignDataGrid}"
					VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
					<DataGrid.Columns>
						<DataGridTextColumn Width="200"
							Binding="{Binding TaskId}"
							Header="TaskId" />
						<DataGridTextColumn Width="500"
							Binding="{Binding TaskName}"
							Header="タスク名" />
						<DataGridTextColumn Width="190"
							Binding="{Binding CronExpression}"
							Header="Cron式" />
						<DataGridTextColumn Width="180"
							Binding="{Binding NextOccurrence, StringFormat={}{0:yyyy/MM/dd HH:mm:ss}}"
							Header="次回実行時刻" />
						<DataGridCheckBoxColumn Width="70"
							Binding="{Binding IsSystemTask}"
							Header="システム" />
					</DataGrid.Columns>
					<DataGrid.ColumnHeaderStyle>
						<Style BasedOn="{StaticResource MenteDataGridColumnHeader}"
							TargetType="DataGridColumnHeader" />
					</DataGrid.ColumnHeaderStyle>
				</DataGrid>
			</Grid>
		</materialDesign:Card>

		<!--  ステータスバー  -->
		<StatusBar Grid.Row="3"
			Background="{DynamicResource MaterialDesignToolBarBackground}">
			<StatusBarItem>
				<TextBlock FontSize="13"
					Foreground="{DynamicResource MaterialDesignBodyLight}"
					Text="{Binding Message}" />
			</StatusBarItem>
			<StatusBarItem HorizontalAlignment="Right">
				<ProgressBar Width="120" Height="4"
					IsIndeterminate="True"
					Style="{StaticResource MaterialDesignCircularProgressBar}"
					Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
			</StatusBarItem>
		</StatusBar>
	</Grid>
</helpers:BaseWindow>
