<?xml version="1.0" encoding="utf-8" ?>
<helpers:BaseWindow x:Class="CvWpfclient.Views._00System.SwitchDbView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:helpers="clr-namespace:CvWpfclient.Helpers" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:vm="clr-namespace:CvWpfclient.ViewModels._00System"
	Title="DB切替処理"
	Width="900" Height="800"
	Background="{DynamicResource AppCommonBackgroundBrush}"
	FontSize="16"
	Foreground="{DynamicResource MaterialDesignBody}"
	ResizeMode="NoResize" TextOptions.TextFormattingMode="Display"
	mc:Ignorable="d">
	<helpers:BaseWindow.DataContext>
		<vm:SwitchDbViewModel />
	</helpers:BaseWindow.DataContext>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<materialDesign:ColorZone Grid.Row="0"
			Padding="12,8"
			materialDesign:ElevationAssist.Elevation="Dp4" Mode="PrimaryMid">
			<StackPanel Orientation="Horizontal">
				<Button Margin="0,0,8,0"
					Command="{Binding ExitCommand}"
					IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBooleanConverter}}"
					Style="{StaticResource ToolCommandButton}"
					ToolTip="閉じる (Esc)">
					<materialDesign:PackIcon Kind="ArrowLeft" />
				</Button>
				<materialDesign:PackIcon Width="28" Height="28"
					VerticalAlignment="Center"
					Kind="DatabaseSync" />
				<TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
					FontSize="20" FontWeight="SemiBold" Text="DB切替処理" />
			</StackPanel>
		</materialDesign:ColorZone>

		<Grid Grid.Row="1"
			Margin="18">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
			</Grid.RowDefinitions>

			<materialDesign:Card Grid.Row="0"
				Padding="24"
				materialDesign:ElevationAssist.Elevation="Dp2" UniformCornerRadius="8">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="170" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>

					<StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
						Margin="0,0,0,12"
						Orientation="Horizontal">
						<materialDesign:PackIcon Width="24" Height="24"
							VerticalAlignment="Center"
							Kind="Cog" />
						<TextBlock Margin="8,0,0,0" VerticalAlignment="Center"
							FontSize="17" FontWeight="SemiBold" Text="実行設定" />
					</StackPanel>

					<TextBlock Grid.Row="1" Grid.Column="0"
						Style="{StaticResource SettingLabel}"
						Text="移動元DB" />
					<ComboBox Grid.Row="1" Grid.Column="1"
						Width="260" Margin="0,4"
						HorizontalAlignment="Left"
						IsEnabled="{Binding HasExecuted, Converter={StaticResource InverseBooleanConverter}}"
						ItemsSource="{Binding ConnectionNames}"
						SelectedItem="{Binding FromConnection}" />

					<TextBlock Grid.Row="2" Grid.Column="0"
						Style="{StaticResource SettingLabel}"
						Text="移動先DB" />
					<ComboBox Grid.Row="2" Grid.Column="1"
						Width="260" Margin="0,4"
						HorizontalAlignment="Left"
						IsEnabled="{Binding HasExecuted, Converter={StaticResource InverseBooleanConverter}}"
						ItemsSource="{Binding ConnectionNames}"
						SelectedItem="{Binding ToConnection}" />

					<TextBlock Grid.Row="3" Grid.Column="1"
						Margin="0,8,0,4"
						Foreground="{DynamicResource MaterialDesignValidationErrorBrush}"
						Text="移動先の対象テーブルは削除して作り直します。移動元は変更しません。実行中は他の利用者が更新しないでください。"
						TextWrapping="Wrap" />

					<TextBlock Grid.Row="4" Grid.Column="0"
						Style="{StaticResource SettingLabel}"
						Text="進捗" />
					<ProgressBar Grid.Row="4" Grid.Column="1"
						Height="18"
						Maximum="100" Minimum="0"
						Value="{Binding ProgressValue}" />
				</Grid>
			</materialDesign:Card>

			<GroupBox Grid.Row="1"
				Margin="0,18,0,0"
				Header="ストリーミングログ">
				<ListBox Margin="8"
					ItemsSource="{Binding StreamMessages}">
					<ListBox.ItemTemplate>
						<DataTemplate>
							<TextBlock Foreground="{DynamicResource MaterialDesignBody}"
								Text="{Binding}"
								TextWrapping="Wrap" />
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>
			</GroupBox>
		</Grid>

		<Border Grid.Row="2"
			Padding="18,12"
			Background="{DynamicResource MaterialDesignPaper}">
			<StackPanel HorizontalAlignment="Right"
				Orientation="Horizontal">
				<Button Width="128" Height="38"
					Margin="0,0,10,0"
					Command="{Binding ExecuteCommand}"
					Style="{StaticResource MaterialDesignRaisedButton}">
					<StackPanel Orientation="Horizontal">
						<materialDesign:PackIcon VerticalAlignment="Center"
							Kind="Play" />
						<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
							Text="実行" />
					</StackPanel>
				</Button>
				<Button Width="128" Height="38"
					Command="{Binding ExitCommand}"
					IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBooleanConverter}}"
					IsCancel="True"
					Style="{StaticResource MaterialDesignOutlinedButton}">
					<StackPanel Orientation="Horizontal">
						<materialDesign:PackIcon VerticalAlignment="Center"
							Kind="ArrowLeft" />
						<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
							Text="戻る" />
					</StackPanel>
				</Button>
			</StackPanel>
		</Border>
	</Grid>
</helpers:BaseWindow>
