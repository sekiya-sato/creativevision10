<helpers:BaseWindow x:Class="CvWpfclient.Views._00System.SysSchedulerCronEditView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:helpers="clr-namespace:CvWpfclient.Helpers"
	xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:vm="clr-namespace:CvWpfclient.ViewModels._00System"
	Title="Cron式編集"
	Width="640" Height="480"
	Background="{DynamicResource AppCommonBackgroundBrush}"
	FontSize="16"
	Foreground="{DynamicResource MaterialDesignBody}"
	TextOptions.TextFormattingMode="Display"
	mc:Ignorable="d">
	<helpers:BaseWindow.DataContext>
		<vm:SysSchedulerCronEditViewModel />
	</helpers:BaseWindow.DataContext>

	<Grid Margin="20">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<!-- タスク名 -->
		<TextBlock Grid.Row="0"
			Margin="0,0,0,4"
			FontWeight="Medium"
			Foreground="{DynamicResource MaterialDesignBodyLight}"
			Text="タスク名" />
		<TextBox Grid.Row="1"
			IsReadOnly="True"
			Style="{StaticResource MaterialDesignOutlinedTextBox}"
			Text="{Binding TaskName}" />

		<!-- Cron式 -->
		<TextBlock Grid.Row="2"
			Margin="0,16,0,4"
			FontWeight="Medium"
			Foreground="{DynamicResource MaterialDesignBodyLight}"
			Text="Cron式" />
		<TextBox Grid.Row="3"
			materialDesign:HintAssist.Hint="例: 0 2 * * *"
			Style="{StaticResource MaterialDesignOutlinedTextBox}"
			Text="{Binding CronExpression, UpdateSourceTrigger=PropertyChanged}" />

		<!-- 検証メッセージ -->
		<TextBlock Grid.Row="4"
			Margin="0,8,0,0"
			Foreground="{DynamicResource MaterialDesignValidationErrorBrush}"
			Text="{Binding ValidationMessage}"
			TextWrapping="Wrap"
			Visibility="{Binding ValidationMessage, Converter={StaticResource StringIsNotEmptyToVisibilityConverter}}" />

		<!-- 次回実行時刻プレビュー -->
		<TextBlock Grid.Row="5"
			Margin="0,8,0,0"
			Foreground="{DynamicResource MaterialDesignBodyLight}"
			Text="{Binding PreviewNextOccurrence}" />

		<!-- プリセットボタン -->
		<WrapPanel Grid.Row="6"
			Margin="0,16,0,0">
			<Button Margin="0,0,8,8"
				Command="{Binding ApplyPresetCommand}"
				CommandParameter="0 2 * * *"
				Style="{StaticResource MaterialDesignFlatButton}"
				Content="毎日2:00" />
			<Button Margin="0,0,8,8"
				Command="{Binding ApplyPresetCommand}"
				CommandParameter="0 * * * *"
				Style="{StaticResource MaterialDesignFlatButton}"
				Content="毎時0分" />
			<Button Margin="0,0,8,8"
				Command="{Binding ApplyPresetCommand}"
				CommandParameter="0 0 1 * *"
				Style="{StaticResource MaterialDesignFlatButton}"
				Content="毎月1日0:00" />
			<Button Margin="0,0,8,8"
				Command="{Binding ApplyPresetCommand}"
				CommandParameter="*/10 * * * *"
				Style="{StaticResource MaterialDesignFlatButton}"
				Content="10分ごと" />
			<Button Margin="0,0,8,8"
				Command="{Binding ApplyPresetCommand}"
				CommandParameter="0 0 * * 0"
				Style="{StaticResource MaterialDesignFlatButton}"
				Content="毎週日曜0:00" />
		</WrapPanel>

		<!-- ボタン群 -->
		<StackPanel Grid.Row="7"
			HorizontalAlignment="Right"
			Orientation="Horizontal">
			<Button Margin="8,0"
				Command="{Binding ConfirmCommand}"
				Style="{StaticResource MaterialDesignFlatMidBgButton}"
				Content="確定" />
			<Button Margin="8,0"
				Command="{Binding ExitCommand}"
				Style="{StaticResource MaterialDesignFlatButton}"
				Content="キャンセル" />
		</StackPanel>
	</Grid>
</helpers:BaseWindow>
