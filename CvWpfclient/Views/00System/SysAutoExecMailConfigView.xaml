<helpers:BaseWindow x:Class="CvWpfclient.Views._00System.SysAutoExecMailConfigView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:helpers="clr-namespace:CvWpfclient.Helpers" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:vm="clr-namespace:CvWpfclient.ViewModels._00System"
	Title="{Binding Title}"
	Width="720" Height="820"
	Background="{DynamicResource AppCommonBackgroundBrush}"
	FontSize="16"
	Foreground="{DynamicResource MaterialDesignBody}"
	TextOptions.TextFormattingMode="Display"
	mc:Ignorable="d">
	<helpers:BaseWindow.DataContext>
		<vm:SysAutoExecMailConfigViewModel />
	</helpers:BaseWindow.DataContext>

	<helpers:BaseWindow.InputBindings>
		<KeyBinding Command="{Binding LoadCommand}"
			Gesture="F5" />
	</helpers:BaseWindow.InputBindings>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<!--  ヘッダー: ColorZone ツールバー  -->
		<materialDesign:ColorZone Grid.Row="0"
			Padding="12,8"
			materialDesign:ElevationAssist.Elevation="Dp4" Mode="PrimaryMid">
			<DockPanel>
				<StackPanel Orientation="Horizontal">
					<Button Margin="0,0,8,0"
						Command="{Binding ExitCommand}"
						Style="{StaticResource ToolCommandButton}"
						ToolTip="閉じる (Esc)">
						<materialDesign:PackIcon Kind="ArrowLeft" />
					</Button>
					<materialDesign:PackIcon Width="28" Height="28"
						VerticalAlignment="Center"
						Kind="EmailOutline" />
					<TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
						FontSize="20" FontWeight="SemiBold"
						Text="{Binding Title}" />
					<Rectangle Width="1"
						Margin="16,4"
						Fill="{DynamicResource PrimaryHueMidForegroundBrush}"
						Opacity="0.3" />
					<Button Command="{Binding LoadCommand}"
						IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
						Style="{StaticResource ToolCommandButton}"
						ToolTip="再読込 (F5)">
						<StackPanel Orientation="Horizontal">
							<materialDesign:PackIcon VerticalAlignment="Center"
								Kind="Refresh" />
							<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
								Text="再読込" />
						</StackPanel>
					</Button>
				</StackPanel>
			</DockPanel>
		</materialDesign:ColorZone>

		<!--  フォーム本体  -->
		<ScrollViewer Grid.Row="1"
			VerticalScrollBarVisibility="Auto">
			<materialDesign:Card Margin="12" Padding="16"
				materialDesign:ElevationAssist.Elevation="Dp2" UniformCornerRadius="8">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="180" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>

					<!--  現在の設定でメール送信できるかどうか  -->
					<Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
						Margin="0,0,0,16" Padding="10,8"
						Background="{DynamicResource MaterialDesignToolBarBackground}"
						CornerRadius="4">
						<TextBlock FontWeight="Medium"
							Text="{Binding ValidationMessage}"
							TextWrapping="Wrap" />
					</Border>

					<TextBlock Grid.Row="1" Grid.Column="0"
						Style="{StaticResource SettingLabel}"
						Text="SMTPサーバー" />
					<TextBox Grid.Row="1" Grid.Column="1"
						materialDesign:HintAssist.Hint="SMTPサーバー"
						Style="{StaticResource FormTextBox}"
						Text="{Binding Server, UpdateSourceTrigger=PropertyChanged}" />

					<TextBlock Grid.Row="2" Grid.Column="0"
						Style="{StaticResource SettingLabel}"
						Text="ポート番号" />
					<TextBox Grid.Row="2" Grid.Column="1"
						materialDesign:HintAssist.Hint="ポート番号"
						Style="{StaticResource FormTextBox}"
						Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" />

					<TextBlock Grid.Row="3" Grid.Column="0"
						Style="{StaticResource SettingLabel}"
						Text="暗号化方式" />
					<ComboBox Grid.Row="3" Grid.Column="1"
						Margin="0,6"
						materialDesign:HintAssist.Hint="暗号化方式"
						ItemsSource="{Binding SecurityValues}"
						SelectedItem="{Binding SelectedSecurity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
						Style="{StaticResource FormComboBox}" />

					<TextBlock Grid.Row="4" Grid.Column="0"
						Style="{StaticResource SettingLabel}"
						Text="認証方式" />
					<ComboBox Grid.Row="4" Grid.Column="1"
						Margin="0,6"
						materialDesign:HintAssist.Hint="認証方式"
						ItemsSource="{Binding AuthModeValues}"
						SelectedItem="{Binding SelectedAuthMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
						Style="{StaticResource FormComboBox}" />

					<TextBlock Grid.Row="5" Grid.Column="0"
						Style="{StaticResource SettingLabel}"
						Text="ユーザーID" />
					<TextBox Grid.Row="5" Grid.Column="1"
						materialDesign:HintAssist.Hint="ユーザーID"
						IsEnabled="{Binding IsCredentialRequired}"
						Style="{StaticResource FormTextBox}"
						Text="{Binding UserId, UpdateSourceTrigger=PropertyChanged}" />

					<TextBlock Grid.Row="6" Grid.Column="0"
						Style="{StaticResource SettingLabel}"
						Text="パスワード" />
					<StackPanel Grid.Row="6" Grid.Column="1">
						<PasswordBox
							helpers:PasswordBoxAssistant.BindPassword="True"
							helpers:PasswordBoxAssistant.BoundPassword="{Binding Credential, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
							IsEnabled="{Binding IsCredentialRequired}"
							materialDesign:HintAssist.Hint="パスワード"
							CaretBrush="{DynamicResource MaterialDesignBody}"
							Foreground="{DynamicResource MaterialDesignBody}"
							Style="{StaticResource FormPasswordBox}" />
						<TextBlock Margin="0,4,0,0"
							FontSize="13"
							Foreground="{DynamicResource MaterialDesignBodyLight}"
							Text="{Binding CredentialStatus}" />
						<CheckBox Margin="0,6,0,0"
							Content="パスワードを消去して保存"
							IsChecked="{Binding ClearCredential, Mode=TwoWay}" />
					</StackPanel>

					<TextBlock Grid.Row="7" Grid.Column="0"
						Style="{StaticResource SettingLabel}"
						Text="送信元アドレス" />
					<TextBox Grid.Row="7" Grid.Column="1"
						materialDesign:HintAssist.Hint="送信元アドレス"
						Style="{StaticResource FormTextBox}"
						Text="{Binding FromAddress, UpdateSourceTrigger=PropertyChanged}" />

					<TextBlock Grid.Row="8" Grid.Column="0"
						Style="{StaticResource SettingLabel}"
						Text="送信元表示名（省略可）" />
					<TextBox Grid.Row="8" Grid.Column="1"
						materialDesign:HintAssist.Hint="送信元表示名（省略可）"
						Style="{StaticResource FormTextBox}"
						Text="{Binding FromName, UpdateSourceTrigger=PropertyChanged}" />

					<TextBlock Grid.Row="9" Grid.Column="0"
						Style="{StaticResource SettingLabel}"
						Text="送信先アドレス" />
					<TextBox Grid.Row="9" Grid.Column="1"
						materialDesign:HintAssist.Hint="カンマまたはセミコロン区切りで複数指定できます"
						Style="{StaticResource FormTextBox}"
						Text="{Binding ToAddress, UpdateSourceTrigger=PropertyChanged}" />
				</Grid>
			</materialDesign:Card>
		</ScrollViewer>

		<!--  ステータスバー / 操作ボタン  -->
		<StatusBar Grid.Row="2"
			Background="{DynamicResource MaterialDesignToolBarBackground}">
			<StatusBarItem>
				<ProgressBar Width="120" Height="4"
					IsIndeterminate="True"
					Style="{StaticResource MaterialDesignCircularProgressBar}"
					Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
			</StatusBarItem>
			<StatusBarItem HorizontalAlignment="Right">
				<StackPanel Orientation="Horizontal">
					<Button Margin="8,4"
						Command="{Binding SaveCommand}"
						Content="保存"
						IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
						Style="{StaticResource MaterialDesignFlatMidBgButton}" />
					<Button Margin="8,4"
						Command="{Binding TestSendCommand}"
						Content="テスト送信"
						IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
						Style="{StaticResource MaterialDesignFlatMidBgButton}" />
					<Button Margin="8,4"
						Command="{Binding ExitCommand}"
						Content="閉じる"
						Style="{StaticResource MaterialDesignFlatButton}" />
				</StackPanel>
			</StatusBarItem>
		</StatusBar>
	</Grid>
</helpers:BaseWindow>
