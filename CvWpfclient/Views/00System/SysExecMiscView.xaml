<?xml version="1.0" encoding="utf-8" ?>
<helpers:BaseWindow x:Class="CvWpfclient.Views._00System.SysExecMiscView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:helpers="clr-namespace:CvWpfclient.Helpers" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:vm="clr-namespace:CvWpfclient.ViewModels._00System"
	Title="管理者用システム処理"
	Width="900" Height="700"
	Background="{DynamicResource AppCommonBackgroundBrush}"
	FontSize="16"
	Foreground="{DynamicResource MaterialDesignBody}"
	ResizeMode="NoResize" TextOptions.TextFormattingMode="Display"
	mc:Ignorable="d">
	<helpers:BaseWindow.DataContext>
		<vm:SysExecMiscViewModel />
	</helpers:BaseWindow.DataContext>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<materialDesign:ColorZone Grid.Row="0"
			Padding="14,10"
			materialDesign:ElevationAssist.Elevation="Dp4" Mode="PrimaryMid">
			<StackPanel Orientation="Horizontal">
				<materialDesign:PackIcon Width="30" Height="30"
					VerticalAlignment="Center"
					Kind="Cog" />
				<TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
					FontSize="20" FontWeight="SemiBold" Text="管理者用システム処理" />
			</StackPanel>
		</materialDesign:ColorZone>

		<Grid Grid.Row="1"
			Margin="18">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
			</Grid.RowDefinitions>

			<materialDesign:Card Grid.Row="0"
				Padding="24"
				materialDesign:ElevationAssist.Elevation="Dp2" UniformCornerRadius="8">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>

					<TextBlock Grid.Row="0"
						Margin="0,0,0,16"
						FontSize="17" FontWeight="SemiBold" Text="実行する処理を選択してください" />

					<WrapPanel Grid.Row="1"
						Orientation="Horizontal">
						<Button Width="200" Height="42"
							Margin="0,0,12,12"
							Command="{Binding Test01Command}"
							IsEnabled="{Binding IsProcessing, Converter={StaticResource InverseBooleanConverter}}"
							Style="{StaticResource MaterialDesignRaisedButton}">
							<StackPanel Orientation="Horizontal">
								<materialDesign:PackIcon VerticalAlignment="Center"
									Kind="DatabaseRemove" />
								<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
									Text="環境変数取得" />
							</StackPanel>
						</Button>
						<Button Width="200" Height="42"
							Margin="0,0,12,12"
							Command="{Binding MasterShohinMeishoRebuildCommand}"
							IsEnabled="{Binding IsProcessing, Converter={StaticResource InverseBooleanConverter}}"
							Style="{StaticResource MaterialDesignRaisedButton}">
							<StackPanel Orientation="Horizontal">
								<materialDesign:PackIcon VerticalAlignment="Center"
									Kind="DatabaseRefresh" />
								<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
									Text="商品名称再構築" />
							</StackPanel>
						</Button>
						<Button Width="200" Height="42"
							Margin="0,0,12,12"
							Command="{Binding MasterVColumnResyncCommand}"
							IsEnabled="{Binding IsProcessing, Converter={StaticResource InverseBooleanConverter}}"
							Style="{StaticResource MaterialDesignRaisedButton}">
							<StackPanel Orientation="Horizontal">
								<materialDesign:PackIcon VerticalAlignment="Center"
									Kind="DatabaseSync" />
								<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
									Text="V*列再同期" />
							</StackPanel>
						</Button>
						<Button Width="200" Height="42"
							Margin="0,0,12,12"
							Command="{Binding TranTaxRebuildCommand}"
							IsEnabled="{Binding IsProcessing, Converter={StaticResource InverseBooleanConverter}}"
							Style="{StaticResource MaterialDesignRaisedButton}"
							ToolTip="対象6伝票（売上/店舗売上/生地・付属仕入/商品仕入/受注/発注）の期首日以降を、取引先マスタの現在の税設定で再計算します（冪等）">
							<StackPanel Orientation="Horizontal">
								<materialDesign:PackIcon VerticalAlignment="Center"
									Kind="Calculator" />
								<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
									Text="伝票税額再更新" />
							</StackPanel>
						</Button>
						<Button Width="200" Height="42"
							Margin="0,0,12,12"
							Command="{Binding ManualLockClearCommand}"
							IsEnabled="{Binding IsProcessing, Converter={StaticResource InverseBooleanConverter}}"
							Style="{StaticResource MaterialDesignRaisedButton}"
							ToolTip="処理が落ちて排他行が残ったままのとき、監視タスクの自動解放を待たずに強制解放します">
							<StackPanel Orientation="Horizontal">
								<materialDesign:PackIcon VerticalAlignment="Center"
									Kind="LockOpenVariant" />
								<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
									Text="マニュアル排他制御クリア" />
							</StackPanel>
						</Button>
					</WrapPanel>
				</Grid>
			</materialDesign:Card>

			<GroupBox Grid.Row="1"
				Margin="0,18,0,0"
				Header="実行結果">
				<TextBox Margin="8"
					IsReadOnly="True"
					Text="{Binding ResultMessage}"
					TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
			</GroupBox>
		</Grid>

		<Border Grid.Row="2"
			Padding="18,12"
			Background="{DynamicResource MaterialDesignPaper}">
			<StackPanel HorizontalAlignment="Right"
				Orientation="Horizontal">
				<Button Width="128" Height="38"
					Command="{Binding ExitCommand}"
					IsCancel="True"
					Style="{StaticResource MaterialDesignOutlinedButton}">
					<StackPanel Orientation="Horizontal">
						<materialDesign:PackIcon VerticalAlignment="Center"
							Kind="ArrowLeft" />
						<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
							Text="戻る" />
					</StackPanel>
				</Button>
			</StackPanel>
		</Border>
	</Grid>
</helpers:BaseWindow>
