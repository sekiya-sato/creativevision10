<helpers:BaseWindow x:Class="CvWpfclient.Views._00System.SysTableSpecView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:helpers="clr-namespace:CvWpfclient.Helpers"
	xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:vm="clr-namespace:CvWpfclient.ViewModels._00System"
	Title="{Binding Title}"
	Width="820" Height="420"
	Background="{DynamicResource AppCommonBackgroundBrush}"
	FontSize="16"
	Foreground="{DynamicResource MaterialDesignBody}"
	TextOptions.TextFormattingMode="Display" WindowStartupLocation="CenterScreen"
	mc:Ignorable="d">
	<helpers:BaseWindow.DataContext>
		<vm:SysTableSpecViewModel />
	</helpers:BaseWindow.DataContext>

	<helpers:BaseWindow.InputBindings>
		<KeyBinding Command="{Binding DoOutputPdfCommand}"
			Gesture="F6" />
		<KeyBinding Command="{Binding ExitCommand}"
			Gesture="Esc" />
	</helpers:BaseWindow.InputBindings>

	<helpers:BaseWindow.Resources>
		<Style x:Key="FormLabel"
			TargetType="TextBlock">
			<Setter Property="VerticalAlignment" Value="Center" />
			<Setter Property="FontWeight" Value="Medium" />
			<Setter Property="Foreground" Value="{DynamicResource MaterialDesignBodyLight}" />
			<Setter Property="Margin" Value="4,0,12,0" />
		</Style>
	</helpers:BaseWindow.Resources>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<materialDesign:ColorZone Grid.Row="0"
			Padding="12,8"
			materialDesign:ElevationAssist.Elevation="Dp4" Mode="PrimaryMid">
			<DockPanel>
				<StackPanel Orientation="Horizontal">
					<Button Margin="0,0,8,0"
						Command="{Binding ExitCommand}"
						Style="{StaticResource MaterialDesignToolForegroundButton}"
						ToolTip="閉じる (Esc)">
						<materialDesign:PackIcon Kind="ArrowLeft" />
					</Button>
					<materialDesign:PackIcon Width="28" Height="28"
						VerticalAlignment="Center"
						Kind="Printer" />
					<TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
						FontSize="20" FontWeight="SemiBold"
						Text="{Binding Title}" />
				</StackPanel>
			</DockPanel>
		</materialDesign:ColorZone>

		<Grid Grid.Row="1"
			Margin="24">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
			</Grid.RowDefinitions>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="120" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>

			<TextBlock Grid.Row="0" Grid.Column="0"
				Style="{StaticResource FormLabel}"
				Text="テーブル" />
			<DockPanel Grid.Row="0" Grid.Column="1"
				Margin="0,4">
				<Button Width="110" Height="36"
					Command="{Binding SelectTablesCommand}"
					DockPanel.Dock="Left"
					Style="{StaticResource MaterialDesignRaisedButton}">
					<StackPanel Orientation="Horizontal">
						<materialDesign:PackIcon VerticalAlignment="Center"
							Kind="CheckboxMultipleMarkedOutline" />
						<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
							Text="選択" />
					</StackPanel>
				</Button>
				<Button Width="80" Height="36"
					Margin="8,0,0,0"
					Command="{Binding ClearTablesCommand}"
					Content="解除" DockPanel.Dock="Right"
					Style="{StaticResource MaterialDesignFlatButton}" />
				<TextBlock Margin="12,0,8,0" VerticalAlignment="Center"
					Foreground="{DynamicResource MaterialDesignBody}"
					Text="{Binding SelectedTablesText}"
					TextTrimming="CharacterEllipsis"
					ToolTip="{Binding SelectedTablesText}" />
			</DockPanel>

			<TextBlock Grid.Row="1" Grid.Column="1"
				Margin="0,8,0,0"
				Foreground="{DynamicResource MaterialDesignBodyLight}">
				<TextBlock.Text>
					<MultiBinding StringFormat="{}取得 {0:N0} / 選択 {1:N0}">
						<Binding Path="ServerTableCount" />
						<Binding Path="SelectedTableCount" />
					</MultiBinding>
				</TextBlock.Text>
			</TextBlock>

			<Button Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
				Margin="0,32,0,16" HorizontalAlignment="Center"
				Command="{Binding DoOutputPdfCommand}"
				Style="{StaticResource MaterialDesignFlatMidBgButton}"
				ToolTip="印刷実行 (F6)">
				<StackPanel Orientation="Horizontal">
					<materialDesign:PackIcon VerticalAlignment="Center"
						Kind="Printer" />
					<TextBlock Margin="8,0,0,0" VerticalAlignment="Center"
						FontSize="20" Text="印刷実行" />
				</StackPanel>
			</Button>

			<TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
				Margin="0,8,0,0"
				Foreground="{DynamicResource MaterialDesignBodyLight}"
				Text="{Binding Message}"
				TextWrapping="Wrap" />
		</Grid>
	</Grid>
</helpers:BaseWindow>
