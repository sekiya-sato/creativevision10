<helpers:BaseWindow x:Class="CvWpfclient.Views._05Shiire.HenpinInputView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:helpers="clr-namespace:CvWpfclient.Helpers"
	xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:vm="clr-namespace:CvWpfclient.ViewModels._05Shiire"
	Title="{Binding Title}"
	Width="1280" Height="820"
	Background="{DynamicResource AppCommonBackgroundBrush}"
	FontSize="14"
	Foreground="{DynamicResource MaterialDesignBody}"
	TextOptions.TextFormattingMode="Display" WindowStartupLocation="CenterScreen"
	mc:Ignorable="d">
	<helpers:BaseWindow.DataContext>
		<vm:HenpinInputViewModel />
	</helpers:BaseWindow.DataContext>

	<behaviors:Interaction.Triggers>
		<behaviors:EventTrigger EventName="ContentRendered">
			<behaviors:InvokeCommandAction Command="{Binding InitCommand}" />
		</behaviors:EventTrigger>
	</behaviors:Interaction.Triggers>

	<helpers:BaseWindow.InputBindings>
		<KeyBinding Command="{Binding SearchCommand}"
			Gesture="F5" />
		<KeyBinding Command="{Binding RegisterCommand}"
			Gesture="F8" />
	</helpers:BaseWindow.InputBindings>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<!--  ヘッダ  -->
		<materialDesign:ColorZone Grid.Row="0"
			Padding="12,8"
			materialDesign:ElevationAssist.Elevation="Dp4" Mode="PrimaryMid">
			<DockPanel>
				<StackPanel VerticalAlignment="Center"
					DockPanel.Dock="Right" Orientation="Horizontal">
					<TextBlock Margin="16,0,0,0" VerticalAlignment="Center"
						Text="伝票No:" />
					<TextBlock Margin="4,0,0,0" VerticalAlignment="Center"
						FontWeight="SemiBold"
						Text="{Binding RegisteredDenId}" />
				</StackPanel>
				<StackPanel Orientation="Horizontal">
					<Button Margin="0,0,8,0"
						Command="{Binding ExitCommand}"
						Style="{StaticResource ToolCommandButton}"
						ToolTip="閉じる (Esc)">
						<materialDesign:PackIcon Kind="ArrowLeft" />
					</Button>
					<materialDesign:PackIcon Width="26" Height="26"
						VerticalAlignment="Center"
						Kind="TruckDelivery" />
					<TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
						FontSize="18" FontWeight="SemiBold"
						Text="{Binding Title}" />
				</StackPanel>
			</DockPanel>
		</materialDesign:ColorZone>

		<!--  伝票ヘッダ入力  -->
		<materialDesign:Card Grid.Row="1"
			Margin="12,12,12,0" Padding="14,12"
			materialDesign:ElevationAssist.Elevation="Dp1" UniformCornerRadius="8">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>

				<!--  取引区分  -->
				<TextBlock Grid.Row="0" Grid.Column="0"
					Style="{StaticResource FormLabel}"
					Text="取引区分" />
				<ComboBox Grid.Row="0" Grid.Column="1"
					Width="150"
					Margin="0,4,16,4"
					DisplayMemberPath="Name"
					ItemsSource="{Binding KubunOptions}"
					SelectedValue="{Binding SelectedKubun, Mode=TwoWay}"
					SelectedValuePath="Value"
					Style="{StaticResource FormComboBox}"
					ToolTip="現状は 20 仕入返品 のみ" />

				<!--  仕入日  -->
				<TextBlock Grid.Row="0" Grid.Column="2"
					Style="{StaticResource FormLabel}"
					Text="仕入日" />
				<StackPanel Grid.Row="0" Grid.Column="3"
					Orientation="Horizontal">
					<TextBox Width="150"
						Margin="0,4" HorizontalContentAlignment="Left"
						Style="{StaticResource FormTextBox}"
						Text="{Binding DenDayText, UpdateSourceTrigger=PropertyChanged}"
						ToolTip="yyyy/MM/dd" />
				</StackPanel>

				<!--  仕入先  -->
				<TextBlock Grid.Row="1" Grid.Column="0"
					Style="{StaticResource FormLabel}"
					Text="仕入先" />
				<StackPanel Grid.Row="1" Grid.Column="1"
					Margin="0,0,16,0"
					Orientation="Horizontal">
					<ComboBox Width="330"
						Margin="0,4"
						DisplayMemberPath="Display" IsEditable="False"
						ItemsSource="{Binding ShiireOptions}"
						SelectedItem="{Binding SelectedShiire, Mode=TwoWay}"
						Style="{StaticResource FormComboBox}"
						ToolTip="返品先の仕入先。対象商品はメーカーCDが仕入先CDと一致するものに絞られます"
						VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" />
					<Button Width="34" Height="30"
						Margin="4,4,0,4" Padding="0"
						Command="{Binding SelectShiireDialogCommand}"
						Style="{StaticResource MaterialDesignOutlinedButton}"
						ToolTip="仕入先を検索して選択">
						<TextBlock Text="&lt;&lt;" />
					</Button>
				</StackPanel>

				<!--  倉庫  -->
				<TextBlock Grid.Row="1" Grid.Column="2"
					Style="{StaticResource FormLabel}"
					Text="倉庫" />
				<StackPanel Grid.Row="1" Grid.Column="3"
					Orientation="Horizontal">
					<ComboBox Width="330"
						Margin="0,4"
						DisplayMemberPath="Display" IsEditable="False"
						ItemsSource="{Binding SokoOptions}"
						SelectedItem="{Binding SelectedSoko, Mode=TwoWay}"
						Style="{StaticResource FormComboBox}"
						ToolTip="返品する在庫のある倉庫"
						VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" />
					<Button Width="34" Height="30"
						Margin="4,4,0,4" Padding="0"
						Command="{Binding SelectSokoDialogCommand}"
						Style="{StaticResource MaterialDesignOutlinedButton}"
						ToolTip="倉庫を検索して選択">
						<TextBlock Text="&lt;&lt;" />
					</Button>
				</StackPanel>

				<!--  備考  -->
				<TextBlock Grid.Row="2" Grid.Column="0"
					InputMethod.IsInputMethodEnabled="True"
					Style="{StaticResource FormLabel}"
					Text="備考" />
				<TextBox Grid.Row="2" Grid.Column="1"
					Margin="0,4,16,4"
					materialDesign:HintAssist.Hint="備考"
					Style="{StaticResource FormTextBox}"
					Text="{Binding Memo, UpdateSourceTrigger=PropertyChanged}" />

				<!--  入力者  -->
				<TextBlock Grid.Row="2" Grid.Column="2"
					Style="{StaticResource FormLabel}"
					Text="入力者" />
				<StackPanel Grid.Row="2" Grid.Column="3"
					Orientation="Horizontal">
					<ComboBox Width="330"
						Margin="0,4"
						DisplayMemberPath="Display" IsEditable="False"
						ItemsSource="{Binding ShainOptions}"
						SelectedItem="{Binding SelectedShain, Mode=TwoWay}"
						Style="{StaticResource FormComboBox}"
						ToolTip="伝票の担当者"
						VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" />
					<Button Width="34" Height="30"
						Margin="4,4,0,4" Padding="0"
						Command="{Binding SelectShainDialogCommand}"
						Style="{StaticResource MaterialDesignOutlinedButton}"
						ToolTip="入力者を検索して選択">
						<TextBlock Text="&lt;&lt;" />
					</Button>
				</StackPanel>

				<!--  在庫取得  -->
				<StackPanel Grid.Row="0" Grid.RowSpan="3" Grid.Column="4"
					Margin="16,0,0,0" VerticalAlignment="Top">
					<Button Command="{Binding SearchCommand}"
						IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
						Style="{StaticResource MaterialDesignRaisedButton}"
						ToolTip="該当倉庫にある該当仕入先の商品を一覧表示 (F5)">
						<StackPanel Orientation="Horizontal">
							<materialDesign:PackIcon VerticalAlignment="Center"
								Kind="DatabaseSearch" />
							<TextBlock Margin="8,0,0,0" VerticalAlignment="Center"
								FontSize="16" Text="在庫取得(F5)" />
						</StackPanel>
					</Button>
					<StackPanel Margin="0,8,0,0"
						Orientation="Horizontal">
						<TextBlock Margin="0,0,8,0" VerticalAlignment="Center"
							Text="取得件数上限" />
						<TextBox Width="80"
							Style="{StaticResource FormTextBox}"
							Text="{Binding MaxCountText, UpdateSourceTrigger=PropertyChanged}" />
					</StackPanel>
				</StackPanel>
			</Grid>
		</materialDesign:Card>

		<!--  合計サマリー  -->
		<materialDesign:Card Grid.Row="2"
			Margin="12,8,12,0" Padding="12,8"
			materialDesign:ElevationAssist.Elevation="Dp1" UniformCornerRadius="8">
			<DockPanel>
				<StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
					<TextBlock VerticalAlignment="Center"
						Text="計" />
					<TextBlock Width="110"
						Margin="8,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Center"
						FontWeight="SemiBold"
						Text="{Binding InputSuTotal, StringFormat={}{0:N0}}"
						TextAlignment="Right"
						ToolTip="数量計" />
					<TextBlock Width="140"
						Margin="16,0,0,0" VerticalAlignment="Center"
						FontWeight="SemiBold"
						Text="{Binding JodaiKingakuTotal, StringFormat={}￥{0:N0}}"
						TextAlignment="Right"
						ToolTip="上代金額計" />
					<TextBlock Width="140"
						Margin="16,0,0,0" VerticalAlignment="Center"
						FontWeight="SemiBold"
						Text="{Binding GedaiKingakuTotal, StringFormat={}￥{0:N0}}"
						TextAlignment="Right"
						ToolTip="下代金額計" />
				</StackPanel>
				<StackPanel Orientation="Horizontal">
					<materialDesign:PackIcon Margin="0,0,8,0" VerticalAlignment="Center"
						Kind="FormatListNumbered" />
					<TextBlock VerticalAlignment="Center"
						FontSize="15" FontWeight="SemiBold" Text="返品明細" />
					<Border Margin="10,0,0,0" Padding="8,2"
						Background="{DynamicResource MaterialDesignDivider}"
						CornerRadius="10">
						<TextBlock FontSize="12" FontWeight="SemiBold"
							Text="{Binding RowCount, StringFormat={}{0:N0} 行}" />
					</Border>
					<TextBlock Margin="16,0,0,0" VerticalAlignment="Center"
						Foreground="{DynamicResource MaterialDesignBodyLight}"
						Text="[在庫取得] をクリックすると、該当仕入先の該当倉庫に在庫が存在する商品を表示します" />
				</StackPanel>
			</DockPanel>
		</materialDesign:Card>

		<!--  明細  -->
		<materialDesign:Card Grid.Row="3"
			Margin="12,8,12,0" Padding="0"
			materialDesign:ElevationAssist.Elevation="Dp1" UniformCornerRadius="8">
			<DataGrid x:Name="MeisaiGrid"
				d:ItemsSource="{d:SampleData ItemCount=5}"
				helpers:DataGridCellEnterNavigation.IsEnabled="True" helpers:DataGridSelectionBehavior.AutoScrollToSelectedItem="True" materialDesign:DataGridAssist.CellPadding="12,6"
				materialDesign:DataGridAssist.ColumnHeaderPadding="12,8"
				AlternatingRowBackground="{DynamicResource DataGridAlternatingRowBackgroundBrush}"
				AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" EnableRowVirtualization="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
				HorizontalGridLinesBrush="{DynamicResource MaterialDesignDivider}"
				IsSynchronizedWithCurrentItem="True"
				ItemsSource="{Binding Rows}"
				SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
				Style="{StaticResource MaterialDesignDataGrid}"
				VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
				<DataGrid.Columns>
					<DataGridTextColumn Width="110"
						Binding="{Binding Code_Shohin}"
						Header="商品CD" IsReadOnly="True" />
					<DataGridTextColumn Width="*" MinWidth="180"
						Binding="{Binding Mei_Shohin}"
						Header="商品名" IsReadOnly="True" />
					<DataGridTextColumn Width="60"
						Binding="{Binding Code_Col}"
						Header="色CD" IsReadOnly="True" />
					<DataGridTextColumn Width="100"
						Binding="{Binding Mei_Col}"
						Header="色名" IsReadOnly="True" />
					<DataGridTextColumn Width="85"
						Binding="{Binding Code_Siz}"
						Header="サイズCD" IsReadOnly="True" />
					<DataGridTextColumn Width="90"
						Binding="{Binding Mei_Siz}"
						Header="サイズ名" IsReadOnly="True" />
					<DataGridTextColumn Width="70"
						Binding="{Binding TheoreticalSu, StringFormat={}{0:N0}}"
						ElementStyle="{StaticResource DataGridRightTextBlock}"
						Header="在庫数" IsReadOnly="True" />
					<DataGridTextColumn Width="70"
						Binding="{Binding InputSu, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N0}}"
						EditingElementStyle="{StaticResource DataGridRightTextBox}"
						ElementStyle="{StaticResource DataGridRightTextBlock}"
						Header="数量" />
					<DataGridTextColumn Width="85"
						Binding="{Binding TankaJodai, StringFormat={}{0:N0}}"
						ElementStyle="{StaticResource DataGridRightTextBlock}"
						Header="上代単価" IsReadOnly="True" />
					<DataGridTextColumn Width="100"
						Binding="{Binding JodaiKingaku, StringFormat={}{0:N0}}"
						ElementStyle="{StaticResource DataGridRightTextBlock}"
						Header="上代金額" IsReadOnly="True" />
					<DataGridTextColumn Width="85"
						Binding="{Binding TankaGenka, StringFormat={}{0:N0}}"
						ElementStyle="{StaticResource DataGridRightTextBlock}"
						Header="下代単価" IsReadOnly="True" />
					<DataGridTextColumn Width="100"
						Binding="{Binding GedaiKingaku, StringFormat={}{0:N0}}"
						ElementStyle="{StaticResource DataGridRightTextBlock}"
						Header="下代金額" IsReadOnly="True" />
				</DataGrid.Columns>
				<DataGrid.ColumnHeaderStyle>
					<Style BasedOn="{StaticResource MenteDataGridColumnHeader}"
						TargetType="DataGridColumnHeader" />
				</DataGrid.ColumnHeaderStyle>
			</DataGrid>
		</materialDesign:Card>

		<!--  操作ボタン  -->
		<Grid Grid.Row="4"
			Margin="12,10,12,4">
			<StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
				<Button Command="{Binding ClearConditionsCommand}"
					Style="{StaticResource MaterialDesignOutlinedButton}"
					ToolTip="入力内容と一覧をクリア">
					<TextBlock FontSize="16" Text="クリア" />
				</Button>
				<StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
					<TextBlock Foreground="{DynamicResource MaterialDesignBodyLight}"
						Text="[実行] をクリックすると、【商品仕入入力】にデータ追加" />
					<TextBlock Foreground="{DynamicResource MaterialDesignBodyLight}"
						Text="修正・削除は、【商品仕入入力】にて可能" />
				</StackPanel>
			</StackPanel>
			<StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
				<Button Command="{Binding RegisterCommand}"
					IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
					Style="{StaticResource MaterialDesignRaisedButton}"
					ToolTip="数量が入力された行を仕入返品伝票(Tran03Shiire 区分20)として登録 (F8)">
					<StackPanel Orientation="Horizontal">
						<materialDesign:PackIcon VerticalAlignment="Center"
							Kind="ContentSave" />
						<TextBlock Margin="8,0,0,0" VerticalAlignment="Center"
							FontSize="16" Text="実行(F8)" />
					</StackPanel>
				</Button>
				<Button Margin="12,0,0,0"
					Command="{Binding ExitCommand}"
					Style="{StaticResource MaterialDesignOutlinedButton}"
					ToolTip="閉じる (Esc)">
					<TextBlock FontSize="16" Text="戻る(ESC)" />
				</Button>
			</StackPanel>
		</Grid>

		<!--  ステータス  -->
		<Border Grid.Row="5"
			Padding="12,6"
			Background="{DynamicResource MaterialDesignChipBackground}">
			<TextBlock VerticalAlignment="Center"
				Text="{Binding Message}"
				TextTrimming="CharacterEllipsis" />
		</Border>
	</Grid>
</helpers:BaseWindow>
