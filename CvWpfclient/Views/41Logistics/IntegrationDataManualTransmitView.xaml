<helpers:BaseWindow x:Class="CvWpfclient.Views._41Logistics.IntegrationDataManualTransmitView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:helpers="clr-namespace:CvWpfclient.Helpers" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:vm="clr-namespace:CvWpfclient.ViewModels._41Logistics"
	Title="連携データ手動送信"
	Width="{StaticResource StandardWindowWidth}" Height="{StaticResource StandardWindowHeight}"
	MinWidth="1010" MinHeight="650"
	Background="{DynamicResource AppCommonBackgroundBrush}"
	FontSize="16"
	Foreground="{DynamicResource MaterialDesignBody}"
	ResizeMode="CanResize" TextOptions.TextFormattingMode="Display"
	mc:Ignorable="d">
	<helpers:BaseWindow.DataContext>
		<vm:IntegrationDataManualTransmitViewModel />
	</helpers:BaseWindow.DataContext>
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>
		<materialDesign:ColorZone Grid.Row="0"
			Padding="12,8"
			materialDesign:ElevationAssist.Elevation="Dp4" Mode="PrimaryMid">
			<StackPanel Orientation="Horizontal">
				<Button Margin="0,0,8,0"
					Command="{Binding ExitCommand}"
					Style="{StaticResource ToolCommandButton}"
					ToolTip="閉じる (Esc)">
					<materialDesign:PackIcon Kind="ArrowLeft" />
				</Button>
				<materialDesign:PackIcon Width="28" Height="28"
					VerticalAlignment="Center"
					Kind="FileSendOutline" />
				<TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
					FontSize="20" FontWeight="SemiBold" Text="物流連携 連携データ手動送信" />
			</StackPanel>
		</materialDesign:ColorZone>
		<Grid Grid.Row="1"
			Margin="18">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>
			<!--  送信条件  -->
			<materialDesign:Card Grid.Row="0"
				Padding="20,12"
				materialDesign:ElevationAssist.Elevation="Dp2" UniformCornerRadius="8">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>
					<Grid IsEnabled="{Binding IsProcessing, Converter={StaticResource InverseBooleanConverter}}">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
						</Grid.RowDefinitions>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="80" />
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="80" />
							<ColumnDefinition Width="190" />
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<TextBlock Grid.Row="0" Grid.Column="0"
							Style="{StaticResource FormLabel}"
							Text="種別" />
						<StackPanel Grid.Row="0" Grid.Column="1"
							Margin="0,4" VerticalAlignment="Center"
							Orientation="Horizontal">
							<RadioButton Margin="0,0,20,0"
								Content="出荷指示(ORDER)" GroupName="SendKind"
								IsChecked="{Binding IsOrder, Mode=TwoWay}" />
							<RadioButton Margin="0,0,20,0"
								Content="入荷予定(STOCK)" GroupName="SendKind"
								IsChecked="{Binding IsStock, Mode=TwoWay}" />
							<RadioButton Content="在庫(ZAIKO)" GroupName="SendKind"
								IsChecked="{Binding IsZaiko, Mode=TwoWay}" />
						</StackPanel>
						<TextBlock Grid.Row="0" Grid.Column="2"
							Margin="24,0,8,0"
							Style="{StaticResource FormLabel}"
							Text="指定日" />
						<DatePicker Grid.Row="0" Grid.Column="3"
							materialDesign:HintAssist.Hint="この日以前が対象"
							IsEnabled="{Binding IsDateEnabled}"
							SelectedDate="{Binding TargetDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
							Style="{StaticResource FormDatePicker}" />
						<Button Grid.Row="0" Grid.Column="5"
							Width="128" Height="38"
							Command="{Binding QueryCommand}"
							Content="対象取得"
							Style="{StaticResource MaterialDesignRaisedButton}" />
						<TextBlock Grid.Row="1" Grid.Column="0"
							Margin="4,8,8,0" VerticalAlignment="Top"
							Style="{StaticResource FormLabel}"
							Text="倉庫" />
						<WrapPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="5"
							Margin="0,8,0,0">
							<CheckBox Margin="0,0,20,4"
								Content="すべて"
								IsChecked="{Binding AllSoko, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
							<ItemsControl IsEnabled="{Binding AllSoko, Converter={StaticResource InverseBooleanConverter}}" ItemsSource="{Binding SokoOptions}">
								<ItemsControl.ItemsPanel>
									<ItemsPanelTemplate>
										<WrapPanel />
									</ItemsPanelTemplate>
								</ItemsControl.ItemsPanel>
								<ItemsControl.ItemTemplate>
									<DataTemplate>
										<CheckBox Margin="0,0,20,4"
											Content="{Binding DisplayText}"
											IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</WrapPanel>
					</Grid>
					<TextBlock Grid.Row="1"
						Margin="0,8,0,0"
						FontWeight="SemiBold"
						Foreground="{DynamicResource MaterialDesignValidationErrorBrush}"
						Text="{Binding UnusableReason}" TextWrapping="Wrap"
						Visibility="{Binding HasUnusableReason, Converter={StaticResource BooleanToVisibilityConverter}}" />
				</Grid>
			</materialDesign:Card>
			<!--  送信対象一覧  -->
			<materialDesign:Card Grid.Row="1"
				Margin="0,14,0,0" Padding="0"
				materialDesign:ElevationAssist.Elevation="Dp2" UniformCornerRadius="8">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
					</Grid.RowDefinitions>
					<Border Grid.Row="0"
						Padding="12,6"
						Background="{DynamicResource MaterialDesignToolBarBackground}"
						CornerRadius="8,8,0,0">
						<DockPanel LastChildFill="True">
							<StackPanel DockPanel.Dock="Right"
								Orientation="Horizontal">
								<Button Height="32"
									Margin="0,0,8,0" Padding="12,0"
									Command="{Binding SelectAllCommand}"
									Content="全選択"
									Style="{StaticResource MaterialDesignOutlinedButton}" />
								<Button Height="32"
									Padding="12,0"
									Command="{Binding UnselectAllCommand}"
									Content="全解除"
									Style="{StaticResource MaterialDesignOutlinedButton}" />
							</StackPanel>
							<TextBlock VerticalAlignment="Center"
								FontWeight="SemiBold" Text="送信対象" />
							<TextBlock Margin="16,0,8,0" VerticalAlignment="Center"
								Text="{Binding SummaryText}" TextTrimming="CharacterEllipsis" />
						</DockPanel>
					</Border>
					<DataGrid x:Name="CandidateGrid" Grid.Row="1"
						materialDesign:DataGridAssist.CellPadding="8,4" materialDesign:DataGridAssist.ColumnHeaderPadding="8,6" AutoGenerateColumns="False" CanUserAddRows="False"
						CanUserDeleteRows="False" EnableColumnVirtualization="True" EnableRowVirtualization="True" FontSize="14" GridLinesVisibility="Horizontal"
						HorizontalGridLinesBrush="{DynamicResource MaterialDesignDivider}"
						ItemsSource="{Binding Candidates}"
						ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" SelectionMode="Extended"
						Style="{StaticResource MaterialDesignDataGrid}"
						VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
						<DataGrid.Columns>
							<DataGridTemplateColumn Width="56" MinWidth="56"
								Header="送信">
								<DataGridTemplateColumn.CellTemplate>
									<DataTemplate>
										<CheckBox HorizontalAlignment="Center"
											IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
											IsEnabled="{Binding IsSelectable}" />
									</DataTemplate>
								</DataGridTemplateColumn.CellTemplate>
							</DataGridTemplateColumn>
							<DataGridTextColumn Width="110" MinWidth="110"
								Binding="{Binding KubunText}"
								Header="区分" IsReadOnly="True" />
							<DataGridTextColumn Width="90" MinWidth="90"
								Binding="{Binding DayText}"
								Header="日付" IsReadOnly="True" />
							<DataGridTextColumn Width="110" MinWidth="110"
								Binding="{Binding SokoText}"
								Header="倉庫" IsReadOnly="True" />
							<DataGridTextColumn Width="140" MinWidth="140"
								Binding="{Binding PartnerText}"
								Header="出荷先/取引先" IsReadOnly="True" />
							<DataGridTextColumn Width="150" MinWidth="150"
								Binding="{Binding SkuText}"
								Header="商品・色・サイズ" IsReadOnly="True" />
							<DataGridTextColumn Width="120" MinWidth="120"
								Binding="{Binding Jan}"
								Header="JAN" IsReadOnly="True" />
							<DataGridTextColumn Width="64" MinWidth="64"
								Binding="{Binding Su, StringFormat={}{0:N0}}"
								ElementStyle="{StaticResource DataGridRightTextBlock}"
								Header="数量" IsReadOnly="True" />
							<DataGridTextColumn Width="70" MinWidth="70"
								Binding="{Binding Su2Text}"
								ElementStyle="{StaticResource DataGridRightTextBlock}"
								Header="積送中" IsReadOnly="True" />
							<DataGridTextColumn Width="*" MinWidth="80"
								Binding="{Binding Memo}"
								Header="メモ" IsReadOnly="True" />
							<DataGridTextColumn Width="150" MinWidth="150"
								Binding="{Binding RefText}"
								Header="参照" IsReadOnly="True" />
						</DataGrid.Columns>
						<DataGrid.ColumnHeaderStyle>
							<Style BasedOn="{StaticResource MenteDataGridColumnHeader}"
								TargetType="DataGridColumnHeader" />
						</DataGrid.ColumnHeaderStyle>
					</DataGrid>
				</Grid>
			</materialDesign:Card>
			<!--  結果  -->
			<TextBox Grid.Row="2"
				Height="96"
				Margin="0,14,0,0"
				VerticalContentAlignment="Top"
				materialDesign:HintAssist.Hint="実行結果・警告" AcceptsReturn="True" FontSize="14" HorizontalScrollBarVisibility="Auto" IsReadOnly="True"
				Style="{StaticResource MaterialDesignOutlinedTextBox}"
				Text="{Binding ResultText, Mode=OneWay}"
				TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
		</Grid>
		<Border Grid.Row="2"
			Padding="18,12"
			Background="{DynamicResource MaterialDesignPaper}">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>
				<ProgressBar Grid.Row="0" Grid.ColumnSpan="2"
					Height="4"
					Margin="0,0,0,8"
					IsIndeterminate="True"
					Visibility="{Binding IsProcessing, Converter={StaticResource BooleanToVisibilityConverter}}" />
				<TextBlock Grid.Row="1" Grid.Column="0"
					Margin="0,0,12,0" VerticalAlignment="Center"
					Text="{Binding StatusMessage}" TextWrapping="Wrap" />
				<StackPanel Grid.Row="1" Grid.Column="1"
					Orientation="Horizontal">
					<Button Width="168" Height="38"
						Margin="0,0,10,0"
						Command="{Binding SendCommand}"
						Content="送信ファイル作成"
						Style="{StaticResource MaterialDesignRaisedButton}" />
					<Button Width="128" Height="38"
						Command="{Binding ExitCommand}"
						Content="閉じる"
						Style="{StaticResource MaterialDesignOutlinedButton}" />
				</StackPanel>
			</Grid>
		</Border>
	</Grid>
</helpers:BaseWindow>
