<helpers:BaseWindow x:Class="CvWpfclient.Views._41Logistics.LogisticsMasterDataCreateView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:helpers="clr-namespace:CvWpfclient.Helpers" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:vm="clr-namespace:CvWpfclient.ViewModels._41Logistics"
	Title="マスタデータ作成"
	Width="{StaticResource StandardWindowWidth}" Height="{StaticResource StandardWindowHeight}"
	MinWidth="800" MinHeight="650"
	Background="{DynamicResource AppCommonBackgroundBrush}"
	FontSize="16"
	Foreground="{DynamicResource MaterialDesignBody}"
	ResizeMode="CanResize" TextOptions.TextFormattingMode="Display"
	mc:Ignorable="d">
	<helpers:BaseWindow.DataContext>
		<vm:LogisticsMasterDataCreateViewModel />
	</helpers:BaseWindow.DataContext>
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>
		<materialDesign:ColorZone Grid.Row="0"
			Padding="12,8"
			materialDesign:ElevationAssist.Elevation="Dp4" Mode="PrimaryMid">
			<StackPanel Orientation="Horizontal">
				<Button Margin="0,0,8,0"
					Command="{Binding ExitCommand}"
					Style="{StaticResource ToolCommandButton}"
					ToolTip="閉じる (Esc)">
					<materialDesign:PackIcon Kind="ArrowLeft" />
				</Button>
				<materialDesign:PackIcon Width="28" Height="28"
					VerticalAlignment="Center"
					Kind="FileExportOutline" />
				<TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
					FontSize="20" FontWeight="SemiBold" Text="物流連携 マスタデータ作成" />
			</StackPanel>
		</materialDesign:ColorZone>
		<Grid Grid.Row="1"
			Margin="18">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
			</Grid.RowDefinitions>
			<!--  連携設定  -->
			<materialDesign:Card Grid.Row="0"
				Padding="20,14"
				materialDesign:ElevationAssist.Elevation="Dp2" UniformCornerRadius="8">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="110" />
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="110" />
						<ColumnDefinition Width="200" />
					</Grid.ColumnDefinitions>
					<TextBlock Grid.Row="0" Grid.Column="0"
						Margin="0,4"
						Style="{StaticResource FormLabel}"
						Text="連携先コード" />
					<TextBlock Grid.Row="0" Grid.Column="1"
						Margin="0,4" VerticalAlignment="Center"
						Text="{Binding LinkCode}" TextTrimming="CharacterEllipsis" />
					<TextBlock Grid.Row="0" Grid.Column="2"
						Margin="0,4"
						Style="{StaticResource FormLabel}"
						Text="文字コード" />
					<TextBlock Grid.Row="0" Grid.Column="3"
						Margin="0,4" VerticalAlignment="Center"
						Text="{Binding EncodingName}" TextTrimming="CharacterEllipsis" />
					<TextBlock Grid.Row="1" Grid.Column="0"
						Margin="0,4"
						Style="{StaticResource FormLabel}"
						Text="連携フォルダ" />
					<TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3"
						Margin="0,4" VerticalAlignment="Center"
						Text="{Binding BaseFolder}" TextTrimming="CharacterEllipsis"
						ToolTip="{Binding BaseFolder}" />
					<TextBlock Grid.Row="2" Grid.Column="0"
						Margin="0,4" VerticalAlignment="Top"
						Style="{StaticResource FormLabel}"
						Text="対象倉庫" />
					<TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3"
						Margin="0,4" VerticalAlignment="Center"
						Text="{Binding TargetSoko}" TextWrapping="Wrap" />
					<TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="4"
						Margin="0,8,0,0"
						FontWeight="SemiBold"
						Foreground="{DynamicResource MaterialDesignValidationErrorBrush}"
						Text="{Binding UnusableReason}" TextWrapping="Wrap"
						Visibility="{Binding HasUnusableReason, Converter={StaticResource BooleanToVisibilityConverter}}" />
				</Grid>
			</materialDesign:Card>
			<!--  作成条件  -->
			<materialDesign:Card Grid.Row="1"
				Margin="0,14,0,0" Padding="20,14"
				materialDesign:ElevationAssist.Elevation="Dp2" UniformCornerRadius="8">
				<Grid IsEnabled="{Binding IsProcessing, Converter={StaticResource InverseBooleanConverter}}">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="110" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>
					<TextBlock Grid.Row="0" Grid.Column="0"
						Style="{StaticResource FormLabel}"
						Text="種別" />
					<StackPanel Grid.Row="0" Grid.Column="1"
						Margin="0,4" Orientation="Horizontal">
						<CheckBox Margin="0,0,24,0"
							Content="商品SKUマスタ(PD)"
							IsChecked="{Binding IncludePd, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
						<CheckBox Content="場所マスタ(BSY)"
							IsChecked="{Binding IncludeBsy, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
					</StackPanel>
					<TextBlock Grid.Row="1" Grid.Column="0"
						Style="{StaticResource FormLabel}"
						Text="作成範囲" />
					<StackPanel Grid.Row="1" Grid.Column="1"
						Margin="0,4" Orientation="Horizontal">
						<RadioButton Margin="0,0,24,0"
							Content="全件" GroupName="MasterRange"
							IsChecked="{Binding IsFull, Mode=TwoWay}" />
						<RadioButton Content="差分" GroupName="MasterRange"
							IsChecked="{Binding IsDiff, Mode=TwoWay}" />
					</StackPanel>
					<TextBlock Grid.Row="2" Grid.Column="0"
						Style="{StaticResource FormLabel}"
						Text="差分基準日" />
					<Grid Grid.Row="2" Grid.Column="1"
						Margin="0,4">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="200" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>
						<DatePicker Grid.Column="0"
							materialDesign:HintAssist.Hint="空欄=前回作成以降"
							IsEnabled="{Binding IsDiff}"
							SelectedDate="{Binding SinceDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
							Style="{StaticResource FormDatePicker}" />
						<TextBlock Grid.Column="1"
							Margin="16,0,0,0" VerticalAlignment="Center"
							Foreground="{DynamicResource MaterialDesignBodyLight}"
							Text="差分は指定日 0:00 以降に更新されたマスタを出力します。空欄なら前回作成以降です。" TextWrapping="Wrap" />
					</Grid>
				</Grid>
			</materialDesign:Card>
			<!--  結果  -->
			<materialDesign:Card Grid.Row="2"
				Margin="0,14,0,0" Padding="0"
				materialDesign:ElevationAssist.Elevation="Dp2" UniformCornerRadius="8">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
					</Grid.RowDefinitions>
					<Border Grid.Row="0"
						Padding="12,8"
						Background="{DynamicResource MaterialDesignToolBarBackground}"
						CornerRadius="8,8,0,0">
						<TextBlock FontWeight="SemiBold" Text="実行結果" />
					</Border>
					<DataGrid Grid.Row="1"
						MinHeight="110"
						materialDesign:DataGridAssist.CellPadding="10,6" materialDesign:DataGridAssist.ColumnHeaderPadding="10,8" AutoGenerateColumns="False" CanUserAddRows="False"
						CanUserDeleteRows="False" FontSize="14" GridLinesVisibility="Horizontal"
						HorizontalGridLinesBrush="{DynamicResource MaterialDesignDivider}"
						IsReadOnly="True"
						ItemsSource="{Binding ResultRows}"
						ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"
						Style="{StaticResource MaterialDesignDataGrid}">
						<DataGrid.Columns>
							<DataGridTextColumn Width="80"
								Binding="{Binding Kind}"
								Header="種別" />
							<DataGridTextColumn Width="180"
								Binding="{Binding KindName}"
								Header="種別名" />
							<DataGridTextColumn Width="120"
								Binding="{Binding Count, StringFormat={}{0:N0}}"
								ElementStyle="{StaticResource DataGridRightTextBlock}"
								Header="件数" />
							<DataGridTextColumn Width="*" MinWidth="200"
								Binding="{Binding FileName}"
								Header="ファイル名" />
						</DataGrid.Columns>
						<DataGrid.ColumnHeaderStyle>
							<Style BasedOn="{StaticResource MenteDataGridColumnHeader}"
								TargetType="DataGridColumnHeader" />
						</DataGrid.ColumnHeaderStyle>
					</DataGrid>
					<TextBox Grid.Row="2"
						Margin="12"
						VerticalAlignment="Stretch" VerticalContentAlignment="Top"
						materialDesign:HintAssist.Hint="メッセージ・警告" AcceptsReturn="True" FontSize="14" HorizontalScrollBarVisibility="Auto" IsReadOnly="True"
						Style="{StaticResource MaterialDesignOutlinedTextBox}"
						Text="{Binding ResultText, Mode=OneWay}"
						TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
				</Grid>
			</materialDesign:Card>
		</Grid>
		<Border Grid.Row="2"
			Padding="18,12"
			Background="{DynamicResource MaterialDesignPaper}">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>
				<ProgressBar Grid.Row="0"
					Height="4"
					Margin="0,0,0,8"
					IsIndeterminate="True"
					Visibility="{Binding IsProcessing, Converter={StaticResource BooleanToVisibilityConverter}}" />
				<TextBlock Grid.Row="1"
					Margin="0,0,0,8"
					Text="{Binding StatusMessage}" TextWrapping="Wrap" />
				<StackPanel Grid.Row="2"
					HorizontalAlignment="Right"
					Orientation="Horizontal">
					<Button Width="128" Height="38"
						Margin="0,0,10,0"
						Command="{Binding PreviewCommand}"
						Content="プレビュー"
						Style="{StaticResource MaterialDesignOutlinedButton}" />
					<Button Width="128" Height="38"
						Margin="0,0,10,0"
						Command="{Binding CreateCommand}"
						Content="作成"
						Style="{StaticResource MaterialDesignRaisedButton}" />
					<Button Width="128" Height="38"
						Command="{Binding ExitCommand}"
						Content="閉じる"
						Style="{StaticResource MaterialDesignOutlinedButton}" />
				</StackPanel>
			</Grid>
		</Border>
	</Grid>
</helpers:BaseWindow>
