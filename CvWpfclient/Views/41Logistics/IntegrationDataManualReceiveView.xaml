<helpers:BaseWindow x:Class="CvWpfclient.Views._41Logistics.IntegrationDataManualReceiveView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:helpers="clr-namespace:CvWpfclient.Helpers" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:vm="clr-namespace:CvWpfclient.ViewModels._41Logistics"
	Title="連携データ手動受信"
	Width="{StaticResource StandardWindowWidth}" Height="{StaticResource StandardWindowHeight}"
	MinWidth="900" MinHeight="680"
	Background="{DynamicResource AppCommonBackgroundBrush}"
	FontSize="16"
	Foreground="{DynamicResource MaterialDesignBody}"
	ResizeMode="CanResize" TextOptions.TextFormattingMode="Display"
	mc:Ignorable="d">
	<helpers:BaseWindow.DataContext>
		<vm:IntegrationDataManualReceiveViewModel />
	</helpers:BaseWindow.DataContext>
	<helpers:BaseWindow.Resources>
		<SolidColorBrush x:Key="LogisticsErrorForegroundBrush"
			Color="#D32F2F" />
		<SolidColorBrush x:Key="LogisticsWarningForegroundBrush"
			Color="#E65100" />
		<SolidColorBrush x:Key="LogisticsInactiveForegroundBrush"
			Color="#9E9E9E" />
		<Style x:Key="LogisticsLineRowStyle"
			BasedOn="{StaticResource MaterialDesignDataGridRow}"
			TargetType="DataGridRow">
			<Style.Triggers>
				<DataTrigger Binding="{Binding IsInactive}"
					Value="True">
					<Setter Property="Foreground" Value="{StaticResource LogisticsInactiveForegroundBrush}" />
				</DataTrigger>
				<DataTrigger Binding="{Binding IsWarning}"
					Value="True">
					<Setter Property="Foreground" Value="{StaticResource LogisticsWarningForegroundBrush}" />
				</DataTrigger>
				<DataTrigger Binding="{Binding IsError}"
					Value="True">
					<Setter Property="Foreground" Value="{StaticResource LogisticsErrorForegroundBrush}" />
					<Setter Property="FontWeight" Value="SemiBold" />
				</DataTrigger>
			</Style.Triggers>
		</Style>
	</helpers:BaseWindow.Resources>
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>
		<materialDesign:ColorZone Grid.Row="0"
			Padding="14,10"
			materialDesign:ElevationAssist.Elevation="Dp4" Mode="PrimaryMid">
			<StackPanel Orientation="Horizontal">
				<materialDesign:PackIcon Width="30" Height="30"
					VerticalAlignment="Center"
					Kind="FileImportOutline" />
				<TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
					FontSize="20" FontWeight="SemiBold" Text="物流連携 連携データ手動受信" />
			</StackPanel>
		</materialDesign:ColorZone>
		<Grid Grid.Row="1"
			Margin="18">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>
			<!--  受信ファイル  -->
			<materialDesign:Card Grid.Row="0"
				Padding="0"
				materialDesign:ElevationAssist.Elevation="Dp2" UniformCornerRadius="8">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>
					<Border Grid.Row="0"
						Padding="12,6"
						Background="{DynamicResource MaterialDesignToolBarBackground}"
						CornerRadius="8,8,0,0">
						<DockPanel LastChildFill="True">
							<StackPanel DockPanel.Dock="Right"
								Orientation="Horizontal">
								<Button Height="32"
									Margin="0,0,8,0" Padding="12,0"
									Command="{Binding RefreshFilesCommand}"
									Content="再読込"
									Style="{StaticResource MaterialDesignOutlinedButton}" />
								<Button Height="32"
									Margin="0,0,8,0" Padding="12,0"
									Command="{Binding PickFilesCommand}"
									Content="PCのファイルを選択"
									Style="{StaticResource MaterialDesignOutlinedButton}" />
								<Button Height="32"
									Padding="12,0"
									Command="{Binding ClearUploadsCommand}"
									Content="選択を解除"
									Style="{StaticResource MaterialDesignOutlinedButton}" />
							</StackPanel>
							<TextBlock VerticalAlignment="Center"
								FontWeight="SemiBold" Text="受信フォルダの未取込ファイル" />
						</DockPanel>
					</Border>
					<DataGrid Grid.Row="1"
						Height="130"
						materialDesign:DataGridAssist.CellPadding="8,3" materialDesign:DataGridAssist.ColumnHeaderPadding="8,6" AutoGenerateColumns="False" CanUserAddRows="False"
						CanUserDeleteRows="False" FontSize="14" GridLinesVisibility="Horizontal"
						HorizontalGridLinesBrush="{DynamicResource MaterialDesignDivider}"
						IsEnabled="{Binding HasUploads, Converter={StaticResource InverseBooleanConverter}}"
						ItemsSource="{Binding ReceiveFiles}"
						ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"
						Style="{StaticResource MaterialDesignDataGrid}"
						VirtualizingPanel.IsVirtualizing="True">
						<DataGrid.Columns>
							<DataGridTemplateColumn Width="64" MinWidth="64"
								Header="取込">
								<DataGridTemplateColumn.CellTemplate>
									<DataTemplate>
										<CheckBox HorizontalAlignment="Center"
											IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
									</DataTemplate>
								</DataGridTemplateColumn.CellTemplate>
							</DataGridTemplateColumn>
							<DataGridTextColumn Width="*" MinWidth="260"
								Binding="{Binding FileName}"
								Header="ファイル名" IsReadOnly="True" />
							<DataGridTextColumn Width="120" MinWidth="120"
								Binding="{Binding KindName}"
								Header="種別" IsReadOnly="True" />
							<DataGridTextColumn Width="110" MinWidth="110"
								Binding="{Binding Size, StringFormat={}{0:N0}}"
								ElementStyle="{StaticResource DataGridRightTextBlock}"
								Header="サイズ" IsReadOnly="True" />
							<DataGridTextColumn Width="180" MinWidth="180"
								Binding="{Binding LastWrite}"
								Header="更新日時" IsReadOnly="True" />
						</DataGrid.Columns>
						<DataGrid.ColumnHeaderStyle>
							<Style BasedOn="{StaticResource MenteDataGridColumnHeader}"
								TargetType="DataGridColumnHeader" />
						</DataGrid.ColumnHeaderStyle>
					</DataGrid>
					<StackPanel Grid.Row="2"
						Margin="12,6">
						<TextBlock FontWeight="SemiBold"
							Foreground="{DynamicResource MaterialDesignValidationErrorBrush}"
							Text="{Binding UnusableReason}" TextWrapping="Wrap"
							Visibility="{Binding HasUnusableReason, Converter={StaticResource BooleanToVisibilityConverter}}" />
						<TextBlock FontSize="14"
							Text="{Binding UploadText}" TextTrimming="CharacterEllipsis"
							ToolTip="{Binding UploadText}"
							Visibility="{Binding HasUploads, Converter={StaticResource BooleanToVisibilityConverter}}" />
					</StackPanel>
				</Grid>
			</materialDesign:Card>
			<!--  受信バッチの行一覧  -->
			<materialDesign:Card Grid.Row="1"
				Margin="0,14,0,0" Padding="0"
				materialDesign:ElevationAssist.Elevation="Dp2" UniformCornerRadius="8">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
					</Grid.RowDefinitions>
					<Border Grid.Row="0"
						Padding="12,4"
						Background="{DynamicResource MaterialDesignToolBarBackground}"
						CornerRadius="8,8,0,0">
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition Width="560" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<TextBlock Grid.Column="0"
								Margin="0,0,12,0" VerticalAlignment="Center"
								FontWeight="SemiBold" Text="受信バッチ" />
							<ComboBox Grid.Column="1"
								VerticalAlignment="Center"
								materialDesign:HintAssist.Hint="未反映の受信バッチ" DisplayMemberPath="DisplayText" FontSize="14"
								IsEnabled="{Binding IsProcessing, Converter={StaticResource InverseBooleanConverter}}"
								ItemsSource="{Binding Batches}"
								SelectedItem="{Binding SelectedBatch, Mode=TwoWay}" />
							<TextBlock Grid.Column="2"
								Margin="16,0,0,0" VerticalAlignment="Center"
								FontSize="14"
								Text="{Binding LineSummaryText}" TextTrimming="CharacterEllipsis" />
						</Grid>
					</Border>
					<DataGrid Grid.Row="1"
						materialDesign:DataGridAssist.CellPadding="8,4" materialDesign:DataGridAssist.ColumnHeaderPadding="8,6" AutoGenerateColumns="False" CanUserAddRows="False"
						CanUserDeleteRows="False" EnableColumnVirtualization="True" EnableRowVirtualization="True" FontSize="14" GridLinesVisibility="Horizontal"
						HorizontalGridLinesBrush="{DynamicResource MaterialDesignDivider}"
						IsReadOnly="True"
						ItemsSource="{Binding Lines}"
						RowStyle="{StaticResource LogisticsLineRowStyle}"
						ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"
						Style="{StaticResource MaterialDesignDataGrid}"
						VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
						<DataGrid.Columns>
							<DataGridTextColumn Width="64" MinWidth="64"
								Binding="{Binding LineNo}"
								ElementStyle="{StaticResource DataGridRightTextBlock}"
								Header="行No" />
							<DataGridTextColumn Width="125" MinWidth="125"
								Binding="{Binding StatusName}"
								Header="状態" />
							<DataGridTextColumn Width="70" MinWidth="70"
								Binding="{Binding ErrorCode}"
								Header="コード" />
							<DataGridTextColumn Width="180" MinWidth="180"
								Binding="{Binding ErrorMsg}"
								Header="エラー・警告" />
							<DataGridTextColumn Width="80" MinWidth="80"
								Binding="{Binding Su, StringFormat={}{0:N0}}"
								ElementStyle="{StaticResource DataGridRightTextBlock}"
								Header="数量" />
							<DataGridTextColumn Width="80" MinWidth="80"
								Binding="{Binding Su2, StringFormat={}{0:N0}}"
								ElementStyle="{StaticResource DataGridRightTextBlock}"
								Header="欠品数" />
							<DataGridTextColumn Width="90" MinWidth="90"
								Binding="{Binding WorkDay}"
								Header="作業日" />
							<DataGridTextColumn Width="130" MinWidth="130"
								Binding="{Binding RefText}"
								Header="参照" />
							<DataGridTextColumn Width="130" MinWidth="130"
								Binding="{Binding TargetText}"
								Header="生成伝票" />
							<DataGridTextColumn Width="*" MinWidth="120"
								Binding="{Binding RawText}"
								Header="原文" />
						</DataGrid.Columns>
						<DataGrid.ColumnHeaderStyle>
							<Style BasedOn="{StaticResource MenteDataGridColumnHeader}"
								TargetType="DataGridColumnHeader" />
						</DataGrid.ColumnHeaderStyle>
					</DataGrid>
				</Grid>
			</materialDesign:Card>
			<!--  結果  -->
			<TextBox Grid.Row="2"
				Height="90"
				Margin="0,14,0,0"
				VerticalContentAlignment="Top"
				materialDesign:HintAssist.Hint="実行結果・警告" AcceptsReturn="True" FontSize="14" HorizontalScrollBarVisibility="Auto" IsReadOnly="True"
				Style="{StaticResource MaterialDesignOutlinedTextBox}"
				Text="{Binding ResultText, Mode=OneWay}"
				TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
		</Grid>
		<Border Grid.Row="2"
			Padding="18,12"
			Background="{DynamicResource MaterialDesignPaper}">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>
				<ProgressBar Grid.Row="0" Grid.ColumnSpan="2"
					Height="4"
					Margin="0,0,0,8"
					IsIndeterminate="True"
					Visibility="{Binding IsProcessing, Converter={StaticResource BooleanToVisibilityConverter}}" />
				<TextBlock Grid.Row="1" Grid.Column="0"
					Margin="0,0,12,0" VerticalAlignment="Center"
					Text="{Binding StatusMessage}" TextWrapping="Wrap" />
				<StackPanel Grid.Row="1" Grid.Column="1"
					Orientation="Horizontal">
					<Button Width="128" Height="38"
						Margin="0,0,10,0"
						Command="{Binding ImportCommand}"
						Content="取込・検査"
						Style="{StaticResource MaterialDesignRaisedButton}" />
					<Button Width="128" Height="38"
						Margin="0,0,10,0"
						Command="{Binding RecheckCommand}"
						Content="再検査"
						Style="{StaticResource MaterialDesignOutlinedButton}" />
					<Button Width="128" Height="38"
						Margin="0,0,10,0"
						Command="{Binding ApplyCommand}"
						Content="反映"
						Style="{StaticResource MaterialDesignRaisedButton}" />
					<Button Width="128" Height="38"
						Command="{Binding ExitCommand}"
						Content="閉じる"
						Style="{StaticResource MaterialDesignOutlinedButton}" />
				</StackPanel>
			</Grid>
		</Border>
	</Grid>
</helpers:BaseWindow>
