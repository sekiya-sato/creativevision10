<helpers:BaseWindow x:Class="CvWpfclient.Views._20UriageAnalysis.ShohinTurnoverRateReportView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:helpers="clr-namespace:CvWpfclient.Helpers"
	xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:vm="clr-namespace:CvWpfclient.ViewModels._20UriageAnalysis"
	Title="{Binding Title}"
	Width="820" Height="700"
	Background="{DynamicResource AppCommonBackgroundBrush}"
	FontSize="16"
	Foreground="{DynamicResource MaterialDesignBody}"
	TextOptions.TextFormattingMode="Display" WindowStartupLocation="CenterScreen"
	mc:Ignorable="d">
	<helpers:BaseWindow.DataContext>
		<vm:ShohinTurnoverRateReportViewModel />
	</helpers:BaseWindow.DataContext>

	<helpers:BaseWindow.InputBindings>
		<KeyBinding Command="{Binding DoOutputPdfCommand}"
			Gesture="F6" />
		<KeyBinding Command="{Binding ExitCommand}"
			Gesture="Esc" />
	</helpers:BaseWindow.InputBindings>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<materialDesign:ColorZone Grid.Row="0"
			Padding="12,8"
			materialDesign:ElevationAssist.Elevation="Dp4" Mode="PrimaryMid">
			<DockPanel>
				<StackPanel Orientation="Horizontal">
					<Button Margin="0,0,8,0"
						Command="{Binding ExitCommand}"
						Style="{StaticResource ToolCommandButton}"
						ToolTip="閉じる (Esc)">
						<materialDesign:PackIcon Kind="ArrowLeft" />
					</Button>
					<materialDesign:PackIcon Width="28" Height="28"
						VerticalAlignment="Center"
						Kind="Printer" />
					<TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
						FontSize="20" FontWeight="SemiBold"
						Text="{Binding Title}" />
				</StackPanel>
			</DockPanel>
		</materialDesign:ColorZone>

		<Grid Grid.Row="1"
			Margin="24">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
			</Grid.RowDefinitions>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="140" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>

			<!--  期間  -->
			<TextBlock Grid.Row="0" Grid.Column="0"
				Style="{StaticResource FormLabel}"
				Text="期間" />
			<TextBox Grid.Row="0" Grid.Column="1"
				Width="200" Height="36"
				HorizontalAlignment="Left" HorizontalContentAlignment="Left"
				Style="{StaticResource MaterialDesignTextBox}"
				Text="{Binding DenDayFrom, UpdateSourceTrigger=PropertyChanged}" />
			<TextBlock Grid.Row="0" Grid.Column="2"
				Margin="8,0" VerticalAlignment="Center"
				Text="～" />
			<TextBox Grid.Row="0" Grid.Column="3"
				Width="200" Height="36"
				HorizontalAlignment="Left" HorizontalContentAlignment="Left"
				Style="{StaticResource MaterialDesignTextBox}"
				Text="{Binding DenDayTo, UpdateSourceTrigger=PropertyChanged}" />

			<!--  商品  -->
			<TextBlock Grid.Row="1" Grid.Column="0"
				Style="{StaticResource FormLabel}"
				Text="商品" />
			<TextBox Grid.Row="1" Grid.Column="1"
				Width="200" Height="36"
				HorizontalAlignment="Left" HorizontalContentAlignment="Left"
				helpers:SearchTextBoxAssist.Command="{Binding SelectShohinCodeFromCommand}"
				BorderThickness="0,0,0,1"
				Style="{StaticResource MenteSearchTextBox}"
				Text="{Binding ShohinCodeFrom, UpdateSourceTrigger=PropertyChanged}" />
			<TextBlock Grid.Row="1" Grid.Column="2"
				Margin="8,0" VerticalAlignment="Center"
				Text="～" />
			<TextBox Grid.Row="1" Grid.Column="3"
				Width="200" Height="36"
				HorizontalAlignment="Left" HorizontalContentAlignment="Left"
				helpers:SearchTextBoxAssist.Command="{Binding SelectShohinCodeToCommand}"
				BorderThickness="0,0,0,1"
				Style="{StaticResource MenteSearchTextBox}"
				Text="{Binding ShohinCodeTo, UpdateSourceTrigger=PropertyChanged}" />

			<!--  ブランド  -->
			<TextBlock Grid.Row="2" Grid.Column="0"
				Style="{StaticResource FormLabel}"
				Text="ブランド" />
			<TextBox Grid.Row="2" Grid.Column="1"
				Width="200" Height="36"
				HorizontalAlignment="Left" HorizontalContentAlignment="Left"
				helpers:SearchTextBoxAssist.Command="{Binding SelectBrandCodeFromCommand}"
				BorderThickness="0,0,0,1"
				Style="{StaticResource MenteSearchTextBox}"
				Text="{Binding BrandCodeFrom, UpdateSourceTrigger=PropertyChanged}" />
			<TextBlock Grid.Row="2" Grid.Column="2"
				Margin="8,0" VerticalAlignment="Center"
				Text="～" />
			<TextBox Grid.Row="2" Grid.Column="3"
				Width="200" Height="36"
				HorizontalAlignment="Left" HorizontalContentAlignment="Left"
				helpers:SearchTextBoxAssist.Command="{Binding SelectBrandCodeToCommand}"
				BorderThickness="0,0,0,1"
				Style="{StaticResource MenteSearchTextBox}"
				Text="{Binding BrandCodeTo, UpdateSourceTrigger=PropertyChanged}" />

			<!--  消化率の分母  -->
			<TextBlock Grid.Row="3" Grid.Column="0"
				Margin="0,10,0,10"
				Style="{StaticResource FormLabel}"
				Text="消化率の分母" />
			<StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3"
				Margin="0,10,0,10"
				Orientation="Horizontal">
				<RadioButton Margin="0,4"
					Content="売上+在庫"
					IsChecked="{Binding IsRateByStock}" />
				<RadioButton Margin="16,4,0,4"
					Content="投入(仕入)数"
					IsChecked="{Binding IsRateByStock, Converter={StaticResource InverseBooleanConverter}}"
					ToolTip="期間外に投入済みの商品では0や100%超になることがあります" />
			</StackPanel>

			<!--  出力対象  -->
			<TextBlock Grid.Row="4" Grid.Column="0"
				Margin="0,10,0,10"
				Style="{StaticResource FormLabel}"
				Text="出力対象" />
			<StackPanel Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3"
				Margin="0,10,0,10"
				Orientation="Horizontal">
				<RadioButton Margin="0,4"
					Content="売上･在庫があるのみ"
					IsChecked="{Binding IsActiveOnly}" />
				<RadioButton Margin="16,4,0,4"
					Content="全て"
					IsChecked="{Binding IsActiveOnly, Converter={StaticResource InverseBooleanConverter}}" />
			</StackPanel>

			<!--  注意書き  -->
			<StackPanel Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="3"
				Margin="0,8">
				<TextBlock Foreground="{DynamicResource MaterialDesignValidationErrorBrush}"
					Text="※値入率＝(上代金額－原価金額)÷上代金額。原価は商品マスタの現在原価です。" TextWrapping="Wrap" />
				<TextBlock Foreground="{DynamicResource MaterialDesignValidationErrorBrush}"
					Text="※在庫は現在時点の在庫です（期間末時点ではありません）。期間末在庫は商品別受払表を使ってください。" TextWrapping="Wrap" />
			</StackPanel>

			<!--  実行ボタン  -->
			<StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="4"
				Margin="0,24" HorizontalAlignment="Center"
				Orientation="Horizontal">
				<Button Command="{Binding DoOutputPdfCommand}"
					Style="{StaticResource MaterialDesignFlatMidBgButton}"
					ToolTip="印刷実行 (F6)">
					<StackPanel Orientation="Horizontal">
						<materialDesign:PackIcon VerticalAlignment="Center"
							Kind="Printer" />
						<TextBlock Margin="8,0,0,0" VerticalAlignment="Center"
							FontSize="20" Text="印刷実行" />
					</StackPanel>
				</Button>
			</StackPanel>
		</Grid>
	</Grid>
</helpers:BaseWindow>
