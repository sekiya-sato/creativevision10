<helpers:BaseWindow x:Class="CvWpfclient.Views._07Haibun.HaibunCommitView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:helpers="clr-namespace:CvWpfclient.Helpers" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:vm="clr-namespace:CvWpfclient.ViewModels._07Haibun"
	Title="{Binding Title}"
	Width="1280" Height="800"
	Background="{DynamicResource AppCommonBackgroundBrush}"
	FontSize="14"
	Foreground="{DynamicResource MaterialDesignBody}"
	TextOptions.TextFormattingMode="Display" WindowStartupLocation="CenterScreen"
	mc:Ignorable="d">
	<helpers:BaseWindow.DataContext>
		<vm:HaibunCommitViewModel />
	</helpers:BaseWindow.DataContext>

	<helpers:BaseWindow.InputBindings>
		<KeyBinding Command="{Binding SearchCommand}"
			Gesture="F5" />
		<KeyBinding Command="{Binding ConfirmSelectedCommand}"
			Gesture="F6" />
		<KeyBinding Command="{Binding ExitCommand}"
			Gesture="Esc" />
	</helpers:BaseWindow.InputBindings>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<materialDesign:ColorZone Grid.Row="0"
			Padding="12,8"
			materialDesign:ElevationAssist.Elevation="Dp4" Mode="PrimaryMid">
			<DockPanel>
				<Button Margin="0,0,8,0"
					Command="{Binding ExitCommand}"
					Style="{StaticResource ToolCommandButton}"
					ToolTip="閉じる (Esc)">
					<materialDesign:PackIcon Kind="ArrowLeft" />
				</Button>
				<materialDesign:PackIcon Width="28" Height="28"
					VerticalAlignment="Center"
					Kind="ClipboardCheckOutline" />
				<TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
					FontSize="20" FontWeight="SemiBold"
					Text="{Binding Title}" />
				<TextBlock Margin="16,0,0,0" VerticalAlignment="Center"
					Opacity="0.8" Text="確定数を入れて確定すると出荷売上／移動伝票を作成します。有効在庫割れは1件も確定しません。確定後は取り消せません。"
					TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
			</DockPanel>
		</materialDesign:ColorZone>

		<Border Grid.Row="1"
			Padding="12"
			Background="{DynamicResource MaterialDesignPaper}">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="90" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" />
				</Grid.ColumnDefinitions>

				<TextBlock Grid.Row="0" Grid.Column="0"
					Margin="0,4" VerticalAlignment="Center"
					Text="指示日" />
				<WrapPanel Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
					Margin="0,4"
					Orientation="Horizontal">
					<TextBox Width="150" Height="32"
						Style="{StaticResource MaterialDesignTextBox}"
						Text="{Binding DenDayFromText, UpdateSourceTrigger=PropertyChanged}" />
					<TextBlock Margin="8,0" VerticalAlignment="Center"
						Text="～" />
					<TextBox Width="150" Height="32"
						Style="{StaticResource MaterialDesignTextBox}"
						Text="{Binding DenDayToText, UpdateSourceTrigger=PropertyChanged}" />
					<TextBlock Margin="24,0,8,0" VerticalAlignment="Center"
						Text="倉庫" />
					<Button Width="70"
						Command="{Binding SelectSokoCommand}"
						Content="選択"
						Style="{StaticResource MaterialDesignOutlinedButton}" />
					<TextBox Width="120" Height="32"
						Margin="8,0,0,0"
						Style="{StaticResource MaterialDesignTextBox}"
						Text="{Binding SokoCode, UpdateSourceTrigger=PropertyChanged}" />
				</WrapPanel>

				<TextBlock Grid.Row="1" Grid.Column="0"
					Margin="0,4" VerticalAlignment="Center"
					Text="絞り込み" />
				<WrapPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
					Margin="0,4"
					Orientation="Horizontal">
					<TextBlock Margin="0,0,8,0" VerticalAlignment="Center"
						Text="商品" />
					<Button Width="70"
						Command="{Binding SelectShohinCommand}"
						Content="選択"
						Style="{StaticResource MaterialDesignOutlinedButton}" />
					<TextBox Width="120" Height="32"
						Margin="8,0,0,0"
						Style="{StaticResource MaterialDesignTextBox}"
						Text="{Binding ShohinCode, UpdateSourceTrigger=PropertyChanged}" />
					<TextBlock Margin="24,0,8,0" VerticalAlignment="Center"
						Text="出荷先" />
					<Button Width="70"
						Command="{Binding SelectTokuiCommand}"
						Content="選択"
						Style="{StaticResource MaterialDesignOutlinedButton}" />
					<TextBox Width="120" Height="32"
						Margin="8,0,0,0"
						Style="{StaticResource MaterialDesignTextBox}"
						Text="{Binding TokuiCode, UpdateSourceTrigger=PropertyChanged}" />
				</WrapPanel>

				<WrapPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
					Margin="0,12,0,0" HorizontalAlignment="Left"
					Orientation="Horizontal">
					<TextBlock Margin="0,0,8,0" VerticalAlignment="Center"
						Text="並び順" />
					<ComboBox Width="120"
						Margin="0,0,24,0"
						ItemsSource="{Binding SortKinds}"
						SelectedItem="{Binding SortKind}"
						ToolTip="商品順：商品×色サイズでまとめて確定する／出荷先順：出荷先ごとに確認して確定する" />
					<TextBlock Margin="0,0,8,0" VerticalAlignment="Center"
						Text="取得件数上限" />
					<TextBox Width="80" Height="32"
						Margin="0,0,16,0"
						Style="{StaticResource MaterialDesignTextBox}"
						Text="{Binding MaxCountText, UpdateSourceTrigger=PropertyChanged}" />
					<Button Command="{Binding SearchCommand}"
						IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
						Style="{StaticResource MaterialDesignFlatMidBgButton}"
						ToolTip="検索 (F5)">
						<StackPanel Orientation="Horizontal">
							<materialDesign:PackIcon VerticalAlignment="Center"
								Kind="Magnify" />
							<TextBlock Margin="8,0,0,0" VerticalAlignment="Center"
								FontSize="16" Text="検索実行" />
						</StackPanel>
					</Button>
					<TextBlock Margin="24,0,8,0" VerticalAlignment="Center"
						Text="確定日(伝票日)" />
					<TextBox Width="150" Height="32"
						Style="{StaticResource MaterialDesignTextBox}"
						Text="{Binding KakuteiDayText, UpdateSourceTrigger=PropertyChanged}" />
					<Button Margin="12,0,0,0"
						Command="{Binding ConfirmSelectedCommand}"
						IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
						Style="{StaticResource MaterialDesignFlatMidBgButton}"
						ToolTip="選択した行を確定数で確定し伝票を作成する (F6)">
						<StackPanel Orientation="Horizontal">
							<materialDesign:PackIcon VerticalAlignment="Center"
								Kind="CheckDecagram" />
							<TextBlock Margin="8,0,0,0" VerticalAlignment="Center"
								FontSize="16" Text="確定実行" />
						</StackPanel>
					</Button>
					<Button Margin="12,0,0,0"
						Command="{Binding ClearConditionsCommand}"
						Style="{StaticResource MaterialDesignOutlinedButton}">
						<TextBlock FontSize="16" Text="条件クリア" />
					</Button>
				</WrapPanel>
			</Grid>
		</Border>

		<DockPanel Grid.Row="2"
			Margin="12">
			<StackPanel Margin="0,0,0,6"
				DockPanel.Dock="Top" Orientation="Horizontal">
				<TextBlock VerticalAlignment="Center"
					FontSize="16" FontWeight="SemiBold" Text="配分（確定対象）" />
				<TextBlock Margin="16,0,0,0" VerticalAlignment="Center"
					Text="{Binding CheckedCount, StringFormat='チェック {0:N0} 件'}" />
				<Button Margin="12,0,0,0"
					Command="{Binding SetKakuteiToShijiCommand}"
					Style="{StaticResource MaterialDesignOutlinedButton}"
					ToolTip="チェックした行の確定数を指示数（全量出荷。仕入配分は入荷済みまで）にする">
					<TextBlock FontSize="16" Text="確定数=指示数" />
				</Button>
				<Button Margin="12,0,0,0"
					Command="{Binding SetKakuteiToZeroCommand}"
					Style="{StaticResource MaterialDesignOutlinedButton}"
					ToolTip="チェックした行の確定数を0（全量欠品）にする">
					<TextBlock FontSize="16" Text="確定数=0" />
				</Button>
				<Button Margin="12,0,0,0"
					Command="{Binding CheckAllCommand}"
					Style="{StaticResource MaterialDesignOutlinedButton}">
					<TextBlock FontSize="16" Text="全チェック" />
				</Button>
				<Button Margin="12,0,0,0"
					Command="{Binding UncheckAllCommand}"
					Style="{StaticResource MaterialDesignOutlinedButton}">
					<TextBlock FontSize="16" Text="全解除" />
				</Button>
			</StackPanel>
			<DataGrid AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="False"
				ItemsSource="{Binding Rows}"
				SelectionMode="Single" SelectionUnit="FullRow" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
				<DataGrid.Columns>
					<DataGridTemplateColumn Width="60"
						Header="選択">
						<DataGridTemplateColumn.CellTemplate>
							<DataTemplate>
								<CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
									IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
							</DataTemplate>
						</DataGridTemplateColumn.CellTemplate>
					</DataGridTemplateColumn>
					<DataGridTextColumn Width="110"
						Binding="{Binding DenDay}"
						Header="指示日" IsReadOnly="True" />
					<DataGridTextColumn Width="130"
						Binding="{Binding SokoDisplay}"
						Header="倉庫" IsReadOnly="True" />
					<DataGridTextColumn Width="165"
						Binding="{Binding TenpoDisplay}"
						Header="出荷先" IsReadOnly="True" />
					<DataGridTextColumn Width="90"
						Binding="{Binding DenKindDisplay}"
						Header="種別" IsReadOnly="True" />
					<DataGridTextColumn Width="165"
						Binding="{Binding ShohinDisplay}"
						Header="商品" IsReadOnly="True" />
					<DataGridTextColumn Width="110"
						Binding="{Binding ColSizDisplay}"
						Header="色/サイズ" IsReadOnly="True" />
					<DataGridTextColumn Width="75"
						Binding="{Binding Su, StringFormat={}{0:N0}}"
						Header="指示数" IsReadOnly="True">
						<DataGridTextColumn.ElementStyle>
							<Style TargetType="TextBlock">
								<Setter Property="HorizontalAlignment" Value="Right" />
							</Style>
						</DataGridTextColumn.ElementStyle>
					</DataGridTextColumn>
					<DataGridTextColumn Width="80"
						Binding="{Binding ArrivedDisplay}"
						Header="入荷済" IsReadOnly="True">
						<DataGridTextColumn.ElementStyle>
							<Style TargetType="TextBlock">
								<Setter Property="HorizontalAlignment" Value="Right" />
								<Setter Property="ToolTip" Value="仕入配分の入荷済み数。仕入配分はこの数までしか確定できない" />
							</Style>
						</DataGridTextColumn.ElementStyle>
					</DataGridTextColumn>
					<DataGridTextColumn Width="75"
						Binding="{Binding KakuteiSu, UpdateSourceTrigger=PropertyChanged}"
						Header="確定数">
						<DataGridTextColumn.ElementStyle>
							<Style TargetType="TextBlock">
								<Setter Property="HorizontalAlignment" Value="Right" />
								<Setter Property="ToolTip" Value="出荷・移動する数（0〜指示数）。指示数との差は欠品" />
							</Style>
						</DataGridTextColumn.ElementStyle>
					</DataGridTextColumn>
					<DataGridTextColumn Width="65"
						Binding="{Binding ShortSu, StringFormat={}{0:N0}}"
						Header="欠品" IsReadOnly="True">
						<DataGridTextColumn.ElementStyle>
							<Style TargetType="TextBlock">
								<Setter Property="HorizontalAlignment" Value="Right" />
							</Style>
						</DataGridTextColumn.ElementStyle>
					</DataGridTextColumn>
					<DataGridTextColumn Width="90"
						Binding="{Binding Yuko, StringFormat={}{0:N0}}"
						Header="有効在庫" IsReadOnly="True">
						<DataGridTextColumn.ElementStyle>
							<Style TargetType="TextBlock">
								<Setter Property="HorizontalAlignment" Value="Right" />
								<Setter Property="ToolTip" Value="参考: 確定前の有効在庫(実在庫 − 引当数)" />
							</Style>
						</DataGridTextColumn.ElementStyle>
					</DataGridTextColumn>
				</DataGrid.Columns>
			</DataGrid>
		</DockPanel>

		<Border Grid.Row="3"
			Padding="12,8"
			Background="{DynamicResource MaterialDesignPaper}">
			<DockPanel>
				<Button Command="{Binding ExitCommand}"
					DockPanel.Dock="Right"
					Style="{StaticResource MaterialDesignOutlinedButton}"
					ToolTip="閉じる (Esc)">
					<TextBlock FontSize="16" Text="閉じる" />
				</Button>
				<TextBlock VerticalAlignment="Center"
					Text="{Binding Message}"
					TextWrapping="Wrap" />
			</DockPanel>
		</Border>
	</Grid>
</helpers:BaseWindow>
