<helpers:BaseWindow x:Class="CvWpfclient.Views._07Haibun.ShippingInputView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:helpers="clr-namespace:CvWpfclient.Helpers"
	xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:vm="clr-namespace:CvWpfclient.ViewModels._07Haibun"
	Title="{Binding Title}"
	Width="1280" Height="800"
	Background="{DynamicResource AppCommonBackgroundBrush}"
	FontSize="14"
	Foreground="{DynamicResource MaterialDesignBody}"
	TextOptions.TextFormattingMode="Display" WindowStartupLocation="CenterScreen"
	mc:Ignorable="d">
	<helpers:BaseWindow.DataContext>
		<vm:ShippingInputViewModel />
	</helpers:BaseWindow.DataContext>

	<helpers:BaseWindow.InputBindings>
		<KeyBinding Command="{Binding SearchCommand}" Gesture="F5" />
		<KeyBinding Command="{Binding ExecuteCommand}" Gesture="F6" />
		<KeyBinding Command="{Binding ExitCommand}" Gesture="Esc" />
	</helpers:BaseWindow.InputBindings>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<materialDesign:ColorZone Grid.Row="0"
			Padding="12,8"
			materialDesign:ElevationAssist.Elevation="Dp4" Mode="PrimaryMid">
			<StackPanel Orientation="Horizontal">
				<materialDesign:PackIcon Width="26" Height="26"
					VerticalAlignment="Center"
					Kind="TruckDeliveryOutline" />
				<TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
					FontSize="18" FontWeight="SemiBold" Text="{Binding Title}" />
				<TextBlock Margin="16,0,0,0" VerticalAlignment="Center"
					Opacity="0.8"
					Text="確定済み配分に実数量を入れ、出荷売上/移動伝票を作成して引当を解除します。" />
			</StackPanel>
		</materialDesign:ColorZone>

		<Border Grid.Row="1"
			Padding="12"
			Background="{DynamicResource MaterialDesignPaper}">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="90" />
					<ColumnDefinition Width="*" />
				</Grid.ColumnDefinitions>

				<TextBlock Grid.Row="0" Grid.Column="0"
					Margin="0,4" VerticalAlignment="Center"
					Text="確定日" />
				<StackPanel Grid.Row="0" Grid.Column="1"
					Margin="0,4" Orientation="Horizontal">
					<TextBox Width="150" Height="32"
						Style="{StaticResource MaterialDesignTextBox}"
						Text="{Binding KakuteiFromText, UpdateSourceTrigger=PropertyChanged}" />
					<TextBlock Margin="8,0" VerticalAlignment="Center" Text="～" />
					<TextBox Width="150" Height="32"
						Style="{StaticResource MaterialDesignTextBox}"
						Text="{Binding KakuteiToText, UpdateSourceTrigger=PropertyChanged}" />
					<TextBlock Margin="24,0,8,0" VerticalAlignment="Center" Text="倉庫" />
					<Button Width="70" Command="{Binding SelectSokoCommand}" Content="選択"
						Style="{StaticResource MaterialDesignOutlinedButton}" />
					<TextBox Width="120" Height="32" Margin="8,0,0,0"
						Style="{StaticResource MaterialDesignTextBox}"
						Text="{Binding SokoCode, UpdateSourceTrigger=PropertyChanged}" />
					<TextBlock Margin="24,0,8,0" VerticalAlignment="Center" Text="出荷先" />
					<Button Width="70" Command="{Binding SelectTokuiCommand}" Content="選択"
						Style="{StaticResource MaterialDesignOutlinedButton}" />
					<TextBox Width="120" Height="32" Margin="8,0,0,0"
						Style="{StaticResource MaterialDesignTextBox}"
						Text="{Binding TokuiCode, UpdateSourceTrigger=PropertyChanged}" />
				</StackPanel>

				<StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
					Margin="0,12,0,0" HorizontalAlignment="Left"
					Orientation="Horizontal">
					<TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Text="取得件数上限" />
					<TextBox Width="80" Height="32" Margin="0,0,16,0"
						Style="{StaticResource MaterialDesignTextBox}"
						Text="{Binding MaxCountText, UpdateSourceTrigger=PropertyChanged}" />
					<Button Command="{Binding SearchCommand}"
						IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
						Style="{StaticResource MaterialDesignFlatMidBgButton}"
						ToolTip="検索 (F5)">
						<StackPanel Orientation="Horizontal">
							<materialDesign:PackIcon VerticalAlignment="Center" Kind="Magnify" />
							<TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="16" Text="検索実行" />
						</StackPanel>
					</Button>
					<TextBlock Margin="24,0,8,0" VerticalAlignment="Center" Text="伝票日付" />
					<TextBox Width="150" Height="32"
						Style="{StaticResource MaterialDesignTextBox}"
						Text="{Binding DenDayText, UpdateSourceTrigger=PropertyChanged}" />
					<TextBlock Margin="16,0,8,0" VerticalAlignment="Center" Text="入力社員" />
					<Button Width="70" Command="{Binding SelectShainCommand}" Content="選択"
						Style="{StaticResource MaterialDesignOutlinedButton}" />
					<TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="{Binding ShainText}" />
					<Button Margin="16,0,0,0"
						Command="{Binding ExecuteCommand}"
						IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
						Style="{StaticResource MaterialDesignFlatMidBgButton}"
						ToolTip="選択した確定済み配分を出荷処理する (F6)">
						<StackPanel Orientation="Horizontal">
							<materialDesign:PackIcon VerticalAlignment="Center" Kind="TruckCheckOutline" />
							<TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="16" Text="出荷処理実行" />
						</StackPanel>
					</Button>
					<Button Margin="12,0,0,0" Command="{Binding CheckAllCommand}"
						Style="{StaticResource MaterialDesignOutlinedButton}">
						<TextBlock FontSize="16" Text="全チェック" />
					</Button>
					<Button Margin="12,0,0,0" Command="{Binding UncheckAllCommand}"
						Style="{StaticResource MaterialDesignOutlinedButton}">
						<TextBlock FontSize="16" Text="全解除" />
					</Button>
					<Button Margin="12,0,0,0" Command="{Binding ClearConditionsCommand}"
						Style="{StaticResource MaterialDesignOutlinedButton}">
						<TextBlock FontSize="16" Text="条件クリア" />
					</Button>
				</StackPanel>
			</Grid>
		</Border>

		<DockPanel Grid.Row="2" Margin="12">
			<StackPanel Margin="0,0,0,6"
				DockPanel.Dock="Top" Orientation="Horizontal">
				<TextBlock FontSize="16" FontWeight="SemiBold" Text="確定済み配分（出荷処理対象）" />
				<TextBlock Margin="16,0,0,0" VerticalAlignment="Center"
					Text="{Binding CheckedCount, StringFormat='チェック {0:N0} 件'}" />
			</StackPanel>
			<DataGrid AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="False"
				ItemsSource="{Binding Rows}"
				SelectionMode="Single" SelectionUnit="Cell" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
				<DataGrid.Columns>
					<DataGridTemplateColumn Width="50" Header="選択">
						<DataGridTemplateColumn.CellTemplate>
							<DataTemplate>
								<CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
									IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
							</DataTemplate>
						</DataGridTemplateColumn.CellTemplate>
					</DataGridTemplateColumn>
					<DataGridTextColumn Width="100" Binding="{Binding DenDay}" Header="指示日" IsReadOnly="True" />
					<DataGridTextColumn Width="180" Binding="{Binding SokoDisplay}" Header="倉庫" IsReadOnly="True" />
					<DataGridTextColumn Width="210" Binding="{Binding TenpoDisplay}" Header="出荷先" IsReadOnly="True" />
					<DataGridTextColumn Width="80" Binding="{Binding DenKindDisplay}" Header="種別" IsReadOnly="True" />
					<DataGridTextColumn Width="210" Binding="{Binding ShohinDisplay}" Header="商品" IsReadOnly="True" />
					<DataGridTextColumn Width="150" Binding="{Binding ColSizDisplay}" Header="色/サイズ" IsReadOnly="True" />
					<DataGridTextColumn Width="80" Binding="{Binding Su, StringFormat={}{0:N0}}" Header="指示数" IsReadOnly="True">
						<DataGridTextColumn.ElementStyle>
							<Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right" /></Style>
						</DataGridTextColumn.ElementStyle>
					</DataGridTextColumn>
					<DataGridTextColumn Width="90" Binding="{Binding JitsuSu, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N0}}" Header="実数量">
						<DataGridTextColumn.ElementStyle>
							<Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right" /></Style>
						</DataGridTextColumn.ElementStyle>
						<DataGridTextColumn.EditingElementStyle>
							<Style TargetType="TextBox"><Setter Property="HorizontalContentAlignment" Value="Right" /></Style>
						</DataGridTextColumn.EditingElementStyle>
					</DataGridTextColumn>
					<DataGridTextColumn Width="80" Binding="{Binding ShortSu, StringFormat={}{0:N0}}" Header="欠品" IsReadOnly="True">
						<DataGridTextColumn.ElementStyle>
							<Style TargetType="TextBlock">
								<Setter Property="HorizontalAlignment" Value="Right" />
								<Setter Property="ToolTip" Value="欠品 = 指示数 − 実数量" />
							</Style>
						</DataGridTextColumn.ElementStyle>
					</DataGridTextColumn>
				</DataGrid.Columns>
			</DataGrid>
		</DockPanel>

		<Border Grid.Row="3"
			Padding="12,8"
			Background="{DynamicResource MaterialDesignPaper}">
			<DockPanel>
				<Button DockPanel.Dock="Right"
					Command="{Binding ExitCommand}"
					Style="{StaticResource MaterialDesignOutlinedButton}"
					ToolTip="閉じる (Esc)">
					<TextBlock FontSize="16" Text="閉じる" />
				</Button>
				<TextBlock VerticalAlignment="Center"
					Text="{Binding Message}" TextWrapping="Wrap" />
			</DockPanel>
		</Border>
	</Grid>
</helpers:BaseWindow>
