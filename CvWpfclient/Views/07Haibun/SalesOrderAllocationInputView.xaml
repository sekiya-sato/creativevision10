<helpers:BaseWindow x:Class="CvWpfclient.Views._07Haibun.SalesOrderAllocationInputView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:helpers="clr-namespace:CvWpfclient.Helpers" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:vm="clr-namespace:CvWpfclient.ViewModels._07Haibun"
	Title="受注配分入力(商品別)"
	Width="1280" Height="800"
	Background="{DynamicResource AppCommonBackgroundBrush}"
	FontSize="14"
	Foreground="{DynamicResource MaterialDesignBody}"
	TextOptions.TextFormattingMode="Display" WindowStartupLocation="CenterScreen"
	mc:Ignorable="d">
	<helpers:BaseWindow.DataContext>
		<vm:SalesOrderAllocationInputViewModel />
	</helpers:BaseWindow.DataContext>

	<helpers:BaseWindow.Resources>
		<!--  SKU 列の見出し。幅は列側(SkuColumnWidth)で決める  -->
		<DataTemplate x:Key="SkuColumnHeaderTemplate">
			<StackPanel>
				<TextBlock HorizontalAlignment="Center"
					FontWeight="SemiBold"
					Text="{Binding Code_Col}"
					ToolTip="{Binding ColDisplay}" />
				<TextBlock HorizontalAlignment="Center"
					FontWeight="SemiBold"
					Text="{Binding Code_Siz}"
					ToolTip="{Binding SizDisplay}" />
				<Separator Margin="0,2"
					Opacity="0.4" />
				<TextBlock HorizontalAlignment="Right"
					FontSize="11"
					Text="{Binding YukoSu, StringFormat={}在庫 {0:N0}}"
					ToolTip="有効在庫（実在庫 − 引当 ＋ 読み込んだ自分の配分）" />
				<TextBlock HorizontalAlignment="Right"
					FontSize="11"
					Text="{Binding ZanTotalSu, StringFormat={}受注残 {0:N0}}" />
				<TextBlock HorizontalAlignment="Right"
					FontSize="11" FontWeight="SemiBold"
					Text="{Binding HaibunTotalSu, StringFormat={}配分 {0:N0}}" />
				<TextBlock HorizontalAlignment="Right"
					FontSize="11"
					Text="{Binding AfterSu, StringFormat={}後 {0:N0}}"
					ToolTip="配分後在庫（有効在庫 − 配分）。マイナスは確定時に在庫不足になる">
					<TextBlock.Style>
						<Style TargetType="TextBlock">
							<Style.Triggers>
								<DataTrigger Binding="{Binding IsShort}"
									Value="True">
									<Setter Property="Foreground" Value="Red" />
									<Setter Property="FontWeight" Value="Bold" />
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</TextBlock.Style>
				</TextBlock>
			</StackPanel>
		</DataTemplate>
	</helpers:BaseWindow.Resources>

	<helpers:BaseWindow.InputBindings>
		<KeyBinding Command="{Binding DoSearchCommand}"
			Gesture="F5" />
		<KeyBinding Command="{Binding DoRegisterCommand}"
			Gesture="F6" />
		<KeyBinding Command="{Binding ExitCommand}"
			Gesture="Esc" />
	</helpers:BaseWindow.InputBindings>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<materialDesign:ColorZone Grid.Row="0"
			Padding="12,8"
			materialDesign:ElevationAssist.Elevation="Dp4" Mode="PrimaryMid">
			<StackPanel Orientation="Horizontal">
				<Button Margin="0,0,8,0"
					Command="{Binding ExitCommand}"
					Style="{StaticResource ToolCommandButton}"
					ToolTip="閉じる (Esc)">
					<materialDesign:PackIcon Kind="ArrowLeft" />
				</Button>
				<materialDesign:PackIcon Width="28" Height="28"
					VerticalAlignment="Center"
					Kind="TableArrowRight" />
				<TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
					FontSize="20" FontWeight="SemiBold"
					Text="受注配分入力(商品別)" />
				<TextBlock Margin="16,0,0,0" VerticalAlignment="Center"
					Opacity="0.8" Text="得意先×SKUで受注残へまとめて配分します。受注日の古い受注から割り付けます。" />
			</StackPanel>
		</materialDesign:ColorZone>

		<Border Grid.Row="1"
			Padding="12,8"
			Background="{DynamicResource MaterialDesignPaper}">
			<StackPanel>
				<WrapPanel Orientation="Horizontal">
					<StackPanel Margin="0,4,20,4"
						Orientation="Horizontal">
						<TextBlock Style="{StaticResource FormLabel}"
							Text="倉庫" />
						<Button Width="64"
							Command="{Binding SelectSokoCommand}"
							Content="選択"
							Style="{StaticResource MaterialDesignOutlinedButton}" />
						<TextBox Width="140"
							Margin="8,0,0,0"
							Style="{StaticResource FormTextBox}"
							Text="{Binding SokoCode, UpdateSourceTrigger=PropertyChanged}" />
						<TextBlock Width="150"
							Margin="8,0,0,0" VerticalAlignment="Center"
							Text="{Binding SokoName}"
							TextTrimming="CharacterEllipsis" />
					</StackPanel>
					<StackPanel Margin="0,4,20,4"
						Orientation="Horizontal">
						<TextBlock Style="{StaticResource FormLabel}"
							Text="商品" />
						<Button Width="64"
							Command="{Binding SelectShohinCommand}"
							Content="選択"
							Style="{StaticResource MaterialDesignOutlinedButton}" />
						<TextBox Width="150"
							Margin="8,0,0,0"
							Style="{StaticResource FormTextBox}"
							Text="{Binding ShohinCode, UpdateSourceTrigger=PropertyChanged}" />
						<TextBlock Width="200"
							Margin="8,0,0,0" VerticalAlignment="Center"
							Text="{Binding ShohinName}"
							TextTrimming="CharacterEllipsis" />
					</StackPanel>
					<StackPanel Margin="0,4,20,4"
						Orientation="Horizontal">
						<TextBlock Style="{StaticResource FormLabel}"
							Text="受注日" />
						<DatePicker Width="140"
							helpers:DatePickerTodayButtonBehavior.IsEnabled="True"
							SelectedDate="{Binding JuchuDayFrom, Mode=TwoWay}"
							Style="{StaticResource FormDatePicker}" />
						<TextBlock Margin="6,0" VerticalAlignment="Center"
							Text="～" />
						<DatePicker Width="140"
							helpers:DatePickerTodayButtonBehavior.IsEnabled="True"
							SelectedDate="{Binding JuchuDayTo, Mode=TwoWay}"
							Style="{StaticResource FormDatePicker}" />
					</StackPanel>
					<StackPanel Margin="0,4,20,4"
						Orientation="Horizontal">
						<TextBlock Style="{StaticResource FormLabel}"
							Text="得意先" />
						<TextBox Width="110"
							Style="{StaticResource FormTextBox}"
							Text="{Binding TokuiCodeFrom, UpdateSourceTrigger=PropertyChanged}" />
						<TextBlock Margin="6,0" VerticalAlignment="Center"
							Text="～" />
						<TextBox Width="110"
							Style="{StaticResource FormTextBox}"
							Text="{Binding TokuiCodeTo, UpdateSourceTrigger=PropertyChanged}" />
					</StackPanel>
					<Button Margin="0,4"
						Command="{Binding DoSearchCommand}"
						IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
						Style="{StaticResource MaterialDesignFlatMidBgButton}"
						ToolTip="検索 (F5)">
						<StackPanel Orientation="Horizontal">
							<materialDesign:PackIcon VerticalAlignment="Center"
								Kind="Magnify" />
							<TextBlock Margin="8,0,0,0" VerticalAlignment="Center"
								FontSize="16" Text="検索" />
						</StackPanel>
					</Button>
				</WrapPanel>
				<WrapPanel Margin="0,4,0,0"
					Orientation="Horizontal">
					<StackPanel Margin="0,4,20,4"
						Orientation="Horizontal">
						<TextBlock Style="{StaticResource FormLabel}"
							Text="指示日" />
						<DatePicker Width="140"
							helpers:DatePickerTodayButtonBehavior.IsEnabled="True"
							SelectedDate="{Binding ShijiDay, Mode=TwoWay}"
							Style="{StaticResource FormDatePicker}" />
					</StackPanel>
					<StackPanel Margin="0,4,20,4"
						Orientation="Horizontal">
						<TextBlock Style="{StaticResource FormLabel}"
							Text="納品日" />
						<DatePicker Width="140"
							helpers:DatePickerTodayButtonBehavior.IsEnabled="True"
							SelectedDate="{Binding NouhinDay, Mode=TwoWay}"
							Style="{StaticResource FormDatePicker}" />
					</StackPanel>
					<StackPanel Margin="0,4,20,4"
						Orientation="Horizontal">
						<TextBlock Style="{StaticResource FormLabel}"
							Text="メモ" />
						<TextBox Width="200"
							Style="{StaticResource FormTextBox}"
							Text="{Binding Memo, UpdateSourceTrigger=PropertyChanged}" />
					</StackPanel>
					<Button Margin="0,4,12,4"
						Command="{Binding LoadZanCommand}"
						Style="{StaticResource MaterialDesignOutlinedButton}"
						ToolTip="受注のあるセルを受注残で上書きする（在庫は見ない）">
						<TextBlock FontSize="16" Text="受注残読込" />
					</Button>
					<Button Margin="0,4,12,4"
						Command="{Binding FillByStockCommand}"
						Style="{StaticResource MaterialDesignOutlinedButton}"
						ToolTip="SKUごとに有効在庫の範囲で、受注日の古い得意先から受注残を割り当てる">
						<TextBlock FontSize="16" Text="在庫内で受注日順に読込" />
					</Button>
					<Button Margin="0,4,12,4"
						Command="{Binding ClearAllCommand}"
						Style="{StaticResource MaterialDesignOutlinedButton}">
						<TextBlock FontSize="16" Text="0クリア" />
					</Button>
					<Button Margin="0,4"
						Command="{Binding DoRegisterCommand}"
						Style="{StaticResource MaterialDesignFlatMidBgButton}"
						ToolTip="登録 (F6)">
						<StackPanel Orientation="Horizontal">
							<materialDesign:PackIcon VerticalAlignment="Center"
								Kind="ContentSave" />
							<TextBlock Margin="8,0,0,0" VerticalAlignment="Center"
								FontSize="16" Text="登録" />
						</StackPanel>
					</Button>
				</WrapPanel>
			</StackPanel>
		</Border>

		<DockPanel Grid.Row="2"
			Margin="12">
			<StackPanel Margin="0,0,0,6"
				DockPanel.Dock="Top" Orientation="Horizontal">
				<TextBlock VerticalAlignment="Center"
					FontSize="16" FontWeight="SemiBold" Text="得意先 × SKU" />
				<TextBlock Margin="16,0,0,0" VerticalAlignment="Center"
					Text="{Binding ZanTotalSu, StringFormat='受注残 {0:N0}'}" />
				<TextBlock Margin="16,0,0,0" VerticalAlignment="Center"
					FontWeight="SemiBold"
					Text="{Binding GrandTotalSu, StringFormat='配分 {0:N0}'}" />
				<TextBlock Margin="16,0,0,0" VerticalAlignment="Center"
					Opacity="0.7" Text="受注残を超えたセルは橙、受注の無いセルは灰色（入力不可）" />
			</StackPanel>
			<DataGrid x:Name="AllocationGrid"
				AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False"
				EnableRowVirtualization="True" FrozenColumnCount="1" GridLinesVisibility="Horizontal"
				ItemsSource="{Binding Rows}"
				SelectionUnit="Cell">
				<DataGrid.Columns>
					<DataGridTextColumn Width="260"
						Binding="{Binding TokuiDisplay}"
						Header="得意先" IsReadOnly="True" />
					<DataGridTextColumn Width="85"
						Binding="{Binding OrderCount, StringFormat={}{0:N0}}"
						ElementStyle="{StaticResource DataGridRightTextBlock}"
						Header="受注数" IsReadOnly="True" />
					<DataGridTextColumn Width="80"
						Binding="{Binding ZanTotalSu, StringFormat={}{0:N0}}"
						ElementStyle="{StaticResource DataGridRightTextBlock}"
						Header="受注残" IsReadOnly="True" />
					<DataGridTextColumn Width="80"
						Binding="{Binding TotalSu, StringFormat={}{0:N0}}"
						ElementStyle="{StaticResource DataGridRightTextBlock}"
						Header="配分計" IsReadOnly="True" />
				</DataGrid.Columns>
			</DataGrid>
		</DockPanel>

		<Border Grid.Row="3"
			Padding="12,8"
			Background="{DynamicResource MaterialDesignPaper}">
			<DockPanel>
				<Button Command="{Binding ExitCommand}"
					DockPanel.Dock="Right"
					Style="{StaticResource MaterialDesignOutlinedButton}"
					ToolTip="閉じる (Esc)">
					<TextBlock FontSize="16" Text="閉じる" />
				</Button>
				<TextBlock VerticalAlignment="Center"
					Text="{Binding Message}"
					TextWrapping="Wrap" />
			</DockPanel>
		</Border>
	</Grid>
</helpers:BaseWindow>
