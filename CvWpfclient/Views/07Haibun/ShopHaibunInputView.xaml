<helpers:BaseWindow x:Class="CvWpfclient.Views._07Haibun.ShopHaibunInputView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:helpers="clr-namespace:CvWpfclient.Helpers"
	xmlns:local="clr-namespace:CvWpfclient.Views" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:vm="clr-namespace:CvWpfclient.ViewModels._07Haibun"
	Title="店舗配分入力"
	Width="1400" Height="900"
	Background="{DynamicResource AppCommonBackgroundBrush}"
	Foreground="{DynamicResource MaterialDesignBody}"
	TextOptions.TextFormattingMode="Display"
	mc:Ignorable="d">
	<helpers:BaseWindow.DataContext>
		<vm:ShopHaibunInputViewModel />
	</helpers:BaseWindow.DataContext>

	<helpers:BaseWindow.InputBindings>
		<KeyBinding Command="{Binding DoUpdateOnDetailTabCommand}"
			Gesture="F2" />
		<KeyBinding Command="{Binding DoSearchCommand}"
			Gesture="F5" />
	</helpers:BaseWindow.InputBindings>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<!--  ===== ヘッダー: ColorZone ツールバー =====  -->
		<materialDesign:ColorZone Grid.Row="0"
			Padding="12,8"
			materialDesign:ElevationAssist.Elevation="Dp4" Mode="PrimaryMid">
			<StackPanel Orientation="Horizontal">
				<Button Margin="0,0,8,0"
					Command="{Binding ExitCommand}"
					Style="{StaticResource ToolCommandButton}"
					ToolTip="閉じる (Esc)">
					<materialDesign:PackIcon Kind="ArrowLeft" />
				</Button>
				<materialDesign:PackIcon Width="28" Height="28"
					VerticalAlignment="Center"
					Kind="StorePlus" />
				<TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
					FontSize="20" FontWeight="SemiBold" Text="店舗配分入力" />
				<TextBlock Margin="24,0,0,0" VerticalAlignment="Center"
					FontSize="13" Opacity="0.85"
					Text="{Binding Message}" />
			</StackPanel>
		</materialDesign:ColorZone>

		<!--  ===== メインコンテンツ =====  -->
		<TabControl x:Name="TabControlMain"
			Grid.Row="1"
			SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}"
			Style="{StaticResource MaterialDesignTabControl}">

			<!--  ================= タブ1: 検索画面 (Shift+F1) =================  -->
			<TabItem x:Name="tabSearch"
				Height="0"
				d:Header="d:検索画面" d:Height="40" Header="">
				<Grid Margin="12">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
					</Grid.RowDefinitions>

					<!--  検索条件カード  -->
					<materialDesign:Card Grid.Row="0"
						Margin="0,0,0,8" Padding="12,10"
						materialDesign:ElevationAssist.Elevation="Dp2" UniformCornerRadius="8">
						<StackPanel>
							<!--  1行目: 配分元倉庫 / 区分  -->
							<WrapPanel Orientation="Horizontal">
								<StackPanel Margin="0,4,24,4"
									Orientation="Horizontal">
									<TextBlock Style="{StaticResource FormLabel}"
										Text="配分元倉庫" />
									<TextBox Width="110"
										helpers:SearchTextBoxAssist.Command="{Binding DoSelectSokoCommand}"
										Style="{StaticResource MenteSearchTextBox}"
										Text="{Binding SokoCode, UpdateSourceTrigger=PropertyChanged}" />
									<TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
										Foreground="{DynamicResource MaterialDesignBody}"
										Text="{Binding SokoName}" />
								</StackPanel>
								<StackPanel Margin="0,4"
									Orientation="Horizontal">
									<TextBlock Style="{StaticResource FormLabel}"
										Text="区分" />
									<ComboBox Width="150"
										materialDesign:HintAssist.Hint="区分" DisplayMemberPath="Name"
										ItemsSource="{Binding KubunOptions}"
										SelectedValue="{Binding Kubun, Mode=TwoWay}"
										SelectedValuePath="Value"
										Style="{StaticResource FormComboBox}" />
								</StackPanel>
							</WrapPanel>

							<Separator Margin="0,6"
								Opacity="0.4" />

							<!--  2行目: 商品分類 FROM-TO  -->
							<WrapPanel Orientation="Horizontal">
								<StackPanel Margin="0,4,24,4"
									Orientation="Horizontal">
									<TextBlock Style="{StaticResource FormLabel}"
										Text="シーズン" />
									<TextBox Width="90"
										materialDesign:HintAssist.Hint="From"
										Style="{StaticResource FormTextBox}"
										Text="{Binding SeasonFrom, UpdateSourceTrigger=PropertyChanged}" />
									<TextBlock Margin="6,0" VerticalAlignment="Center"
										Text="～" />
									<TextBox Width="90"
										materialDesign:HintAssist.Hint="To"
										Style="{StaticResource FormTextBox}"
										Text="{Binding SeasonTo, UpdateSourceTrigger=PropertyChanged}" />
								</StackPanel>
								<StackPanel Margin="0,4,24,4"
									Orientation="Horizontal">
									<TextBlock Style="{StaticResource FormLabel}"
										Text="ブランド" />
									<TextBox Width="90"
										materialDesign:HintAssist.Hint="From"
										Style="{StaticResource FormTextBox}"
										Text="{Binding BrandFrom, UpdateSourceTrigger=PropertyChanged}" />
									<TextBlock Margin="6,0" VerticalAlignment="Center"
										Text="～" />
									<TextBox Width="90"
										materialDesign:HintAssist.Hint="To"
										Style="{StaticResource FormTextBox}"
										Text="{Binding BrandTo, UpdateSourceTrigger=PropertyChanged}" />
								</StackPanel>
								<StackPanel Margin="0,4"
									Orientation="Horizontal">
									<TextBlock Style="{StaticResource FormLabel}"
										Text="アイテム" />
									<TextBox Width="90"
										materialDesign:HintAssist.Hint="From"
										Style="{StaticResource FormTextBox}"
										Text="{Binding ItemFrom, UpdateSourceTrigger=PropertyChanged}" />
									<TextBlock Margin="6,0" VerticalAlignment="Center"
										Text="～" />
									<TextBox Width="90"
										materialDesign:HintAssist.Hint="To"
										Style="{StaticResource FormTextBox}"
										Text="{Binding ItemTo, UpdateSourceTrigger=PropertyChanged}" />
								</StackPanel>
							</WrapPanel>

							<!--  3行目: 日付範囲 + 一覧取得  -->
							<DockPanel Margin="0,4,0,0">
								<Button Command="{Binding DoSearchCommand}"
									DockPanel.Dock="Right"
									Style="{StaticResource MaterialDesignRaisedButton}"
									ToolTip="一覧取得 (F5)">
									<StackPanel Orientation="Horizontal">
										<materialDesign:PackIcon VerticalAlignment="Center"
											Kind="DatabaseSearch" />
										<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
											Text="一覧取得" />
									</StackPanel>
								</Button>
								<StackPanel Orientation="Horizontal">
									<TextBlock Style="{StaticResource FormLabel}"
										Text="配分指示日" />
									<DatePicker Width="150"
										helpers:DatePickerTodayButtonBehavior.IsEnabled="True" materialDesign:HintAssist.Hint="From"
										SelectedDate="{Binding UriageDayFrom, Mode=TwoWay}"
										Style="{StaticResource FormDatePicker}" />
									<TextBlock Margin="6,0" VerticalAlignment="Center"
										Text="～" />
									<DatePicker Width="150"
										helpers:DatePickerTodayButtonBehavior.IsEnabled="True" materialDesign:HintAssist.Hint="To"
										SelectedDate="{Binding UriageDayTo, Mode=TwoWay}"
										Style="{StaticResource FormDatePicker}" />
									<TextBlock Margin="24,0,0,0"
										Style="{StaticResource FormLabel}"
										Text="追加条件" />
									<DatePicker Width="150"
										helpers:DatePickerTodayButtonBehavior.IsEnabled="True" materialDesign:HintAssist.Hint="From"
										SelectedDate="{Binding NyukaDayFrom, Mode=TwoWay}"
										Style="{StaticResource FormDatePicker}" />
								</StackPanel>
							</DockPanel>
						</StackPanel>
					</materialDesign:Card>

					<!--  商品一覧カード  -->
					<materialDesign:Card Grid.Row="1"
						Padding="0"
						materialDesign:ElevationAssist.Elevation="Dp2" UniformCornerRadius="8">
						<Grid>
							<Grid.RowDefinitions>
								<RowDefinition Height="Auto" />
								<RowDefinition Height="*" />
							</Grid.RowDefinitions>

							<!--  カードヘッダー: 件数 + 配分画面へ  -->
							<Border Grid.Row="0"
								Padding="12,8"
								Background="{DynamicResource MaterialDesignToolBarBackground}"
								CornerRadius="8,8,0,0">
								<DockPanel>
									<Button Command="{Binding GoToEditCommand}"
										DockPanel.Dock="Right"
										Style="{StaticResource MaterialDesignOutlinedButton}"
										ToolTip="選択商品の配分入力へ">
										<StackPanel Orientation="Horizontal">
											<materialDesign:PackIcon VerticalAlignment="Center"
												Kind="FileDocumentEdit" />
											<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
										Text="配分レコードを開く" />
										</StackPanel>
									</Button>
									<TextBlock VerticalAlignment="Center"
										FontSize="13"
										Foreground="{DynamicResource MaterialDesignBodyLight}"
										Text="{Binding SearchCount, StringFormat={}配分レコード: {0:N0} 件}" />
								</DockPanel>
							</Border>

							<!--  商品一覧 DataGrid  -->
							<DataGrid x:Name="SearchGrid"
								Grid.Row="1"
								helpers:DataGridDoubleClick.Command="{Binding GoToEditCommand}"
								helpers:DataGridSelectionBehavior.AutoScrollToSelectedItem="True" materialDesign:DataGridAssist.CellPadding="12,6" materialDesign:DataGridAssist.ColumnHeaderPadding="12,8"
								AutoGenerateColumns="False" EnableRowVirtualization="True" FrozenColumnCount="1" GridLinesVisibility="Horizontal"
								HorizontalGridLinesBrush="{DynamicResource MaterialDesignDivider}"
								IsReadOnly="True" IsSynchronizedWithCurrentItem="True"
								ItemsSource="{Binding SearchRows}"
								SelectedItem="{Binding SelectedSearchRow, Mode=TwoWay}"
								Style="{StaticResource MaterialDesignDataGrid}"
								VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
								<DataGrid.Columns>
									<DataGridTextColumn Width="150"
										Binding="{Binding Id}"
										Header="Id" />
									<DataGridTextColumn Width="220"
										Binding="{Binding DenDay}"
										Header="配分指示日" />
									<DataGridTextColumn Width="150"
										Binding="{Binding NouhinDay}"
										Header="納品日" />
									<DataGridTextColumn Width="120"
										Binding="{Binding Id_Soko}"
										Header="倉庫Id" />
									<DataGridTextColumn Width="90"
										Binding="{Binding Id_Tenpo, StringFormat={}{0:N0}}"
										ElementStyle="{StaticResource DataGridRightTextBlock}"
										Header="店舗Id" />
									<DataGridTextColumn Width="90"
										Binding="{Binding Id_Shohin, StringFormat={}{0:N0}}"
										ElementStyle="{StaticResource DataGridRightTextBlock}"
										Header="商品Id" />
									<DataGridTextColumn Width="90"
										Binding="{Binding JanCode}"
										ElementStyle="{StaticResource DataGridRightTextBlock}"
										Header="JAN" />
									<DataGridTextColumn Width="100"
										Binding="{Binding Su, StringFormat={}{0:N0}}"
										ElementStyle="{StaticResource DataGridRightTextBlock}"
										Header="配分数" />
									<DataGridTextColumn Width="100"
										Binding="{Binding Jodai, StringFormat={}{0:N0}}"
										ElementStyle="{StaticResource DataGridRightTextBlock}"
										Header="上代" />
								</DataGrid.Columns>
								<DataGrid.ColumnHeaderStyle>
									<Style BasedOn="{StaticResource MenteDataGridColumnHeader}"
										TargetType="DataGridColumnHeader" />
								</DataGrid.ColumnHeaderStyle>
							</DataGrid>
						</Grid>
					</materialDesign:Card>
				</Grid>
			</TabItem>

			<!--  ================= タブ2: 修正・登録画面 (Shift+F2) =================  -->
			<TabItem x:Name="tabEdit"
				Height="0"
				d:Header="d:修正・登録画面" d:Height="40" Header="">
				<Grid Margin="12">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
					</Grid.RowDefinitions>

					<!--  ヘッダー: 商品情報 + 日付 + 操作ボタン  -->
					<DockPanel Grid.Row="0"
						Margin="0,0,0,8">
						<StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
							<Button Margin="4,0"
								Command="{Binding GoToSearchCommand}"
								Style="{StaticResource MaterialDesignOutlinedButton}"
								ToolTip="検索画面へ戻る">
								<StackPanel Orientation="Horizontal">
									<materialDesign:PackIcon VerticalAlignment="Center"
										Kind="Magnify" />
									<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
										Text="検索へ" />
								</StackPanel>
							</Button>
							<Button Margin="4,0"
								Command="{Binding GoToNewCommand}"
								Style="{StaticResource MaterialDesignOutlinedButton}"
								ToolTip="全クリア">
								<StackPanel Orientation="Horizontal">
									<materialDesign:PackIcon VerticalAlignment="Center"
										Kind="Eraser" />
									<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
									Text="新規" />
								</StackPanel>
							</Button>
							<Button Margin="4,0"
								Command="{Binding DoInsertOnDetailTabCommand}"
								Style="{StaticResource MaterialDesignRaisedButton}"
								ToolTip="配分データを生成 (F2)">
								<StackPanel Orientation="Horizontal">
									<materialDesign:PackIcon VerticalAlignment="Center"
										Kind="CheckCircle" />
									<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
									Text="追加" />
								</StackPanel>
							</Button>
						</StackPanel>
						<StackPanel Orientation="Horizontal">
							<materialDesign:PackIcon Margin="0,0,6,0" VerticalAlignment="Center"
								Kind="StorePlus" />
							<TextBlock VerticalAlignment="Center"
								FontSize="16" FontWeight="SemiBold">
								<TextBlock.Text>
									<MultiBinding StringFormat="{}{0} {1}">
										<Binding Path="TargetShohinCode" />
										<Binding Path="TargetShohinName" />
									</MultiBinding>
								</TextBlock.Text>
							</TextBlock>
						</StackPanel>
					</DockPanel>

					<!--  商品/配分情報カード  -->
					<materialDesign:Card Grid.Row="1"
						Margin="0,0,0,8" Padding="12,8"
						materialDesign:ElevationAssist.Elevation="Dp2" UniformCornerRadius="8">
						<WrapPanel Orientation="Horizontal">
							<StackPanel Margin="0,4,20,4"
								Orientation="Horizontal">
								<TextBlock Style="{StaticResource FormLabel}"
									Text="倉庫Id" />
								<TextBox Width="150"
									IsReadOnly="True"
									Style="{StaticResource FormTextBox}"
									Text="{Binding CurrentEdit.Id_Soko, Mode=OneWay}" />
							</StackPanel>
							<StackPanel Margin="0,4,20,4"
								Orientation="Horizontal">
								<TextBlock Style="{StaticResource FormLabel}"
									Text="区分" />
								<ComboBox Width="130"
									DisplayMemberPath="Name"
									ItemsSource="{Binding KubunOptions}"
									SelectedValue="{Binding Kubun, Mode=TwoWay}"
									SelectedValuePath="Value"
									Style="{StaticResource FormComboBox}" />
							</StackPanel>
							<StackPanel Margin="0,4,20,4"
								Orientation="Horizontal">
								<TextBlock Style="{StaticResource FormLabel}"
									Text="指示日" />
								<DatePicker Width="150"
									helpers:DatePickerTodayButtonBehavior.IsEnabled="True" materialDesign:HintAssist.Hint="指示日"
									SelectedDate="{Binding ShijiDay, Mode=TwoWay}"
									Style="{StaticResource FormDatePicker}" />
							</StackPanel>
							<StackPanel Margin="0,4,20,4"
								Orientation="Horizontal">
								<TextBlock Style="{StaticResource FormLabel}"
									Text="納品日" />
								<DatePicker Width="150"
									helpers:DatePickerTodayButtonBehavior.IsEnabled="True" materialDesign:HintAssist.Hint="納品日"
									SelectedDate="{Binding NouhinDay, Mode=TwoWay}"
									Style="{StaticResource FormDatePicker}" />
							</StackPanel>
							<StackPanel Margin="0,4,20,4"
								Orientation="Horizontal">
								<TextBlock Style="{StaticResource FormLabel}"
									Text="入力者" />
								<TextBox Width="120"
									materialDesign:HintAssist.Hint="入力者"
									Style="{StaticResource FormTextBox}"
									Text="{Binding Nyuryokusha, UpdateSourceTrigger=PropertyChanged}" />
							</StackPanel>
							<StackPanel Margin="0,4,20,4"
								Orientation="Horizontal">
								<TextBlock Style="{StaticResource FormLabel}"
									Text="上代" />
								<TextBox Width="100"
									HorizontalContentAlignment="Right"
									IsReadOnly="True"
									Style="{StaticResource FormTextBox}"
									Text="{Binding TargetJodai, Mode=OneWay, StringFormat={}{0:N0}}" />
							</StackPanel>
							<StackPanel Margin="0,4"
								Orientation="Horizontal">
								<TextBlock Style="{StaticResource FormLabel}"
									Text="配分合計" />
								<TextBox Width="100"
									HorizontalContentAlignment="Right"
									IsReadOnly="True"
									Style="{StaticResource FormTextBox}"
									Text="{Binding TotalSu, Mode=OneWay, StringFormat={}{0:N0}}" />
							</StackPanel>
						</WrapPanel>
					</materialDesign:Card>

					<!--  配分入力カード  -->
					<materialDesign:Card Grid.Row="2"
						Padding="0"
						materialDesign:ElevationAssist.Elevation="Dp2" UniformCornerRadius="8">
						<Grid>
							<Grid.RowDefinitions>
								<RowDefinition Height="Auto" />
								<RowDefinition Height="*" />
							</Grid.RowDefinitions>

							<!--  操作: 店舗追加 / 店舗削除  -->
							<Border Grid.Row="0"
								Padding="8,6"
								Background="{DynamicResource MaterialDesignToolBarBackground}"
								CornerRadius="8,8,0,0">
								<StackPanel Orientation="Horizontal">
									<Button Margin="4,0"
										Command="{Binding DoSelectTenpoCommand}"
										Style="{StaticResource MaterialDesignOutlinedButton}"
										ToolTip="配分先店舗を追加">
										<StackPanel Orientation="Horizontal">
											<materialDesign:PackIcon VerticalAlignment="Center"
												Kind="StorePlusOutline" />
											<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
											Text="店舗選択" />
										</StackPanel>
									</Button>
									<Button Margin="4,0"
										Command="{Binding DoSelectShohinCommand}"
										Style="{StaticResource MaterialDesignOutlinedButton}"
										ToolTip="選択行の店舗を削除">
										<StackPanel Orientation="Horizontal">
											<materialDesign:PackIcon VerticalAlignment="Center"
											Kind="PackageVariantClosed" />
											<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
											Text="商品選択" />
									</StackPanel>
								</Button>
								<Button Margin="4,0"
									Command="{Binding DoSelectSkuCommand}"
									Style="{StaticResource MaterialDesignOutlinedButton}"
									ToolTip="商品色サイズを選択">
									<StackPanel Orientation="Horizontal">
										<materialDesign:PackIcon VerticalAlignment="Center" Kind="PaletteOutline" />
										<TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="SKU選択" />
									</StackPanel>
								</Button>
								<Button Margin="4,0"
									Command="{Binding DoDeleteOnDetailTabCommand}"
									Style="{StaticResource MaterialDesignOutlinedButton}"
									ToolTip="配分レコードを削除">
									<StackPanel Orientation="Horizontal">
										<materialDesign:PackIcon VerticalAlignment="Center" Kind="DeleteOutline" />
										<TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="削除" />
									</StackPanel>
								</Button>
								<Button Margin="4,0"
									Command="{Binding DoUpdateOnDetailTabCommand}"
									Style="{StaticResource MaterialDesignRaisedButton}"
									ToolTip="配分レコードを更新">
									<StackPanel Orientation="Horizontal">
										<materialDesign:PackIcon VerticalAlignment="Center" Kind="ContentSaveOutline" />
										<TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="更新" />
									</StackPanel>
								</Button>
									<TextBlock Margin="16,0,0,0" VerticalAlignment="Center"
										FontSize="12"
										Foreground="{DynamicResource MaterialDesignBodyLight}"
									Text="商品・SKU・店舗を選択し、「指示数」に配分数を入力してください。" />
								</StackPanel>
							</Border>

							<!--  配分明細 DataGrid (SKU × 店舗)  -->
							<DataGrid x:Name="EntryGrid"
								Grid.Row="1"
								helpers:DataGridCellEnterNavigation.IsEnabled="True" helpers:DataGridSelectionBehavior.AutoScrollToSelectedItem="True" materialDesign:DataGridAssist.CellPadding="12,4"
								materialDesign:DataGridAssist.ColumnHeaderPadding="12,8" AlternatingRowBackground="Beige" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
								EnableRowVirtualization="True" FrozenColumnCount="2" GridLinesVisibility="Horizontal"
								HorizontalGridLinesBrush="{DynamicResource MaterialDesignDivider}"
								IsSynchronizedWithCurrentItem="True"
								ItemsSource="{Binding EntryRows}"
								SelectedItem="{Binding SelectedEntryRow, Mode=TwoWay}"
								Style="{StaticResource MaterialDesignDataGrid}"
								VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
								<DataGrid.Columns>
									<DataGridTextColumn Width="90"
										Binding="{Binding Id_Tenpo}"
										Header="店舗Id" IsReadOnly="True" />
									<DataGridTextColumn Width="160"
										Binding="{Binding Id_Soko}"
										Header="倉庫Id" IsReadOnly="True" />
									<DataGridTextColumn Width="130"
										Binding="{Binding Id_Shohin}"
										Header="商品Id" IsReadOnly="True" />
									<DataGridTextColumn Width="70"
										Binding="{Binding Id_Col}"
										Header="色Id" IsReadOnly="True" />
									<DataGridTextColumn Width="90"
										Binding="{Binding Id_Siz}"
										Header="サイズId" IsReadOnly="True" />
									<DataGridTextColumn Width="70"
										Binding="{Binding JanCode}"
										Header="JAN" IsReadOnly="True" />
									<DataGridTextColumn Width="90"
										Binding="{Binding Su, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N0}}"
										EditingElementStyle="{StaticResource DataGridRightTextBox}"
										ElementStyle="{StaticResource DataGridRightTextBlock}"
										Header="指示数" />
									<DataGridTextColumn Width="80"
										Binding="{Binding JitsuSu, StringFormat={}{0:N0}}"
										ElementStyle="{StaticResource DataGridRightTextBlock}"
										Header="実数量" />
									<DataGridTextColumn Width="80"
										Binding="{Binding SendFlg, StringFormat={}{0:N0}}"
										ElementStyle="{StaticResource DataGridRightTextBlock}"
										Header="送信FLG" />
									<DataGridTextColumn Width="80"
										Binding="{Binding Tanka, StringFormat={}{0:N0}}"
										ElementStyle="{StaticResource DataGridRightTextBlock}"
										Header="単価" />
									<DataGridTextColumn Width="80"
										Binding="{Binding Kingaku, StringFormat={}{0:N0}}"
										ElementStyle="{StaticResource DataGridRightTextBlock}"
										Header="金額" />
									<DataGridTextColumn Width="*"
										Header=" " IsReadOnly="True" />
								</DataGrid.Columns>
								<DataGrid.ColumnHeaderStyle>
									<Style BasedOn="{StaticResource MenteDataGridColumnHeader}"
										TargetType="DataGridColumnHeader" />
								</DataGrid.ColumnHeaderStyle>
							</DataGrid>
						</Grid>
					</materialDesign:Card>
				</Grid>
			</TabItem>

		</TabControl>
	</Grid>
</helpers:BaseWindow>
