<helpers:BaseWindow x:Class="CvWpfclient.Views._07Haibun.ShopHaibunInputView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:helpers="clr-namespace:CvWpfclient.Helpers" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:vm="clr-namespace:CvWpfclient.ViewModels._07Haibun"
	Title="店舗配分入力"
	Width="1400" Height="900"
	Background="{DynamicResource AppCommonBackgroundBrush}"
	Foreground="{DynamicResource MaterialDesignBody}"
	TextOptions.TextFormattingMode="Display"
	mc:Ignorable="d">
	<helpers:BaseWindow.DataContext>
		<vm:ShopHaibunInputViewModel />
	</helpers:BaseWindow.DataContext>

	<helpers:BaseWindow.InputBindings>
		<KeyBinding Command="{Binding DoRegisterCommand}"
			Gesture="F2" />
		<KeyBinding Command="{Binding DoSearchCommand}"
			Gesture="F5" />
	</helpers:BaseWindow.InputBindings>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<!--  ===== ヘッダー: ColorZone ツールバー =====  -->
		<materialDesign:ColorZone Grid.Row="0"
			Padding="12,8"
			materialDesign:ElevationAssist.Elevation="Dp4" Mode="PrimaryMid">
			<StackPanel Orientation="Horizontal">
				<Button Margin="0,0,8,0"
					Command="{Binding ExitCommand}"
					Style="{StaticResource ToolCommandButton}"
					ToolTip="閉じる (Esc)">
					<materialDesign:PackIcon Kind="ArrowLeft" />
				</Button>
				<materialDesign:PackIcon Width="28" Height="28"
					VerticalAlignment="Center"
					Kind="StorePlus" />
				<TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
					FontSize="20" FontWeight="SemiBold" Text="店舗配分入力" />
				<TextBlock Margin="24,0,0,0" VerticalAlignment="Center"
					FontSize="13" Opacity="0.85"
					Text="{Binding Message}" />
			</StackPanel>
		</materialDesign:ColorZone>

		<!--  ===== メインコンテンツ =====  -->
		<TabControl x:Name="TabControlMain"
			Grid.Row="1"
			SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}"
			Style="{StaticResource MaterialDesignTabControl}">

			<!--  ================= タブ1: 商品一覧（商品Id 単位の全体把握） =================  -->
			<TabItem x:Name="tabSearch"
				Height="0"
				d:Header="d:商品一覧" d:Height="40" Header="">
				<Grid Margin="12">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
					</Grid.RowDefinitions>

					<!--  検索条件バー（条件指定は別ウィンドウダイアログ）  -->
					<materialDesign:Card Grid.Row="0"
						Margin="0,0,0,8" Padding="12,8"
						materialDesign:ElevationAssist.Elevation="Dp2" UniformCornerRadius="8">
						<DockPanel>
							<Button Command="{Binding DoSearchCommand}"
								DockPanel.Dock="Left"
								Style="{StaticResource MaterialDesignRaisedButton}"
								ToolTip="条件を指定して一覧取得 (F5)">
								<StackPanel Orientation="Horizontal">
									<materialDesign:PackIcon VerticalAlignment="Center"
										Kind="DatabaseSearch" />
									<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
										Text="一覧取得" />
								</StackPanel>
							</Button>
							<TextBlock Margin="16,0,0,0" VerticalAlignment="Center"
								FontSize="13"
								Foreground="{DynamicResource MaterialDesignBodyLight}"
								Text="{Binding SearchConditionText}"
								TextTrimming="CharacterEllipsis" />
						</DockPanel>
					</materialDesign:Card>

					<!--  商品一覧カード  -->
					<materialDesign:Card Grid.Row="1"
						Padding="0"
						materialDesign:ElevationAssist.Elevation="Dp2" UniformCornerRadius="8">
						<Grid>
							<Grid.RowDefinitions>
								<RowDefinition Height="Auto" />
								<RowDefinition Height="*" />
							</Grid.RowDefinitions>

							<!--  カードヘッダー: 件数 + 配分画面へ  -->
							<Border Grid.Row="0"
								Padding="12,8"
								Background="{DynamicResource MaterialDesignToolBarBackground}"
								CornerRadius="8,8,0,0">
								<DockPanel>
									<Button Command="{Binding GoToEditCommand}"
										DockPanel.Dock="Right"
										Style="{StaticResource MaterialDesignRaisedButton}"
										ToolTip="選択商品のSKU（色・サイズ）×店舗の配分入力へ">
										<StackPanel Orientation="Horizontal">
											<materialDesign:PackIcon VerticalAlignment="Center"
												Kind="FileDocumentEdit" />
											<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
												Text="配分画面へ" />
										</StackPanel>
									</Button>
									<TextBlock VerticalAlignment="Center"
										FontSize="13"
										Foreground="{DynamicResource MaterialDesignBodyLight}"
										Text="{Binding SearchCount, StringFormat={}対象商品: {0:N0} 件}" />
								</DockPanel>
							</Border>

							<!--  商品一覧 DataGrid  -->
							<DataGrid x:Name="SearchGrid"
								Grid.Row="1"
								helpers:DataGridDoubleClick.Command="{Binding GoToEditCommand}"
								helpers:DataGridSelectionBehavior.AutoScrollToSelectedItem="True" materialDesign:DataGridAssist.CellPadding="12,6" materialDesign:DataGridAssist.ColumnHeaderPadding="12,8"
								AutoGenerateColumns="False" EnableRowVirtualization="True" FrozenColumnCount="2" GridLinesVisibility="Horizontal"
								HorizontalGridLinesBrush="{DynamicResource MaterialDesignDivider}"
								IsReadOnly="True" IsSynchronizedWithCurrentItem="True"
								ItemsSource="{Binding SearchRows}"
								SelectedItem="{Binding SelectedSearchRow, Mode=TwoWay}"
								Style="{StaticResource MaterialDesignDataGrid}"
								VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
								<DataGrid.Columns>
									<DataGridTextColumn Width="130"
										Binding="{Binding Code}"
										Header="商品CD" />
									<DataGridTextColumn Width="220"
										Binding="{Binding Name}"
										Header="商品名" />
									<DataGridTextColumn Width="130"
										Binding="{Binding BrandDisplay}"
										Header="ブランド" />
									<DataGridTextColumn Width="130"
										Binding="{Binding ItemDisplay}"
										Header="アイテム" />
									<DataGridTextColumn Width="110"
										Binding="{Binding SeasonDisplay}"
										Header="シーズン" />
									<DataGridTextColumn Width="90"
										Binding="{Binding TankaJodai, StringFormat={}{0:N0}}"
										ElementStyle="{StaticResource DataGridRightTextBlock}"
										Header="上代" />
									<DataGridTextColumn Width="90"
										Binding="{Binding UriageSu, StringFormat={}{0:N0}}"
										ElementStyle="{StaticResource DataGridRightTextBlock}"
										Header="累計売上" />
									<DataGridTextColumn Width="90"
										Binding="{Binding ZaikoSu, StringFormat={}{0:N0}}"
										ElementStyle="{StaticResource DataGridRightTextBlock}"
										Header="現在庫" />
									<DataGridTextColumn Width="90"
										Binding="{Binding ShijiSu, StringFormat={}{0:N0}}"
										ElementStyle="{StaticResource DataGridRightTextBlock}"
										Header="現在指示数" />
									<DataGridTextColumn Width="100"
										Binding="{Binding NyukaYoteiSu, StringFormat={}{0:N0}}"
										ElementStyle="{StaticResource DataGridRightTextBlock}"
										Header="入荷予定数" />
									<DataGridTextColumn Width="100"
										Binding="{Binding HaibunKanoSu, StringFormat={}{0:N0}}"
										ElementStyle="{StaticResource DataGridRightTextBlock}"
										Header="配分可能数" />
									<DataGridTextColumn Width="*"
										Header=" " />
								</DataGrid.Columns>
								<DataGrid.ColumnHeaderStyle>
									<Style BasedOn="{StaticResource MenteDataGridColumnHeader}"
										TargetType="DataGridColumnHeader" />
								</DataGrid.ColumnHeaderStyle>
							</DataGrid>
						</Grid>
					</materialDesign:Card>
				</Grid>
			</TabItem>

			<!--  ================= タブ2: 配分入力（SKU × 店舗） =================  -->
			<TabItem x:Name="tabEdit"
				Height="0"
				d:Header="d:配分入力" d:Height="40" Header="">
				<Grid Margin="12">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
					</Grid.RowDefinitions>

					<!--  ヘッダー: 商品情報 + 操作ボタン  -->
					<DockPanel Grid.Row="0"
						Margin="0,0,0,8">
						<StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
							<Button Margin="4,0"
								Command="{Binding GoToSearchCommand}"
								Style="{StaticResource MaterialDesignOutlinedButton}"
								ToolTip="商品一覧へ戻る">
								<StackPanel Orientation="Horizontal">
									<materialDesign:PackIcon VerticalAlignment="Center"
										Kind="Magnify" />
									<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
										Text="一覧へ" />
								</StackPanel>
							</Button>
							<Button Margin="4,0"
								Command="{Binding DoRegisterCommand}"
								Style="{StaticResource MaterialDesignRaisedButton}"
								ToolTip="配分指示を登録 (F2)">
								<StackPanel Orientation="Horizontal">
									<materialDesign:PackIcon VerticalAlignment="Center"
										Kind="ContentSaveOutline" />
									<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
										Text="登録" />
								</StackPanel>
							</Button>
						</StackPanel>
						<StackPanel Orientation="Horizontal">
							<materialDesign:PackIcon Margin="0,0,6,0" VerticalAlignment="Center"
								Kind="StorePlus" />
							<TextBlock VerticalAlignment="Center"
								FontSize="16" FontWeight="SemiBold">
								<TextBlock.Text>
									<MultiBinding StringFormat="{}{0} {1}">
										<Binding Path="TargetShohinCode" />
										<Binding Path="TargetShohinName" />
									</MultiBinding>
								</TextBlock.Text>
							</TextBlock>
						</StackPanel>
					</DockPanel>

					<!--  配分情報カード  -->
					<materialDesign:Card Grid.Row="1"
						Margin="0,0,0,8" Padding="12,8"
						materialDesign:ElevationAssist.Elevation="Dp2" UniformCornerRadius="8">
						<WrapPanel Orientation="Horizontal">
							<StackPanel Margin="0,4,20,4"
								Orientation="Horizontal">
								<TextBlock Style="{StaticResource FormLabel}"
									Text="配分元倉庫" />
								<TextBox Width="170"
									IsReadOnly="True"
									Style="{StaticResource FormTextBox}"
									Text="{Binding SokoDisplay, Mode=OneWay}" />
							</StackPanel>
							<StackPanel Margin="0,4,20,4"
								Orientation="Horizontal">
								<TextBlock Style="{StaticResource FormLabel}"
									Text="区分" />
								<TextBox Width="100"
									IsReadOnly="True"
									Style="{StaticResource FormTextBox}"
									Text="{Binding KubunDisplay, Mode=OneWay}" />
							</StackPanel>
							<StackPanel Margin="0,4,20,4"
								Orientation="Horizontal">
								<TextBlock Style="{StaticResource FormLabel}"
									Text="指示日" />
								<DatePicker Width="150"
									helpers:DatePickerTodayButtonBehavior.IsEnabled="True" materialDesign:HintAssist.Hint="指示日"
									SelectedDate="{Binding ShijiDay, Mode=TwoWay}"
									Style="{StaticResource FormDatePicker}" />
							</StackPanel>
							<StackPanel Margin="0,4,20,4"
								Orientation="Horizontal">
								<TextBlock Style="{StaticResource FormLabel}"
									Text="納品日" />
								<DatePicker Width="150"
									helpers:DatePickerTodayButtonBehavior.IsEnabled="True" materialDesign:HintAssist.Hint="納品日"
									SelectedDate="{Binding NouhinDay, Mode=TwoWay}"
									Style="{StaticResource FormDatePicker}" />
							</StackPanel>
							<StackPanel Margin="0,4,20,4"
								Orientation="Horizontal">
								<TextBlock Style="{StaticResource FormLabel}"
									Text="入力者" />
								<TextBox Width="170"
									helpers:SearchTextBoxAssist.Command="{Binding SelectShainCommand}"
									IsReadOnly="True"
									Style="{StaticResource MenteSearchTextBox}"
									Text="{Binding ShainDisplay, Mode=OneWay}" />
							</StackPanel>
							<StackPanel Margin="0,4,20,4"
								Orientation="Horizontal">
								<TextBlock Style="{StaticResource FormLabel}"
									Text="上代" />
								<TextBox Width="90"
									HorizontalContentAlignment="Right"
									IsReadOnly="True"
									Style="{StaticResource FormTextBox}"
									Text="{Binding TargetJodai, Mode=OneWay, StringFormat={}{0:N0}}" />
							</StackPanel>
							<StackPanel Margin="0,4,20,4"
								Orientation="Horizontal">
								<TextBlock Style="{StaticResource FormLabel}"
									Text="総配分数" />
								<TextBox Width="90"
									HorizontalContentAlignment="Right"
									IsReadOnly="True"
									Style="{StaticResource FormTextBox}"
									Text="{Binding GrandTotalSu, Mode=OneWay, StringFormat={}{0:N0}}" />
							</StackPanel>
							<StackPanel Margin="0,4"
								Orientation="Horizontal">
								<TextBlock Style="{StaticResource FormLabel}"
									Text="配分可能数" />
								<TextBox Width="90"
									HorizontalContentAlignment="Right"
									IsReadOnly="True"
									Style="{StaticResource FormTextBox}"
									Text="{Binding HaibunKanoSu, Mode=OneWay, StringFormat={}{0:N0}}" />
							</StackPanel>
						</WrapPanel>
					</materialDesign:Card>

					<!--  配分入力: 左=配分先店舗 / 右=選択店舗の SKU 明細  -->
					<Grid Grid.Row="2">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="300" />
							<ColumnDefinition Width="8" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>

						<!--  店舗リストカード  -->
						<materialDesign:Card Grid.Column="0"
							Padding="0"
							materialDesign:ElevationAssist.Elevation="Dp2" UniformCornerRadius="8">
							<Grid>
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto" />
									<RowDefinition Height="*" />
								</Grid.RowDefinitions>

								<Border Grid.Row="0"
									Padding="8,6"
									Background="{DynamicResource MaterialDesignToolBarBackground}"
									CornerRadius="8,8,0,0">
									<StackPanel Orientation="Horizontal">
										<Button Margin="4,0"
											Command="{Binding SelectTenpoCommand}"
											Style="{StaticResource MaterialDesignOutlinedButton}"
											ToolTip="配分先店舗を選択（複数）">
											<StackPanel Orientation="Horizontal">
												<materialDesign:PackIcon VerticalAlignment="Center"
													Kind="StorePlusOutline" />
												<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
													Text="店舗選択" />
											</StackPanel>
										</Button>
										<Button Margin="4,0"
											Command="{Binding RemoveTenpoCommand}"
											Style="{StaticResource MaterialDesignOutlinedButton}"
											ToolTip="選択中の店舗をリストから外す">
											<StackPanel Orientation="Horizontal">
												<materialDesign:PackIcon VerticalAlignment="Center"
													Kind="DeleteOutline" />
												<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
													Text="削除" />
											</StackPanel>
										</Button>
									</StackPanel>
								</Border>

								<ListBox Grid.Row="1"
									ItemsSource="{Binding TenpoEntries}"
									SelectedItem="{Binding SelectedTenpo, Mode=TwoWay}">
									<ListBox.ItemTemplate>
										<DataTemplate>
											<DockPanel>
												<TextBlock Margin="8,0,0,0" VerticalAlignment="Center"
													DockPanel.Dock="Right" FontWeight="SemiBold"
													Text="{Binding TotalSu, StringFormat={}{0:N0} 点}" />
												<TextBlock VerticalAlignment="Center"
													Text="{Binding TenpoDisplay}"
													TextTrimming="CharacterEllipsis" />
											</DockPanel>
										</DataTemplate>
									</ListBox.ItemTemplate>
								</ListBox>
							</Grid>
						</materialDesign:Card>

						<!--  SKU 明細カード（選択店舗）  -->
						<materialDesign:Card Grid.Column="2"
							Padding="0"
							materialDesign:ElevationAssist.Elevation="Dp2" UniformCornerRadius="8">
							<Grid>
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto" />
									<RowDefinition Height="*" />
								</Grid.RowDefinitions>

								<Border Grid.Row="0"
									Padding="12,8"
									Background="{DynamicResource MaterialDesignToolBarBackground}"
									CornerRadius="8,8,0,0">
									<DockPanel>
										<TextBlock VerticalAlignment="Center"
											FontSize="13" FontWeight="SemiBold"
											Text="{Binding SelectedTenpo.TenpoDisplay, StringFormat={}配分先: {0}}" />
										<TextBlock Margin="16,0,0,0" VerticalAlignment="Center"
											FontSize="12"
											Foreground="{DynamicResource MaterialDesignBodyLight}"
											Text="SKU（色・サイズ）ごとに「指示数」を入力してください。「配分計」「残」は全店舗の入力に連動します。"
											TextTrimming="CharacterEllipsis" />
									</DockPanel>
								</Border>

								<DataGrid x:Name="EntryGrid"
									Grid.Row="1"
									helpers:DataGridCellEnterNavigation.IsEnabled="True" helpers:DataGridSelectionBehavior.AutoScrollToSelectedItem="True" materialDesign:DataGridAssist.CellPadding="12,4"
									materialDesign:DataGridAssist.ColumnHeaderPadding="12,8" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
									EnableRowVirtualization="True" FrozenColumnCount="2" GridLinesVisibility="Horizontal"
									HorizontalGridLinesBrush="{DynamicResource MaterialDesignDivider}"
									ItemsSource="{Binding SelectedTenpo.Rows}"
									Style="{StaticResource MaterialDesignDataGrid}"
									VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
									<DataGrid.Columns>
										<DataGridTextColumn Width="140"
											Binding="{Binding ColDisplay}"
											Header="色" IsReadOnly="True" />
										<DataGridTextColumn Width="120"
											Binding="{Binding SizDisplay}"
											Header="サイズ" IsReadOnly="True" />
										<DataGridTextColumn Width="130"
											Binding="{Binding Jan1}"
											Header="JAN" IsReadOnly="True" />
										<DataGridTextColumn Width="80"
											Binding="{Binding Summary.ZaikoSu, StringFormat={}{0:N0}}"
											ElementStyle="{StaticResource DataGridRightTextBlock}"
											Header="在庫" IsReadOnly="True" />
										<DataGridTextColumn Width="90"
											Binding="{Binding Summary.NyukaYoteiSu, StringFormat={}{0:N0}}"
											ElementStyle="{StaticResource DataGridRightTextBlock}"
											Header="入荷予定" IsReadOnly="True" />
										<DataGridTextColumn Width="80"
											Binding="{Binding Summary.OtherShijiSu, StringFormat={}{0:N0}}"
											ElementStyle="{StaticResource DataGridRightTextBlock}"
											Header="他指示" IsReadOnly="True" />
										<DataGridTextColumn Width="90"
											Binding="{Binding Su, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N0}}"
											EditingElementStyle="{StaticResource DataGridRightTextBox}"
											ElementStyle="{StaticResource DataGridRightTextBlock}"
											Header="指示数" />
										<DataGridTextColumn Width="90"
											Binding="{Binding Summary.HaibunTotalSu, StringFormat={}{0:N0}}"
											ElementStyle="{StaticResource DataGridRightTextBlock}"
											Header="配分計" IsReadOnly="True" />
										<DataGridTextColumn Width="80"
											Binding="{Binding Summary.NokoriSu, StringFormat={}{0:N0}}"
											ElementStyle="{StaticResource DataGridRightTextBlock}"
											Header="残" IsReadOnly="True" />
										<DataGridTextColumn Width="*"
											Header=" " IsReadOnly="True" />
									</DataGrid.Columns>
									<DataGrid.ColumnHeaderStyle>
										<Style BasedOn="{StaticResource MenteDataGridColumnHeader}"
											TargetType="DataGridColumnHeader" />
									</DataGrid.ColumnHeaderStyle>
								</DataGrid>
							</Grid>
						</materialDesign:Card>
					</Grid>
				</Grid>
			</TabItem>

		</TabControl>
	</Grid>
</helpers:BaseWindow>
