<helpers:BaseWindow x:Class="CvWpfclient.Views._07Haibun.PurchaseReceiptAllocationInputView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:helpers="clr-namespace:CvWpfclient.Helpers" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:vm="clr-namespace:CvWpfclient.ViewModels._07Haibun"
	Title="仕入配分入力(商品別)"
	Width="1280" Height="800"
	Background="{DynamicResource AppCommonBackgroundBrush}"
	FontSize="14"
	Foreground="{DynamicResource MaterialDesignBody}"
	TextOptions.TextFormattingMode="Display" WindowStartupLocation="CenterScreen"
	mc:Ignorable="d">
	<helpers:BaseWindow.DataContext>
		<vm:PurchaseReceiptAllocationInputViewModel />
	</helpers:BaseWindow.DataContext>

	<helpers:BaseWindow.Resources>
		<!--  SKU 列の見出し。幅は列側(SkuColumnWidth)で決める  -->
		<DataTemplate x:Key="SkuColumnHeaderTemplate">
			<StackPanel>
				<TextBlock HorizontalAlignment="Center"
					FontWeight="SemiBold"
					Text="{Binding Code_Col}"
					ToolTip="{Binding ColDisplay}" />
				<TextBlock HorizontalAlignment="Center"
					FontWeight="SemiBold"
					Text="{Binding Code_Siz}"
					ToolTip="{Binding SizDisplay}" />
				<Separator Margin="0,2"
					Opacity="0.4" />
				<TextBlock HorizontalAlignment="Right"
					FontSize="11"
					Text="{Binding HachuSu, StringFormat={}発注 {0:N0}}" />
				<TextBlock HorizontalAlignment="Right"
					FontSize="11"
					Text="{Binding NyukaSu, StringFormat={}入荷 {0:N0}}"
					ToolTip="対象発注に紐付く仕入数。入荷済みの数だけが引当・確定の対象になる" />
				<TextBlock HorizontalAlignment="Right"
					FontSize="11"
					Text="{Binding KanoSu, StringFormat={}可能 {0:N0}}"
					ToolTip="配分可能数（発注数 − ほかの仕入配分）" />
				<TextBlock HorizontalAlignment="Right"
					FontSize="11" FontWeight="SemiBold"
					Text="{Binding HaibunTotalSu, StringFormat={}配分 {0:N0}}" />
				<TextBlock HorizontalAlignment="Right"
					FontSize="11"
					Text="{Binding RemainSu, StringFormat={}残 {0:N0}}"
					ToolTip="配分可能 − 配分。マイナスは発注数を超えるため登録できない">
					<TextBlock.Style>
						<Style TargetType="TextBlock">
							<Style.Triggers>
								<DataTrigger Binding="{Binding IsOver}"
									Value="True">
									<Setter Property="Foreground" Value="{DynamicResource NegativeForegroundBrush}" />
									<Setter Property="FontWeight" Value="Bold" />
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</TextBlock.Style>
				</TextBlock>
			</StackPanel>
		</DataTemplate>
	</helpers:BaseWindow.Resources>

	<helpers:BaseWindow.InputBindings>
		<KeyBinding Command="{Binding DoRegisterCommand}"
			Gesture="F2" />
		<KeyBinding Command="{Binding DoSearchCommand}"
			Gesture="F5" />
		<KeyBinding Command="{Binding ExitCommand}"
			Gesture="Esc" />
	</helpers:BaseWindow.InputBindings>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<materialDesign:ColorZone Grid.Row="0"
			Padding="12,8"
			materialDesign:ElevationAssist.Elevation="Dp4" Mode="PrimaryMid">
			<DockPanel>
				<Button Margin="0,0,8,0"
					Command="{Binding ExitCommand}"
					Style="{StaticResource ToolCommandButton}"
					ToolTip="閉じる (Esc)">
					<materialDesign:PackIcon Kind="ArrowLeft" />
				</Button>
				<materialDesign:PackIcon Width="28" Height="28"
					VerticalAlignment="Center"
					Kind="TruckDelivery" />
				<TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
					FontSize="20" FontWeight="SemiBold"
					Text="仕入配分入力(商品別)" />
				<TextBlock Margin="16,0,0,0" VerticalAlignment="Center"
					Opacity="0.8" Text="発注の入荷予定を配分先へ振り分けます。入荷した数だけが引当・確定の対象です。"
					TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
			</DockPanel>
		</materialDesign:ColorZone>

		<Border Grid.Row="1"
			Padding="12,8"
			Background="{DynamicResource MaterialDesignPaper}">
			<StackPanel>
				<WrapPanel Orientation="Horizontal">
					<StackPanel Margin="0,4,20,4"
						Orientation="Horizontal">
						<TextBlock Style="{StaticResource FormLabel}"
							Text="入荷倉庫" />
						<Button Width="64"
							Command="{Binding SelectSokoCommand}"
							Content="選択"
							Style="{StaticResource MaterialDesignOutlinedButton}" />
						<TextBox Width="140"
							Margin="8,0,0,0"
							Style="{StaticResource FormTextBox}"
							Text="{Binding SokoCode, UpdateSourceTrigger=PropertyChanged}" />
						<TextBlock Width="150"
							Margin="8,0,0,0" VerticalAlignment="Center"
							Text="{Binding SokoName}"
							TextTrimming="CharacterEllipsis" />
					</StackPanel>
					<StackPanel Margin="0,4,20,4"
						Orientation="Horizontal">
						<TextBlock Style="{StaticResource FormLabel}"
							Text="商品" />
						<Button Width="64"
							Command="{Binding SelectShohinCommand}"
							Content="選択"
							Style="{StaticResource MaterialDesignOutlinedButton}" />
						<TextBox Width="150"
							Margin="8,0,0,0"
							Style="{StaticResource FormTextBox}"
							Text="{Binding ShohinCode, UpdateSourceTrigger=PropertyChanged}" />
						<TextBlock Width="180"
							Margin="8,0,0,0" VerticalAlignment="Center"
							Text="{Binding ShohinName}"
							TextTrimming="CharacterEllipsis" />
					</StackPanel>
					<StackPanel Margin="0,4,20,4"
						Orientation="Horizontal">
						<TextBlock Style="{StaticResource FormLabel}"
							Text="納品予定日" />
						<DatePicker Width="140"
							helpers:DatePickerTodayButtonBehavior.IsEnabled="True"
							SelectedDate="{Binding NouhinDayFrom, Mode=TwoWay}"
							Style="{StaticResource FormDatePicker}" />
						<TextBlock Margin="6,0" VerticalAlignment="Center"
							Text="～" />
						<DatePicker Width="140"
							helpers:DatePickerTodayButtonBehavior.IsEnabled="True"
							SelectedDate="{Binding NouhinDayTo, Mode=TwoWay}"
							Style="{StaticResource FormDatePicker}" />
					</StackPanel>
					<StackPanel Margin="0,4,20,4"
						Orientation="Horizontal">
						<TextBlock Style="{StaticResource FormLabel}"
							Text="仕入先" />
						<TextBox Width="120"
							Style="{StaticResource FormTextBox}"
							Text="{Binding ShiireCode, UpdateSourceTrigger=PropertyChanged}" />
					</StackPanel>
					<Button Margin="0,4"
						Command="{Binding DoSearchCommand}"
						IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
						Style="{StaticResource MaterialDesignFlatMidBgButton}"
						ToolTip="検索 (F5)">
						<StackPanel Orientation="Horizontal">
							<materialDesign:PackIcon VerticalAlignment="Center"
								Kind="Magnify" />
							<TextBlock Margin="8,0,0,0" VerticalAlignment="Center"
								FontSize="16" Text="検索" />
						</StackPanel>
					</Button>
				</WrapPanel>
				<WrapPanel Margin="0,4,0,0"
					Orientation="Horizontal">
					<StackPanel Margin="0,4,20,4"
						Orientation="Horizontal">
						<TextBlock Style="{StaticResource FormLabel}"
							Text="指示日" />
						<DatePicker Width="140"
							helpers:DatePickerTodayButtonBehavior.IsEnabled="True"
							SelectedDate="{Binding ShijiDay, Mode=TwoWay}"
							Style="{StaticResource FormDatePicker}" />
					</StackPanel>
					<StackPanel Margin="0,4,20,4"
						Orientation="Horizontal">
						<TextBlock Style="{StaticResource FormLabel}"
							Text="納品日" />
						<DatePicker Width="140"
							helpers:DatePickerTodayButtonBehavior.IsEnabled="True"
							SelectedDate="{Binding NouhinDay, Mode=TwoWay}"
							Style="{StaticResource FormDatePicker}" />
					</StackPanel>
					<StackPanel Margin="0,4,20,4"
						Orientation="Horizontal">
						<TextBlock Style="{StaticResource FormLabel}"
							Text="メモ" />
						<TextBox Width="180"
							Style="{StaticResource FormTextBox}"
							Text="{Binding Memo, UpdateSourceTrigger=PropertyChanged}" />
					</StackPanel>
					<StackPanel Margin="0,4,16,4"
						Orientation="Horizontal">
						<TextBlock Style="{StaticResource FormLabel}"
							Text="方式" />
						<ComboBox Width="90"
							ItemsSource="{Binding Modes}"
							SelectedItem="{Binding Mode}"
							Style="{StaticResource FormComboBox}" />
						<TextBlock Margin="12,0,6,0" VerticalAlignment="Center"
							Text="同数" />
						<TextBox Width="60"
							HorizontalContentAlignment="Right"
							Style="{StaticResource FormTextBox}"
							Text="{Binding SameQty, UpdateSourceTrigger=PropertyChanged}" />
					</StackPanel>
					<StackPanel Margin="0,4,16,4"
						Orientation="Horizontal">
						<TextBlock Style="{StaticResource FormLabel}"
							Text="比率の基準" />
						<ComboBox Width="110"
							ItemsSource="{Binding Bases}"
							SelectedItem="{Binding Basis}"
							Style="{StaticResource FormComboBox}" />
					</StackPanel>
					<StackPanel Margin="0,4,16,4"
						Orientation="Horizontal">
						<TextBlock Style="{StaticResource FormLabel}"
							Text="端数" />
						<ComboBox Width="110"
							ItemsSource="{Binding Roundings}"
							SelectedItem="{Binding Rounding}"
							Style="{StaticResource FormComboBox}" />
					</StackPanel>
					<StackPanel Margin="0,4,16,4"
						Orientation="Horizontal">
						<TextBlock Style="{StaticResource FormLabel}"
							Text="総数" />
						<ComboBox Width="120"
							ItemsSource="{Binding TotalModes}"
							SelectedItem="{Binding TotalMode}"
							Style="{StaticResource FormComboBox}" />
						<TextBox Width="70"
							Margin="8,0,0,0"
							HorizontalContentAlignment="Right"
							Style="{StaticResource FormTextBox}"
							Text="{Binding TotalQty, UpdateSourceTrigger=PropertyChanged}"
							ToolTip="総数を「入力した数」にしたときのSKUごとの数" />
					</StackPanel>
					<StackPanel Margin="0,4,16,4"
						Orientation="Horizontal">
						<TextBlock Style="{StaticResource FormLabel}"
							Text="対象" />
						<ComboBox Width="130"
							ItemsSource="{Binding Targets}"
							SelectedItem="{Binding Target}"
							Style="{StaticResource FormComboBox}" />
					</StackPanel>
					<Button Margin="0,4,12,4"
						Command="{Binding CalcRatioCommand}"
						Style="{StaticResource MaterialDesignOutlinedButton}"
						ToolTip="前回配分から各行の比率(%)を計算する">
						<TextBlock FontSize="16" Text="比率を計算" />
					</Button>
					<Button Margin="0,4"
						Command="{Binding ApplyAllocationCommand}"
						Style="{StaticResource MaterialDesignFlatMidBgButton}"
						ToolTip="同数または比率で配分数を入れる（既存の入力は上書き）">
						<TextBlock FontSize="16" Text="按分実行" />
					</Button>
				</WrapPanel>
			</StackPanel>
		</Border>

		<DockPanel Grid.Row="2"
			Margin="12">
			<!--  縮小時に右端の［登録］が隠れないよう折り返す  -->
			<WrapPanel Margin="0,0,0,6"
				DockPanel.Dock="Top" Orientation="Horizontal">
				<TextBlock VerticalAlignment="Center"
					FontSize="16" FontWeight="SemiBold" Text="配分先 × SKU" />
				<TextBlock Margin="16,0,0,0" VerticalAlignment="Center"
					Text="{Binding OrderCount, StringFormat='発注 {0:N0} 件'}" />
				<TextBlock Margin="16,0,0,0" VerticalAlignment="Center"
					FontWeight="SemiBold"
					Text="{Binding GrandTotalSu, StringFormat='配分 {0:N0}'}" />
				<Button Margin="24,0,0,0"
					Command="{Binding AddDestinationsCommand}"
					Style="{StaticResource MaterialDesignOutlinedButton}"
					ToolTip="配分先（倉庫・卸先・売仕店・直営店）を追加・削除する">
					<TextBlock FontSize="16" Text="配分先の追加・削除" />
				</Button>
				<Button Margin="12,0,0,0"
					Command="{Binding LoadPreviousDestinationsCommand}"
					Style="{StaticResource MaterialDesignOutlinedButton}"
					ToolTip="この商品（無ければ同じブランド）の直近の配分の配分先を追加する">
					<TextBlock FontSize="16" Text="前回の配分先を読込" />
				</Button>
				<Button Margin="12,0,0,0"
					Command="{Binding ClearAllCommand}"
					Style="{StaticResource MaterialDesignOutlinedButton}">
					<TextBlock FontSize="16" Text="0クリア" />
				</Button>
				<Button Margin="12,0,0,0"
					Command="{Binding DoRegisterCommand}"
					Style="{StaticResource MaterialDesignFlatMidBgButton}"
					ToolTip="登録 (F2)">
					<StackPanel Orientation="Horizontal">
						<materialDesign:PackIcon VerticalAlignment="Center"
							Kind="ContentSave" />
						<TextBlock Margin="8,0,0,0" VerticalAlignment="Center"
							FontSize="16" Text="登録" />
					</StackPanel>
				</Button>
			</WrapPanel>
			<DataGrid x:Name="AllocationGrid"
				AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False"
				CurrentCellChanged="AllocationGrid_CurrentCellChanged"
				EnableRowVirtualization="True" FrozenColumnCount="1" GridLinesVisibility="Horizontal"
				ItemsSource="{Binding Rows}"
				SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
				SelectionUnit="CellOrRowHeader">
				<DataGrid.Columns>
					<DataGridTextColumn Width="260"
						Binding="{Binding TenpoDisplay}"
						Header="配分先" IsReadOnly="True" />
					<DataGridTextColumn Width="90"
						Binding="{Binding KindDisplay}"
						Header="種別" IsReadOnly="True" />
					<DataGridTextColumn Width="80"
						Binding="{Binding RatioText, UpdateSourceTrigger=LostFocus}"
						EditingElementStyle="{StaticResource DataGridRightTextBox}"
						ElementStyle="{StaticResource DataGridRightTextBlock}"
						Header="比率%" />
					<DataGridTextColumn Width="80"
						Binding="{Binding TotalSu, StringFormat={}{0:N0}}"
						ElementStyle="{StaticResource DataGridRightTextBlock}"
						Header="合計" IsReadOnly="True" />
				</DataGrid.Columns>
			</DataGrid>
		</DockPanel>

		<Border Grid.Row="3"
			Padding="12,8"
			Background="{DynamicResource MaterialDesignPaper}">
			<DockPanel>
				<Button Command="{Binding ExitCommand}"
					DockPanel.Dock="Right"
					Style="{StaticResource MaterialDesignOutlinedButton}"
					ToolTip="閉じる (Esc)">
					<TextBlock FontSize="16" Text="閉じる" />
				</Button>
				<TextBlock VerticalAlignment="Center"
					Text="{Binding Message}"
					TextWrapping="Wrap" />
			</DockPanel>
		</Border>
	</Grid>
</helpers:BaseWindow>
