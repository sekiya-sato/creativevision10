<helpers:BaseWindow x:Class="CvWpfclient.Views._07Haibun.ShippingConfirmDetailPrintView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:helpers="clr-namespace:CvWpfclient.Helpers"
	xmlns:local="clr-namespace:CvWpfclient.Views" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:vm="clr-namespace:CvWpfclient.ViewModels._07Haibun"
	Title="{Binding Title}"
	Width="820" Height="620"
	Background="{DynamicResource AppCommonBackgroundBrush}"
	FontSize="16"
	Foreground="{DynamicResource MaterialDesignBody}"
	TextOptions.TextFormattingMode="Display" WindowStartupLocation="CenterScreen"
	mc:Ignorable="d">
	<helpers:BaseWindow.DataContext>
		<vm:ShippingConfirmDetailPrintViewModel />
	</helpers:BaseWindow.DataContext>

	<helpers:BaseWindow.InputBindings>
		<KeyBinding Command="{Binding DoPrintCommand}"
			Gesture="F6" />
		<KeyBinding Command="{Binding ExitCommand}"
			Gesture="Esc" />
	</helpers:BaseWindow.InputBindings>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<materialDesign:ColorZone Grid.Row="0"
			Padding="12,8"
			materialDesign:ElevationAssist.Elevation="Dp4" Mode="PrimaryMid">
			<StackPanel Orientation="Horizontal">
				<Button Margin="0,0,8,0"
					Command="{Binding ExitCommand}"
					Style="{StaticResource ToolCommandButton}"
					ToolTip="閉じる (Esc)">
					<materialDesign:PackIcon Kind="ArrowLeft" />
				</Button>
				<materialDesign:PackIcon Width="28" Height="28"
					VerticalAlignment="Center"
					Kind="Printer" />
				<TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
					FontSize="20" FontWeight="SemiBold"
					Text="{Binding Title}" />
			</StackPanel>
		</materialDesign:ColorZone>

		<Grid Grid.Row="1"
			Margin="24">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
			</Grid.RowDefinitions>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="140" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>

			<!--  区分  -->
			<TextBlock Grid.Row="0" Grid.Column="0"
				Style="{StaticResource FormLabel}"
				Text="区分" />
			<ComboBox Grid.Row="0" Grid.Column="1"
				Width="200"
				HorizontalAlignment="Left"
				DisplayMemberPath="Name"
				ItemsSource="{Binding KubunOptions}"
				SelectedValue="{Binding SelectedKubun}"
				SelectedValuePath="Value"
				Style="{StaticResource FormComboBox}" />

			<!--  配分指示日  -->
			<TextBlock Grid.Row="1" Grid.Column="0"
				Style="{StaticResource FormLabel}"
				Text="配分指示日" />
			<TextBox Grid.Row="1" Grid.Column="1"
				Width="200" Height="36"
				HorizontalAlignment="Left" HorizontalContentAlignment="Left"
				Style="{StaticResource MaterialDesignTextBox}"
				Text="{Binding DenDayFromText, UpdateSourceTrigger=PropertyChanged}" />
			<TextBlock Grid.Row="1" Grid.Column="2"
				Margin="8,0" VerticalAlignment="Center"
				Text="～" />
			<TextBox Grid.Row="1" Grid.Column="3"
				Width="200" Height="36"
				HorizontalAlignment="Left" HorizontalContentAlignment="Left"
				Style="{StaticResource MaterialDesignTextBox}"
				Text="{Binding DenDayToText, UpdateSourceTrigger=PropertyChanged}" />

			<!--  出庫倉庫  -->
			<TextBlock Grid.Row="2" Grid.Column="0"
				Style="{StaticResource FormLabel}"
				Text="出庫倉庫" />
			<TextBox Grid.Row="2" Grid.Column="1"
				Width="200" Height="36"
				HorizontalAlignment="Left" HorizontalContentAlignment="Left"
				helpers:SearchTextBoxAssist.Command="{Binding SelectSokoFromCommand}"
				BorderThickness="0,0,0,1"
				Style="{StaticResource MenteSearchTextBox}"
				Text="{Binding SokoCodeFrom, UpdateSourceTrigger=PropertyChanged}" />
			<TextBlock Grid.Row="2" Grid.Column="2"
				Margin="8,0" VerticalAlignment="Center"
				Text="～" />
			<TextBox Grid.Row="2" Grid.Column="3"
				Width="200" Height="36"
				HorizontalAlignment="Left" HorizontalContentAlignment="Left"
				helpers:SearchTextBoxAssist.Command="{Binding SelectSokoToCommand}"
				BorderThickness="0,0,0,1"
				Style="{StaticResource MenteSearchTextBox}"
				Text="{Binding SokoCodeTo, UpdateSourceTrigger=PropertyChanged}" />

			<!--  出荷先  -->
			<TextBlock Grid.Row="3" Grid.Column="0"
				Style="{StaticResource FormLabel}"
				Text="出荷先" />
			<TextBox Grid.Row="3" Grid.Column="1"
				Width="200" Height="36"
				HorizontalAlignment="Left" HorizontalContentAlignment="Left"
				helpers:SearchTextBoxAssist.Command="{Binding SelectTenpoFromCommand}"
				BorderThickness="0,0,0,1"
				Style="{StaticResource MenteSearchTextBox}"
				Text="{Binding TenpoCodeFrom, UpdateSourceTrigger=PropertyChanged}" />
			<TextBlock Grid.Row="3" Grid.Column="2"
				Margin="8,0" VerticalAlignment="Center"
				Text="～" />
			<TextBox Grid.Row="3" Grid.Column="3"
				Width="200" Height="36"
				HorizontalAlignment="Left" HorizontalContentAlignment="Left"
				helpers:SearchTextBoxAssist.Command="{Binding SelectTenpoToCommand}"
				BorderThickness="0,0,0,1"
				Style="{StaticResource MenteSearchTextBox}"
				Text="{Binding TenpoCodeTo, UpdateSourceTrigger=PropertyChanged}" />

			<!--  絞り込み  -->
			<TextBlock Grid.Row="4" Grid.Column="0"
				Margin="0,10,0,10"
				Style="{StaticResource FormLabel}"
				Text="絞り込み" />
			<StackPanel Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3"
				Margin="0,10,0,10"
				Orientation="Horizontal">
				<CheckBox Margin="0,4"
					Content="確定済みのみ"
					IsChecked="{Binding KakuteiOnly}" />
			</StackPanel>

			<!--  注意書き  -->
			<StackPanel Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="3"
				Margin="0,8">
				<TextBlock Foreground="{DynamicResource MaterialDesignValidationErrorBrush}"
					Text="※配分(TranHaibun)を仮想ヘッダキー単位でグルーピングして印刷します。1回の印刷でヘッダ集計（サマリー）→SKU明細（バーコード付き・伝票計）の2帳票を出力します。" TextWrapping="Wrap" />
				<TextBlock Foreground="{DynamicResource MaterialDesignValidationErrorBrush}"
					Text="※対象データが0件の場合は印刷を中止します。" TextWrapping="Wrap" />
			</StackPanel>

			<!--  実行ボタン  -->
			<StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="4"
				Margin="0,24" HorizontalAlignment="Center"
				Orientation="Horizontal">
				<Button Command="{Binding DoPrintCommand}"
					Style="{StaticResource MaterialDesignFlatMidBgButton}"
					ToolTip="印刷 (F6)">
					<StackPanel Orientation="Horizontal">
						<materialDesign:PackIcon VerticalAlignment="Center"
							Kind="Printer" />
						<TextBlock Margin="8,0,0,0" VerticalAlignment="Center"
							FontSize="20" Text="印刷" />
					</StackPanel>
				</Button>
				<Button Margin="16,0,0,0"
					Command="{Binding ClearConditionsCommand}"
					Style="{StaticResource MaterialDesignOutlinedButton}">
					<TextBlock FontSize="16" Text="条件クリア" />
				</Button>
			</StackPanel>
		</Grid>

		<Border Grid.Row="2"
			Padding="12,8"
			Background="{DynamicResource MaterialDesignPaper}">
			<TextBlock VerticalAlignment="Center"
				Text="{Binding Message}"
				TextWrapping="Wrap" />
		</Border>
	</Grid>
</helpers:BaseWindow>
