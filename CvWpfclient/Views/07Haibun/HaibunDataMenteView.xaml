<helpers:BaseWindow x:Class="CvWpfclient.Views._07Haibun.HaibunDataMenteView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:helpers="clr-namespace:CvWpfclient.Helpers" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:vm="clr-namespace:CvWpfclient.ViewModels._07Haibun"
	Title="{Binding Title}"
	Width="1400"
	Height="{StaticResource StandardWindowHeight}"
	Background="{DynamicResource AppCommonBackgroundBrush}"
	FontSize="16"
	Foreground="{DynamicResource MaterialDesignBody}"
	TextOptions.TextFormattingMode="Display" WindowStartupLocation="CenterScreen"
	mc:Ignorable="d">
	<helpers:BaseWindow.DataContext>
		<vm:HaibunDataMenteViewModel />
	</helpers:BaseWindow.DataContext>

	<helpers:BaseWindow.InputBindings>
		<KeyBinding Command="{Binding DoUpdateCommand}"
			Gesture="F2" />
		<KeyBinding Command="{Binding DoDeleteCommand}"
			Gesture="F3" />
		<KeyBinding Command="{Binding DoListCommand}"
			Gesture="F5" />
	</helpers:BaseWindow.InputBindings>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<materialDesign:ColorZone Grid.Row="0"
			Padding="12,8"
			materialDesign:ElevationAssist.Elevation="Dp4" Mode="PrimaryMid">
			<DockPanel>
				<StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
					<Button Margin="4,0"
						Command="{Binding DoUpdateCommand}"
						Style="{StaticResource ToolCommandButton}"
						ToolTip="修正 (F2)">
						<StackPanel Orientation="Horizontal">
							<materialDesign:PackIcon VerticalAlignment="Center"
								Kind="Pencil" />
							<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
								Text="修正" />
						</StackPanel>
					</Button>
					<Button Margin="4,0"
						Command="{Binding DoDeleteCommand}"
						Style="{StaticResource ToolCommandButton}"
						ToolTip="削除 (F3)">
						<StackPanel Orientation="Horizontal">
							<materialDesign:PackIcon VerticalAlignment="Center"
								Kind="Delete" />
							<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
								Text="削除" />
						</StackPanel>
					</Button>
				</StackPanel>

				<StackPanel Orientation="Horizontal">
					<Button Margin="0,0,8,0"
						Command="{Binding ExitCommand}"
						Style="{StaticResource ToolCommandButton}"
						ToolTip="閉じる (Esc)">
						<materialDesign:PackIcon Kind="ArrowLeft" />
					</Button>
					<materialDesign:PackIcon Width="28" Height="28"
						VerticalAlignment="Center"
						Kind="DatabaseEdit" />
					<TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
						FontSize="20" FontWeight="SemiBold"
						Text="{Binding Title}" />
					<Rectangle Width="1"
						Margin="16,4"
						Fill="{DynamicResource PrimaryHueMidForegroundBrush}"
						Opacity="0.3" />
					<Button Command="{Binding DoListCommand}"
						Style="{StaticResource ToolCommandButton}"
						ToolTip="一覧取得 (F5)">
						<StackPanel Orientation="Horizontal">
							<materialDesign:PackIcon VerticalAlignment="Center"
								Kind="DatabaseSearch" />
							<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
								Text="一覧取得" />
						</StackPanel>
					</Button>
				</StackPanel>
			</DockPanel>
		</materialDesign:ColorZone>

		<Grid Grid.Row="1"
			Margin="12">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="380" />
			</Grid.ColumnDefinitions>

			<materialDesign:Card Grid.Column="0"
				Padding="0"
				materialDesign:ElevationAssist.Elevation="Dp2" UniformCornerRadius="8">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
					</Grid.RowDefinitions>

					<Border Grid.Row="0"
						Padding="12,8"
						Background="{DynamicResource MaterialDesignToolBarBackground}"
						CornerRadius="8,8,0,0">
						<DockPanel>
							<TextBlock VerticalAlignment="Center"
								DockPanel.Dock="Right" FontSize="13"
								Foreground="{DynamicResource MaterialDesignBodyLight}"
								Text="{Binding Count, StringFormat={}件数: {0:N0}}" />
							<TextBlock VerticalAlignment="Center"
								FontSize="13"
								Foreground="{DynamicResource MaterialDesignBodyLight}"
								Text="{Binding Message}"
								TextTrimming="CharacterEllipsis" />
						</DockPanel>
					</Border>

					<DataGrid x:Name="HaibunDataGrid"
						Grid.Row="1"
						d:ItemsSource="{d:SampleData ItemCount=5}"
						helpers:DataGridSelectionBehavior.AutoScrollToSelectedItem="True" materialDesign:DataGridAssist.CellPadding="8,6" materialDesign:DataGridAssist.ColumnHeaderPadding="8,8"
						AutoGenerateColumns="False" EnableRowVirtualization="True" FrozenColumnCount="2" GridLinesVisibility="Horizontal"
						HorizontalGridLinesBrush="{DynamicResource MaterialDesignDivider}"
						IsReadOnly="True" IsSynchronizedWithCurrentItem="True"
						ItemsSource="{Binding ListData}"
						SelectedItem="{Binding Current}"
						Style="{StaticResource MaterialDesignDataGrid}"
						VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
						<DataGrid.Columns>
							<DataGridTextColumn Width="60"
								Binding="{Binding Id}"
								Header="Id" />
							<DataGridTextColumn Width="100"
								Binding="{Binding DenDay, Converter={StaticResource DateYmd8Converter}, StringFormat=yyyy/MM/dd}"
								Header="日付" />
							<DataGridTextColumn Width="90"
								Binding="{Binding SokoName}"
								Header="倉庫" />
							<DataGridTextColumn Width="90"
								Binding="{Binding TenpoName}"
								Header="店舗" />
							<DataGridTextColumn Width="105"
								Binding="{Binding ShohinCode}"
								Header="商品CD" />
							<DataGridTextColumn Width="55"
								Binding="{Binding ColName}"
								Header="色" />
							<DataGridTextColumn Width="65"
								Binding="{Binding SizName}"
								Header="サイズ" />
							<DataGridTextColumn Width="55"
								Binding="{Binding Su}"
								ElementStyle="{StaticResource StockQueryNumericCell}"
								Header="数量" />
							<DataGridTextColumn Width="55"
								Binding="{Binding JitsuSu}"
								ElementStyle="{StaticResource StockQueryNumericCell}"
								Header="実数" />
							<DataGridTextColumn Width="55"
								Binding="{Binding ShortSu}"
								ElementStyle="{StaticResource StockQueryNumericCell}"
								Header="欠品" />
							<DataGridTextColumn Width="100"
								Binding="{Binding KakuteiDay, Converter={StaticResource DateYmd8Converter}, StringFormat=yyyy/MM/dd}"
								Header="確定日" />
							<DataGridTextColumn Width="50"
								Binding="{Binding EndFlag}"
								Header="完了" />
							<DataGridTextColumn Width="50"
								Binding="{Binding SendFlg}"
								Header="送信" />
							<DataGridTextColumn Width="100"
								Binding="{Binding EnKubun, Converter={StaticResource EnumCommentDisplayConverter}}"
								Header="区分" />
							<DataGridTextColumn Width="160"
								Binding="{Binding ShohinName}"
								Header="商品名" />
						</DataGrid.Columns>
						<DataGrid.ColumnHeaderStyle>
							<Style BasedOn="{StaticResource MenteDataGridColumnHeader}"
								TargetType="DataGridColumnHeader" />
						</DataGrid.ColumnHeaderStyle>
					</DataGrid>
				</Grid>
			</materialDesign:Card>

			<GridSplitter Grid.Column="1"
				Width="6"
				Margin="3,0" HorizontalAlignment="Center" VerticalAlignment="Stretch"
				Background="Transparent" />

			<materialDesign:Card Grid.Column="2"
				Padding="0"
				materialDesign:ElevationAssist.Elevation="Dp2" UniformCornerRadius="8">
				<TabControl Style="{StaticResource MaterialDesignTabControl}">
					<TabItem>
						<TabItem.Header>
							<StackPanel Orientation="Horizontal">
								<materialDesign:PackIcon Margin="0,0,6,0" VerticalAlignment="Center"
									Kind="InformationOutline" />
								<TextBlock Text="{Binding CurrentEdit.Id, StringFormat={}Id:{0}}" />
							</StackPanel>
						</TabItem.Header>
						<ScrollViewer Padding="10,10,20,20"
							VerticalScrollBarVisibility="Auto">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="110" />
									<ColumnDefinition Width="*" />
								</Grid.ColumnDefinitions>
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
								</Grid.RowDefinitions>

								<!--  読取専用：配分のキーと数量（変更は各配分入力画面で行う）  -->
								<TextBlock Grid.Row="0"
									Style="{StaticResource FormLabel}"
									Text="日付/区分" />
								<TextBlock Grid.Row="0" Grid.Column="1"
									VerticalAlignment="Center"
									TextWrapping="Wrap">
									<TextBlock.Text>
										<MultiBinding StringFormat="{}{0:yyyy/MM/dd}  {1}  元伝票Id={2}">
											<Binding Converter="{StaticResource DateYmd8Converter}" Path="CurrentEdit.DenDay" />
											<Binding Converter="{StaticResource EnumCommentDisplayConverter}" Path="CurrentEdit.EnKubun" />
											<Binding Path="CurrentEdit.RelateNo1" />
										</MultiBinding>
									</TextBlock.Text>
								</TextBlock>

								<TextBlock Grid.Row="1"
									Style="{StaticResource FormLabel}"
									Text="倉庫→店舗" />
								<TextBlock Grid.Row="1" Grid.Column="1"
									VerticalAlignment="Center"
									TextWrapping="Wrap">
									<TextBlock.Text>
										<MultiBinding StringFormat="{}{0}:{1} → {2}:{3}">
											<Binding Path="CurrentEdit.Id_Soko" />
											<Binding Path="CurrentEdit.SokoName" />
											<Binding Path="CurrentEdit.Id_Tenpo" />
											<Binding Path="CurrentEdit.TenpoName" />
										</MultiBinding>
									</TextBlock.Text>
								</TextBlock>

								<TextBlock Grid.Row="2"
									Style="{StaticResource FormLabel}"
									Text="商品" />
								<TextBlock Grid.Row="2" Grid.Column="1"
									VerticalAlignment="Center"
									TextWrapping="Wrap">
									<TextBlock.Text>
										<MultiBinding StringFormat="{}{0} {1}  {2}/{3}">
											<Binding Path="CurrentEdit.ShohinCode" />
											<Binding Path="CurrentEdit.ShohinName" />
											<Binding Path="CurrentEdit.ColName" />
											<Binding Path="CurrentEdit.SizName" />
										</MultiBinding>
									</TextBlock.Text>
								</TextBlock>

								<TextBlock Grid.Row="3"
									Style="{StaticResource FormLabel}"
									Text="数量" />
								<TextBlock Grid.Row="3" Grid.Column="1"
									VerticalAlignment="Center">
									<TextBlock.Text>
										<MultiBinding StringFormat="{}指示数={0:N0}  入荷済み数={1:N0}">
											<Binding Path="CurrentEdit.Su" />
											<Binding Path="CurrentEdit.ArrivedSu" />
										</MultiBinding>
									</TextBlock.Text>
								</TextBlock>

								<Separator Grid.Row="4" Grid.ColumnSpan="2"
									Margin="0,8" />

								<!--  編集可能項目  -->
								<TextBlock Grid.Row="5"
									Style="{StaticResource FormLabel}"
									Text="納品日" />
								<TextBox Grid.Row="5" Grid.Column="1"
									Width="160"
									HorizontalAlignment="Left"
									materialDesign:HintAssist.Hint="yyyyMMdd"
									Style="{StaticResource FormTextBox}"
									Text="{Binding CurrentEdit.NouhinDay, UpdateSourceTrigger=PropertyChanged}" />

								<TextBlock Grid.Row="6"
									Style="{StaticResource FormLabel}"
									Text="確定日" />
								<TextBox Grid.Row="6" Grid.Column="1"
									Width="160"
									HorizontalAlignment="Left"
									materialDesign:HintAssist.Hint="空=未確定"
									Style="{StaticResource FormTextBox}"
									Text="{Binding CurrentEdit.KakuteiDay, UpdateSourceTrigger=PropertyChanged}" />

								<TextBlock Grid.Row="7"
									Style="{StaticResource FormLabel}"
									Text="実数量" />
								<TextBox Grid.Row="7" Grid.Column="1"
									Width="160"
									HorizontalAlignment="Left"
									materialDesign:HintAssist.Hint="実数量"
									Style="{StaticResource NumericFormTextBox}"
									Text="{Binding CurrentEdit.JitsuSu, UpdateSourceTrigger=PropertyChanged}" />

								<TextBlock Grid.Row="8"
									Style="{StaticResource FormLabel}"
									Text="欠品数" />
								<TextBox Grid.Row="8" Grid.Column="1"
									Width="160"
									HorizontalAlignment="Left"
									materialDesign:HintAssist.Hint="欠品数"
									Style="{StaticResource NumericFormTextBox}"
									Text="{Binding CurrentEdit.ShortSu, UpdateSourceTrigger=PropertyChanged}" />

								<TextBlock Grid.Row="9"
									Style="{StaticResource FormLabel}"
									Text="完了FLG" />
								<ComboBox Grid.Row="9" Grid.Column="1"
									Width="160"
									HorizontalAlignment="Left"
									DisplayMemberPath="Value"
									ItemsSource="{Binding EndFlagOptions}"
									SelectedValue="{Binding CurrentEdit.EndFlag, Mode=TwoWay}"
									SelectedValuePath="Key"
									Style="{StaticResource FormComboBox}" />

								<TextBlock Grid.Row="10"
									Style="{StaticResource FormLabel}"
									Text="完了理由" />
								<ComboBox Grid.Row="10" Grid.Column="1"
									Width="160"
									HorizontalAlignment="Left"
									DisplayMemberPath="Value"
									ItemsSource="{Binding EndReasonOptions}"
									SelectedValue="{Binding CurrentEdit.EndReason, Mode=TwoWay}"
									SelectedValuePath="Key"
									Style="{StaticResource FormComboBox}" />

								<TextBlock Grid.Row="11"
									Style="{StaticResource FormLabel}"
									Text="送信FLG" />
								<ComboBox Grid.Row="11" Grid.Column="1"
									Width="160"
									HorizontalAlignment="Left"
									DisplayMemberPath="Value"
									ItemsSource="{Binding SendFlgOptions}"
									SelectedValue="{Binding CurrentEdit.SendFlg, Mode=TwoWay}"
									SelectedValuePath="Key"
									Style="{StaticResource FormComboBox}" />

								<TextBlock Grid.Row="12"
									Style="{StaticResource FormLabel}"
									Text="関連No2" />
								<TextBox Grid.Row="12" Grid.Column="1"
									Width="160"
									HorizontalAlignment="Left"
									materialDesign:HintAssist.Hint="作成伝票Id"
									Style="{StaticResource NumericFormTextBox}"
									Text="{Binding CurrentEdit.RelateNo2, UpdateSourceTrigger=PropertyChanged}" />

								<TextBlock Grid.Row="13"
									Style="{StaticResource FormLabel}"
									Text="メモ" />
								<TextBox Grid.Row="13" Grid.Column="1"
									materialDesign:HintAssist.Hint="明細メモ" MaxLength="200"
									Style="{StaticResource FormTextBox}"
									Text="{Binding CurrentEdit.Memo, UpdateSourceTrigger=PropertyChanged}" />

								<TextBlock Grid.Row="14" Grid.ColumnSpan="2"
									Margin="0,12,0,0"
									Foreground="{DynamicResource MaterialDesignBody}"
									TextWrapping="Wrap">
									<TextBlock.Text>
										<MultiBinding StringFormat="{}登録日={0}  修正日={1}">
											<Binding Path="CurrentEdit.VdateC" />
											<Binding Path="CurrentEdit.VdateU" />
										</MultiBinding>
									</TextBlock.Text>
								</TextBlock>
							</Grid>
						</ScrollViewer>
					</TabItem>
				</TabControl>
			</materialDesign:Card>
		</Grid>
	</Grid>
</helpers:BaseWindow>
