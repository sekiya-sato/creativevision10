<helpers:BaseWindow x:Class="CvWpfclient.Views._07Haibun.HaibunShippingListReportView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:helpers="clr-namespace:CvWpfclient.Helpers"
	xmlns:local="clr-namespace:CvWpfclient.Views" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:vm="clr-namespace:CvWpfclient.ViewModels._07Haibun"
	Title="{Binding Title}"
	Width="900" Height="760"
	Background="{DynamicResource AppCommonBackgroundBrush}"
	FontSize="16"
	Foreground="{DynamicResource MaterialDesignBody}"
	TextOptions.TextFormattingMode="Display" WindowStartupLocation="CenterScreen"
	mc:Ignorable="d">
	<helpers:BaseWindow.DataContext>
		<vm:HaibunShippingListReportViewModel />
	</helpers:BaseWindow.DataContext>

	<helpers:BaseWindow.InputBindings>
		<KeyBinding Command="{Binding DoOutputPdfCommand}"
			Gesture="F6" />
		<KeyBinding Command="{Binding ExitCommand}"
			Gesture="Esc" />
	</helpers:BaseWindow.InputBindings>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<materialDesign:ColorZone Grid.Row="0"
			Padding="12,8"
			materialDesign:ElevationAssist.Elevation="Dp4" Mode="PrimaryMid">
			<StackPanel Orientation="Horizontal">
				<Button Margin="0,0,8,0"
					Command="{Binding ExitCommand}"
					Style="{StaticResource ToolCommandButton}"
					ToolTip="閉じる (Esc)">
					<materialDesign:PackIcon Kind="ArrowLeft" />
				</Button>
				<materialDesign:PackIcon Width="28" Height="28"
					VerticalAlignment="Center"
					Kind="Printer" />
				<TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
					FontSize="20" FontWeight="SemiBold"
					Text="{Binding Title}" />
			</StackPanel>
		</materialDesign:ColorZone>

		<ScrollViewer Grid.Row="1"
			VerticalScrollBarVisibility="Auto">
			<Grid Margin="24">
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="150" />
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" />
				</Grid.ColumnDefinitions>

				<!--  出力単位・ソートキー  -->
				<TextBlock Grid.Row="0" Grid.Column="0"
					Style="{StaticResource FormLabel}"
					Text="出力単位" />
				<StackPanel Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3"
					Orientation="Horizontal">
					<ComboBox Width="200"
						HorizontalAlignment="Left"
						ItemsSource="{Binding OutputUnitList}"
						SelectedItem="{Binding OutputUnit}"
						Style="{StaticResource FormComboBox}" />
					<TextBlock Margin="24,0,8,0" VerticalAlignment="Center"
						Text="ソートキー（伝票毎のみ）" />
					<ComboBox Width="160"
						HorizontalAlignment="Left" IsEnabled="{Binding IsSortKeyEnabled}"
						ItemsSource="{Binding SortKeyList}"
						SelectedItem="{Binding SortKey}"
						Style="{StaticResource FormComboBox}" />
				</StackPanel>

				<!--  区分・印刷区分  -->
				<TextBlock Grid.Row="1" Grid.Column="0"
					Style="{StaticResource FormLabel}"
					Text="区分" />
				<StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3"
					Orientation="Horizontal">
					<ComboBox Width="200"
						HorizontalAlignment="Left"
						DisplayMemberPath="Name"
						ItemsSource="{Binding KubunOptions}"
						SelectedValue="{Binding SelectedKubun}"
						SelectedValuePath="Value"
						Style="{StaticResource FormComboBox}" />
					<CheckBox Margin="24,0,0,0" VerticalAlignment="Center"
						Content="印刷区分：残のみ（未出荷）"
						IsChecked="{Binding ZanOnly}" />
				</StackPanel>

				<!--  配分指示日  -->
				<TextBlock Grid.Row="2" Grid.Column="0"
					Style="{StaticResource FormLabel}"
					Text="配分指示日" />
				<TextBox Grid.Row="2" Grid.Column="1"
					Width="200" Height="36"
					HorizontalAlignment="Left" HorizontalContentAlignment="Left"
					Style="{StaticResource MaterialDesignTextBox}"
					Text="{Binding DenDayFromText, UpdateSourceTrigger=PropertyChanged}" />
				<TextBlock Grid.Row="2" Grid.Column="2"
					Margin="8,0" VerticalAlignment="Center"
					Text="～" />
				<TextBox Grid.Row="2" Grid.Column="3"
					Width="200" Height="36"
					HorizontalAlignment="Left" HorizontalContentAlignment="Left"
					Style="{StaticResource MaterialDesignTextBox}"
					Text="{Binding DenDayToText, UpdateSourceTrigger=PropertyChanged}" />

				<!--  納品日  -->
				<TextBlock Grid.Row="3" Grid.Column="0"
					Style="{StaticResource FormLabel}"
					Text="納品日" />
				<TextBox Grid.Row="3" Grid.Column="1"
					Width="200" Height="36"
					HorizontalAlignment="Left" HorizontalContentAlignment="Left"
					Style="{StaticResource MaterialDesignTextBox}"
					Text="{Binding NouhinDayFromText, UpdateSourceTrigger=PropertyChanged}" />
				<TextBlock Grid.Row="3" Grid.Column="2"
					Margin="8,0" VerticalAlignment="Center"
					Text="～" />
				<TextBox Grid.Row="3" Grid.Column="3"
					Width="200" Height="36"
					HorizontalAlignment="Left" HorizontalContentAlignment="Left"
					Style="{StaticResource MaterialDesignTextBox}"
					Text="{Binding NouhinDayToText, UpdateSourceTrigger=PropertyChanged}" />

				<!--  倉庫  -->
				<TextBlock Grid.Row="4" Grid.Column="0"
					Style="{StaticResource FormLabel}"
					Text="倉庫" />
				<TextBox Grid.Row="4" Grid.Column="1"
					Width="200" Height="36"
					HorizontalAlignment="Left" HorizontalContentAlignment="Left"
					helpers:SearchTextBoxAssist.Command="{Binding SelectSokoFromCommand}"
					BorderThickness="0,0,0,1"
					Style="{StaticResource MenteSearchTextBox}"
					Text="{Binding SokoCodeFrom, UpdateSourceTrigger=PropertyChanged}" />
				<TextBlock Grid.Row="4" Grid.Column="2"
					Margin="8,0" VerticalAlignment="Center"
					Text="～" />
				<TextBox Grid.Row="4" Grid.Column="3"
					Width="200" Height="36"
					HorizontalAlignment="Left" HorizontalContentAlignment="Left"
					helpers:SearchTextBoxAssist.Command="{Binding SelectSokoToCommand}"
					BorderThickness="0,0,0,1"
					Style="{StaticResource MenteSearchTextBox}"
					Text="{Binding SokoCodeTo, UpdateSourceTrigger=PropertyChanged}" />

				<!--  得意先  -->
				<TextBlock Grid.Row="5" Grid.Column="0"
					Style="{StaticResource FormLabel}"
					Text="得意先" />
				<TextBox Grid.Row="5" Grid.Column="1"
					Width="200" Height="36"
					HorizontalAlignment="Left" HorizontalContentAlignment="Left"
					helpers:SearchTextBoxAssist.Command="{Binding SelectTokuiFromCommand}"
					BorderThickness="0,0,0,1"
					Style="{StaticResource MenteSearchTextBox}"
					Text="{Binding TokuiCodeFrom, UpdateSourceTrigger=PropertyChanged}" />
				<TextBlock Grid.Row="5" Grid.Column="2"
					Margin="8,0" VerticalAlignment="Center"
					Text="～" />
				<TextBox Grid.Row="5" Grid.Column="3"
					Width="200" Height="36"
					HorizontalAlignment="Left" HorizontalContentAlignment="Left"
					helpers:SearchTextBoxAssist.Command="{Binding SelectTokuiToCommand}"
					BorderThickness="0,0,0,1"
					Style="{StaticResource MenteSearchTextBox}"
					Text="{Binding TokuiCodeTo, UpdateSourceTrigger=PropertyChanged}" />

				<!--  商品  -->
				<TextBlock Grid.Row="6" Grid.Column="0"
					Style="{StaticResource FormLabel}"
					Text="商品" />
				<TextBox Grid.Row="6" Grid.Column="1"
					Width="200" Height="36"
					HorizontalAlignment="Left" HorizontalContentAlignment="Left"
					helpers:SearchTextBoxAssist.Command="{Binding SelectShohinFromCommand}"
					BorderThickness="0,0,0,1"
					Style="{StaticResource MenteSearchTextBox}"
					Text="{Binding ShohinCodeFrom, UpdateSourceTrigger=PropertyChanged}" />
				<TextBlock Grid.Row="6" Grid.Column="2"
					Margin="8,0" VerticalAlignment="Center"
					Text="～" />
				<TextBox Grid.Row="6" Grid.Column="3"
					Width="200" Height="36"
					HorizontalAlignment="Left" HorizontalContentAlignment="Left"
					helpers:SearchTextBoxAssist.Command="{Binding SelectShohinToCommand}"
					BorderThickness="0,0,0,1"
					Style="{StaticResource MenteSearchTextBox}"
					Text="{Binding ShohinCodeTo, UpdateSourceTrigger=PropertyChanged}" />

				<!--  ブランド  -->
				<TextBlock Grid.Row="7" Grid.Column="0"
					Style="{StaticResource FormLabel}"
					Text="ブランド" />
				<TextBox Grid.Row="7" Grid.Column="1"
					Width="200" Height="36"
					HorizontalAlignment="Left" HorizontalContentAlignment="Left"
					helpers:SearchTextBoxAssist.Command="{Binding SelectBrandFromCommand}"
					BorderThickness="0,0,0,1"
					Style="{StaticResource MenteSearchTextBox}"
					Text="{Binding BrandCodeFrom, UpdateSourceTrigger=PropertyChanged}" />
				<TextBlock Grid.Row="7" Grid.Column="2"
					Margin="8,0" VerticalAlignment="Center"
					Text="～" />
				<TextBox Grid.Row="7" Grid.Column="3"
					Width="200" Height="36"
					HorizontalAlignment="Left" HorizontalContentAlignment="Left"
					helpers:SearchTextBoxAssist.Command="{Binding SelectBrandToCommand}"
					BorderThickness="0,0,0,1"
					Style="{StaticResource MenteSearchTextBox}"
					Text="{Binding BrandCodeTo, UpdateSourceTrigger=PropertyChanged}" />

				<!--  アイテム  -->
				<TextBlock Grid.Row="8" Grid.Column="0"
					Style="{StaticResource FormLabel}"
					Text="アイテム" />
				<TextBox Grid.Row="8" Grid.Column="1"
					Width="200" Height="36"
					HorizontalAlignment="Left" HorizontalContentAlignment="Left"
					helpers:SearchTextBoxAssist.Command="{Binding SelectItemFromCommand}"
					BorderThickness="0,0,0,1"
					Style="{StaticResource MenteSearchTextBox}"
					Text="{Binding ItemCodeFrom, UpdateSourceTrigger=PropertyChanged}" />
				<TextBlock Grid.Row="8" Grid.Column="2"
					Margin="8,0" VerticalAlignment="Center"
					Text="～" />
				<TextBox Grid.Row="8" Grid.Column="3"
					Width="200" Height="36"
					HorizontalAlignment="Left" HorizontalContentAlignment="Left"
					helpers:SearchTextBoxAssist.Command="{Binding SelectItemToCommand}"
					BorderThickness="0,0,0,1"
					Style="{StaticResource MenteSearchTextBox}"
					Text="{Binding ItemCodeTo, UpdateSourceTrigger=PropertyChanged}" />

				<!--  展示会  -->
				<TextBlock Grid.Row="9" Grid.Column="0"
					Style="{StaticResource FormLabel}"
					Text="展示会" />
				<TextBox Grid.Row="9" Grid.Column="1"
					Width="200" Height="36"
					HorizontalAlignment="Left" HorizontalContentAlignment="Left"
					helpers:SearchTextBoxAssist.Command="{Binding SelectTenjiFromCommand}"
					BorderThickness="0,0,0,1"
					Style="{StaticResource MenteSearchTextBox}"
					Text="{Binding TenjiCodeFrom, UpdateSourceTrigger=PropertyChanged}" />
				<TextBlock Grid.Row="9" Grid.Column="2"
					Margin="8,0" VerticalAlignment="Center"
					Text="～" />
				<TextBox Grid.Row="9" Grid.Column="3"
					Width="200" Height="36"
					HorizontalAlignment="Left" HorizontalContentAlignment="Left"
					helpers:SearchTextBoxAssist.Command="{Binding SelectTenjiToCommand}"
					BorderThickness="0,0,0,1"
					Style="{StaticResource MenteSearchTextBox}"
					Text="{Binding TenjiCodeTo, UpdateSourceTrigger=PropertyChanged}" />

				<!--  メーカー  -->
				<TextBlock Grid.Row="10" Grid.Column="0"
					Style="{StaticResource FormLabel}"
					Text="メーカー" />
				<TextBox Grid.Row="10" Grid.Column="1"
					Width="200" Height="36"
					HorizontalAlignment="Left" HorizontalContentAlignment="Left"
					helpers:SearchTextBoxAssist.Command="{Binding SelectMakerFromCommand}"
					BorderThickness="0,0,0,1"
					Style="{StaticResource MenteSearchTextBox}"
					Text="{Binding MakerCodeFrom, UpdateSourceTrigger=PropertyChanged}" />
				<TextBlock Grid.Row="10" Grid.Column="2"
					Margin="8,0" VerticalAlignment="Center"
					Text="～" />
				<TextBox Grid.Row="10" Grid.Column="3"
					Width="200" Height="36"
					HorizontalAlignment="Left" HorizontalContentAlignment="Left"
					helpers:SearchTextBoxAssist.Command="{Binding SelectMakerToCommand}"
					BorderThickness="0,0,0,1"
					Style="{StaticResource MenteSearchTextBox}"
					Text="{Binding MakerCodeTo, UpdateSourceTrigger=PropertyChanged}" />

				<!--  注意書き  -->
				<StackPanel Grid.Row="11" Grid.Column="1" Grid.ColumnSpan="3"
					Margin="0,8">
					<TextBlock Foreground="{DynamicResource MaterialDesignValidationErrorBrush}"
						Text="※配分(TranHaibun)を対象に、出力単位ごとに集計してPDF出力します。マトリクス形式（色×サイズ、得意先×倉庫×色×サイズ）は対象外です。" TextWrapping="Wrap" />
					<TextBlock Foreground="{DynamicResource MaterialDesignValidationErrorBrush}"
						Text="※対象データが0件の場合は印刷を中止します。" TextWrapping="Wrap" />
				</StackPanel>

				<!--  実行ボタン  -->
				<StackPanel Grid.Row="12" Grid.Column="0" Grid.ColumnSpan="4"
					Margin="0,24" HorizontalAlignment="Center"
					Orientation="Horizontal">
					<Button Command="{Binding DoOutputPdfCommand}"
						Style="{StaticResource MaterialDesignFlatMidBgButton}"
						ToolTip="印刷 (F6)">
						<StackPanel Orientation="Horizontal">
							<materialDesign:PackIcon VerticalAlignment="Center"
								Kind="Printer" />
							<TextBlock Margin="8,0,0,0" VerticalAlignment="Center"
								FontSize="20" Text="印刷" />
						</StackPanel>
					</Button>
					<Button Margin="16,0,0,0"
						Command="{Binding ClearConditionsCommand}"
						Style="{StaticResource MaterialDesignOutlinedButton}">
						<TextBlock FontSize="16" Text="条件クリア" />
					</Button>
				</StackPanel>
			</Grid>
		</ScrollViewer>

		<Border Grid.Row="2"
			Padding="12,8"
			Background="{DynamicResource MaterialDesignPaper}">
			<TextBlock VerticalAlignment="Center"
				Text="{Binding Message}"
				TextWrapping="Wrap" />
		</Border>
	</Grid>
</helpers:BaseWindow>
