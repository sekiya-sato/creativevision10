<helpers:BaseWindow x:Class="CvWpfclient.Views.Sub.SelectShohinView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:helpers="clr-namespace:CvWpfclient.Helpers" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:vm="clr-namespace:CvWpfclient.ViewModels.Sub"
	Title="{Binding Title}"
	Width="980" Height="800"
	Background="{DynamicResource AppCommonBackgroundBrush}"
	FontSize="18"
	Foreground="{DynamicResource MaterialDesignBody}"
	TextOptions.TextFormattingMode="Display" WindowStartupLocation="CenterOwner"
	mc:Ignorable="d">
	<helpers:BaseWindow.DataContext>
		<vm:SelectShohinViewModel />
	</helpers:BaseWindow.DataContext>

	<helpers:BaseWindow.Resources>
		<Style x:Key="GridRightTextBlock"
			TargetType="TextBlock">
			<Setter Property="HorizontalAlignment" Value="Stretch" />
			<Setter Property="TextAlignment" Value="Right" />
		</Style>
	</helpers:BaseWindow.Resources>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<!--  Header: ColorZone Toolbar  -->
		<materialDesign:ColorZone Grid.Row="0"
			Padding="12,8"
			materialDesign:ElevationAssist.Elevation="Dp4" ClipToBounds="True" Mode="PrimaryMid">
			<StackPanel Orientation="Horizontal">
				<materialDesign:PackIcon Width="28" Height="28"
					VerticalAlignment="Center"
					Kind="DatabaseSearch" />
				<TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
					FontSize="20" FontWeight="SemiBold"
					Text="{Binding Title}" />
			</StackPanel>
		</materialDesign:ColorZone>

		<!--  Main Content  -->
		<Grid Grid.Row="1"
			Margin="16">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
			</Grid.RowDefinitions>

			<TextBlock Grid.Row="0"
				Margin="0,0,0,8"
				FontSize="18" FontWeight="Bold"
				Foreground="{DynamicResource MaterialDesignBody}"
				Text="{Binding Message}"
				TextWrapping="Wrap" />

			<!--  検索条件  -->
			<materialDesign:Card Grid.Row="1"
				Padding="12,12,12,0"
				materialDesign:ElevationAssist.Elevation="Dp2" UniformCornerRadius="8"
				Visibility="{Binding IsSearchMode, Converter={StaticResource BooleanToVisibilityConverter}}">
				<Grid Margin="2">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="150" />
						<ColumnDefinition Width="180" />
						<ColumnDefinition Width="40" />
						<ColumnDefinition Width="180" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>

					<TextBlock Grid.Row="0" Grid.Column="0"
						Style="{StaticResource FormLabel}"
						Text="商品Id" />
					<TextBox Grid.Row="0" Grid.Column="1"
						HorizontalContentAlignment="Right" VerticalContentAlignment="Center"
						materialDesign:HintAssist.Hint="商品Id (開始)"
						Style="{StaticResource FormTextBox}"
						Text="{Binding ShohinIdFrom, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
					<TextBlock Grid.Row="0" Grid.Column="2"
						HorizontalAlignment="Center"
						Style="{StaticResource FormLabel}"
						Text="-" />
					<TextBox Grid.Row="0" Grid.Column="3"
						HorizontalContentAlignment="Right" VerticalContentAlignment="Center"
						materialDesign:HintAssist.Hint="商品Id (終了)"
						Style="{StaticResource FormTextBox}"
						Text="{Binding ShohinIdTo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

					<TextBlock Grid.Row="1" Grid.Column="0"
						Style="{StaticResource FormLabel}"
						Text="商品CD" />
					<TextBox Grid.Row="1" Grid.Column="1"
						VerticalContentAlignment="Center"
						materialDesign:HintAssist.Hint="商品CD (開始)"
						Style="{StaticResource FormTextBox}"
						Text="{Binding ShohinCodeFrom, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
					<TextBlock Grid.Row="1" Grid.Column="2"
						HorizontalAlignment="Center"
						Style="{StaticResource FormLabel}"
						Text="-" />
					<TextBox Grid.Row="1" Grid.Column="3"
						VerticalContentAlignment="Center"
						materialDesign:HintAssist.Hint="商品CD (終了)"
						Style="{StaticResource FormTextBox}"
						Text="{Binding ShohinCodeTo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

					<TextBlock Grid.Row="2" Grid.Column="0"
						Style="{StaticResource FormLabel}"
						Text="ブランドId" />
					<DockPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="4"
						Margin="0,4">
						<Button Width="110" Height="36"
							Command="{Binding SelectBrandIdsCommand}"
							DockPanel.Dock="Left"
							Style="{StaticResource MaterialDesignRaisedButton}"
							ToolTip="ブランドIdを選択">
							<StackPanel Orientation="Horizontal">
								<materialDesign:PackIcon VerticalAlignment="Center"
									Kind="CheckboxMultipleMarkedOutline" />
								<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
									Text="選択" />
							</StackPanel>
						</Button>
						<Button Width="80" Height="36"
							Margin="8,0,0,0"
							Command="{Binding ClearBrandIdsCommand}"
							Content="解除" DockPanel.Dock="Right"
							Style="{StaticResource MaterialDesignFlatButton}"
							ToolTip="ブランドIdの選択を解除" />
						<TextBlock Style="{StaticResource SelectionResultText}"
							Text="{Binding BrandIdsText}"
							ToolTipService.InitialShowDelay="300">
							<TextBlock.ToolTip>
								<TextBlock MaxWidth="600"
									Text="{Binding BrandIdsText}"
									TextWrapping="Wrap" />
							</TextBlock.ToolTip>
						</TextBlock>
					</DockPanel>

					<TextBlock Grid.Row="3" Grid.Column="0"
						Style="{StaticResource FormLabel}"
						Text="アイテムId" />
					<DockPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="4"
						Margin="0,4">
						<Button Width="110" Height="36"
							Command="{Binding SelectItemIdsCommand}"
							DockPanel.Dock="Left"
							Style="{StaticResource MaterialDesignRaisedButton}"
							ToolTip="アイテムIdを選択">
							<StackPanel Orientation="Horizontal">
								<materialDesign:PackIcon VerticalAlignment="Center"
									Kind="CheckboxMultipleMarkedOutline" />
								<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
									Text="選択" />
							</StackPanel>
						</Button>
						<Button Width="80" Height="36"
							Margin="8,0,0,0"
							Command="{Binding ClearItemIdsCommand}"
							Content="解除" DockPanel.Dock="Right"
							Style="{StaticResource MaterialDesignFlatButton}"
							ToolTip="アイテムIdの選択を解除" />
						<TextBlock Style="{StaticResource SelectionResultText}"
							Text="{Binding ItemIdsText}"
							ToolTipService.InitialShowDelay="300">
							<TextBlock.ToolTip>
								<TextBlock MaxWidth="600"
									Text="{Binding ItemIdsText}"
									TextWrapping="Wrap" />
							</TextBlock.ToolTip>
						</TextBlock>
					</DockPanel>

					<TextBlock Grid.Row="4" Grid.Column="0"
						Style="{StaticResource FormLabel}"
						Text="商品名" />
					<TextBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="4"
						VerticalContentAlignment="Center"
						materialDesign:HintAssist.Hint="商品名 (部分一致)"
						Style="{StaticResource FormTextBox}"
						Text="{Binding ShohinName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

					<TextBlock Grid.Row="5" Grid.Column="0"
						Style="{StaticResource FormLabel}"
						Text="略称" />
					<TextBox Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="4"
						VerticalContentAlignment="Center"
						materialDesign:HintAssist.Hint="略称 (部分一致)"
						Style="{StaticResource FormTextBox}"
						Text="{Binding ShohinRyaku, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

					<TextBlock Grid.Row="6" Grid.Column="0"
						Style="{StaticResource FormLabel}"
						Text="カナ" />
					<TextBox Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="4"
						VerticalContentAlignment="Center"
						materialDesign:HintAssist.Hint="カナ (部分一致)"
						Style="{StaticResource FormTextBox}"
						Text="{Binding ShohinKana, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

					<TextBlock Grid.Row="7" Grid.Column="0"
						Style="{StaticResource FormLabel}"
						Text="JAN" />
					<TextBox Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="4"
						VerticalContentAlignment="Center"
						materialDesign:HintAssist.Hint="JAN (部分一致)"
						Style="{StaticResource FormTextBox}"
						Text="{Binding Jan, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

					<TextBlock Grid.Row="8" Grid.Column="0"
						Style="{StaticResource FormLabel}"
						Text="件数" />
					<TextBox Grid.Row="8" Grid.Column="1"
						HorizontalContentAlignment="Right" VerticalContentAlignment="Center"
						materialDesign:HintAssist.Hint="件数"
						Style="{StaticResource FormTextBox}"
						Text="{Binding MaxCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
					<TextBlock Grid.Row="8" Grid.Column="2" Grid.ColumnSpan="3"
						Margin="8,0,0,0" VerticalAlignment="Center"
						Foreground="{DynamicResource MaterialDesignBodyLight}"
						Text="(空白:全件取得)" />

					<TextBlock Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="5"
						Margin="0,8,0,0"
						Foreground="{DynamicResource MaterialDesignBodyLight}"
						Text="条件を指定しない場合、すべての商品が対象になります。" TextWrapping="Wrap" />
				</Grid>
			</materialDesign:Card>

			<!--  商品一覧  -->
			<materialDesign:Card Grid.Row="1"
				Padding="0"
				materialDesign:ElevationAssist.Elevation="Dp2" UniformCornerRadius="8"
				Visibility="{Binding IsResultMode, Converter={StaticResource BooleanToVisibilityConverter}}">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
					</Grid.RowDefinitions>

					<Border Grid.Row="0"
						Padding="12,8"
						Background="{DynamicResource MaterialDesignToolBarBackground}"
						CornerRadius="8,8,0,0">
						<DockPanel>
							<TextBlock VerticalAlignment="Center"
								DockPanel.Dock="Right"
								Foreground="{DynamicResource MaterialDesignBodyLight}"
								Text="{Binding Count, StringFormat={}件数: {0:N0}}" />
							<TextBlock VerticalAlignment="Center"
								Foreground="{DynamicResource MaterialDesignBodyLight}"
								Text="商品一覧" />
						</DockPanel>
					</Border>

					<DataGrid x:Name="SelectGrid"
						Grid.Row="1"
						d:ItemsSource="{d:SampleData ItemCount=5}"
						helpers:DataGridDoubleClick.Command="{Binding DoSelectCommand}"
						helpers:DataGridEnterCommand.TargetButton="{Binding ElementName=DefaultButton}"
						helpers:DataGridSelectionBehavior.AutoScrollToSelectedItem="True" materialDesign:DataGridAssist.CellPadding="12,6" materialDesign:DataGridAssist.ColumnHeaderPadding="12,8"
						AutoGenerateColumns="False" EnableRowVirtualization="True" FrozenColumnCount="2" GridLinesVisibility="Horizontal"
						HorizontalGridLinesBrush="{DynamicResource MaterialDesignDivider}"
						IsReadOnly="True"
						ItemsSource="{Binding ListData}"
						SelectedItem="{Binding Current, Mode=TwoWay}"
						SelectionMode="Single"
						Style="{StaticResource MaterialDesignDataGrid}"
						VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
						<DataGrid.ColumnHeaderStyle>
							<Style BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}"
								TargetType="DataGridColumnHeader">
								<Setter Property="HorizontalContentAlignment" Value="Center" />
								<Setter Property="FontWeight" Value="SemiBold" />
								<Setter Property="Background" Value="{DynamicResource MaterialDesignToolBarBackground}" />
							</Style>
						</DataGrid.ColumnHeaderStyle>
						<DataGrid.Columns>
							<DataGridTextColumn Width="80"
								Binding="{Binding Id}"
								Header="Id" />
							<DataGridTextColumn Width="130"
								Binding="{Binding Code}"
								Header="商品CD" />
							<DataGridTextColumn Width="260"
								Binding="{Binding Name}"
								Header="商品名" />
							<DataGridTextColumn Width="90"
								Binding="{Binding TankaJodai, StringFormat={}{0:N0}}"
								ElementStyle="{StaticResource GridRightTextBlock}"
								Header="上代" />
							<DataGridTextColumn Width="180"
								Binding="{Binding BrandDisplay}"
								Header="ブランド" />
							<DataGridTextColumn Width="180"
								Binding="{Binding ItemDisplay}"
								Header="アイテム" />
						</DataGrid.Columns>
					</DataGrid>
				</Grid>
			</materialDesign:Card>
		</Grid>

		<!--  検索条件モードの操作ボタン  -->
		<StackPanel Grid.Row="2"
			Margin="0,0,16,16" HorizontalAlignment="Right"
			Orientation="Horizontal"
			Visibility="{Binding IsSearchMode, Converter={StaticResource BooleanToVisibilityConverter}}">
			<Button Width="150" Height="38"
				Margin="0,0,8,0"
				Command="{Binding SearchOrCommitCommand}"
				IsDefault="True"
				Style="{StaticResource MaterialDesignRaisedButton}"
				ToolTip="{Binding SearchActionText, StringFormat={}{0} (Enter)}">
				<StackPanel Orientation="Horizontal">
					<materialDesign:PackIcon VerticalAlignment="Center"
						Kind="CheckCircle" />
					<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
						FontSize="16"
						Text="{Binding SearchActionText}" />
				</StackPanel>
			</Button>
			<Button Width="140" Height="38"
				Command="{Binding ExitCommand}"
				IsCancel="True"
				Style="{StaticResource MaterialDesignFlatButton}"
				ToolTip="戻る (Esc)">
				<StackPanel Orientation="Horizontal">
					<materialDesign:PackIcon VerticalAlignment="Center"
						Kind="ArrowLeft" />
					<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
						FontSize="16" Text="戻る" />
				</StackPanel>
			</Button>
		</StackPanel>

		<!--  商品一覧モードの操作ボタン  -->
		<StackPanel Grid.Row="2"
			Margin="0,0,16,16" HorizontalAlignment="Right"
			Orientation="Horizontal"
			Visibility="{Binding IsResultMode, Converter={StaticResource BooleanToVisibilityConverter}}">
			<Button x:Name="DefaultButton"
				Width="150" Height="38"
				Margin="0,0,8,0"
				Command="{Binding DoSelectCommand}"
				IsDefault="True"
				Style="{StaticResource MaterialDesignRaisedButton}"
				ToolTip="選択 (Enter)">
				<StackPanel Orientation="Horizontal">
					<materialDesign:PackIcon VerticalAlignment="Center"
						Kind="CheckCircle" />
					<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
						FontSize="16" Text="選択" />
				</StackPanel>
			</Button>
			<Button Width="140" Height="38"
				Command="{Binding BackCommand}"
				Style="{StaticResource MaterialDesignFlatButton}"
				ToolTip="検索条件へ戻る">
				<StackPanel Orientation="Horizontal">
					<materialDesign:PackIcon VerticalAlignment="Center"
						Kind="ArrowLeft" />
					<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
						FontSize="16" Text="戻る" />
				</StackPanel>
			</Button>
		</StackPanel>
	</Grid>
</helpers:BaseWindow>
