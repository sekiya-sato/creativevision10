<helpers:BaseWindow x:Class="CvWpfclient.Views.Sub.SelectShohinView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:helpers="clr-namespace:CvWpfclient.Helpers" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:vm="clr-namespace:CvWpfclient.ViewModels.Sub"
	Title="{Binding Title}"
	Width="980" Height="680"
	Background="{DynamicResource AppCommonBackgroundBrush}"
	Foreground="{DynamicResource MaterialDesignBody}"
	TextOptions.TextFormattingMode="Display"
	mc:Ignorable="d">
	<helpers:BaseWindow.DataContext>
		<vm:SelectShohinViewModel />
	</helpers:BaseWindow.DataContext>

	<helpers:BaseWindow.Resources>
		<BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />

		<Style x:Key="ConditionLabel"
			TargetType="TextBlock">
			<Setter Property="Margin" Value="0,0,0,4" />
			<Setter Property="FontSize" Value="13" />
			<Setter Property="Foreground" Value="{DynamicResource MaterialDesignBodyLight}" />
		</Style>

		<Style x:Key="ConditionSearchTextBox"
			BasedOn="{StaticResource SearchTextBox}"
			TargetType="{x:Type TextBox}">
			<Setter Property="Width" Value="130" />
			<Setter Property="Height" Value="34" />
			<Setter Property="Background" Value="White" />
			<Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}" />
			<Setter Property="helpers:SearchTextBoxAssist.ButtonBackground" Value="{DynamicResource SearchButtonBackgroundBrush}" />
		</Style>

		<Style x:Key="SearchTextBoxStyle"
			BasedOn="{StaticResource MaterialDesignTextBox}"
			TargetType="TextBox">
			<Setter Property="Height" Value="34" />
			<Setter Property="Padding" Value="8,0" />
			<Setter Property="VerticalContentAlignment" Value="Center" />
			<Setter Property="Background" Value="White" />
			<Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}" />
		</Style>

		<Style x:Key="GridRightTextBlock"
			TargetType="TextBlock">
			<Setter Property="HorizontalAlignment" Value="Stretch" />
			<Setter Property="TextAlignment" Value="Right" />
		</Style>
	</helpers:BaseWindow.Resources>

	<Grid Background="{DynamicResource AppCommonBackgroundBrush}">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<materialDesign:ColorZone Grid.Row="0"
			Padding="12,8"
			materialDesign:ElevationAssist.Elevation="Dp4" Mode="PrimaryMid">
			<DockPanel>
				<StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
					<Button MinWidth="110"
						Command="{Binding SearchOrCommitCommand}"
						Style="{StaticResource MaterialDesignToolForegroundButton}"
						Visibility="{Binding IsSearchMode, Converter={StaticResource BoolToVisibilityConverter}}">
						<StackPanel Orientation="Horizontal">
							<materialDesign:PackIcon Margin="0,0,6,0" VerticalAlignment="Center"
								Kind="FormatListBulleted" />
							<TextBlock Text="{Binding SearchActionText}" />
						</StackPanel>
					</Button>
					<Button x:Name="DefaultButton"
						MinWidth="96"
						Command="{Binding DoSelectCommand}"
						IsDefault="True"
						Style="{StaticResource MaterialDesignToolForegroundButton}"
						Visibility="{Binding IsResultMode, Converter={StaticResource BoolToVisibilityConverter}}">
						<StackPanel Orientation="Horizontal">
							<materialDesign:PackIcon Margin="0,0,6,0" VerticalAlignment="Center"
								Kind="Check" />
							<TextBlock Text="選択" />
						</StackPanel>
					</Button>
				</StackPanel>

				<StackPanel Orientation="Horizontal">
					<Button Margin="0,0,8,0"
						Command="{Binding ExitCommand}"
						IsCancel="True"
						Style="{StaticResource MaterialDesignToolForegroundButton}"
						ToolTip="閉じる">
						<materialDesign:PackIcon Kind="ArrowLeft" />
					</Button>
					<TextBlock VerticalAlignment="Center"
						FontSize="20" FontWeight="SemiBold"
						Text="{Binding Title}" />
					<TextBlock Margin="24,0,0,0" VerticalAlignment="Center"
						FontSize="14" Opacity="0.75"
						Text="{Binding Message}" />
				</StackPanel>
			</DockPanel>
		</materialDesign:ColorZone>

		<Border Grid.Row="1"
			Padding="12,6"
			Background="{DynamicResource MaterialDesignToolBarBackground}">
			<DockPanel>
				<TextBlock VerticalAlignment="Center"
					DockPanel.Dock="Right"
					Foreground="{DynamicResource MaterialDesignBodyLight}"
					Text="{Binding Count, StringFormat={}候補: {0:N0}}"
					Visibility="{Binding IsResultMode, Converter={StaticResource BoolToVisibilityConverter}}" />
				<StackPanel Orientation="Horizontal">
					<TextBlock Foreground="{DynamicResource MaterialDesignBodyLight}"
						Text="商品検索・選択" />
					<TextBlock Margin="16,0,0,0"
						Foreground="{DynamicResource MaterialDesignBodyLight}"
						Text="検索条件を入力し、一覧から商品を選択します" />
				</StackPanel>
			</DockPanel>
		</Border>

		<Grid Grid.Row="2"
			Margin="12">
			<materialDesign:Card Padding="18"
				materialDesign:ElevationAssist.Elevation="Dp2" UniformCornerRadius="8"
				Visibility="{Binding IsSearchMode, Converter={StaticResource BoolToVisibilityConverter}}">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>

					<TextBlock Grid.Row="0"
						Margin="0,0,0,16"
						FontSize="18" FontWeight="SemiBold"
						Foreground="{DynamicResource MaterialDesignBody}"
						Text="検索条件" />

					<ScrollViewer Grid.Row="1"
						HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
						<Grid>
							<Grid.RowDefinitions>
								<RowDefinition Height="Auto" />
								<RowDefinition Height="Auto" />
								<RowDefinition Height="Auto" />
								<RowDefinition Height="Auto" />
								<RowDefinition Height="Auto" />
								<RowDefinition Height="Auto" />
							</Grid.RowDefinitions>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="150" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>

							<TextBlock Grid.Row="0" Grid.Column="0"
								VerticalAlignment="Center"
								Style="{StaticResource ConditionLabel}"
								Text="商品Id" />
							<Grid Grid.Row="0" Grid.Column="1"
								Margin="0,0,0,12"
								HorizontalAlignment="Left">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="140" />
									<ColumnDefinition Width="46" />
									<ColumnDefinition Width="140" />
								</Grid.ColumnDefinitions>
								<TextBox Grid.Column="0"
									HorizontalContentAlignment="Right"
									Style="{StaticResource SearchTextBoxStyle}"
									Text="{Binding ShohinIdFrom, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
								<TextBlock Grid.Column="1"
									HorizontalAlignment="Center" VerticalAlignment="Center"
									FontSize="16" Text="～" TextAlignment="Center" />
								<TextBox Grid.Column="2"
									HorizontalContentAlignment="Right"
									Style="{StaticResource SearchTextBoxStyle}"
									Text="{Binding ShohinIdTo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
							</Grid>

							<TextBlock Grid.Row="1" Grid.Column="0"
								VerticalAlignment="Center"
								Style="{StaticResource ConditionLabel}"
								Text="商品CD" />
							<Grid Grid.Row="1" Grid.Column="1"
								Margin="0,0,0,12"
								HorizontalAlignment="Left">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="180" />
									<ColumnDefinition Width="46" />
									<ColumnDefinition Width="180" />
								</Grid.ColumnDefinitions>
								<TextBox Grid.Column="0"
									Style="{StaticResource SearchTextBoxStyle}"
									Text="{Binding ShohinCodeFrom, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
								<TextBlock Grid.Column="1"
									HorizontalAlignment="Center" VerticalAlignment="Center"
									FontSize="16" Text="～" TextAlignment="Center" />
								<TextBox Grid.Column="2"
									Style="{StaticResource SearchTextBoxStyle}"
									Text="{Binding ShohinCodeTo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
							</Grid>

							<TextBlock Grid.Row="2" Grid.Column="0"
								VerticalAlignment="Center"
								Style="{StaticResource ConditionLabel}"
								Text="ブランドID" />
							<DockPanel Grid.Row="2" Grid.Column="1"
								Margin="0,0,0,12"
								LastChildFill="True">
								<Button Width="112" Height="34"
									Command="{Binding SelectBrandIdsCommand}"
									DockPanel.Dock="Left"
									Style="{StaticResource MaterialDesignRaisedButton}">
									<StackPanel Orientation="Horizontal">
										<materialDesign:PackIcon VerticalAlignment="Center"
											Kind="CheckboxMultipleMarkedOutline" />
										<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
											Text="選択" />
									</StackPanel>
								</Button>
								<Button Width="80" Height="34"
									Margin="8,0,0,0"
									Command="{Binding ClearBrandIdsCommand}"
									Content="解除" DockPanel.Dock="Right"
									Style="{StaticResource MaterialDesignFlatButton}" />
								<TextBlock Margin="12,0,8,0" VerticalAlignment="Center"
									Foreground="{DynamicResource MaterialDesignBody}"
									Text="{Binding BrandIdsText}"
									TextTrimming="CharacterEllipsis"
									ToolTip="{Binding BrandIdsText}" />
							</DockPanel>

							<TextBlock Grid.Row="3" Grid.Column="0"
								VerticalAlignment="Center"
								Style="{StaticResource ConditionLabel}"
								Text="アイテムID" />
							<DockPanel Grid.Row="3" Grid.Column="1"
								Margin="0,0,0,12"
								LastChildFill="True">
								<Button Width="112" Height="34"
									Command="{Binding SelectItemIdsCommand}"
									DockPanel.Dock="Left"
									Style="{StaticResource MaterialDesignRaisedButton}">
									<StackPanel Orientation="Horizontal">
										<materialDesign:PackIcon VerticalAlignment="Center"
											Kind="CheckboxMultipleMarkedOutline" />
										<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
											Text="選択" />
									</StackPanel>
								</Button>
								<Button Width="80" Height="34"
									Margin="8,0,0,0"
									Command="{Binding ClearItemIdsCommand}"
									Content="解除" DockPanel.Dock="Right"
									Style="{StaticResource MaterialDesignFlatButton}" />
								<TextBlock Margin="12,0,8,0" VerticalAlignment="Center"
									Foreground="{DynamicResource MaterialDesignBody}"
									Text="{Binding ItemIdsText}"
									TextTrimming="CharacterEllipsis"
									ToolTip="{Binding ItemIdsText}" />
							</DockPanel>

							<TextBlock Grid.Row="4" Grid.Column="0"
								VerticalAlignment="Center"
								Style="{StaticResource ConditionLabel}"
								Text="商品名（部分一致）" />
							<TextBox Grid.Row="4" Grid.Column="1"
								Margin="0,0,0,12"
								Style="{StaticResource SearchTextBoxStyle}"
								Text="{Binding ShohinName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

							<TextBlock Grid.Row="5" Grid.Column="0"
								VerticalAlignment="Center"
								Style="{StaticResource ConditionLabel}"
								Text="JAN（部分一致）" />
							<TextBox Grid.Row="5" Grid.Column="1"
								Style="{StaticResource SearchTextBoxStyle}"
								Text="{Binding Jan, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
						</Grid>
					</ScrollViewer>

					<DockPanel Grid.Row="2"
						Margin="0,18,0,0">
						<StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
							<Button MinWidth="104"
								Margin="0,0,8,0"
								Command="{Binding ExitCommand}"
								Style="{StaticResource MaterialDesignOutlinedButton}">
								<StackPanel Orientation="Horizontal">
									<materialDesign:PackIcon Margin="0,0,6,0" VerticalAlignment="Center"
										Kind="ArrowLeft" />
									<TextBlock Text="戻る" />
								</StackPanel>
							</Button>
							<Button MinWidth="128"
								Command="{Binding SearchOrCommitCommand}"
								Style="{StaticResource MaterialDesignRaisedButton}">
								<StackPanel Orientation="Horizontal">
									<materialDesign:PackIcon Margin="0,0,6,0" VerticalAlignment="Center"
										Kind="FormatListBulleted" />
									<TextBlock Text="{Binding SearchActionText}" />
								</StackPanel>
							</Button>
						</StackPanel>
					</DockPanel>
				</Grid>
			</materialDesign:Card>

			<materialDesign:Card Padding="0"
				materialDesign:ElevationAssist.Elevation="Dp2" UniformCornerRadius="8"
				Visibility="{Binding IsResultMode, Converter={StaticResource BoolToVisibilityConverter}}">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>

					<Border Grid.Row="0"
						Padding="12,8"
						Background="{DynamicResource MaterialDesignToolBarBackground}"
						CornerRadius="8,8,0,0">
						<DockPanel>
							<TextBlock VerticalAlignment="Center"
								DockPanel.Dock="Right"
								Foreground="{DynamicResource MaterialDesignBodyLight}"
								Text="{Binding Count, StringFormat={}件数: {0:N0}}" />
							<TextBlock VerticalAlignment="Center"
								Foreground="{DynamicResource MaterialDesignBodyLight}"
								Text="商品一覧" />
						</DockPanel>
					</Border>

					<DataGrid x:Name="SelectGrid"
						Grid.Row="1"
						d:ItemsSource="{d:SampleData ItemCount=5}"
						helpers:DataGridDoubleClick.Command="{Binding DoSelectCommand}"
						helpers:DataGridEnterCommand.TargetButton="{Binding ElementName=DefaultButton}"
						helpers:DataGridSelectionBehavior.AutoScrollToSelectedItem="True" materialDesign:DataGridAssist.CellPadding="12,6" materialDesign:DataGridAssist.ColumnHeaderPadding="12,8"
						AutoGenerateColumns="False" EnableRowVirtualization="True" FrozenColumnCount="2" GridLinesVisibility="Horizontal"
						HorizontalGridLinesBrush="{DynamicResource MaterialDesignDivider}"
						IsReadOnly="True"
						ItemsSource="{Binding ListData}"
						SelectedItem="{Binding Current, Mode=TwoWay}"
						SelectionMode="Single"
						Style="{StaticResource MaterialDesignDataGrid}"
						VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
						<DataGrid.ColumnHeaderStyle>
							<Style BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}"
								TargetType="DataGridColumnHeader">
								<Setter Property="HorizontalContentAlignment" Value="Center" />
								<Setter Property="FontWeight" Value="SemiBold" />
								<Setter Property="Background" Value="{DynamicResource MaterialDesignToolBarBackground}" />
							</Style>
						</DataGrid.ColumnHeaderStyle>
						<DataGrid.Columns>
							<DataGridTextColumn Width="80"
								Binding="{Binding Id}"
								Header="Id" />
							<DataGridTextColumn Width="130"
								Binding="{Binding Code}"
								Header="商品CD" />
							<DataGridTextColumn Width="260"
								Binding="{Binding Name}"
								Header="商品名" />
							<DataGridTextColumn Width="90"
								Binding="{Binding TankaJodai, StringFormat={}{0:N0}}"
								ElementStyle="{StaticResource GridRightTextBlock}"
								Header="上代" />
							<DataGridTextColumn Width="180"
								Binding="{Binding BrandDisplay}"
								Header="ブランド" />
							<DataGridTextColumn Width="180"
								Binding="{Binding ItemDisplay}"
								Header="アイテム" />
						</DataGrid.Columns>
					</DataGrid>

					<DockPanel Grid.Row="2"
						Margin="12"
						LastChildFill="False">
						<StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
							<Button MinWidth="104"
								Margin="0,0,8,0"
								Command="{Binding BackCommand}"
								Style="{StaticResource MaterialDesignOutlinedButton}">
								<StackPanel Orientation="Horizontal">
									<materialDesign:PackIcon Margin="0,0,6,0" VerticalAlignment="Center"
										Kind="ArrowLeft" />
									<TextBlock Text="戻る" />
								</StackPanel>
							</Button>
							<Button MinWidth="104"
								Command="{Binding DoSelectCommand}"
								Style="{StaticResource MaterialDesignRaisedButton}">
								<StackPanel Orientation="Horizontal">
									<materialDesign:PackIcon Margin="0,0,6,0" VerticalAlignment="Center"
										Kind="Check" />
									<TextBlock Text="選択" />
								</StackPanel>
							</Button>
						</StackPanel>
					</DockPanel>
				</Grid>
			</materialDesign:Card>
		</Grid>
	</Grid>
</helpers:BaseWindow>
