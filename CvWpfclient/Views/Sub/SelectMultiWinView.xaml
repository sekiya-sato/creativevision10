<helpers:BaseWindow x:Class="CvWpfclient.Views.Sub.SelectMultiWinView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:helpers="clr-namespace:CvWpfclient.Helpers"
	xmlns:local="clr-namespace:CvWpfclient.Views" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:vm="clr-namespace:CvWpfclient.ViewModels.Sub"
	Title="{Binding Title}"
	Width="660" Height="540"
	helpers:OwnerWindowPlacement.IsEnabled="True" helpers:OwnerWindowPlacement.LeftOffset="-40" helpers:OwnerWindowPlacement.TopOffset="-20" BorderBrush="DarkSlateGray"
	BorderThickness="0.5,0,1.5,1.5" FontSize="18" WindowStartupLocation="Manual"
	mc:Ignorable="d">
	<helpers:BaseWindow.DataContext>
		<vm:SelectMultiWinViewModel />
	</helpers:BaseWindow.DataContext>
	<Grid Background="{DynamicResource AppCommonBackgroundBrush}">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>
		<materialDesign:ColorZone Grid.Row="0"
			Padding="12,8"
			materialDesign:ElevationAssist.Elevation="Dp4" Mode="PrimaryMid">
			<DockPanel LastChildFill="True">
				<StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
					<Button MinWidth="150"
						Command="{Binding ChangeDisplayConditionCommand}"
						IsEnabled="{Binding IsDisplayConditionChangeEnabled}"
						Style="{StaticResource ToolCommandButton}">
						<StackPanel Orientation="Horizontal">
							<materialDesign:PackIcon VerticalAlignment="Center"
								Kind="FilterVariant" />
							<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
								Text="表示条件変更" />
						</StackPanel>
					</Button>
					<Button Margin="8,0,0,0"
						Command="{Binding SelectAllCommand}"
						Style="{StaticResource ToolCommandButton}">
						<StackPanel Orientation="Horizontal">
							<materialDesign:PackIcon VerticalAlignment="Center"
								Kind="CheckboxMultipleMarkedOutline" />
							<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
								Text="全選択" />
						</StackPanel>
					</Button>
					<Button Margin="4,0,0,0"
						Command="{Binding ClearSelectionCommand}"
						Style="{StaticResource ToolCommandButton}">
						<StackPanel Orientation="Horizontal">
							<materialDesign:PackIcon VerticalAlignment="Center"
								Kind="CheckboxMultipleBlankOutline" />
							<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
								Text="解除" />
						</StackPanel>
					</Button>
					<Button x:Name="DefaultButton"
						Margin="12,0,0,0"
						Command="{Binding DoSelectCommand}"
						IsDefault="True"
						Style="{StaticResource ToolCommandButton}">
						<StackPanel Background="DarkGray" Orientation="Horizontal">
							<materialDesign:PackIcon VerticalAlignment="Center"
								Kind="Check" />
							<TextBlock Margin="6" VerticalAlignment="Center"
								Text="選択" />
						</StackPanel>
					</Button>
				</StackPanel>
				<Grid MinWidth="0">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>
					<Button Grid.Column="0"
						Margin="0,0,8,0"
						Command="{Binding ExitCommand}"
						IsCancel="True"
						Style="{StaticResource ToolCommandButton}"
						ToolTip="閉じる">
						<materialDesign:PackIcon Kind="ArrowLeft" />
					</Button>
					<TextBlock Grid.Column="1"
						MinWidth="0"
						VerticalAlignment="Center"
						FontSize="20" FontWeight="SemiBold"
						Text="{Binding Title}"
						TextTrimming="CharacterEllipsis" />
					<TextBlock Grid.Column="2"
						Margin="32,0,0,0" VerticalAlignment="Center"
						FontSize="14" Opacity="0.75"
						Text="{Binding Count, StringFormat={}件数 {0:N0}}" />
					<TextBlock Grid.Column="3"
						Margin="16,0,12,0" VerticalAlignment="Center"
						FontSize="14" Opacity="0.75"
						Text="{Binding SelectedCount, StringFormat={}選択 {0:N0}}" />
				</Grid>
			</DockPanel>
		</materialDesign:ColorZone>
		<Grid Grid.Row="1"
			Margin="12">
			<materialDesign:Card Padding="0"
				materialDesign:ElevationAssist.Elevation="Dp2" UniformCornerRadius="8">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
					</Grid.RowDefinitions>
					<Border Grid.Row="0"
						Padding="12,6"
						Background="{DynamicResource MaterialDesignToolBarBackground}"
						CornerRadius="8,8,0,0">
						<StackPanel Orientation="Vertical">
							<!--  選択中マスタは「(Id) コード 名称」の共通表示で1行にまとめる  -->
							<TextBlock MinWidth="0"
								Foreground="{DynamicResource MaterialDesignBodyLight}"
								TextTrimming="CharacterEllipsis">
								<TextBlock.Text>
									<MultiBinding Converter="{StaticResource IdCodeNameDisplayConverter}">
										<Binding Path="Current.Id" />
										<Binding Path="Current.Code" />
										<Binding Path="Current.Name" />
									</MultiBinding>
								</TextBlock.Text>
							</TextBlock>
							<TextBlock MinWidth="0"
								Foreground="{DynamicResource MaterialDesignBodyLight}"
								Text="{Binding Current.Desc0}"
								TextTrimming="CharacterEllipsis" />
						</StackPanel>
					</Border>
					<DataGrid x:Name="SelectGrid"
						Grid.Row="1"
						d:ItemsSource="{d:SampleData ItemCount=5}"
						helpers:DataGridEnterCommand.TargetButton="{Binding ElementName=DefaultButton}"
						helpers:DataGridSelectionBehavior.AutoScrollToSelectedItem="True" helpers:DataGridSelectionBehavior.FocusOnSelectionMessage="True" materialDesign:DataGridAssist.CellPadding="12,6"
						materialDesign:DataGridAssist.ColumnHeaderPadding="12,8" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" FrozenColumnCount="1"
						GridLinesVisibility="Horizontal"
						HorizontalGridLinesBrush="{DynamicResource MaterialDesignDivider}"
						IsSynchronizedWithCurrentItem="True"
						ItemsSource="{Binding ListData}"
						RowHeight="35"
						SelectedItem="{Binding Current}"
						SelectionMode="Single"
						Style="{StaticResource MaterialDesignDataGrid}"
						VerticalScrollBarVisibility="Visible">
						<DataGrid.InputBindings>
							<KeyBinding Key="Space"
								Command="{Binding ToggleCurrentCommand}" />
						</DataGrid.InputBindings>
						<DataGrid.ColumnHeaderStyle>
							<Style BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}"
								TargetType="{x:Type DataGridColumnHeader}">
								<Setter Property="Background" Value="{DynamicResource PrimaryHueMidBrush}" />
								<Setter Property="Foreground" Value="{DynamicResource PrimaryHueMidForegroundBrush}" />
								<Setter Property="Padding" Value="12,8" />
								<Setter Property="FontWeight" Value="SemiBold" />
							</Style>
						</DataGrid.ColumnHeaderStyle>
						<DataGrid.Columns>
							<DataGridTemplateColumn Width="55"
								CanUserReorder="False" CanUserResize="False" CanUserSort="False" Header="選択">
								<DataGridTemplateColumn.CellTemplate>
									<DataTemplate>
										<CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
											IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
											Style="{StaticResource MaterialDesignCheckBox}" />
									</DataTemplate>
								</DataGridTemplateColumn.CellTemplate>
							</DataGridTemplateColumn>
							<DataGridTextColumn x:Name="Col00"
								Width="60"
								Binding="{Binding Path=Id}"
								CanUserReorder="True" CanUserResize="True" CanUserSort="True" Header="      Id" IsReadOnly="True">
								<DataGridTextColumn.ElementStyle>
									<Style TargetType="{x:Type TextBlock}">
										<Setter Property="TextAlignment" Value="Right" />
									</Style>
								</DataGridTextColumn.ElementStyle>
							</DataGridTextColumn>
							<DataGridTextColumn x:Name="Col01"
								Width="{Binding DisplayWidthCode}"
								d:Width="80"
								Binding="{Binding Path=Code}"
								CanUserReorder="True" CanUserResize="True" CanUserSort="True" IsReadOnly="True">
								<DataGridTextColumn.HeaderTemplate>
									<DataTemplate>
										<TextBlock Text="{Binding DataContext.DisplayNameCode, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
									</DataTemplate>
								</DataGridTextColumn.HeaderTemplate>
							</DataGridTextColumn>
							<DataGridTextColumn x:Name="Col02"
								Width="{Binding DisplayWidthName}"
								d:Width="280"
								Binding="{Binding Path=Name}"
								CanUserReorder="True" CanUserResize="True" CanUserSort="True" IsReadOnly="True">
								<DataGridTextColumn.HeaderTemplate>
									<DataTemplate>
										<TextBlock Text="{Binding DataContext.DisplayNameName, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
									</DataTemplate>
								</DataGridTextColumn.HeaderTemplate>
							</DataGridTextColumn>
							<DataGridTextColumn x:Name="Col03"
								Width="{Binding DisplayWidthRyaku}"
								d:Width="120"
								Binding="{Binding Path=Ryaku}"
								CanUserReorder="True" CanUserResize="True" CanUserSort="True" IsReadOnly="True">
								<DataGridTextColumn.HeaderTemplate>
									<DataTemplate>
										<TextBlock Text="{Binding DataContext.DisplayNameRyaku, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
									</DataTemplate>
								</DataGridTextColumn.HeaderTemplate>
							</DataGridTextColumn>
						</DataGrid.Columns>
					</DataGrid>
				</Grid>
			</materialDesign:Card>
		</Grid>
	</Grid>
</helpers:BaseWindow>
