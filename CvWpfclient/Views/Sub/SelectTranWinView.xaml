<helpers:BaseWindow x:Class="CvWpfclient.Views.Sub.SelectTranWinView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:helpers="clr-namespace:CvWpfclient.Helpers" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:vm="clr-namespace:CvWpfclient.ViewModels.Sub"
	Title="{Binding Title}"
	Width="1100" Height="620"
	helpers:OwnerWindowPlacement.IsEnabled="True" helpers:OwnerWindowPlacement.LeftOffset="-40" helpers:OwnerWindowPlacement.TopOffset="-20" BorderBrush="DarkSlateGray"
	BorderThickness="0.5,0,1.5,1.5" FontSize="18" WindowStartupLocation="Manual"
	mc:Ignorable="d">
	<helpers:BaseWindow.DataContext>
		<vm:SelectTranWinViewModel />
	</helpers:BaseWindow.DataContext>

	<helpers:BaseWindow.InputBindings>
		<KeyBinding Command="{Binding DoSearchCommand}"
			Gesture="F5" />
	</helpers:BaseWindow.InputBindings>

	<Grid Background="{DynamicResource AppCommonBackgroundBrush}">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<materialDesign:ColorZone Grid.Row="0"
			Padding="12,8"
			materialDesign:ElevationAssist.Elevation="Dp4" Mode="PrimaryMid">
			<DockPanel>
				<StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
					<Button x:Name="DefaultButton"
						Margin="8,0,0,0"
						Command="{Binding DoSelectCommand}"
						Style="{StaticResource ToolCommandButton}">
						<StackPanel Background="DarkGray" Orientation="Horizontal">
							<materialDesign:PackIcon VerticalAlignment="Center"
								Kind="Check" />
							<TextBlock Margin="6" VerticalAlignment="Center"
								Text="選択" />
						</StackPanel>
					</Button>
				</StackPanel>
				<StackPanel Orientation="Horizontal">
					<Button Margin="0,0,8,0"
						Command="{Binding ExitCommand}"
						IsCancel="True"
						Style="{StaticResource ToolCommandButton}"
						ToolTip="閉じる">
						<materialDesign:PackIcon Kind="ArrowLeft" />
					</Button>
					<TextBlock VerticalAlignment="Center"
						FontSize="20" FontWeight="SemiBold"
						Text="{Binding Title}" />
					<TextBlock Margin="32,0,0,0" VerticalAlignment="Center"
						FontSize="14" Opacity="0.75"
						Text="{Binding Count, StringFormat={}件数 {0:N0}}" />
				</StackPanel>
			</DockPanel>
		</materialDesign:ColorZone>

		<Grid Grid.Row="1"
			Margin="12">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
			</Grid.RowDefinitions>

			<!--  絞り込み条件（伝票はコード/名称を持たないので伝票Noと計上日で絞る）  -->
			<materialDesign:Card Grid.Row="0"
				Margin="0,0,0,8" Padding="12,8"
				materialDesign:ElevationAssist.Elevation="Dp2" UniformCornerRadius="8">
				<WrapPanel Orientation="Horizontal">
					<StackPanel Margin="0,4,20,4"
						Orientation="Horizontal">
						<TextBlock Style="{StaticResource FormLabel}"
							Text="伝票No" />
						<TextBox Width="90"
							HorizontalContentAlignment="Right"
							Style="{StaticResource FormTextBox}"
							Text="{Binding DenNoFrom, UpdateSourceTrigger=PropertyChanged}" />
						<TextBlock Margin="6,0" VerticalAlignment="Center"
							Text="～" />
						<TextBox Width="90"
							HorizontalContentAlignment="Right"
							Style="{StaticResource FormTextBox}"
							Text="{Binding DenNoTo, UpdateSourceTrigger=PropertyChanged}" />
					</StackPanel>
					<StackPanel Margin="0,4,20,4"
						Orientation="Horizontal">
						<TextBlock Style="{StaticResource FormLabel}"
							Text="計上日" />
						<DatePicker Width="140"
							helpers:DatePickerTodayButtonBehavior.IsEnabled="True"
							SelectedDate="{Binding DenDayFrom, Mode=TwoWay}"
							Style="{StaticResource FormDatePicker}" />
						<TextBlock Margin="6,0" VerticalAlignment="Center"
							Text="～" />
						<DatePicker Width="140"
							helpers:DatePickerTodayButtonBehavior.IsEnabled="True"
							SelectedDate="{Binding DenDayTo, Mode=TwoWay}"
							Style="{StaticResource FormDatePicker}" />
					</StackPanel>
					<StackPanel Margin="0,4,20,4"
						Orientation="Horizontal">
						<TextBlock Style="{StaticResource FormLabel}"
							Text="最大件数" />
						<TextBox Width="80"
							HorizontalContentAlignment="Right"
							Style="{StaticResource FormTextBox}"
							Text="{Binding MaxCount, UpdateSourceTrigger=PropertyChanged}" />
					</StackPanel>
					<StackPanel Margin="0,4"
						Orientation="Horizontal">
						<Button Margin="0,0,8,0"
							Command="{Binding DoSearchCommand}"
							Style="{StaticResource MaterialDesignRaisedButton}"
							ToolTip="条件で再取得 (F5)">
							<StackPanel Orientation="Horizontal">
								<materialDesign:PackIcon VerticalAlignment="Center"
									Kind="DatabaseSearch" />
								<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
									Text="再取得" />
							</StackPanel>
						</Button>
						<Button Command="{Binding ClearConditionsCommand}"
							Style="{StaticResource MaterialDesignOutlinedButton}"
							ToolTip="絞り込み条件をクリア">
							<TextBlock Text="条件クリア" />
						</Button>
					</StackPanel>
				</WrapPanel>
			</materialDesign:Card>

			<materialDesign:Card Grid.Row="1"
				Padding="0"
				materialDesign:ElevationAssist.Elevation="Dp2" UniformCornerRadius="8">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
					</Grid.RowDefinitions>

					<Border Grid.Row="0"
						Padding="12,6"
						Background="{DynamicResource MaterialDesignToolBarBackground}"
						CornerRadius="8,8,0,0">
						<TextBlock Foreground="{DynamicResource MaterialDesignBodyLight}"
							TextTrimming="CharacterEllipsis">
							<TextBlock.Text>
								<MultiBinding StringFormat="{}伝票No {0:N0}　{1}　{2}　金額 {3:N0}">
									<Binding Path="Current.Id" />
									<Binding Path="Current.DenDayDisplay" />
									<Binding Path="Current.TorisakiDisplay" />
									<Binding Path="Current.KingakuTotal" />
								</MultiBinding>
							</TextBlock.Text>
						</TextBlock>
					</Border>

					<DataGrid x:Name="SelectGrid"
						Grid.Row="1"
						helpers:DataGridDoubleClick.Command="{Binding DoSelectCommand}" helpers:DataGridEnterCommand.TargetButton="{Binding ElementName=DefaultButton}"
						helpers:DataGridSelectionBehavior.AutoScrollToSelectedItem="True" materialDesign:DataGridAssist.CellPadding="12,6" materialDesign:DataGridAssist.ColumnHeaderPadding="12,8"
						AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" EnableRowVirtualization="True" FrozenColumnCount="1"
						GridLinesVisibility="Horizontal"
						HorizontalGridLinesBrush="{DynamicResource MaterialDesignDivider}"
						IsReadOnly="True" IsSynchronizedWithCurrentItem="True"
						ItemsSource="{Binding ListData}"
						RowHeight="35"
						SelectedItem="{Binding Current, Mode=TwoWay}"
						SelectionMode="Single" SelectionUnit="FullRow"
						Style="{StaticResource MaterialDesignDataGrid}"
						VerticalScrollBarVisibility="Visible" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
						<DataGrid.Columns>
							<DataGridTextColumn Width="90"
								Binding="{Binding Id, StringFormat={}{0:N0}}"
								ElementStyle="{StaticResource DataGridRightTextBlock}"
								Header="伝票No" />
							<DataGridTextColumn Width="110"
								Binding="{Binding DenDayDisplay}"
								Header="計上日" />
							<DataGridTextColumn Width="110"
								Binding="{Binding KubunDisplay}"
								Header="区分" />
							<!--  見出しと表示有無は伝票種別で変わるので xaml.cs から設定する（列は視覚ツリー外でバインドが効かないため）  -->
							<DataGridTextColumn x:Name="TorisakiColumn"
								Width="220"
								Binding="{Binding TorisakiDisplay}"
								Header="取引先" />
							<DataGridTextColumn Width="160"
								Binding="{Binding SokoDisplay}"
								Header="倉庫" />
							<DataGridTextColumn x:Name="SuTotalColumn"
								Width="80"
								Binding="{Binding SuTotal, StringFormat={}{0:N0}}"
								ElementStyle="{StaticResource DataGridRightTextBlock}"
								Header="数量" />
							<DataGridTextColumn Width="110"
								Binding="{Binding KingakuTotal, StringFormat={}{0:N0}}"
								ElementStyle="{StaticResource DataGridRightTextBlock}"
								Header="金額" />
							<DataGridTextColumn Width="160"
								Binding="{Binding ShainDisplay}"
								Header="入力者" />
							<DataGridTextColumn Width="*"
								Binding="{Binding Memo}"
								Header="メモ" />
						</DataGrid.Columns>
						<DataGrid.ColumnHeaderStyle>
							<Style BasedOn="{StaticResource MenteDataGridColumnHeader}"
								TargetType="DataGridColumnHeader" />
						</DataGrid.ColumnHeaderStyle>
					</DataGrid>
				</Grid>
			</materialDesign:Card>
		</Grid>
	</Grid>
</helpers:BaseWindow>
