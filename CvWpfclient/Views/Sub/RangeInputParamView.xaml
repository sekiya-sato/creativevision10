<helpers:BaseWindow x:Class="CvWpfclient.Views.Sub.RangeInputParamView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:helpers="clr-namespace:CvWpfclient.Helpers" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:vm="clr-namespace:CvWpfclient.ViewModels.Sub"
	Title="{Binding Parameter.DisplayName, TargetNullValue=入力, StringFormat={}{0}一覧条件}"
	Width="820" Height="660"
	Background="{DynamicResource AppCommonBackgroundBrush}"
	FontSize="16"
	Foreground="{DynamicResource MaterialDesignBody}"
	TextOptions.TextFormattingMode="Display" WindowStartupLocation="CenterOwner"
	mc:Ignorable="d">
	<helpers:BaseWindow.DataContext>
		<vm:RangeInputParamViewModel />
	</helpers:BaseWindow.DataContext>
	<helpers:BaseWindow.Resources>
		<Style x:Key="MenteSearchTextBox"
			BasedOn="{StaticResource SearchTextBox}"
			TargetType="{x:Type TextBox}">
			<Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Window}}" />
			<Setter Property="Background" Value="{DynamicResource MaterialDesignPaper}" />
			<Setter Property="helpers:SearchTextBoxAssist.ButtonBackground" Value="{DynamicResource SearchButtonBackgroundBrush}" />
		</Style>
		<Style x:Key="FormLabel"
			TargetType="TextBlock">
			<Setter Property="VerticalAlignment" Value="Center" />
			<Setter Property="FontWeight" Value="Medium" />
			<Setter Property="Foreground" Value="{DynamicResource MaterialDesignBodyLight}" />
			<Setter Property="Margin" Value="4,0,8,0" />
		</Style>
		<Style x:Key="FormTextBox"
			BasedOn="{StaticResource MaterialDesignOutlinedTextBox}"
			TargetType="TextBox">
			<Setter Property="Margin" Value="0,4" />
			<Setter Property="MinWidth" Value="0" />
			<Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}" />
			<Setter Property="materialDesign:HintAssist.FloatingScale" Value="0.7" />
		</Style>
		<Style x:Key="SelectionResultText"
			TargetType="TextBlock">
			<Setter Property="MinWidth" Value="0" />
			<Setter Property="Margin" Value="12,0,8,0" />
			<Setter Property="VerticalAlignment" Value="Center" />
			<Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}" />
			<Setter Property="TextTrimming" Value="CharacterEllipsis" />
		</Style>
	</helpers:BaseWindow.Resources>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>
		<materialDesign:ColorZone Grid.Row="0"
			Padding="12,8"
			materialDesign:ElevationAssist.Elevation="Dp4" ClipToBounds="True" Mode="PrimaryMid">
			<StackPanel Orientation="Horizontal">
				<materialDesign:PackIcon Width="28" Height="28"
					VerticalAlignment="Center"
					Kind="DatabaseSearch" />
				<TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
					FontSize="20" FontWeight="SemiBold"
					Text="{Binding Parameter.DisplayName, TargetNullValue=入力, StringFormat={}{0}選択}" />
			</StackPanel>
		</materialDesign:ColorZone>

		<Grid Grid.Row="1"
			Margin="16,12,16,12">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
			</Grid.RowDefinitions>

			<TextBlock Grid.Row="0"
				Margin="0,0,0,8"
				FontSize="18" FontWeight="Bold"
				Foreground="{DynamicResource MaterialDesignBody}"
				Text="{Binding Parameter.DisplayName, TargetNullValue=入力, StringFormat={}{0}一覧の対象範囲を指定してください}" />

			<materialDesign:Card Grid.Row="1"
				Padding="12,12,12,0"
				materialDesign:ElevationAssist.Elevation="Dp2" UniformCornerRadius="8">
				<Grid Margin="2">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="120" />
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>

					<TextBlock Grid.Row="0" Grid.Column="0"
						Style="{StaticResource FormLabel}"><Run Language="ja-jp" Text="伝票No" /></TextBlock>
					<TextBox Grid.Row="0" Grid.Column="1"
						Width="220"
						HorizontalAlignment="Left" HorizontalContentAlignment="Right" VerticalContentAlignment="Center"
						materialDesign:HintAssist.Hint="伝票No (開始)"
						Style="{StaticResource FormTextBox}"
						TabIndex="0"
						Text="{Binding Parameter.FromId, UpdateSourceTrigger=PropertyChanged}" />

					<TextBlock Grid.Row="0" Grid.Column="2"
						Margin="12,0" HorizontalAlignment="Center" VerticalAlignment="Center"
						Style="{StaticResource FormLabel}"><Run Language="ja-jp" Text="-" /></TextBlock>
					<TextBox Grid.Row="0" Grid.Column="3"
						Width="220"
						HorizontalAlignment="Left" HorizontalContentAlignment="Right" VerticalContentAlignment="Center"
						materialDesign:HintAssist.Hint="伝票No (終了)"
						Style="{StaticResource FormTextBox}"
						TabIndex="1"
						Text="{Binding Parameter.ToId, UpdateSourceTrigger=PropertyChanged}" />

					<TextBlock Grid.Row="1" Grid.Column="0"
						Style="{StaticResource FormLabel}"><Run Language="ja-jp" Text="日付" /></TextBlock>
					<DatePicker Grid.Row="1" Grid.Column="1"
						Width="220"
						Margin="0,4" HorizontalAlignment="Left" VerticalContentAlignment="Center"
						helpers:DatePickerTodayButtonBehavior.IsEnabled="True" FontSize="16" IsTodayHighlighted="False"
						SelectedDate="{Binding Parameter.FromDate, Converter={StaticResource DateYmd8Converter}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
						Style="{StaticResource MaterialDesignFloatingHintDatePicker}"
						TabIndex="2" />

					<TextBlock Grid.Row="1" Grid.Column="2"
						Margin="12,0" HorizontalAlignment="Center" VerticalAlignment="Center"
						Style="{StaticResource FormLabel}"><Run Language="ja-jp" Text="-" /></TextBlock>
					<DatePicker Grid.Row="1" Grid.Column="3"
						Width="220"
						Margin="0,4" HorizontalAlignment="Left" VerticalContentAlignment="Center"
						helpers:DatePickerTodayButtonBehavior.IsEnabled="True" FontSize="16" IsTodayHighlighted="False"
						SelectedDate="{Binding Parameter.ToDate, Converter={StaticResource DateYmd8Converter}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
						Style="{StaticResource MaterialDesignFloatingHintDatePicker}"
						TabIndex="3" />

					<TextBlock Grid.Row="2" Grid.Column="0"
						Style="{StaticResource FormLabel}"
						Text="{Binding Parameter.ToriLabel}"
						Visibility="{Binding Parameter.IsToriVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
					<DockPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3"
						Margin="0,4"
						Visibility="{Binding Parameter.IsToriVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
						<Button Width="110" Height="36"
							Command="{Binding DoSelectToriIdsCommand}"
							DockPanel.Dock="Left"
							Style="{StaticResource MaterialDesignRaisedButton}"
							ToolTip="{Binding Parameter.ToriLabel, StringFormat={}{0}を選択}">
							<StackPanel Orientation="Horizontal">
								<materialDesign:PackIcon VerticalAlignment="Center"
									Kind="CheckboxMultipleMarkedOutline" />
								<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
									Text="選択" />
							</StackPanel>
						</Button>
						<Button Width="80" Height="36"
							Margin="8,0,0,0"
							Command="{Binding ClearToriIdsCommand}"
							Content="解除" DockPanel.Dock="Right"
							Style="{StaticResource MaterialDesignFlatButton}"
							ToolTip="{Binding Parameter.ToriLabel, StringFormat={}{0}の選択を解除}" />
						<TextBlock Style="{StaticResource SelectionResultText}"
							Text="{Binding Parameter.ToriIdsText}"
							ToolTipService.InitialShowDelay="300">
							<TextBlock.ToolTip>
								<TextBlock MaxWidth="600"
									Text="{Binding Parameter.ToriIdsText}"
									TextWrapping="Wrap" />
							</TextBlock.ToolTip>
						</TextBlock>
					</DockPanel>

					<TextBlock Grid.Row="3" Grid.Column="0"
						Style="{StaticResource FormLabel}"><Run Language="ja-jp" Text="倉庫Id" /></TextBlock>
					<DockPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3"
						Margin="0,4">
						<Button Width="110" Height="36"
							Command="{Binding DoSelectSokoIdsCommand}"
							DockPanel.Dock="Left"
							Style="{StaticResource MaterialDesignRaisedButton}"
							ToolTip="倉庫Idを選択">
							<StackPanel Orientation="Horizontal">
								<materialDesign:PackIcon VerticalAlignment="Center"
									Kind="CheckboxMultipleMarkedOutline" />
								<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
									Text="選択" />
							</StackPanel>
						</Button>
						<Button Width="80" Height="36"
							Margin="8,0,0,0"
							Command="{Binding ClearSokoIdsCommand}"
							Content="解除" DockPanel.Dock="Right"
							Style="{StaticResource MaterialDesignFlatButton}"
							ToolTip="倉庫Idの選択を解除" />
						<TextBlock Style="{StaticResource SelectionResultText}"
							Text="{Binding Parameter.SokoIdsText}"
							ToolTipService.InitialShowDelay="300">
							<TextBlock.ToolTip>
								<TextBlock MaxWidth="600"
									Text="{Binding Parameter.SokoIdsText}"
									TextWrapping="Wrap" />
							</TextBlock.ToolTip>
						</TextBlock>
					</DockPanel>

					<TextBlock Grid.Row="4" Grid.Column="0"
						Style="{StaticResource FormLabel}"><Run Language="ja-jp" Text="商品Id" /></TextBlock>
					<DockPanel Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3"
						Margin="0,4">
						<Button Width="110" Height="36"
							Command="{Binding DoSelectShohinIdsCommand}"
							DockPanel.Dock="Left"
							Style="{StaticResource MaterialDesignRaisedButton}"
							ToolTip="商品Idを選択">
							<StackPanel Orientation="Horizontal">
								<materialDesign:PackIcon VerticalAlignment="Center"
									Kind="CheckboxMultipleMarkedOutline" />
								<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
									Text="選択" />
							</StackPanel>
						</Button>
						<Button Width="80" Height="36"
							Margin="8,0,0,0"
							Command="{Binding ClearShohinIdsCommand}"
							Content="解除" DockPanel.Dock="Right"
							Style="{StaticResource MaterialDesignFlatButton}"
							ToolTip="商品Idの選択を解除" />
						<TextBlock Style="{StaticResource SelectionResultText}"
							Text="{Binding Parameter.ShohinIdsText}"
							ToolTipService.InitialShowDelay="300">
							<TextBlock.ToolTip>
								<TextBlock MaxWidth="600"
									Text="{Binding Parameter.ShohinIdsText}"
									TextWrapping="Wrap" />
							</TextBlock.ToolTip>
						</TextBlock>
					</DockPanel>

					<TextBlock Grid.Row="5" Grid.Column="0"
						Style="{StaticResource FormLabel}"><Run Language="ja-jp" Text="入力バーコード" /></TextBlock>
					<TextBox Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="3"
						Width="400"
						HorizontalAlignment="Left" VerticalContentAlignment="Center"
						materialDesign:HintAssist.Hint="入力バーコード"
						Style="{StaticResource FormTextBox}"
						TabIndex="7"
						Text="{Binding Parameter.InputBarcode, UpdateSourceTrigger=PropertyChanged}" />

					<TextBlock Grid.Row="6" Grid.Column="0"
						Style="{StaticResource FormLabel}"><Run Language="ja-jp" Text="商品名" /></TextBlock>
					<TextBox Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="3"
						Width="400"
						HorizontalAlignment="Left" VerticalContentAlignment="Center"
						materialDesign:HintAssist.Hint="商品名 (部分一致)"
						Style="{StaticResource FormTextBox}"
						TabIndex="8"
						Text="{Binding Parameter.ShohinNameLike, UpdateSourceTrigger=PropertyChanged}" />

					<TextBlock Grid.Row="7" Grid.Column="0"
						Style="{StaticResource FormLabel}"><Run Language="ja-jp" Text="件数" /></TextBlock>
					<TextBox Grid.Row="7" Grid.Column="1"
						Width="220"
						HorizontalAlignment="Left" HorizontalContentAlignment="Right" VerticalContentAlignment="Center"
						materialDesign:HintAssist.Hint="件数"
						Style="{StaticResource FormTextBox}"
						TabIndex="10"
						Text="{Binding Parameter.MaxCount, UpdateSourceTrigger=PropertyChanged}" />
					<TextBlock Grid.Row="7" Grid.Column="2" Grid.ColumnSpan="2"
						Margin="12,0,0,0" VerticalAlignment="Center"
						Foreground="{DynamicResource MaterialDesignBodyLight}"
						Text="(空白:全件取得)" />

				</Grid>
			</materialDesign:Card>
		</Grid>

		<StackPanel Grid.Row="2"
			Margin="12" HorizontalAlignment="Right"
			Orientation="Horizontal">
			<Button Width="120" Height="38"
				Margin="0,0,8,0"
				Command="{Binding OkCommand}"
				IsDefault="True"
				Style="{StaticResource MaterialDesignRaisedButton}"
				ToolTip="選択確定 (Enter)">
				<StackPanel Orientation="Horizontal">
					<materialDesign:PackIcon VerticalAlignment="Center"
						Kind="CheckCircle" />
					<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
						FontSize="16" Text="選択確定" />
				</StackPanel>
			</Button>
			<Button Width="140" Height="38"
				Command="{Binding ExitCommand}"
				IsCancel="True"
				Style="{StaticResource MaterialDesignFlatButton}"
				ToolTip="戻る (Esc)">
				<StackPanel Orientation="Horizontal">
					<materialDesign:PackIcon VerticalAlignment="Center"
						Kind="ArrowLeft" />
					<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
						FontSize="16" Text="戻る" />
				</StackPanel>
			</Button>
		</StackPanel>
	</Grid>
</helpers:BaseWindow>
