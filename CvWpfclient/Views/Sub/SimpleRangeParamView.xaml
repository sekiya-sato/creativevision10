<helpers:BaseWindow x:Class="CvWpfclient.Views.Sub.SimpleRangeParamView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:helpers="clr-namespace:CvWpfclient.Helpers" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:vm="clr-namespace:CvWpfclient.ViewModels.Sub"
	Title="{Binding Parameter.DisplayName, StringFormat={}{0}検索}"
	Width="660" Height="500"
	Background="{DynamicResource AppCommonBackgroundBrush}"
	FontSize="18" WindowStartupLocation="CenterOwner"
	mc:Ignorable="d">
	<helpers:BaseWindow.DataContext>
		<vm:SimpleRangeParamViewModel />
	</helpers:BaseWindow.DataContext>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<materialDesign:ColorZone Grid.Row="0"
			Padding="12,8"
			materialDesign:ElevationAssist.Elevation="Dp4" ClipToBounds="True" Mode="PrimaryMid">
			<StackPanel Orientation="Horizontal">
				<materialDesign:PackIcon Width="28" Height="28"
					VerticalAlignment="Center"
					Kind="DatabaseSearch" />
				<TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
					FontSize="20" FontWeight="SemiBold"
					Text="{Binding Parameter.DisplayName, StringFormat={}{0}検索}" />
			</StackPanel>
		</materialDesign:ColorZone>

		<Grid Grid.Row="1"
			Margin="16">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
			</Grid.RowDefinitions>

			<TextBlock Grid.Row="0"
				Margin="0,0,0,8"
				FontSize="18" FontWeight="Bold"
				Foreground="{DynamicResource MaterialDesignBody}"
				Text="{Binding Parameter.DisplayName, StringFormat={}{0}一覧の検索条件を指定してください}" />

			<!--  行ごとの表示切替は Parameter の Is*Visible で行う。列幅は SharedSizeGroup で揃える  -->
			<materialDesign:Card Grid.Row="1"
				Padding="12,12,12,8" VerticalAlignment="Top"
				materialDesign:ElevationAssist.Elevation="Dp2" UniformCornerRadius="8">
				<StackPanel Margin="2" Grid.IsSharedSizeScope="True">
					<!--  カテゴリ  -->
					<Grid Margin="0,0,0,4"
						Visibility="{Binding Parameter.IsCategoryVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="170" SharedSizeGroup="Label" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>
						<TextBlock Grid.Column="0"
							VerticalAlignment="Center"
							FontWeight="Medium"
							Foreground="{DynamicResource MaterialDesignBodyLight}"
							Text="{Binding Parameter.CategoryLabel}" />
						<ComboBox Grid.Column="1"
							Margin="0,4" VerticalContentAlignment="Center"
							IsEditable="False"
							ItemsSource="{Binding Parameter.CategoryList}"
							SelectedItem="{Binding Parameter.SelectedCategory, UpdateSourceTrigger=PropertyChanged}"
							Style="{StaticResource MaterialDesignComboBox}">
							<materialDesign:HintAssist.Hint>
								<TextBlock Text="{Binding Parameter.CategoryLabel, StringFormat={}{0}(未選択:すべて対象)}" />
							</materialDesign:HintAssist.Hint>
						</ComboBox>
					</Grid>

					<!--  Id範囲  -->
					<Grid Margin="0,0,0,4">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="170" SharedSizeGroup="Label" />
							<ColumnDefinition Width="180" />
							<ColumnDefinition Width="40" />
							<ColumnDefinition Width="180" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>
						<TextBlock Grid.Column="0"
							VerticalAlignment="Center"
							FontWeight="Medium"
							Foreground="{DynamicResource MaterialDesignBodyLight}"
							Text="{Binding Parameter.IdLabel}" />
						<TextBox Grid.Column="1"
							HorizontalContentAlignment="Right" VerticalContentAlignment="Center"
							Style="{StaticResource FormTextBox}"
							Text="{Binding Parameter.FromId, UpdateSourceTrigger=PropertyChanged}">
							<materialDesign:HintAssist.Hint>
								<TextBlock Text="{Binding Parameter.IdLabel, StringFormat={}{0} (開始)}" />
							</materialDesign:HintAssist.Hint>
						</TextBox>
						<TextBlock Grid.Column="2"
							HorizontalAlignment="Center" VerticalAlignment="Center"
							FontWeight="Medium"
							Foreground="{DynamicResource MaterialDesignBodyLight}"
							Text="-" />
						<TextBox Grid.Column="3"
							HorizontalContentAlignment="Right" VerticalContentAlignment="Center"
							Style="{StaticResource FormTextBox}"
							Text="{Binding Parameter.ToId, UpdateSourceTrigger=PropertyChanged}">
							<materialDesign:HintAssist.Hint>
								<TextBlock Text="{Binding Parameter.IdLabel, StringFormat={}{0} (終了)}" />
							</materialDesign:HintAssist.Hint>
						</TextBox>
					</Grid>

					<!--  名前(部分一致)  -->
					<Grid Margin="0,0,0,4"
						Visibility="{Binding Parameter.IsNameVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="170" SharedSizeGroup="Label" />
							<ColumnDefinition Width="400" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>
						<TextBlock Grid.Column="0"
							VerticalAlignment="Center"
							FontWeight="Medium"
							Foreground="{DynamicResource MaterialDesignBodyLight}"
							Text="{Binding Parameter.NameLabel}" />
						<TextBox Grid.Column="1"
							VerticalContentAlignment="Center"
							Style="{StaticResource FormTextBox}"
							Text="{Binding Parameter.Name, UpdateSourceTrigger=PropertyChanged}">
							<materialDesign:HintAssist.Hint>
								<TextBlock Text="{Binding Parameter.NameLabel, StringFormat={}{0} (部分一致)}" />
							</materialDesign:HintAssist.Hint>
						</TextBox>
					</Grid>

					<!--  日付範囲  -->
					<Grid Margin="0,0,0,4"
						Visibility="{Binding Parameter.IsDateVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="170" SharedSizeGroup="Label" />
							<ColumnDefinition Width="180" />
							<ColumnDefinition Width="40" />
							<ColumnDefinition Width="180" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>
						<TextBlock Grid.Column="0"
							VerticalAlignment="Center"
							FontWeight="Medium"
							Foreground="{DynamicResource MaterialDesignBodyLight}"
							Text="{Binding Parameter.DateLabel}" />
						<DatePicker Grid.Column="1"
							Margin="0,4" VerticalContentAlignment="Center"
							helpers:DatePickerTodayButtonBehavior.IsEnabled="True" FontSize="16" IsTodayHighlighted="False"
							SelectedDate="{Binding Parameter.FromDate, Converter={StaticResource DateYmd8Converter}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
							Style="{StaticResource FormDatePicker}" />
						<TextBlock Grid.Column="2"
							HorizontalAlignment="Center" VerticalAlignment="Center"
							FontWeight="Medium"
							Foreground="{DynamicResource MaterialDesignBodyLight}"
							Text="-" />
						<DatePicker Grid.Column="3"
							Margin="0,4" VerticalContentAlignment="Center"
							helpers:DatePickerTodayButtonBehavior.IsEnabled="True" FontSize="16" IsTodayHighlighted="False"
							SelectedDate="{Binding Parameter.ToDate, Converter={StaticResource DateYmd8Converter}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
							Style="{StaticResource FormDatePicker}" />
					</Grid>

					<!--  件数  -->
					<Grid Margin="0,0,0,4">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="170" SharedSizeGroup="Label" />
							<ColumnDefinition Width="180" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>
						<TextBlock Grid.Column="0"
							VerticalAlignment="Center"
							FontWeight="Medium"
							Foreground="{DynamicResource MaterialDesignBodyLight}"
							Text="件数" />
						<TextBox Grid.Column="1"
							HorizontalContentAlignment="Right" VerticalContentAlignment="Center"
							materialDesign:HintAssist.Hint="件数"
							Style="{StaticResource FormTextBox}"
							Text="{Binding Parameter.MaxCount, UpdateSourceTrigger=PropertyChanged}" />
						<TextBlock Grid.Column="2"
							Margin="8,0,0,0" VerticalAlignment="Center"
							Foreground="{DynamicResource MaterialDesignBodyLight}"
							Text="(空白:全件取得)" />
					</Grid>

					<TextBlock Margin="0,8,0,0"
						Foreground="{DynamicResource MaterialDesignBodyLight}"
						Text="{Binding Parameter.DisplayName, StringFormat={}条件を指定しない場合、すべての{0}が対象になります。}"
						TextWrapping="Wrap" />
				</StackPanel>
			</materialDesign:Card>
		</Grid>

		<StackPanel Grid.Row="2"
			Margin="0,16,16,16" HorizontalAlignment="Right"
			Orientation="Horizontal">
			<Button Width="120" Height="38"
				Margin="0,0,8,0"
				Command="{Binding OkCommand}"
				IsDefault="True"
				Style="{StaticResource MaterialDesignRaisedButton}">
				<StackPanel Orientation="Horizontal">
					<materialDesign:PackIcon VerticalAlignment="Center"
						Kind="CheckCircle" />
					<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
						FontSize="16" Text="検索" />
				</StackPanel>
			</Button>
			<Button Width="120" Height="38"
				Command="{Binding ExitCommand}"
				IsCancel="True"
				Style="{StaticResource MaterialDesignFlatButton}">
				<StackPanel Orientation="Horizontal">
					<materialDesign:PackIcon VerticalAlignment="Center"
						Kind="ArrowLeft" />
					<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
						FontSize="16" Text="戻る" />
				</StackPanel>
			</Button>
		</StackPanel>
	</Grid>
</helpers:BaseWindow>
