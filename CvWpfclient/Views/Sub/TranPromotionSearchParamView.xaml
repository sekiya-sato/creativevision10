<helpers:BaseWindow x:Class="CvWpfclient.Views.Sub.TranPromotionSearchParamView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:helpers="clr-namespace:CvWpfclient.Helpers" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:vm="clr-namespace:CvWpfclient.ViewModels.Sub"
	Title="{Binding Parameter.DisplayName, StringFormat={}{0}検索}"
	Width="660" Height="520"
	Background="{DynamicResource AppCommonBackgroundBrush}"
	FontSize="18" WindowStartupLocation="CenterOwner"
	mc:Ignorable="d">
	<helpers:BaseWindow.DataContext>
		<vm:TranPromotionSearchParamViewModel />
	</helpers:BaseWindow.DataContext>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<materialDesign:ColorZone Grid.Row="0"
			Padding="12,8"
			materialDesign:ElevationAssist.Elevation="Dp4" ClipToBounds="True" Mode="PrimaryMid">
			<StackPanel Orientation="Horizontal">
				<materialDesign:PackIcon Width="28" Height="28"
					VerticalAlignment="Center"
					Kind="DatabaseSearch" />
				<TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
					FontSize="20" FontWeight="SemiBold"
					Text="{Binding Parameter.DisplayName, StringFormat={}{0}検索}" />
			</StackPanel>
		</materialDesign:ColorZone>

		<Grid Grid.Row="1"
			Margin="16">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
			</Grid.RowDefinitions>

			<TextBlock Grid.Row="0"
				Margin="0,0,0,8"
				FontSize="18" FontWeight="Bold"
				Foreground="{DynamicResource MaterialDesignBody}"
				Text="{Binding Parameter.DisplayName, StringFormat={}{0}一覧の検索条件を指定してください}" />

			<materialDesign:Card Grid.Row="1"
				Padding="12,12,12,0"
				materialDesign:ElevationAssist.Elevation="Dp2" UniformCornerRadius="8">
				<Grid Margin="2">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="150" />
						<ColumnDefinition Width="180" />
						<ColumnDefinition Width="40" />
						<ColumnDefinition Width="180" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>

					<TextBlock Grid.Row="0" Grid.Column="0"
						VerticalAlignment="Center"
						FontWeight="Medium"
						Foreground="{DynamicResource MaterialDesignBodyLight}"
						Text="{Binding Parameter.TargetIdLabel}" />
					<TextBox Grid.Row="0" Grid.Column="1"
						HorizontalContentAlignment="Right" VerticalContentAlignment="Center"
						materialDesign:HintAssist.Hint="{Binding Parameter.TargetIdLabel, StringFormat={}{0} (開始)}"
						Style="{StaticResource FormTextBox}"
						Text="{Binding Parameter.FromTargetId, UpdateSourceTrigger=PropertyChanged}" />
					<TextBlock Grid.Row="0" Grid.Column="2"
						HorizontalAlignment="Center" VerticalAlignment="Center"
						FontWeight="Medium"
						Foreground="{DynamicResource MaterialDesignBodyLight}"
						Text="-" />
					<TextBox Grid.Row="0" Grid.Column="3"
						HorizontalContentAlignment="Right" VerticalContentAlignment="Center"
						materialDesign:HintAssist.Hint="{Binding Parameter.TargetIdLabel, StringFormat={}{0} (終了)}"
						Style="{StaticResource FormTextBox}"
						Text="{Binding Parameter.ToTargetId, UpdateSourceTrigger=PropertyChanged}" />

					<TextBlock Grid.Row="1" Grid.Column="0"
						VerticalAlignment="Center"
						FontWeight="Medium"
						Foreground="{DynamicResource MaterialDesignBodyLight}"
						Text="日付" />
					<DatePicker Grid.Row="1" Grid.Column="1"
						Margin="0,4" VerticalContentAlignment="Center"
						helpers:DatePickerTodayButtonBehavior.IsEnabled="True" FontSize="16" IsTodayHighlighted="False"
						SelectedDate="{Binding Parameter.FromDate, Converter={StaticResource DateYmd8Converter}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
						Style="{StaticResource MaterialDesignFloatingHintDatePicker}" />
					<TextBlock Grid.Row="1" Grid.Column="2"
						HorizontalAlignment="Center" VerticalAlignment="Center"
						FontWeight="Medium"
						Foreground="{DynamicResource MaterialDesignBodyLight}"
						Text="-" />
					<DatePicker Grid.Row="1" Grid.Column="3"
						Margin="0,4" VerticalContentAlignment="Center"
						helpers:DatePickerTodayButtonBehavior.IsEnabled="True" FontSize="16" IsTodayHighlighted="False"
						SelectedDate="{Binding Parameter.ToDate, Converter={StaticResource DateYmd8Converter}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
						Style="{StaticResource MaterialDesignFloatingHintDatePicker}" />

					<TextBlock Grid.Row="2" Grid.Column="0"
						VerticalAlignment="Center"
						FontWeight="Medium"
						Foreground="{DynamicResource MaterialDesignBodyLight}"
						Text="件数" />
					<TextBox Grid.Row="2" Grid.Column="1"
						HorizontalContentAlignment="Right" VerticalContentAlignment="Center"
						materialDesign:HintAssist.Hint="件数"
						Style="{StaticResource FormTextBox}"
						Text="{Binding Parameter.MaxCount, UpdateSourceTrigger=PropertyChanged}" />
					<TextBlock Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="3"
						Margin="8,0,0,0" VerticalAlignment="Center"
						Foreground="{DynamicResource MaterialDesignBodyLight}"
						Text="(空白:全件取得)" />

					<TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="5"
						Margin="0,8,0,0"
						Foreground="{DynamicResource MaterialDesignBodyLight}"
						Text="{Binding Parameter.DisplayName, StringFormat={}条件を指定しない場合、すべての{0}が対象になります。}"
						TextWrapping="Wrap" />
				</Grid>
			</materialDesign:Card>
		</Grid>

		<StackPanel Grid.Row="2"
			Margin="0,16,16,16" HorizontalAlignment="Right"
			Orientation="Horizontal">
			<Button Width="120" Height="38"
				Margin="0,0,8,0"
				Command="{Binding OkCommand}"
				IsDefault="True"
				Style="{StaticResource MaterialDesignRaisedButton}">
				<StackPanel Orientation="Horizontal">
					<materialDesign:PackIcon VerticalAlignment="Center"
						Kind="CheckCircle" />
					<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
						FontSize="16" Text="検索" />
				</StackPanel>
			</Button>
			<Button Width="120" Height="38"
				Command="{Binding ExitCommand}"
				IsCancel="True"
				Style="{StaticResource MaterialDesignFlatButton}">
				<StackPanel Orientation="Horizontal">
					<materialDesign:PackIcon VerticalAlignment="Center"
						Kind="ArrowLeft" />
					<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
						FontSize="16" Text="戻る" />
				</StackPanel>
			</Button>
		</StackPanel>
	</Grid>
</helpers:BaseWindow>
