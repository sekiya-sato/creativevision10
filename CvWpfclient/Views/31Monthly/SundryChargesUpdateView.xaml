<helpers:BaseWindow x:Class="CvWpfclient.Views._31Monthly.SundryChargesUpdateView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:helpers="clr-namespace:CvWpfclient.Helpers"
	xmlns:local="clr-namespace:CvWpfclient.Views" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:vm="clr-namespace:CvWpfclient.ViewModels._31Monthly"
	Title="諸掛確認"
	Width="{StaticResource StandardWindowWidth}"
	Height="{StaticResource StandardWindowHeight}"
	Background="{DynamicResource AppCommonBackgroundBrush}"
	Foreground="{DynamicResource MaterialDesignBody}"
	TextOptions.TextFormattingMode="Display"
	mc:Ignorable="d">
	<helpers:BaseWindow.DataContext>
		<vm:SundryChargesUpdateViewModel />
	</helpers:BaseWindow.DataContext>

	<helpers:BaseWindow.Resources>
		<SolidColorBrush x:Key="SundryErrorForegroundBrush"
			Color="#D32F2F" />
		<SolidColorBrush x:Key="SundryWarningForegroundBrush"
			Color="#F9A825" />

		<Style x:Key="SundrySeverityRowStyle"
			TargetType="DataGridRow">
			<Style.Triggers>
				<DataTrigger Binding="{Binding IsWarning}"
					Value="True">
					<Setter Property="Foreground" Value="{StaticResource SundryWarningForegroundBrush}" />
				</DataTrigger>
				<DataTrigger Binding="{Binding IsError}"
					Value="True">
					<Setter Property="Foreground" Value="{StaticResource SundryErrorForegroundBrush}" />
					<Setter Property="FontWeight" Value="SemiBold" />
				</DataTrigger>
			</Style.Triggers>
		</Style>
	</helpers:BaseWindow.Resources>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<materialDesign:ColorZone Grid.Row="0"
			Padding="14,10"
			materialDesign:ElevationAssist.Elevation="Dp4" Mode="PrimaryMid">
			<StackPanel Orientation="Horizontal">
				<materialDesign:PackIcon Width="30" Height="30"
					VerticalAlignment="Center"
					Kind="TruckDeliveryOutline" />
				<TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
					FontSize="20" FontWeight="SemiBold" Text="諸掛確認" />
				<TextBlock Margin="16,0,0,0" VerticalAlignment="Center"
					FontSize="13" Opacity="0.85" Text="参照専用画面です。更新は総平均原価更新の実行時に自動集計されます。" />
			</StackPanel>
		</materialDesign:ColorZone>

		<Grid Grid.Row="1"
			Margin="18">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="2*" />
				<RowDefinition Height="1.2*" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>

			<materialDesign:Card Grid.Row="0"
				Padding="24"
				materialDesign:ElevationAssist.Elevation="Dp2" UniformCornerRadius="8">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="120" />
						<ColumnDefinition Width="180" />
						<ColumnDefinition Width="140" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>

					<TextBlock Grid.Column="0"
						VerticalAlignment="Center"
						Style="{StaticResource SettingLabel}"
						Text="対象月" />
					<TextBox Grid.Column="1"
						Width="120"
						HorizontalAlignment="Left" VerticalAlignment="Center"
						helpers:YearMonthInputBehavior.IsEnabled="True"
						IsEnabled="{Binding IsProcessing, Converter={StaticResource InverseBooleanConverter}}"
						MaxLength="7"
						Style="{StaticResource MaterialDesignOutlinedTextBox}"
						Text="{Binding TargetMonth}" />

					<TextBlock Grid.Column="2"
						VerticalAlignment="Center"
						Style="{StaticResource SettingLabel}"
						Text="対象期間" />
					<TextBlock Grid.Column="3"
						VerticalAlignment="Center"
						Text="{Binding PeriodText}" />
				</Grid>
			</materialDesign:Card>

			<ItemsControl Grid.Row="1"
				Margin="0,8,0,0"
				ItemsSource="{Binding InfoMessages}">
				<ItemsControl.ItemTemplate>
					<DataTemplate>
						<materialDesign:Card Margin="0,4,0,0" Padding="10,6"
							Background="{DynamicResource MaterialDesignChipBackground}"
							UniformCornerRadius="6">
							<StackPanel Orientation="Horizontal">
								<materialDesign:PackIcon VerticalAlignment="Center"
									Kind="InformationOutline" />
								<TextBlock Margin="8,0,0,0" VerticalAlignment="Center"
									Text="{Binding}"
									TextWrapping="Wrap" />
							</StackPanel>
						</materialDesign:Card>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>

			<GroupBox Grid.Row="2"
				Margin="0,12,0,0"
				Header="明細一覧">
				<Grid Margin="8">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
					</Grid.RowDefinitions>

					<StackPanel Grid.Row="0"
						Margin="0,0,0,8"
						Orientation="Horizontal">
						<TextBlock VerticalAlignment="Center"
							Foreground="{StaticResource SundryErrorForegroundBrush}"
							Text="{Binding ErrorCount, StringFormat='エラー {0:N0} 件'}" />
						<TextBlock Margin="16,0,0,0" VerticalAlignment="Center"
							Foreground="{StaticResource SundryWarningForegroundBrush}"
							Text="{Binding WarningCount, StringFormat='警告 {0:N0} 件'}" />
						<CheckBox Margin="24,0,0,0" VerticalAlignment="Center"
							Content="エラー・警告行のみ表示"
							IsChecked="{Binding ShowErrorsAndWarningsOnly}" />
						<Button Margin="24,0,0,0"
							Command="{Binding ExportCsvCommand}"
							Style="{StaticResource MaterialDesignOutlinedButton}">
							<StackPanel Orientation="Horizontal">
								<materialDesign:PackIcon VerticalAlignment="Center"
									Kind="FileDelimitedOutline" />
								<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
									Text="CSV出力" />
							</StackPanel>
						</Button>
					</StackPanel>

					<DataGrid Grid.Row="1"
						AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
						ItemsSource="{Binding DetailRows}"
						RowStyle="{StaticResource SundrySeverityRowStyle}">
						<DataGrid.Columns>
							<DataGridTextColumn Width="90"
								Binding="{Binding DenNo}"
								Header="伝票No" />
							<DataGridTextColumn Width="100"
								Binding="{Binding DenDayText}"
								Header="伝票日" />
							<DataGridTextColumn Width="90"
								Binding="{Binding KubunText}"
								Header="取引区分" />
							<DataGridTextColumn Width="150"
								Binding="{Binding MeiShiire}"
								Header="仕入先" />
							<DataGridTextColumn Width="70"
								Binding="{Binding MeisaiNo}"
								Header="明細No" />
							<DataGridTextColumn Width="140"
								Binding="{Binding MeiMaterial}"
								Header="費目" />
							<DataGridTextColumn Width="200"
								Binding="{Binding ShohinText}"
								Header="商品" />
							<DataGridTextColumn Width="70"
								Binding="{Binding Su}"
								Header="数量" />
							<DataGridTextColumn Width="100"
								Binding="{Binding Kingaku, StringFormat=N0}"
								Header="金額" />
							<DataGridTextColumn Width="70"
								Binding="{Binding SeverityText}"
								Header="状態" />
							<DataGridTextColumn Width="240"
								Binding="{Binding ErrorMessage}"
								Header="エラー" />
						</DataGrid.Columns>
					</DataGrid>
				</Grid>
			</GroupBox>

			<GroupBox Grid.Row="3"
				Margin="0,12,0,0"
				Header="商品別集計一覧（総平均原価更新の分子・分母。エラー行はここで発見できます）">
				<DataGrid Margin="8"
					AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
					ItemsSource="{Binding SummaryRows}"
					RowStyle="{StaticResource SundrySeverityRowStyle}">
					<DataGrid.Columns>
						<DataGridTextColumn Width="220"
							Binding="{Binding ShohinText}"
							Header="商品" />
						<DataGridTextColumn Width="90"
							Binding="{Binding SundryCount}"
							Header="諸掛件数" />
						<DataGridTextColumn Width="110"
							Binding="{Binding SundryAmount, StringFormat=N0}"
							Header="諸掛金額" />
						<DataGridTextColumn Width="90"
							Binding="{Binding PurchaseQty}"
							Header="当月仕入数" />
						<DataGridTextColumn Width="110"
							Binding="{Binding PurchaseAmount, StringFormat=N0}"
							Header="当月仕入金額" />
						<DataGridTextColumn Width="90"
							Binding="{Binding OpeningQty}"
							Header="前月在庫数" />
						<DataGridTextColumn Width="70"
							Binding="{Binding SeverityText}"
							Header="状態" />
						<DataGridTextColumn Width="260"
							Binding="{Binding ErrorMessage}"
							Header="エラー" />
					</DataGrid.Columns>
				</DataGrid>
			</GroupBox>

			<GroupBox Grid.Row="4"
				Margin="0,12,0,0"
				Header="処理メッセージ">
				<TextBox MaxHeight="60"
					Margin="8"
					IsReadOnly="True"
					Style="{StaticResource MaterialDesignTextBox}"
					Text="{Binding StatusMessage, UpdateSourceTrigger=PropertyChanged}"
					TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
			</GroupBox>
		</Grid>

		<Border Grid.Row="2"
			Padding="18,12"
			Background="{DynamicResource MaterialDesignPaper}">
			<StackPanel HorizontalAlignment="Right"
				Orientation="Horizontal">
				<Button Width="128" Height="38"
					Margin="0,0,10,0"
					Command="{Binding ConfirmCommand}"
					IsDefault="True"
					Style="{StaticResource MaterialDesignRaisedButton}">
					<StackPanel Orientation="Horizontal">
						<materialDesign:PackIcon VerticalAlignment="Center"
							Kind="ClipboardCheckOutline" />
						<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
							Text="確認" />
					</StackPanel>
				</Button>
				<Button Width="128" Height="38"
					Command="{Binding ExitCommand}"
					IsCancel="True"
					Style="{StaticResource MaterialDesignOutlinedButton}">
					<StackPanel Orientation="Horizontal">
						<materialDesign:PackIcon VerticalAlignment="Center"
							Kind="ArrowLeft" />
						<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
							Text="キャンセル" />
					</StackPanel>
				</Button>
			</StackPanel>
		</Border>
	</Grid>
</helpers:BaseWindow>
