<helpers:BaseWindow x:Class="CvWpfclient.Views._31Monthly.BalanceRegistrationView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:helpers="clr-namespace:CvWpfclient.Helpers" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:vm="clr-namespace:CvWpfclient.ViewModels._31Monthly"
	Title="残高登録処理"
	Width="{StaticResource StandardWindowWidth}"
	Height="{StaticResource StandardWindowHeight}"
	Background="{DynamicResource AppCommonBackgroundBrush}"
	FontSize="14"
	Foreground="{DynamicResource MaterialDesignBody}"
	TextOptions.TextFormattingMode="Display" WindowStartupLocation="CenterScreen"
	mc:Ignorable="d">
	<helpers:BaseWindow.DataContext>
		<vm:BalanceRegistrationViewModel />
	</helpers:BaseWindow.DataContext>

	<helpers:BaseWindow.InputBindings>
		<KeyBinding Command="{Binding ExportTemplateCommand}"
			Gesture="F3" />
		<KeyBinding Command="{Binding SelectFileCommand}"
			Gesture="F4" />
		<KeyBinding Command="{Binding ValidateFileCommand}"
			Gesture="F5" />
		<KeyBinding Command="{Binding RegisterCommand}"
			Gesture="F6" />
		<KeyBinding Command="{Binding ExitCommand}"
			Gesture="Esc" />
	</helpers:BaseWindow.InputBindings>

	<helpers:BaseWindow.Resources>
		<Style x:Key="FormCaption"
			TargetType="TextBlock">
			<Setter Property="VerticalAlignment" Value="Center" />
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="Foreground" Value="{DynamicResource MaterialDesignBodyLight}" />
			<Setter Property="Margin" Value="0,0,6,0" />
		</Style>
		<Style x:Key="SummaryValue"
			TargetType="TextBlock">
			<Setter Property="VerticalAlignment" Value="Center" />
			<Setter Property="Margin" Value="4,0,16,0" />
			<Setter Property="TextAlignment" Value="Right" />
			<Setter Property="MinWidth" Value="44" />
		</Style>
	</helpers:BaseWindow.Resources>

	<Grid Margin="12">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<!--  ① 期首情報  -->
		<GroupBox Grid.Row="0"
			Header="① 期首情報">
			<Grid Margin="4">
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="24" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="120" />
					<ColumnDefinition Width="24" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="120" />
					<ColumnDefinition Width="24" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="130" />
					<ColumnDefinition Width="*" />
				</Grid.ColumnDefinitions>

				<TextBlock Grid.Row="0" Grid.Column="0"
					Style="{StaticResource FormCaption}"
					Text="期首日" />
				<TextBlock Grid.Row="0" Grid.Column="1"
					VerticalAlignment="Center"
					FontWeight="Bold"
					Text="{Binding FiscalStartDateText}" />

				<TextBlock Grid.Row="0" Grid.Column="3"
					Style="{StaticResource FormCaption}"
					Text="残高区分" />
				<ComboBox Grid.Row="0" Grid.Column="4"
					DisplayMemberPath="Name"
					IsEnabled="{Binding IsFiscalStartUnset, Converter={StaticResource InverseBooleanConverter}}"
					ItemsSource="{Binding KindItems}"
					SelectedValue="{Binding SelectedKind, Mode=TwoWay}"
					SelectedValuePath="Kind"
					Style="{StaticResource FormComboBox}" />

				<TextBlock Grid.Row="0" Grid.Column="6"
					Style="{StaticResource FormCaption}"
					Text="締日"
					Visibility="{Binding IsClosingBased, Converter={StaticResource BooleanToVisibilityConverter}}" />
				<ComboBox Grid.Row="0" Grid.Column="7"
					DisplayMemberPath="Name"
					ItemsSource="{Binding ShimeItems}"
					SelectedValue="{Binding SelectedShime, Mode=TwoWay}"
					SelectedValuePath="Value"
					Style="{StaticResource FormComboBox}"
					Visibility="{Binding IsClosingBased, Converter={StaticResource BooleanToVisibilityConverter}}" />

				<TextBlock Grid.Row="0" Grid.Column="9"
					Style="{StaticResource FormCaption}"
					Text="{Binding KeyDateLabel}" />
				<TextBox Grid.Row="0" Grid.Column="10"
					IsEnabled="{Binding IsFiscalStartUnset, Converter={StaticResource InverseBooleanConverter}}"
					Style="{StaticResource FormTextBox}"
					Text="{Binding KeyDateText, UpdateSourceTrigger=PropertyChanged, Delay=400}" />

				<TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="12"
					Margin="0,6,0,0"
					Foreground="{DynamicResource MaterialDesignBodyLight}"
					Text="{Binding KeyDateGuide}"
					TextWrapping="Wrap" />
			</Grid>
		</GroupBox>

		<!--  ② テンプレートCSVの出力  -->
		<GroupBox Grid.Row="1"
			Margin="0,8,0,0"
			Header="② テンプレートCSVの出力（Excelで期首残高を記入するための雛形）">
			<Grid Margin="4">
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="110" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="110" />
					<ColumnDefinition Width="24" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>

				<TextBlock Grid.Row="0" Grid.Column="0"
					Style="{StaticResource FormCaption}">
					<Run Text="{Binding OwnerLabel, Mode=OneWay}" /><Run Text="コード" />
				</TextBlock>
				<TextBox Grid.Row="0" Grid.Column="1"
					Style="{StaticResource FormTextBox}"
					Text="{Binding OwnerCodeFrom, UpdateSourceTrigger=PropertyChanged, Delay=400}" />
				<TextBlock Grid.Row="0" Grid.Column="2"
					Margin="6,0" VerticalAlignment="Center"
					Text="～" />
				<TextBox Grid.Row="0" Grid.Column="3"
					Style="{StaticResource FormTextBox}"
					Text="{Binding OwnerCodeTo, UpdateSourceTrigger=PropertyChanged, Delay=400}" />

				<TextBlock Grid.Row="0" Grid.Column="5"
					VerticalAlignment="Center">
					<Run Text="対象" /><Run FontWeight="Bold"
						Text="{Binding TargetCount, Mode=OneWay, StringFormat={}{0:N0}}" /><Run Text="件 ／ うち期首残あり" /><Run FontWeight="Bold"
						Text="{Binding ExistingCount, Mode=OneWay, StringFormat={}{0:N0}}" /><Run Text="件" />
				</TextBlock>

				<Button Grid.Row="0" Grid.Column="7"
					MinWidth="170"
					Command="{Binding ExportTemplateCommand}"
					Style="{StaticResource MaterialDesignRaisedButton}"
					ToolTip="テンプレート出力 (F3)">
					<StackPanel Orientation="Horizontal">
						<materialDesign:PackIcon VerticalAlignment="Center"
							Kind="FileExport" />
						<TextBlock Margin="6,0,0,0"
							Text="テンプレート出力" />
					</StackPanel>
				</Button>

				<StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="8"
					Margin="0,6,0,0"
					Orientation="Horizontal">
					<TextBlock Style="{StaticResource FormCaption}"
						Text="出力内容" />
					<RadioButton Margin="0,0,16,0"
						Content="全取引先（残高欄は空）" GroupName="TemplateMode"
						IsChecked="{Binding IsTemplateAllOwners, Mode=TwoWay}" />
					<RadioButton Margin="0,0,24,0"
						Content="既存の期首残がある取引先のみ" GroupName="TemplateMode"
						IsChecked="{Binding IsTemplateAllOwners, Mode=TwoWay, Converter={StaticResource InverseBooleanConverter}}" />
					<CheckBox Content="内訳列（売上・返品・値引・消費税・入金内訳）も出力する"
						IsChecked="{Binding IncludeBreakdown, Mode=TwoWay}" />
				</StackPanel>
			</Grid>
		</GroupBox>

		<!--  ③ CSV読込と登録  -->
		<GroupBox Grid.Row="2"
			Margin="0,8,0,0"
			Header="③ CSV読込と登録">
			<Grid Margin="4">
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="3*" />
					<RowDefinition Height="8" />
					<RowDefinition Height="2*" />
				</Grid.RowDefinitions>

				<Grid Grid.Row="0">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="8" />
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="8" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>

					<TextBlock Grid.Column="0"
						Style="{StaticResource FormCaption}"
						Text="CSVファイル" />
					<TextBox Grid.Column="1"
						IsReadOnly="True"
						Text="{Binding FilePath}" />
					<Button Grid.Column="3"
						MinWidth="110"
						Command="{Binding SelectFileCommand}"
						Style="{StaticResource MaterialDesignRaisedButton}"
						ToolTip="ファイル選択 (F4)">
						<StackPanel Orientation="Horizontal">
							<materialDesign:PackIcon VerticalAlignment="Center"
								Kind="FolderOpen" />
							<TextBlock Margin="6,0,0,0"
								Text="選択" />
						</StackPanel>
					</Button>
					<Button Grid.Column="5"
						MinWidth="110"
						Command="{Binding ValidateFileCommand}"
						Style="{StaticResource MaterialDesignOutlinedButton}"
						ToolTip="再検証 (F5)">
						<StackPanel Orientation="Horizontal">
							<materialDesign:PackIcon VerticalAlignment="Center"
								Kind="FileCheckOutline" />
							<TextBlock Margin="6,0,0,0"
								Text="再検証" />
						</StackPanel>
					</Button>
				</Grid>

				<Border Grid.Row="1"
					Margin="0,8,0,8" Padding="8"
					Background="{DynamicResource MaterialDesignPaper}">
					<StackPanel Orientation="Horizontal">
						<TextBlock Style="{StaticResource FormCaption}"
							Text="形式" />
						<TextBlock Margin="4,0,16,0" VerticalAlignment="Center"
							Text="{Binding FormatName}" />
						<TextBlock Style="{StaticResource FormCaption}"
							Text="データ行" />
						<TextBlock Style="{StaticResource SummaryValue}"
							Text="{Binding DataRowCount, StringFormat={}{0:N0}}" />
						<TextBlock Style="{StaticResource FormCaption}"
							Text="新規" />
						<TextBlock Style="{StaticResource SummaryValue}"
							Text="{Binding NewCount, StringFormat={}{0:N0}}" />
						<TextBlock Style="{StaticResource FormCaption}"
							Text="上書き" />
						<TextBlock Style="{StaticResource SummaryValue}"
							Text="{Binding OverwriteCount, StringFormat={}{0:N0}}" />
						<TextBlock Style="{StaticResource FormCaption}"
							Text="削除" />
						<TextBlock Style="{StaticResource SummaryValue}"
							Text="{Binding DeleteCount, StringFormat={}{0:N0}}" />
						<TextBlock Style="{StaticResource FormCaption}"
							Text="対象外" />
						<TextBlock Style="{StaticResource SummaryValue}"
							Text="{Binding SkipCount, StringFormat={}{0:N0}}" />
						<TextBlock Foreground="{DynamicResource MaterialDesignValidationErrorBrush}"
							Style="{StaticResource FormCaption}"
							Text="エラー" />
						<TextBlock Foreground="{DynamicResource MaterialDesignValidationErrorBrush}"
							Style="{StaticResource SummaryValue}"
							Text="{Binding ErrorCount, StringFormat={}{0:N0}}" />
						<TextBlock Style="{StaticResource FormCaption}"
							Text="警告" />
						<TextBlock Style="{StaticResource SummaryValue}"
							Text="{Binding WarningCount, StringFormat={}{0:N0}}" />
						<TextBlock Style="{StaticResource FormCaption}"
							Text="合計 期首残高" />
						<TextBlock MinWidth="120"
							VerticalAlignment="Center"
							FontWeight="Bold"
							Text="{Binding TotalAmount, StringFormat={}{0:N0}}"
							TextAlignment="Right" />
					</StackPanel>
				</Border>

				<GroupBox Grid.Row="2"
					Header="取込プレビュー（先頭100件）">
					<DataGrid d:ItemsSource="{d:SampleData ItemCount=5}"
						materialDesign:DataGridAssist.CellPadding="8,4" materialDesign:DataGridAssist.ColumnHeaderPadding="8,6" AutoGenerateColumns="False" CanUserAddRows="False"
						GridLinesVisibility="Horizontal" IsReadOnly="True"
						ItemsSource="{Binding PreviewRows}"
						RowHeight="28"
						Style="{StaticResource MaterialDesignDataGrid}">
						<DataGrid.Columns>
							<DataGridTextColumn Width="60"
								Binding="{Binding LineNo}"
								Header="行" />
							<DataGridTextColumn Width="80"
								Binding="{Binding Status}"
								Header="状態" />
							<DataGridTextColumn Width="130"
								Binding="{Binding Code}"
								Header="取引先コード" />
							<DataGridTextColumn Width="240"
								Binding="{Binding Name}"
								Header="取引先名" />
							<DataGridTextColumn Width="130"
								Binding="{Binding Amount, StringFormat={}{0:N0}}"
								ElementStyle="{StaticResource DataGridRightTextBlock}"
								Header="期首残高" />
							<DataGridTextColumn Width="130"
								Binding="{Binding BreakdownTotal, StringFormat={}{0:N0}}"
								ElementStyle="{StaticResource DataGridRightTextBlock}"
								Header="内訳計" />
							<DataGridTextColumn Width="130"
								Binding="{Binding Balance, StringFormat={}{0:N0}}"
								ElementStyle="{StaticResource DataGridRightTextBlock}"
								Header="内部残高" />
							<DataGridTextColumn Width="*"
								Binding="{Binding Note}"
								Header="備考" />
						</DataGrid.Columns>
					</DataGrid>
				</GroupBox>

				<GroupBox Grid.Row="4"
					Header="エラー・警告">
					<DataGrid d:ItemsSource="{d:SampleData ItemCount=5}"
						materialDesign:DataGridAssist.CellPadding="8,4" materialDesign:DataGridAssist.ColumnHeaderPadding="8,6" AutoGenerateColumns="False" CanUserAddRows="False"
						GridLinesVisibility="Horizontal" IsReadOnly="True"
						ItemsSource="{Binding ErrorRows}"
						RowHeight="28"
						Style="{StaticResource MaterialDesignDataGrid}">
						<DataGrid.Columns>
							<DataGridTextColumn Width="70"
								Binding="{Binding Kind}"
								Header="種別">
								<DataGridTextColumn.ElementStyle>
									<Style TargetType="TextBlock">
										<Setter Property="FontWeight" Value="SemiBold" />
										<Style.Triggers>
											<!--  警告は登録を止めない。止まるエラーだけを赤で示す  -->
											<DataTrigger Binding="{Binding IsWarning}"
												Value="False">
												<Setter Property="Foreground" Value="{DynamicResource MaterialDesignValidationErrorBrush}" />
											</DataTrigger>
										</Style.Triggers>
									</Style>
								</DataGridTextColumn.ElementStyle>
							</DataGridTextColumn>
							<DataGridTextColumn Width="60"
								Binding="{Binding LineNo}"
								Header="行" />
							<DataGridTextColumn Width="160"
								Binding="{Binding ColumnName}"
								Header="列" />
							<DataGridTextColumn Width="*"
								Binding="{Binding Detail}"
								Header="内容" />
						</DataGrid.Columns>
					</DataGrid>
				</GroupBox>
			</Grid>
		</GroupBox>

		<!--  操作  -->
		<Border Grid.Row="3"
			Margin="0,8,0,0" Padding="10"
			Background="{DynamicResource MaterialDesignToolBarBackground}">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="12" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>

				<TextBlock Grid.Column="0"
					VerticalAlignment="Center"
					Text="{Binding Message}"
					TextTrimming="CharacterEllipsis"
					ToolTip="{Binding Message}" />
				<Button Grid.Column="1"
					MinWidth="140"
					Command="{Binding RegisterCommand}"
					IsEnabled="{Binding CanRegister}"
					Style="{StaticResource MaterialDesignRaisedButton}"
					ToolTip="登録実行 (F6)">
					<StackPanel Orientation="Horizontal">
						<materialDesign:PackIcon VerticalAlignment="Center"
							Kind="DatabaseImport" />
						<TextBlock Margin="6,0,0,0"
							Text="登録実行" />
					</StackPanel>
				</Button>
				<Button Grid.Column="3"
					MinWidth="100"
					Command="{Binding ExitCommand}"
					Content="戻る (ESC)" IsCancel="True"
					Style="{StaticResource MaterialDesignOutlinedButton}" />
			</Grid>
		</Border>
	</Grid>
</helpers:BaseWindow>
