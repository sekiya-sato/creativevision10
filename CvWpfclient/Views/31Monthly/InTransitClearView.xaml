<helpers:BaseWindow x:Class="CvWpfclient.Views._31Monthly.InTransitClearView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:helpers="clr-namespace:CvWpfclient.Helpers" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:vm="clr-namespace:CvWpfclient.ViewModels._31Monthly"
	Title="積送中クリア"
	Width="{StaticResource StandardWindowWidth}" Height="{StaticResource StandardWindowHeight}"
	MinWidth="800" MinHeight="650"
	Background="{DynamicResource AppCommonBackgroundBrush}"
	FontSize="16"
	Foreground="{DynamicResource MaterialDesignBody}"
	ResizeMode="CanResize" TextOptions.TextFormattingMode="Display"
	mc:Ignorable="d">
	<helpers:BaseWindow.DataContext>
		<vm:InTransitClearViewModel />
	</helpers:BaseWindow.DataContext>
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>
		<materialDesign:ColorZone Grid.Row="0"
			Padding="14,10"
			materialDesign:ElevationAssist.Elevation="Dp4" Mode="PrimaryMid">
			<StackPanel Orientation="Horizontal">
				<materialDesign:PackIcon Width="30" Height="30"
					VerticalAlignment="Center"
					Kind="ClipboardCheckOutline" />
				<TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
					FontSize="20" FontWeight="SemiBold" Text="積送中クリア" />
			</StackPanel>
		</materialDesign:ColorZone>
		<Grid Grid.Row="1"
			Margin="18">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
			</Grid.RowDefinitions>
			<materialDesign:Card Grid.Row="0"
				Padding="20"
				materialDesign:ElevationAssist.Elevation="Dp2" UniformCornerRadius="8">
				<StackPanel>
					<TextBlock Text="移動先倉庫の積送残を移動受でクリアします。正数量は実在庫が増加、負数量は減少します。実行中は移動・HHT更新を停止してください。" TextWrapping="Wrap" />
					<TextBlock Margin="0,8,0,0"
						Foreground="{DynamicResource MaterialDesignBodyLight}"
						Text="正負の積送残を含む倉庫は、合計が0でも表示します。出庫番号別の消込は行いません。クリア済み分を通常の移動受で再登録しないでください。通信エラーで結果が不明な場合は、登録済み伝票と積送残を確認してから再実行してください。" TextWrapping="Wrap" />
					<CheckBox Margin="0,12,0,0"
						Content="移動・HHT更新を停止しました"
						IsChecked="{Binding OperationStopped, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
						IsEnabled="{Binding IsProcessing, Converter={StaticResource InverseBooleanConverter}}" />
				</StackPanel>
			</materialDesign:Card>
			<materialDesign:Card Grid.Row="1"
				Margin="0,14,0,0" Padding="0"
				materialDesign:ElevationAssist.Elevation="Dp2" UniformCornerRadius="8">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
					</Grid.RowDefinitions>
					<Border Grid.Row="0"
						Padding="12,8"
						Background="{DynamicResource MaterialDesignToolBarBackground}"
						CornerRadius="8,8,0,0">
						<WrapPanel IsEnabled="{Binding IsProcessing, Converter={StaticResource InverseBooleanConverter}}">
							<Button Margin="0,0,12,0"
								Command="{Binding LoadStatusCommand}"
								Content="一覧再取得"
								Style="{StaticResource MaterialDesignOutlinedButton}" />
							<Button Margin="0,0,8,0"
								Command="{Binding SelectAllTargetsCommand}"
								Content="全選択"
								Style="{StaticResource MaterialDesignOutlinedButton}" />
							<Button Command="{Binding ClearAllTargetsCommand}"
								Content="全解除"
								Style="{StaticResource MaterialDesignOutlinedButton}" />
						</WrapPanel>
					</Border>
					<DataGrid Grid.Row="1"
						materialDesign:DataGridAssist.CellPadding="10,6" materialDesign:DataGridAssist.ColumnHeaderPadding="10,8" AutoGenerateColumns="False" CanUserAddRows="False"
						CanUserDeleteRows="False" EnableRowVirtualization="True" FontSize="14" GridLinesVisibility="Horizontal"
						HorizontalGridLinesBrush="{DynamicResource MaterialDesignDivider}"
						IsEnabled="{Binding IsProcessing, Converter={StaticResource InverseBooleanConverter}}"
						IsReadOnly="True"
						ItemsSource="{Binding Rows}"
						ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"
						Style="{StaticResource MaterialDesignDataGrid}"
						VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
						<DataGrid.Columns>
							<DataGridTemplateColumn Width="60"
								Header="対象">
								<DataGridTemplateColumn.CellTemplate>
									<DataTemplate>
										<CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
											IsChecked="{Binding IsTarget, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
									</DataTemplate>
								</DataGridTemplateColumn.CellTemplate>
							</DataGridTemplateColumn>
							<DataGridTextColumn Width="110"
								Binding="{Binding WarehouseCode}"
								Header="倉庫コード" />
							<DataGridTextColumn Width="*" MinWidth="160"
								Binding="{Binding WarehouseName}"
								Header="倉庫名" />
							<DataGridTextColumn Width="130"
								Binding="{Binding TransitQty, StringFormat={}{0:N0}}"
								ElementStyle="{StaticResource DataGridRightTextBlock}"
								Header="積送残合計" />
							<DataGridTextColumn Width="130"
								Binding="{Binding PositiveQty, StringFormat={}{0:N0}}"
								ElementStyle="{StaticResource DataGridRightTextBlock}"
								Header="正数量" />
							<DataGridTextColumn Width="130"
								Binding="{Binding NegativeQty, StringFormat={}{0:N0}}"
								ElementStyle="{StaticResource DataGridRightTextBlock}"
								Header="負数量" />
							<DataGridTextColumn Width="100"
								Binding="{Binding SkuCount, StringFormat={}{0:N0}}"
								ElementStyle="{StaticResource DataGridRightTextBlock}"
								Header="対象SKU数" />
						</DataGrid.Columns>
						<DataGrid.ColumnHeaderStyle>
							<Style BasedOn="{StaticResource MenteDataGridColumnHeader}"
								TargetType="DataGridColumnHeader" />
						</DataGrid.ColumnHeaderStyle>
					</DataGrid>
				</Grid>
			</materialDesign:Card>
		</Grid>
		<Border Grid.Row="2"
			Padding="18,12"
			Background="{DynamicResource MaterialDesignPaper}">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>
				<ProgressBar Grid.Row="0"
					Height="4"
					Margin="0,0,0,8"
					IsIndeterminate="True"
					Visibility="{Binding IsProcessing, Converter={StaticResource BooleanToVisibilityConverter}}" />
				<TextBlock Grid.Row="1"
					Margin="0,0,0,8"
					Text="{Binding StatusMessage}" TextWrapping="Wrap" />
				<TextBlock Grid.Row="2"
					Margin="0,0,0,8"
					Foreground="{DynamicResource MaterialDesignValidationErrorBrush}"
					Text="登録結果が不明です。移動受伝票と積送残を確認してください。"
					TextWrapping="Wrap"
					Visibility="{Binding HasUncertainResult, Converter={StaticResource BooleanToVisibilityConverter}}" />
				<StackPanel Grid.Row="3"
					HorizontalAlignment="Right"
					Orientation="Horizontal">
					<Button Width="150" Height="38"
						Margin="0,0,10,0"
						Command="{Binding ExecuteCommand}"
						Content="積送中クリア実行"
						Style="{StaticResource MaterialDesignRaisedButton}" />
					<Button Width="128" Height="38"
						Command="{Binding ExitCommand}"
						Content="閉じる"
						Style="{StaticResource MaterialDesignOutlinedButton}" />
				</StackPanel>
			</Grid>
		</Border>
	</Grid>
</helpers:BaseWindow>
