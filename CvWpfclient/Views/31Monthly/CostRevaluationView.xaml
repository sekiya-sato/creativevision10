<helpers:BaseWindow x:Class="CvWpfclient.Views._31Monthly.CostRevaluationView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:helpers="clr-namespace:CvWpfclient.Helpers"
	xmlns:local="clr-namespace:CvWpfclient.Views" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:vm="clr-namespace:CvWpfclient.ViewModels._31Monthly"
	Title="評価替え"
	Width="{StaticResource StandardWindowWidth}"
	Height="{StaticResource StandardWindowHeight}"
	Background="{DynamicResource AppCommonBackgroundBrush}"
	Foreground="{DynamicResource MaterialDesignBody}"
	TextOptions.TextFormattingMode="Display"
	mc:Ignorable="d">
	<helpers:BaseWindow.DataContext>
		<vm:CostRevaluationViewModel />
	</helpers:BaseWindow.DataContext>

	<helpers:BaseWindow.Resources>
		<SolidColorBrush x:Key="RevalExcludedForegroundBrush"
			Color="#757575" />
		<SolidColorBrush x:Key="RevalErrorForegroundBrush"
			Color="#D32F2F" />

		<Style x:Key="RevalDetailRowStyle"
			TargetType="DataGridRow">
			<Style.Triggers>
				<DataTrigger Binding="{Binding IsTarget}"
					Value="False">
					<Setter Property="Foreground" Value="{StaticResource RevalExcludedForegroundBrush}" />
				</DataTrigger>
				<DataTrigger Binding="{Binding IsError}"
					Value="True">
					<Setter Property="Foreground" Value="{StaticResource RevalErrorForegroundBrush}" />
					<Setter Property="FontWeight" Value="SemiBold" />
				</DataTrigger>
			</Style.Triggers>
		</Style>
	</helpers:BaseWindow.Resources>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<materialDesign:ColorZone Grid.Row="0"
			Padding="14,10"
			materialDesign:ElevationAssist.Elevation="Dp4" Mode="PrimaryMid">
			<StackPanel Orientation="Horizontal">
				<materialDesign:PackIcon Width="30" Height="30"
					VerticalAlignment="Center"
					Kind="CalculatorVariantOutline" />
				<TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
					FontSize="20" FontWeight="SemiBold" Text="評価替え" />
				<TextBlock Margin="16,0,0,0" VerticalAlignment="Center"
					FontSize="13" Opacity="0.85" Text="条件で抽出した在庫商品の原価を引き下げ、指定計上月の原価履歴として確定します。" />
			</StackPanel>
		</materialDesign:ColorZone>

		<ScrollViewer Grid.Row="1"
			Margin="18"
			HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
			<StackPanel>

				<materialDesign:Card Padding="24"
					materialDesign:ElevationAssist.Elevation="Dp2" UniformCornerRadius="8">
					<Grid>
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
						</Grid.RowDefinitions>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="120" />
							<ColumnDefinition Width="160" />
							<ColumnDefinition Width="120" />
							<ColumnDefinition Width="200" />
							<ColumnDefinition Width="120" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>

						<TextBlock Grid.Row="0" Grid.Column="0"
							VerticalAlignment="Center"
							Style="{StaticResource SettingLabel}"
							Text="変更日(計上月)" />
						<TextBox Grid.Row="0" Grid.Column="1"
							Width="120"
							HorizontalAlignment="Left" VerticalAlignment="Center"
							helpers:YearMonthInputBehavior.IsEnabled="True"
							IsEnabled="{Binding IsProcessing, Converter={StaticResource InverseBooleanConverter}}"
							MaxLength="7"
							Style="{StaticResource MaterialDesignOutlinedTextBox}"
							Text="{Binding TargetMonth}" />

						<TextBlock Grid.Row="0" Grid.Column="2"
							VerticalAlignment="Center"
							Style="{StaticResource SettingLabel}"
							Text="適用時点" />
						<ComboBox Grid.Row="0" Grid.Column="3"
							Width="180"
							HorizontalAlignment="Left" VerticalAlignment="Center"
							DisplayMemberPath="Name"
							IsEnabled="{Binding IsProcessing, Converter={StaticResource InverseBooleanConverter}}"
							ItemsSource="{Binding ApplyPointOptions}"
							SelectedValue="{Binding ApplyPoint}"
							SelectedValuePath="Value"
							Style="{StaticResource MaterialDesignOutlinedComboBox}" />

						<TextBlock Grid.Row="0" Grid.Column="4"
							VerticalAlignment="Center"
							Style="{StaticResource SettingLabel}"
							Text="対象期間" />
						<TextBlock Grid.Row="0" Grid.Column="5"
							VerticalAlignment="Center"
							Text="{Binding PeriodText}" />

						<TextBlock Grid.Row="1" Grid.Column="0"
							Margin="0,12,0,0" VerticalAlignment="Center"
							Style="{StaticResource SettingLabel}"
							Text="集計単位" />
						<ComboBox Grid.Row="1" Grid.Column="1"
							Width="140"
							Margin="0,12,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
							DisplayMemberPath="Name"
							IsEnabled="{Binding IsProcessing, Converter={StaticResource InverseBooleanConverter}}"
							ItemsSource="{Binding GroupKeyOptions}"
							SelectedValue="{Binding GroupKey}"
							SelectedValuePath="Value"
							Style="{StaticResource MaterialDesignOutlinedComboBox}" />

						<TextBlock Grid.Row="1" Grid.Column="2"
							Margin="0,12,0,0" VerticalAlignment="Center"
							Style="{StaticResource SettingLabel}"
							Text="指定方式" />
						<ComboBox Grid.Row="1" Grid.Column="3"
							Width="160"
							Margin="0,12,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
							DisplayMemberPath="Name"
							IsEnabled="{Binding IsProcessing, Converter={StaticResource InverseBooleanConverter}}"
							ItemsSource="{Binding MethodOptions}"
							SelectedValue="{Binding Method}"
							SelectedValuePath="Value"
							Style="{StaticResource MaterialDesignOutlinedComboBox}" />

						<TextBlock Grid.Row="2" Grid.Column="0"
							Margin="0,12,0,0" VerticalAlignment="Center"
							Style="{StaticResource SettingLabel}"
							Text="掛率(%)" />
						<StackPanel Grid.Row="2" Grid.Column="1"
							Margin="0,12,0,0"
							Orientation="Horizontal">
							<TextBox Width="80"
								HorizontalAlignment="Left" VerticalAlignment="Center"
								IsEnabled="{Binding IsProcessing, Converter={StaticResource InverseBooleanConverter}}"
								MaxLength="3"
								Style="{StaticResource MaterialDesignOutlinedTextBox}"
								Text="{Binding RatePercent}" />
						</StackPanel>

						<TextBlock Grid.Row="2" Grid.Column="2"
							Margin="0,12,0,0" VerticalAlignment="Center"
							Style="{StaticResource SettingLabel}"
							Text="指定単価(円)" />
						<TextBox Grid.Row="2" Grid.Column="3"
							Width="140"
							Margin="0,12,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
							IsEnabled="{Binding IsProcessing, Converter={StaticResource InverseBooleanConverter}}"
							MaxLength="9"
							Style="{StaticResource MaterialDesignOutlinedTextBox}"
							Text="{Binding FixedCost}" />

						<TextBlock Grid.Row="2" Grid.Column="4"
							Margin="0,12,0,0" VerticalAlignment="Center"
							Style="{StaticResource SettingLabel}"
							Text="端数単位／処理" />
						<StackPanel Grid.Row="2" Grid.Column="5"
							Margin="0,12,0,0"
							Orientation="Horizontal">
							<ComboBox Width="90"
								HorizontalAlignment="Left" VerticalAlignment="Center"
								IsEnabled="{Binding IsProcessing, Converter={StaticResource InverseBooleanConverter}}"
								ItemsSource="{Binding RoundingUnitOptions}"
								SelectedItem="{Binding RoundingUnit}"
								Style="{StaticResource MaterialDesignOutlinedComboBox}" />
							<ComboBox Width="120"
								Margin="8,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
								DisplayMemberPath="Name"
								IsEnabled="{Binding IsProcessing, Converter={StaticResource InverseBooleanConverter}}"
								ItemsSource="{Binding RoundingOptions}"
								SelectedValue="{Binding Rounding}"
								SelectedValuePath="Value"
								Style="{StaticResource MaterialDesignOutlinedComboBox}" />
						</StackPanel>
					</Grid>
				</materialDesign:Card>

				<!--  掛率の計算式(設計書§16.5「画面ラベルは『率』ではなく『掛率』とし、入力欄の直後に計算式を表示」)  -->
				<materialDesign:Card Margin="0,8,0,0" Padding="10,6"
					Background="{DynamicResource MaterialDesignChipBackground}"
					UniformCornerRadius="6">
					<StackPanel Orientation="Horizontal">
						<materialDesign:PackIcon VerticalAlignment="Center"
							Kind="Calculator" />
						<TextBlock Margin="8,0,0,0" VerticalAlignment="Center"
							Text="{Binding RateFormulaText}" />
					</StackPanel>
				</materialDesign:Card>

				<GroupBox Margin="0,8,0,0"
					Header="抽出条件（0行なら全在庫商品が対象）">
					<StackPanel Margin="8">
						<DataGrid Height="150"
							AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
							ItemsSource="{Binding CondRows}">
							<DataGrid.Columns>
								<DataGridComboBoxColumn Width="140"
									DisplayMemberPath="Name" Header="項目"
									ItemsSource="{Binding Source={x:Static vm:CostRevaluationViewModel.CondFieldOptionsStatic}}"
									SelectedItemBinding="{Binding Field, Mode=TwoWay}" />
								<DataGridTextColumn Width="140"
									Binding="{Binding CodeFrom}"
									Header="From" />
								<DataGridTextColumn Width="140"
									Binding="{Binding CodeTo}"
									Header="To" />
								<DataGridTemplateColumn Width="70"
									Header="削除">
									<DataGridTemplateColumn.CellTemplate>
										<DataTemplate>
											<Button Padding="4"
												Command="{Binding DataContext.RemoveCondRowCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
												CommandParameter="{Binding}"
												Style="{StaticResource MaterialDesignIconButton}">
												<materialDesign:PackIcon Kind="Delete" />
											</Button>
										</DataTemplate>
									</DataGridTemplateColumn.CellTemplate>
								</DataGridTemplateColumn>
							</DataGrid.Columns>
						</DataGrid>
						<Button Width="140"
							Margin="0,8,0,0" HorizontalAlignment="Left"
							Command="{Binding AddCondRowCommand}"
							Style="{StaticResource MaterialDesignOutlinedButton}">
							<StackPanel Orientation="Horizontal">
								<materialDesign:PackIcon VerticalAlignment="Center"
									Kind="Plus" />
								<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
									Text="条件行を追加" />
							</StackPanel>
						</Button>
					</StackPanel>
				</GroupBox>

				<ItemsControl Margin="0,8,0,0"
					ItemsSource="{Binding InfoMessages}">
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<materialDesign:Card Margin="0,4,0,0" Padding="10,6"
								Background="{DynamicResource MaterialDesignChipBackground}"
								UniformCornerRadius="6">
								<StackPanel Orientation="Horizontal">
									<materialDesign:PackIcon VerticalAlignment="Center"
										Kind="InformationOutline" />
									<TextBlock Margin="8,0,0,0" VerticalAlignment="Center"
										Text="{Binding}"
										TextWrapping="Wrap" />
								</StackPanel>
							</materialDesign:Card>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>

				<GroupBox Margin="0,8,0,0"
					Header="集計行（最下部が全体の合計）">
					<DataGrid Height="150"
						Margin="8"
						AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
						ItemsSource="{Binding SummaryRows}">
						<DataGrid.Columns>
							<DataGridTextColumn Width="160"
								Header="集計単位">
								<DataGridTextColumn.Binding>
									<MultiBinding StringFormat="{}{0} {1}">
										<Binding Path="GroupCode" />
										<Binding Path="GroupName" />
									</MultiBinding>
								</DataGridTextColumn.Binding>
							</DataGridTextColumn>
							<DataGridTextColumn Width="90"
								Binding="{Binding TargetCount}"
								Header="対象品番数" />
							<DataGridTextColumn Width="90"
								Binding="{Binding Qty}"
								Header="数量" />
							<DataGridTextColumn Width="110"
								Binding="{Binding JodaiAmount, StringFormat=N0}"
								Header="元上代金額" />
							<DataGridTextColumn Width="110"
								Binding="{Binding BeforeAmount, StringFormat=N0}"
								Header="在庫金額" />
							<DataGridTextColumn Width="110"
								Binding="{Binding AfterAmount, StringFormat=N0}"
								Header="評価減後金額" />
							<DataGridTextColumn Width="110"
								Binding="{Binding DiffAmount, StringFormat=N0}"
								Header="評価減差額" />
						</DataGrid.Columns>
					</DataGrid>
				</GroupBox>

				<materialDesign:Card Margin="0,4,0,0" Padding="10,6"
					Background="{DynamicResource MaterialDesignChipBackground}"
					UniformCornerRadius="6">
					<StackPanel Orientation="Horizontal">
						<TextBlock FontWeight="SemiBold" Text="合計: " />
						<TextBlock Text="{Binding TotalRow.TargetCount, StringFormat='対象品番数 {0:N0}'}" />
						<TextBlock Margin="12,0,0,0"
							Text="{Binding TotalRow.Qty, StringFormat='数量 {0:N0}'}" />
						<TextBlock Margin="12,0,0,0"
							Text="{Binding TotalRow.BeforeAmount, StringFormat='在庫金額 {0:N0}'}" />
						<TextBlock Margin="12,0,0,0"
							Text="{Binding TotalRow.AfterAmount, StringFormat='評価減後金額 {0:N0}'}" />
						<TextBlock Margin="12,0,0,0"
							Text="{Binding TotalRow.DiffAmount, StringFormat='評価減差額 {0:N0}'}" />
					</StackPanel>
				</materialDesign:Card>

				<GroupBox Margin="0,8,0,0"
					Header="明細行">
					<Grid Margin="8">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="*" />
						</Grid.RowDefinitions>

						<StackPanel Grid.Row="0"
							Margin="0,0,0,8"
							Orientation="Horizontal">
							<TextBlock VerticalAlignment="Center"
								Text="{Binding TargetCount, StringFormat='対象 {0:N0} 品番'}" />
							<TextBlock Margin="16,0,0,0" VerticalAlignment="Center"
								Foreground="{StaticResource RevalErrorForegroundBrush}"
								Text="{Binding ErrorCount, StringFormat='エラー {0:N0} 件'}" />
							<CheckBox Margin="24,0,0,0" VerticalAlignment="Center"
								Content="対象外行のみ表示（理由: 在庫0／原価0／引き下げにならない）"
								IsChecked="{Binding ShowExcludedOnly}" />
							<Button Margin="24,0,0,0"
								Command="{Binding ExportCsvCommand}"
								Style="{StaticResource MaterialDesignOutlinedButton}">
								<StackPanel Orientation="Horizontal">
									<materialDesign:PackIcon VerticalAlignment="Center"
										Kind="FileDelimitedOutline" />
									<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
										Text="CSV出力" />
								</StackPanel>
							</Button>
						</StackPanel>

						<DataGrid Grid.Row="1"
							Height="260"
							AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
							ItemsSource="{Binding DetailRows}"
							RowStyle="{StaticResource RevalDetailRowStyle}">
							<DataGrid.Columns>
								<DataGridTextColumn Width="200"
									Binding="{Binding ShohinText}"
									Header="商品" />
								<DataGridTextColumn Width="100"
									Binding="{Binding MeiSeason}"
									Header="シーズン" />
								<DataGridTextColumn Width="100"
									Binding="{Binding MeiBrand}"
									Header="ブランド" />
								<DataGridTextColumn Width="100"
									Binding="{Binding MeiItem}"
									Header="アイテム" />
								<DataGridTextColumn Width="80"
									Binding="{Binding Jodai, StringFormat=N0}"
									Header="上代" />
								<DataGridTextColumn Width="70"
									Binding="{Binding Qty}"
									Header="数量" />
								<DataGridTextColumn Width="90"
									Binding="{Binding BeforeCost, StringFormat=N0}"
									Header="前原価" />
								<DataGridTextColumn Width="90"
									Binding="{Binding AfterCost, StringFormat=N0}"
									Header="後原価" />
								<DataGridTextColumn Width="100"
									Binding="{Binding BeforeAmount, StringFormat=N0}"
									Header="在庫金額" />
								<DataGridTextColumn Width="110"
									Binding="{Binding AfterAmount, StringFormat=N0}"
									Header="評価減後金額" />
								<DataGridTextColumn Width="70"
									Binding="{Binding StatusText}"
									Header="状態" />
								<DataGridTextColumn Width="220"
									Binding="{Binding ReasonText}"
									Header="エラー" />
							</DataGrid.Columns>
						</DataGrid>
					</Grid>
				</GroupBox>

				<GroupBox Margin="0,8,0,0"
					Header="実行履歴（ヘッダ単位で取消できます。取消は元に戻せません）">
					<Grid Margin="8">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="*" />
						</Grid.RowDefinitions>

						<Button Grid.Row="0"
							Width="160"
							Margin="0,0,0,8" HorizontalAlignment="Right"
							Command="{Binding CancelHistoryCommand}"
							Style="{StaticResource MaterialDesignOutlinedButton}">
							<StackPanel Orientation="Horizontal">
								<materialDesign:PackIcon VerticalAlignment="Center"
									Kind="Close" />
								<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
									Text="選択行を取消" />
							</StackPanel>
						</Button>

						<DataGrid Grid.Row="1"
							Height="180"
							AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
							ItemsSource="{Binding HistoryRows}"
							SelectedItem="{Binding SelectedHistoryRow}"
							SelectionMode="Single">
							<DataGrid.Columns>
								<DataGridTextColumn Width="90"
									Binding="{Binding SumMonthText}"
									Header="対象計上月" />
								<DataGridTextColumn Width="100"
									Binding="{Binding EffectiveDayText}"
									Header="原価適用日" />
								<DataGridTextColumn Width="90"
									Binding="{Binding GroupKeyText}"
									Header="集計単位" />
								<DataGridTextColumn Width="90"
									Binding="{Binding MethodText}"
									Header="指定方式" />
								<DataGridTextColumn Width="100"
									Binding="{Binding SpecText}"
									Header="指定値" />
								<DataGridTextColumn Width="120"
									Binding="{Binding RoundingText}"
									Header="端数" />
								<DataGridTextColumn Width="80"
									Binding="{Binding TargetCount}"
									Header="対象品番数" />
								<DataGridTextColumn Width="100"
									Binding="{Binding BeforeAmount, StringFormat=N0}"
									Header="在庫金額" />
								<DataGridTextColumn Width="100"
									Binding="{Binding AfterAmount, StringFormat=N0}"
									Header="評価減後金額" />
								<DataGridTextColumn Width="140"
									Binding="{Binding RunAtText}"
									Header="実行日時" />
								<DataGridTextColumn Width="120"
									Binding="{Binding VShainMei}"
									Header="実行社員" />
							</DataGrid.Columns>
						</DataGrid>
					</Grid>
				</GroupBox>

				<GroupBox Margin="0,8,0,0"
					Header="処理メッセージ">
					<TextBox MaxHeight="60"
						Margin="8"
						IsReadOnly="True"
						Style="{StaticResource MaterialDesignTextBox}"
						Text="{Binding StatusMessage, UpdateSourceTrigger=PropertyChanged}"
						TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
				</GroupBox>
			</StackPanel>
		</ScrollViewer>

		<Border Grid.Row="2"
			Padding="18,12"
			Background="{DynamicResource MaterialDesignPaper}">
			<Grid>
				<ProgressBar Width="200" Height="4"
					HorizontalAlignment="Left" VerticalAlignment="Bottom"
					Maximum="100"
					Visibility="{Binding IsProcessing, Converter={StaticResource BooleanToVisibilityConverter}}"
					Value="{Binding ProgressValue, Mode=OneWay}" />
				<StackPanel HorizontalAlignment="Right"
					Orientation="Horizontal">
					<Button Width="128" Height="38"
						Margin="0,0,10,0"
						Command="{Binding ConfirmCommand}"
						IsDefault="True"
						Style="{StaticResource MaterialDesignRaisedButton}">
						<StackPanel Orientation="Horizontal">
							<materialDesign:PackIcon VerticalAlignment="Center"
								Kind="ClipboardCheckOutline" />
							<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
								Text="確認" />
						</StackPanel>
					</Button>
					<Button Width="128" Height="38"
						Margin="0,0,10,0"
						Command="{Binding UpdateCommand}"
						Style="{StaticResource MaterialDesignRaisedButton}">
						<StackPanel Orientation="Horizontal">
							<materialDesign:PackIcon VerticalAlignment="Center"
								Kind="ContentSave" />
							<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
								Text="更新" />
						</StackPanel>
					</Button>
					<Button Width="128" Height="38"
						Command="{Binding ExitCommand}"
						IsCancel="True"
						Style="{StaticResource MaterialDesignOutlinedButton}">
						<StackPanel Orientation="Horizontal">
							<materialDesign:PackIcon VerticalAlignment="Center"
								Kind="ArrowLeft" />
							<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
								Text="キャンセル" />
						</StackPanel>
					</Button>
				</StackPanel>
			</Grid>
		</Border>
	</Grid>
</helpers:BaseWindow>
