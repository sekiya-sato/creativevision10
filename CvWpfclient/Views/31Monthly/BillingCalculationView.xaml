<helpers:BaseWindow x:Class="CvWpfclient.Views._31Monthly.BillingCalculationView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:helpers="clr-namespace:CvWpfclient.Helpers" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:vm="clr-namespace:CvWpfclient.ViewModels._31Monthly"
	Title="請求計算"
	Width="820" Height="650"
	Background="{DynamicResource AppCommonBackgroundBrush}"
	FontSize="16"
	Foreground="{DynamicResource MaterialDesignBody}"
	ResizeMode="NoResize" TextOptions.TextFormattingMode="Display"
	mc:Ignorable="d">
	<helpers:BaseWindow.DataContext>
		<vm:BillingCalculationViewModel />
	</helpers:BaseWindow.DataContext>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<materialDesign:ColorZone Grid.Row="0"
			Padding="14,10"
			materialDesign:ElevationAssist.Elevation="Dp4" Mode="PrimaryMid">
			<StackPanel Orientation="Horizontal">
				<materialDesign:PackIcon Width="30" Height="30"
					VerticalAlignment="Center"
					Kind="FileDocumentEditOutline" />
				<TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
					FontSize="20" FontWeight="SemiBold" Text="請求計算" />
			</StackPanel>
		</materialDesign:ColorZone>

		<Grid Grid.Row="1"
			Margin="18">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
			</Grid.RowDefinitions>

			<materialDesign:Card Grid.Row="0"
				Padding="24"
				materialDesign:ElevationAssist.Elevation="Dp2" UniformCornerRadius="8">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="140" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>

					<TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
						Margin="0,0,0,16"
						Text="得意先の締日・請求月ごとに請求残を作成します。再実行時は請求書番号と連番を維持して内訳を作り直します。" TextWrapping="Wrap" />

					<TextBlock Grid.Row="1" Grid.Column="0"
						Style="{StaticResource SettingLabel}"
						Text="請求月" />
					<TextBox Grid.Row="1" Grid.Column="1"
						Width="120"
						HorizontalAlignment="Left" VerticalAlignment="Center"
						IsEnabled="{Binding IsProcessing, Converter={StaticResource InverseBooleanConverter}}"
						MaxLength="7"
						Style="{StaticResource MaterialDesignOutlinedTextBox}"
						Text="{Binding BillingMonth}" />

					<TextBlock Grid.Row="2" Grid.Column="0"
						Margin="0,16,0,0"
						Style="{StaticResource SettingLabel}"
						Text="締日" />
					<ComboBox Grid.Row="2" Grid.Column="1"
						Width="160"
						Margin="0,16,0,0" HorizontalAlignment="Left"
						DisplayMemberPath="Name"
						IsEnabled="{Binding IsProcessing, Converter={StaticResource InverseBooleanConverter}}"
						ItemsSource="{Binding ShimeItems}"
						SelectedValue="{Binding SelectedShime}"
						SelectedValuePath="Value"
						Style="{StaticResource MaterialDesignOutlinedComboBox}" />

					<TextBlock Grid.Row="3" Grid.Column="0"
						Margin="0,16,0,0"
						Style="{StaticResource SettingLabel}"
						Text="得意先コード範囲" />
					<StackPanel Grid.Row="3" Grid.Column="1"
						Margin="0,16,0,0"
						Orientation="Horizontal">
						<TextBox Width="160"
							IsEnabled="{Binding IsProcessing, Converter={StaticResource InverseBooleanConverter}}"
							Style="{StaticResource MaterialDesignOutlinedTextBox}"
							Text="{Binding TorihikiCodeFrom}" />
						<TextBlock Margin="10,0" VerticalAlignment="Center"
							Text="～" />
						<TextBox Width="160"
							IsEnabled="{Binding IsProcessing, Converter={StaticResource InverseBooleanConverter}}"
							Style="{StaticResource MaterialDesignOutlinedTextBox}"
							Text="{Binding TorihikiCodeTo}" />
					</StackPanel>

					<CheckBox Grid.Row="4" Grid.Column="1"
						Margin="0,16,0,0"
						Content="請求書を再発行する（連番を+1）"
						IsChecked="{Binding IsReissue}"
						IsEnabled="{Binding IsProcessing, Converter={StaticResource InverseBooleanConverter}}" />

					<TextBlock Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2"
						Margin="0,16,0,0"
						Foreground="{DynamicResource NegativeForegroundBrush}"
						Text="{Binding WarningMessage}"
						TextWrapping="Wrap"
						Visibility="{Binding WarningMessage, Converter={StaticResource StringIsNotEmptyToVisibilityConverter}}" />
				</Grid>
			</materialDesign:Card>

			<GroupBox Grid.Row="1"
				Margin="0,18,0,0"
				Header="処理メッセージ">
				<Grid Margin="8">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
					</Grid.RowDefinitions>
					<ProgressBar Height="18"
						Maximum="100" Minimum="0"
						Value="{Binding ProgressValue}" />
					<TextBox Grid.Row="1"
						Margin="0,8,0,0"
						IsReadOnly="True"
						Style="{StaticResource MaterialDesignTextBox}"
						Text="{Binding StatusMessage, UpdateSourceTrigger=PropertyChanged}"
						TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
				</Grid>
			</GroupBox>
		</Grid>

		<Border Grid.Row="2"
			Padding="18,12"
			Background="{DynamicResource MaterialDesignPaper}">
			<StackPanel HorizontalAlignment="Right"
				Orientation="Horizontal">
				<Button Width="128" Height="38"
					Margin="0,0,10,0"
					Command="{Binding ExecuteCommand}"
					IsDefault="True"
					Style="{StaticResource MaterialDesignRaisedButton}">
					<StackPanel Orientation="Horizontal">
						<materialDesign:PackIcon VerticalAlignment="Center"
							Kind="CalculatorVariantOutline" />
						<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
							Text="実行" />
					</StackPanel>
				</Button>
				<Button Width="128" Height="38"
					Command="{Binding ExitCommand}"
					IsCancel="True"
					Style="{StaticResource MaterialDesignOutlinedButton}">
					<StackPanel Orientation="Horizontal">
						<materialDesign:PackIcon VerticalAlignment="Center"
							Kind="ArrowLeft" />
						<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
							Text="キャンセル" />
					</StackPanel>
				</Button>
			</StackPanel>
		</Border>
	</Grid>
</helpers:BaseWindow>
