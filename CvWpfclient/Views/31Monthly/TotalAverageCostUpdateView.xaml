<helpers:BaseWindow x:Class="CvWpfclient.Views._31Monthly.TotalAverageCostUpdateView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:helpers="clr-namespace:CvWpfclient.Helpers"
	xmlns:local="clr-namespace:CvWpfclient.Views" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:vm="clr-namespace:CvWpfclient.ViewModels._31Monthly"
	Title="総平均原価更新"
	Width="{StaticResource StandardWindowWidth}"
	Height="{StaticResource StandardWindowHeight}"
	Background="{DynamicResource AppCommonBackgroundBrush}"
	Foreground="{DynamicResource MaterialDesignBody}"
	TextOptions.TextFormattingMode="Display"
	mc:Ignorable="d">
	<helpers:BaseWindow.DataContext>
		<vm:TotalAverageCostUpdateViewModel />
	</helpers:BaseWindow.DataContext>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<materialDesign:ColorZone Grid.Row="0"
			Padding="14,10"
			materialDesign:ElevationAssist.Elevation="Dp4" Mode="PrimaryMid">
			<StackPanel Orientation="Horizontal">
				<materialDesign:PackIcon Width="30" Height="30"
					VerticalAlignment="Center"
					Kind="CalculatorVariantOutline" />
				<TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
					FontSize="20" FontWeight="SemiBold" Text="総平均原価更新" />
			</StackPanel>
		</materialDesign:ColorZone>

		<Grid Grid.Row="1"
			Margin="18">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>

			<materialDesign:Card Grid.Row="0"
				Padding="24"
				materialDesign:ElevationAssist.Elevation="Dp2" UniformCornerRadius="8">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="120" />
						<ColumnDefinition Width="180" />
						<ColumnDefinition Width="140" />
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="140" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>

					<TextBlock Grid.Row="0" Grid.Column="0"
						VerticalAlignment="Center"
						Style="{StaticResource SettingLabel}"
						Text="対象月" />
					<TextBox Grid.Row="0" Grid.Column="1"
						Width="120"
						HorizontalAlignment="Left" VerticalAlignment="Center"
						helpers:YearMonthInputBehavior.IsEnabled="True"
						IsEnabled="{Binding IsProcessing, Converter={StaticResource InverseBooleanConverter}}"
						MaxLength="7"
						Style="{StaticResource MaterialDesignOutlinedTextBox}"
						Text="{Binding TargetMonth}" />

					<TextBlock Grid.Row="0" Grid.Column="2"
						VerticalAlignment="Center"
						Style="{StaticResource SettingLabel}"
						Text="対象期間" />
					<TextBlock Grid.Row="0" Grid.Column="3"
						VerticalAlignment="Center"
						Text="{Binding PeriodText}" />

					<Button Grid.Row="0" Grid.Column="5"
						Width="120"
						HorizontalAlignment="Right"
						Command="{Binding RefreshStatusCommand}"
						Style="{StaticResource MaterialDesignOutlinedButton}">
						<StackPanel Orientation="Horizontal">
							<materialDesign:PackIcon VerticalAlignment="Center"
								Kind="Refresh" />
							<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
								Text="状態更新" />
						</StackPanel>
					</Button>

					<TextBlock Grid.Row="1" Grid.Column="0"
						Margin="0,12,0,0" VerticalAlignment="Center"
						Style="{StaticResource SettingLabel}"
						Text="前回実行日時" />
					<TextBlock Grid.Row="1" Grid.Column="1"
						Margin="0,12,0,0" VerticalAlignment="Center"
						Text="{Binding LastRunAtText}" />

					<TextBlock Grid.Row="1" Grid.Column="2"
						Margin="0,12,0,0" VerticalAlignment="Center"
						Style="{StaticResource SettingLabel}"
						Text="状態" />
					<TextBlock Grid.Row="1" Grid.Column="3"
						Margin="0,12,0,0" VerticalAlignment="Center"
						Text="{Binding ProcessStatusText}" />
				</Grid>
			</materialDesign:Card>

			<GroupBox Grid.Row="1"
				Margin="0,18,0,0"
				Header="確認一覧">
				<Grid Margin="8">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
					</Grid.RowDefinitions>

					<!--
						原価方式不一致(設計書§2.3、U-01)。一覧の1行に埋もれさせず専用バナーで明示する。
						CostMethodMismatchMessageが空文字なら非表示。
					-->
					<Border Grid.Row="0"
						Margin="0,0,0,8" Padding="12,8"
						BorderBrush="{DynamicResource NegativeForegroundBrush}"
						BorderThickness="1" CornerRadius="4"
						Visibility="{Binding CostMethodMismatchMessage, Converter={StaticResource StringIsNotEmptyToVisibilityConverter}}">
						<StackPanel Orientation="Horizontal">
							<materialDesign:PackIcon VerticalAlignment="Center"
								Foreground="{DynamicResource NegativeForegroundBrush}"
								Kind="AlertCircleOutline" />
							<TextBlock Margin="8,0,0,0" VerticalAlignment="Center"
								Foreground="{DynamicResource NegativeForegroundBrush}"
								Text="{Binding CostMethodMismatchMessage}"
								TextWrapping="Wrap" />
						</StackPanel>
					</Border>

					<StackPanel Grid.Row="1"
						Margin="0,0,0,8"
						Orientation="Horizontal">
						<TextBlock VerticalAlignment="Center"
							Text="{Binding TargetCount, StringFormat='対象 {0:N0} 件'}" />
						<TextBlock Margin="16,0,0,0" VerticalAlignment="Center"
							Foreground="{DynamicResource NegativeForegroundBrush}"
							Text="{Binding ErrorCount, StringFormat='エラー {0:N0} 件'}" />
						<!--  対象外(設計書§6.5「2026-09-06改訂」)。エラー件数とは別に表示する。  -->
						<TextBlock Margin="16,0,0,0" VerticalAlignment="Center"
							Text="{Binding ExcludedCount, StringFormat='対象外 {0:N0} 件'}" />
						<CheckBox Margin="24,0,0,0" VerticalAlignment="Center"
							Content="エラー行のみ表示"
							IsChecked="{Binding ShowErrorsOnly}" />
						<CheckBox Margin="16,0,0,0" VerticalAlignment="Center"
							Content="対象外行のみ表示"
							IsChecked="{Binding ShowExcludedOnly}" />
						<Button Margin="24,0,0,0"
							Command="{Binding ExportCsvCommand}"
							Style="{StaticResource MaterialDesignOutlinedButton}">
							<StackPanel Orientation="Horizontal">
								<materialDesign:PackIcon VerticalAlignment="Center"
									Kind="FileDelimitedOutline" />
								<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
									Text="CSV出力" />
							</StackPanel>
						</Button>
					</StackPanel>

					<!--
						計上月列(§6.6): 対象月に加え再計算される後続月の行も同じ一覧に混在するため、
						どの月の行か区別できるように列として表示する（設計書の列指定に無い追加列。詳細はVMのコメント参照）。
					-->
					<DataGrid Grid.Row="2"
						AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
						ItemsSource="{Binding Rows}">
						<DataGrid.Columns>
							<DataGridTextColumn Width="80"
								Binding="{Binding SumMonthText}"
								Header="計上月" />
							<DataGridTextColumn Width="200"
								Binding="{Binding ShohinText}"
								Header="商品" />
							<DataGridTextColumn Width="90"
								Binding="{Binding BeforeCost, StringFormat=N0}"
								Header="前原価" />
							<DataGridTextColumn Width="90"
								Binding="{Binding AfterCost, StringFormat=N0}"
								Header="後原価" />
							<DataGridTextColumn Width="90"
								Binding="{Binding DiffCost, StringFormat=N0}"
								Header="差額" />
							<DataGridTextColumn Width="90"
								Binding="{Binding OpeningQty, StringFormat=N0}"
								Header="前月在庫数" />
							<DataGridTextColumn Width="100"
								Binding="{Binding OpeningAmount, StringFormat=N0}"
								Header="前月在庫金額" />
							<DataGridTextColumn Width="90"
								Binding="{Binding PurchaseQty, StringFormat=N0}"
								Header="当月仕入数" />
							<DataGridTextColumn Width="100"
								Binding="{Binding PurchaseAmount, StringFormat=N0}"
								Header="当月仕入金額" />
							<DataGridTextColumn Width="90"
								Binding="{Binding SundryAmount, StringFormat=N0}"
								Header="諸掛" />
							<DataGridTextColumn Width="80"
								Binding="{Binding Denominator, StringFormat=N0}"
								Header="分母" />
							<DataGridTextColumn Width="70"
								Binding="{Binding StatusText}"
								Header="状態" />
							<DataGridTextColumn Width="220"
								Binding="{Binding ReasonText}"
								Header="エラー" />
						</DataGrid.Columns>
					</DataGrid>
				</Grid>
			</GroupBox>

			<GroupBox Grid.Row="2"
				Margin="0,18,0,0"
				Header="処理メッセージ">
				<Grid Margin="8">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>
					<ProgressBar Height="18"
						Maximum="100" Minimum="0"
						Value="{Binding ProgressValue}" />
					<TextBox Grid.Row="1"
						MaxHeight="60"
						Margin="0,8,0,0"
						IsReadOnly="True"
						Style="{StaticResource MaterialDesignTextBox}"
						Text="{Binding StatusMessage, UpdateSourceTrigger=PropertyChanged}"
						TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
				</Grid>
			</GroupBox>
		</Grid>

		<Border Grid.Row="2"
			Padding="18,12"
			Background="{DynamicResource MaterialDesignPaper}">
			<StackPanel HorizontalAlignment="Right"
				Orientation="Horizontal">
				<Button Width="128" Height="38"
					Margin="0,0,10,0"
					Command="{Binding ConfirmCommand}"
					Style="{StaticResource MaterialDesignOutlinedButton}">
					<StackPanel Orientation="Horizontal">
						<materialDesign:PackIcon VerticalAlignment="Center"
							Kind="ClipboardCheckOutline" />
						<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
							Text="確認" />
					</StackPanel>
				</Button>
				<Button Width="128" Height="38"
					Margin="0,0,10,0"
					Command="{Binding UpdateCommand}"
					IsDefault="True"
					Style="{StaticResource MaterialDesignRaisedButton}">
					<StackPanel Orientation="Horizontal">
						<materialDesign:PackIcon VerticalAlignment="Center"
							Kind="DatabaseImportOutline" />
						<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
							Text="更新" />
					</StackPanel>
				</Button>
				<Button Width="128" Height="38"
					Command="{Binding ExitCommand}"
					IsCancel="True"
					Style="{StaticResource MaterialDesignOutlinedButton}">
					<StackPanel Orientation="Horizontal">
						<materialDesign:PackIcon VerticalAlignment="Center"
							Kind="ArrowLeft" />
						<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
							Text="キャンセル" />
					</StackPanel>
				</Button>
			</StackPanel>
		</Border>
	</Grid>
</helpers:BaseWindow>
