<helpers:BaseWindow x:Class="CvWpfclient.Views._31Monthly.StockTakeFinalizationView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:helpers="clr-namespace:CvWpfclient.Helpers" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:vm="clr-namespace:CvWpfclient.ViewModels._31Monthly"
	Title="棚卸確定処理"
	Width="1180" Height="820"
	Background="{DynamicResource AppCommonBackgroundBrush}"
	FontSize="16"
	Foreground="{DynamicResource MaterialDesignBody}"
	ResizeMode="NoResize" TextOptions.TextFormattingMode="Display"
	mc:Ignorable="d">
	<helpers:BaseWindow.DataContext>
		<vm:StockTakeFinalizationViewModel />
	</helpers:BaseWindow.DataContext>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<materialDesign:ColorZone Grid.Row="0"
			Padding="14,10"
			materialDesign:ElevationAssist.Elevation="Dp4" Mode="PrimaryMid">
			<StackPanel Orientation="Horizontal">
				<materialDesign:PackIcon Width="30" Height="30"
					VerticalAlignment="Center"
					Kind="ClipboardCheckOutline" />
				<TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
					FontSize="20" FontWeight="SemiBold" Text="棚卸確定処理" />
			</StackPanel>
		</materialDesign:ColorZone>

		<Grid Grid.Row="1"
			Margin="18">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
				<RowDefinition Height="140" />
			</Grid.RowDefinitions>

			<materialDesign:Card Grid.Row="0"
				Padding="24"
				materialDesign:ElevationAssist.Elevation="Dp2" UniformCornerRadius="8">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="160" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>

					<TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
						Margin="0,0,0,16"
						Text="実棚数と帳簿在庫の差を在庫調整伝票にして在庫へ反映します。この処理を行わないと棚卸データは在庫に反映されません。&#x0a;確定後に対象日以前の伝票を修正した場合は、もう一度実行すれば作り直します（再確定）。" TextWrapping="Wrap" />

					<TextBlock Grid.Row="1" Grid.Column="0"
						Style="{StaticResource SettingLabel}"
						Text="棚卸日未設定店舗の対象月" />
					<TextBox Grid.Row="1" Grid.Column="1"
						Width="120"
						HorizontalAlignment="Left" VerticalAlignment="Center"
						helpers:YearMonthInputBehavior.IsEnabled="True"
						IsEnabled="{Binding IsProcessing, Converter={StaticResource InverseBooleanConverter}}"
						MaxLength="7"
						Style="{StaticResource MaterialDesignOutlinedTextBox}"
						Text="{Binding FallbackMonth}" />

					<TextBlock Grid.Row="2" Grid.Column="0"
						Margin="0,16,0,0"
						Style="{StaticResource SettingLabel}"
						Text="対象倉庫" />
					<StackPanel Grid.Row="2" Grid.Column="1"
						Margin="0,16,0,0"
						Orientation="Horizontal">
						<Button Width="96"
							Command="{Binding SelectSokoCommand}"
							Content="選択"
							IsEnabled="{Binding IsProcessing, Converter={StaticResource InverseBooleanConverter}}"
							Style="{StaticResource MaterialDesignOutlinedButton}" />
						<Button Width="96"
							Margin="8,0,0,0"
							Command="{Binding ClearSokoCommand}"
							Content="全倉庫"
							IsEnabled="{Binding IsProcessing, Converter={StaticResource InverseBooleanConverter}}"
							Style="{StaticResource MaterialDesignOutlinedButton}" />
						<TextBlock Margin="12,0,0,0" VerticalAlignment="Center"
							Text="{Binding SokoText}" />
					</StackPanel>

					<TextBlock Grid.Row="3" Grid.Column="0"
						Margin="0,16,0,0"
						Style="{StaticResource SettingLabel}"
						Text="入力社員" />
					<StackPanel Grid.Row="3" Grid.Column="1"
						Margin="0,16,0,0"
						Orientation="Horizontal">
						<Button Width="96"
							Command="{Binding SelectShainCommand}"
							Content="選択"
							IsEnabled="{Binding IsProcessing, Converter={StaticResource InverseBooleanConverter}}"
							Style="{StaticResource MaterialDesignOutlinedButton}" />
						<TextBlock Margin="12,0,0,0" VerticalAlignment="Center"
							Text="{Binding ShainText}" />
					</StackPanel>

					<TextBlock Grid.Row="4" Grid.Column="0"
						Margin="0,16,0,0"
						Style="{StaticResource SettingLabel}"
						Text="進捗" />
					<ProgressBar Grid.Row="4" Grid.Column="1"
						Height="18"
						Margin="0,16,0,0"
						Maximum="100" Minimum="0"
						Value="{Binding ProgressValue}" />

					<TextBlock Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2"
						Margin="0,16,0,0"
						Foreground="{DynamicResource MaterialDesignBodyLight}"
						Text="在庫再集計を実行した後は、棚卸開始処理を再実行してください。帳簿在庫のスナップショットは再集計で失われます。" TextWrapping="Wrap" />

					<TextBlock Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2"
						Margin="0,8,0,0"
						Foreground="{DynamicResource ValidationErrorBrush}"
						Text="{Binding MisdatedSummary}" TextWrapping="Wrap"
						Visibility="{Binding MisdatedSummary, Converter={StaticResource StringIsNotEmptyToVisibilityConverter}}" />
				</Grid>
			</materialDesign:Card>

			<materialDesign:Card Grid.Row="1"
				Margin="0,14,0,0" Padding="0"
				materialDesign:ElevationAssist.Elevation="Dp2" UniformCornerRadius="8">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
					</Grid.RowDefinitions>
					<Border Grid.Row="0"
						Padding="12,8"
						Background="{DynamicResource MaterialDesignToolBarBackground}"
						CornerRadius="8,8,0,0">
						<DockPanel>
							<StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
								<Button Margin="4,0"
									Command="{Binding SelectAllTargetsCommand}"
									Style="{StaticResource ToolCommandButton}"
									ToolTip="全行を対象にする">
									<materialDesign:PackIcon Kind="CheckboxMarkedOutline" />
								</Button>
								<Button Margin="4,0"
									Command="{Binding ClearAllTargetsCommand}"
									Style="{StaticResource ToolCommandButton}"
									ToolTip="全行の対象を外す">
									<materialDesign:PackIcon Kind="CheckboxBlankOffOutline" />
								</Button>
							</StackPanel>
							<Button Margin="0"
								Command="{Binding LoadStatusCommand}"
								Content="一覧取得"
								IsEnabled="{Binding IsProcessing, Converter={StaticResource InverseBooleanConverter}}"
								Style="{StaticResource MaterialDesignOutlinedButton}" />
						</DockPanel>
					</Border>

					<DataGrid Grid.Row="1"
						materialDesign:DataGridAssist.CellPadding="10,6" materialDesign:DataGridAssist.ColumnHeaderPadding="10,8"
						AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" EnableRowVirtualization="True" FontSize="14" GridLinesVisibility="Horizontal"
						HorizontalGridLinesBrush="{DynamicResource MaterialDesignDivider}"
						IsReadOnly="False" ItemsSource="{Binding Rows}"
						Style="{StaticResource MaterialDesignDataGrid}"
						VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
						<DataGrid.Columns>
							<DataGridCheckBoxColumn Width="60"
								Binding="{Binding IsTarget, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
								Header="対象" />
							<DataGridTextColumn Width="100"
								Binding="{Binding ShopCode}"
								Header="店舗コード" IsReadOnly="True" />
							<DataGridTextColumn Width="200"
								Binding="{Binding ShopName}"
								Header="店舗名" IsReadOnly="True" />
							<DataGridTextColumn Width="110"
								Binding="{Binding TanaDay}"
								Header="棚卸日" IsReadOnly="True" />
							<DataGridTextColumn Width="90"
								Binding="{Binding SumMonth}"
								Header="計上月" IsReadOnly="True" />
							<DataGridTextColumn Width="100"
								Binding="{Binding BookQtyTotal}"
								ElementStyle="{StaticResource DataGridRightTextBlock}"
								Header="帳簿在庫" IsReadOnly="True" />
							<DataGridTextColumn Width="100"
								Binding="{Binding ActualQtyTotal}"
								ElementStyle="{StaticResource DataGridRightTextBlock}"
								Header="実棚数" IsReadOnly="True" />
							<DataGridTextColumn Width="90"
								Binding="{Binding DiffSkuCount}"
								ElementStyle="{StaticResource DataGridRightTextBlock}"
								Header="差異SKU" IsReadOnly="True" />
							<DataGridTextColumn Width="110"
								Binding="{Binding FixDayText}"
								Header="最終確定日" IsReadOnly="True" />
							<DataGridTextColumn Width="90"
								Binding="{Binding StatusText}"
								Header="状態" IsReadOnly="True" />
						</DataGrid.Columns>
						<DataGrid.ColumnHeaderStyle>
							<Style BasedOn="{StaticResource MenteDataGridColumnHeader}"
								TargetType="DataGridColumnHeader" />
						</DataGrid.ColumnHeaderStyle>
					</DataGrid>
				</Grid>
			</materialDesign:Card>

			<GroupBox Grid.Row="2"
				Margin="0,14,0,0"
				Header="処理メッセージ">
				<TextBox Margin="8"
					IsReadOnly="True"
					Style="{StaticResource MaterialDesignTextBox}"
					Text="{Binding StatusMessage, UpdateSourceTrigger=PropertyChanged}"
					TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
			</GroupBox>
		</Grid>

		<Border Grid.Row="2"
			Padding="18,12"
			Background="{DynamicResource MaterialDesignPaper}">
			<StackPanel HorizontalAlignment="Right"
				Orientation="Horizontal">
				<Button Width="128" Height="38"
					Margin="0,0,10,0"
					Command="{Binding ExecuteCommand}"
					IsDefault="True"
					Style="{StaticResource MaterialDesignRaisedButton}">
					<StackPanel Orientation="Horizontal">
						<materialDesign:PackIcon VerticalAlignment="Center"
							Kind="CheckBold" />
						<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
							Text="棚卸確定" />
					</StackPanel>
				</Button>
				<Button Width="128" Height="38"
					Command="{Binding ExitCommand}"
					IsCancel="True"
					Style="{StaticResource MaterialDesignOutlinedButton}">
					<StackPanel Orientation="Horizontal">
						<materialDesign:PackIcon VerticalAlignment="Center"
							Kind="ArrowLeft" />
						<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
							Text="キャンセル" />
					</StackPanel>
				</Button>
			</StackPanel>
		</Border>
	</Grid>
</helpers:BaseWindow>
