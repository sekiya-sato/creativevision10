												Style="{StaticResource FormDatePicker}" />
											<DatePicker Grid.Column="5"
												Width="130"
												Margin="0,0,6,0"
												helpers:DatePickerTodayButtonBehavior.IsEnabled="True" IsTodayHighlighted="False"
												SelectedDate="{Binding ShopDayTo, Mode=TwoWay}"
												Style="{StaticResource FormDatePicker}" />
											<Button Grid.Column="6"
												Command="{Binding ApplyShopPeriodCommand}"
												Style="{StaticResource MaterialDesignOutlinedButton}"
												ToolTip="チェック済みの対象へ期間をまとめて設定（Scope1件の互換運用向け。手動の期間微調整は保存時に維持されます）">
												<TextBlock FontSize="14" Text="期間設定" />
											</Button>
										</Grid>

										<DataGrid Grid.Row="2"
											d:ItemsSource="{d:SampleData ItemCount=5}"
											helpers:DataGridCellEnterNavigation.IsEnabled="True" materialDesign:DataGridAssist.CellPadding="8,4" materialDesign:DataGridAssist.ColumnHeaderPadding="8,6"
											AlternatingRowBackground="{DynamicResource DataGridAlternatingRowBackgroundBrush}"
											AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" EnableRowVirtualization="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
											HorizontalGridLinesBrush="{DynamicResource MaterialDesignDivider}"
											ItemsSource="{Binding ShopRows}"
											Style="{StaticResource MaterialDesignDataGrid}"
											VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
											<DataGrid.Columns>
												<DataGridCheckBoxColumn Width="46"
													Binding="{Binding IsTarget, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
													Header="対象" />
												<DataGridTextColumn Width="80"
													Binding="{Binding Code_Tenpo}"
													Header="CD" IsReadOnly="True" />
												<DataGridTextColumn Width="*" MinWidth="120"
													Binding="{Binding Mei_Tenpo}"
													Header="名称" IsReadOnly="True" />
												<DataGridTextColumn Width="90"
													Binding="{Binding DayFrom, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
													Header="開始日" />
												<DataGridTextColumn Width="90"
													Binding="{Binding DayTo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
													Header="終了日" />
											</DataGrid.Columns>
											<DataGrid.ColumnHeaderStyle>
												<Style BasedOn="{StaticResource MenteDataGridColumnHeader}"
													TargetType="DataGridColumnHeader" />
											</DataGrid.ColumnHeaderStyle>
										</DataGrid>
									</Grid>
								</materialDesign:Card>
							</Grid>
						</TabItem>

						<!--  ================= ③ 価格 (Price Matrix) =================  -->
						<!--
							行=商品 / 列=Scope（設計書5.4）。Scope列はxaml.cs(RebuildScopeColumns)で実行時に
							生成する。動的列生成はCvWpfclient/Views/03Hatchu/HachuHaibunInputView.xaml.cs
							（配分クロス表: 行=入庫先/列=色サイズ）と同じ流儀（列インデックスで
							Cells[i]を束縛し、ScopeRowsの増減に合わせてRebuildScopeColumnsで作り直す）に揃えた。
							主入力手段ではなく確認・例外編集用（対象取得と一括計算が主入力）。
						-->
						<TabItem Header="③ 価格">
							<Grid Margin="0,10,0,0">
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto" />
									<RowDefinition Height="*" />
								</Grid.RowDefinitions>

								<materialDesign:Card Grid.Row="0"
									Margin="0,0,0,8" Padding="12,8"
									materialDesign:ElevationAssist.Elevation="Dp1" UniformCornerRadius="8">
									<StackPanel>
										<DockPanel>
											<StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
												<Border Padding="8,2"
													Background="{DynamicResource MaterialDesignDivider}"
													CornerRadius="10">
													<TextBlock FontSize="12" FontWeight="SemiBold"
														Text="{Binding MeisaiCount, StringFormat={}明細 {0:N0} 件}" />
												</Border>
												<Border Margin="6,0,0,0" Padding="8,2"
													Background="{DynamicResource MaterialDesignDivider}"
													CornerRadius="10">
													<TextBlock FontSize="12" FontWeight="SemiBold"
														Text="{Binding ExpandEstimate, StringFormat={}展開見込 {0:N0} 行}"
														ToolTip="確定すると DerivedJodai にこの行数が作成されます" />
												</Border>
												<Button Margin="12,0,0,0"
													Command="{Binding RecalcMatrixCommand}"
													Style="{StaticResource MaterialDesignOutlinedButton}"
													ToolTip="選択Scope（または全Scope）の価格ルールで全セルを再計算します（設計書5.6「一括計算」）">
													<StackPanel Orientation="Horizontal">
														<materialDesign:PackIcon Kind="Calculator" />
														<TextBlock Margin="6,0,0,0"
															Text="一括計算" />
													</StackPanel>
												</Button>
											</StackPanel>
											<TextBlock VerticalAlignment="Center"
												FontWeight="SemiBold" Text="Price Matrix（商品×Scope。確認・例外編集用）" />
										</DockPanel>

										<StackPanel Margin="0,8,0,0"
											Orientation="Horizontal">
											<TextBlock VerticalAlignment="Center"
												Text="選択セルへ一括操作:" />
											<ComboBox Width="130"
												Margin="8,0,0,0"
												DisplayMemberPath="Name"
												ItemsSource="{Binding BulkPriceMethodOptions}"
												SelectedValue="{Binding BulkMethod, Mode=TwoWay}"
												SelectedValuePath="Value"
												Style="{StaticResource FormComboBox}" />
											<TextBox Width="90"
												Margin="8,0,0,0"
												Style="{StaticResource FormTextBox}"
												Text="{Binding BulkValueText, UpdateSourceTrigger=PropertyChanged}"
												ToolTip="方式により値下率(%)・値引額(円)・掛率(%)・固定額(円)の意味が変わります" />
											<ComboBox Width="170"
												Margin="8,0,0,0"
												DisplayMemberPath="Display"
												ItemsSource="{Binding PricePointOptions}"
												SelectedItem="{Binding BulkPricePoint, Mode=TwoWay}"
												Style="{StaticResource FormComboBox}"
												ToolTip="方式=価格ポイントのときのみ使用" />
											<Button Margin="12,0,0,0"
												Command="{Binding ApplyBulkOperationCommand}"
												Style="{StaticResource MaterialDesignRaisedButton}">
												<TextBlock Text="{Binding SelectedMatrixCellCount, StringFormat={}選択セルへ適用 ({0} 件)}" />
											</Button>
										</StackPanel>
									</StackPanel>
								</materialDesign:Card>

								<materialDesign:Card Grid.Row="1"
									Padding="0"
									materialDesign:ElevationAssist.Elevation="Dp1" UniformCornerRadius="8">
									<DataGrid x:Name="PriceMatrixGrid"
										helpers:DataGridCellEnterNavigation.IsEnabled="True" materialDesign:DataGridAssist.CellPadding="8,4" materialDesign:DataGridAssist.ColumnHeaderPadding="8,6"
										AlternatingRowBackground="{DynamicResource DataGridAlternatingRowBackgroundBrush}"
										AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" EnableRowVirtualization="True" FrozenColumnCount="4" GridLinesVisibility="All"
										HeadersVisibility="Column"
										HorizontalGridLinesBrush="{DynamicResource MaterialDesignDivider}"
										ItemsSource="{Binding MeisaiRows}"
										Loaded="PriceMatrixGrid_Loaded" SelectedCellsChanged="PriceMatrixGrid_SelectedCellsChanged"
										SelectedItem="{Binding SelectedMeisaiRow, Mode=TwoWay}"
										SelectionMode="Extended" SelectionUnit="Cell"
										Style="{StaticResource MaterialDesignDataGrid}"
										VerticalGridLinesBrush="{DynamicResource MaterialDesignDivider}"
										VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
										<DataGrid.Columns>
											<DataGridTextColumn Width="120"
												Binding="{Binding Code_Shohin}"
												Header="商品CD" IsReadOnly="True" />
											<DataGridTextColumn Width="*" MinWidth="160"
												Binding="{Binding Mei_Shohin}"
												Header="商品名" IsReadOnly="True" />
											<DataGridTextColumn Width="90"
												Binding="{Binding JodaiOld, StringFormat={}{0:N0}}"
												ElementStyle="{StaticResource DataGridRightTextBlock}"
												Header="通常上代" IsReadOnly="True" />
											<DataGridTextColumn Width="90"
												Binding="{Binding TankaGenka, StringFormat={}{0:N0}}"
												ElementStyle="{StaticResource DataGridRightTextBlock}"
												Header="原価" IsReadOnly="True" />
										</DataGrid.Columns>
										<DataGrid.ColumnHeaderStyle>
											<Style BasedOn="{StaticResource MenteDataGridColumnHeader}"
												TargetType="DataGridColumnHeader" />
										</DataGrid.ColumnHeaderStyle>
									</DataGrid>
								</materialDesign:Card>
							</Grid>
						</TabItem>

						<!--  ================= ④ 確認（プレビュー・競合・Timeline。設計書2.8・2.9・5.5）=================  -->
						<TabItem>
							<TabItem.Header>
								<StackPanel Orientation="Horizontal">
									<TextBlock VerticalAlignment="Center"
										Text="④ 確認" />
									<Border Margin="6,0,0,0" Padding="6,1"
										CornerRadius="8">
										<Border.Style>
											<Style TargetType="Border">
												<Setter Property="Background" Value="{DynamicResource MaterialDesignDivider}" />
												<Style.Triggers>
													<DataTrigger Binding="{Binding DataContext.HasConflicts, RelativeSource={RelativeSource AncestorType=TabControl}}"
														Value="True">
														<Setter Property="Background" Value="{DynamicResource MaterialDesignValidationErrorBrush}" />
													</DataTrigger>
												</Style.Triggers>
											</Style>
										</Border.Style>
										<TextBlock FontSize="11" FontWeight="SemiBold"
											Text="{Binding DataContext.ConflictCount, RelativeSource={RelativeSource AncestorType=TabControl}, StringFormat={}競合 {0:N0}}">
											<TextBlock.Style>
												<Style BasedOn="{StaticResource {x:Type TextBlock}}"
													TargetType="TextBlock">
													<Style.Triggers>
														<DataTrigger Binding="{Binding DataContext.HasConflicts, RelativeSource={RelativeSource AncestorType=TabControl}}"
															Value="True">
															<Setter Property="Foreground" Value="White" />
														</DataTrigger>
													</Style.Triggers>
												</Style>
											</TextBlock.Style>
										</TextBlock>
									</Border>
								</StackPanel>
							</TabItem.Header>
							<Grid Margin="0,10,0,0">
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto" />
									<RowDefinition Height="*" />
									<RowDefinition Height="Auto" />
								</Grid.RowDefinitions>

								<!--  プレビュー（設計書2.9）  -->
								<materialDesign:Card Grid.Row="0"
									Margin="0,0,0,8" Padding="12,8"
									materialDesign:ElevationAssist.Elevation="Dp1" UniformCornerRadius="8">
									<StackPanel>
										<DockPanel>
											<Button Command="{Binding CheckConflictsCommand}"
												DockPanel.Dock="Right"
												IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
												Style="{StaticResource MaterialDesignOutlinedButton}"
												ToolTip="プレビュー集計と競合（C1〜C8）を再計算します（設計書5.6「競合チェック」）">
												<StackPanel Orientation="Horizontal">
													<materialDesign:PackIcon Kind="Refresh" />
													<TextBlock Margin="6,0,0,0"
														Text="競合チェック" />
												</StackPanel>
											</Button>
											<TextBlock VerticalAlignment="Center"
												FontWeight="SemiBold" Text="プレビュー（確定前シミュレーション）" />
										</DockPanel>

										<WrapPanel Margin="0,8,0,0"
											Orientation="Horizontal">
											<materialDesign:Card Margin="0,0,8,8" Padding="10,6"
												materialDesign:ElevationAssist.Elevation="Dp0" UniformCornerRadius="6">
												<StackPanel>
													<TextBlock FontSize="11"
														Foreground="{DynamicResource MaterialDesignBodyLight}"
														Text="対象Style数" />
													<TextBlock FontSize="16" FontWeight="SemiBold"
														Text="{Binding PreviewStyleCount, StringFormat={}{0:N0}}" />
												</StackPanel>
											</materialDesign:Card>
											<materialDesign:Card Margin="0,0,8,8" Padding="10,6"
												materialDesign:ElevationAssist.Elevation="Dp0" UniformCornerRadius="6">
												<StackPanel>
													<TextBlock FontSize="11"
														Foreground="{DynamicResource MaterialDesignBodyLight}"
														Text="対象SKU数" />
													<TextBlock FontSize="16" FontWeight="SemiBold"
														Text="{Binding PreviewSkuCount, StringFormat={}{0:N0}}" />
												</StackPanel>
											</materialDesign:Card>
											<materialDesign:Card Margin="0,0,8,8" Padding="10,6"
												materialDesign:ElevationAssist.Elevation="Dp0" UniformCornerRadius="6">
												<StackPanel>
													<TextBlock FontSize="11"
														Foreground="{DynamicResource MaterialDesignBodyLight}"
														Text="対象店舗数" />
													<TextBlock FontSize="16" FontWeight="SemiBold"
														Text="{Binding PreviewShopCount, StringFormat={}{0:N0}}" />
												</StackPanel>
											</materialDesign:Card>
											<materialDesign:Card Margin="0,0,8,8" Padding="10,6"
												materialDesign:ElevationAssist.Elevation="Dp0" UniformCornerRadius="6">
												<StackPanel>
													<TextBlock FontSize="11"
														Foreground="{DynamicResource MaterialDesignBodyLight}"
														Text="適用期間" />
													<TextBlock FontSize="16" FontWeight="SemiBold"
														Text="{Binding PreviewPeriodText}" />
												</StackPanel>
											</materialDesign:Card>
											<materialDesign:Card Margin="0,0,8,8" Padding="10,6"
												materialDesign:ElevationAssist.Elevation="Dp0" UniformCornerRadius="6">
												<StackPanel>
													<TextBlock FontSize="11"
														Foreground="{DynamicResource MaterialDesignBodyLight}"
														Text="現在平均上代" />
													<TextBlock FontSize="16" FontWeight="SemiBold"
														Text="{Binding PreviewAvgJodaiOld, StringFormat={}{0:N0}円}" />
												</StackPanel>
											</materialDesign:Card>
											<materialDesign:Card Margin="0,0,8,8" Padding="10,6"
												materialDesign:ElevationAssist.Elevation="Dp0" UniformCornerRadius="6">
												<StackPanel>
													<TextBlock FontSize="11"
														Foreground="{DynamicResource MaterialDesignBodyLight}"
														Text="変更後平均上代" />
													<TextBlock FontSize="16" FontWeight="SemiBold"
														Text="{Binding PreviewAvgJodaiNew, StringFormat={}{0:N0}円}" />
												</StackPanel>
											</materialDesign:Card>
											<materialDesign:Card Margin="0,0,8,8" Padding="10,6"
												materialDesign:ElevationAssist.Elevation="Dp0" UniformCornerRadius="6">
												<StackPanel>
													<TextBlock FontSize="11"
														Foreground="{DynamicResource MaterialDesignBodyLight}"
														Text="平均値下率" />
													<TextBlock FontSize="16" FontWeight="SemiBold"
														Text="{Binding PreviewAvgRateOffPercent, StringFormat={}{0:N2}%}" />
												</StackPanel>
											</materialDesign:Card>
											<materialDesign:Card Margin="0,0,8,8" Padding="10,6"
												materialDesign:ElevationAssist.Elevation="Dp0" ToolTip="MasterConfig.JodaiExpandWarnRows を超えると赤字で警告します（設計書2.9）" UniformCornerRadius="6">
												<StackPanel>
													<TextBlock FontSize="11"
														Foreground="{DynamicResource MaterialDesignBodyLight}"
														Text="展開見込行数" />
													<TextBlock FontSize="16" FontWeight="SemiBold"
														Text="{Binding PreviewExpandRows, StringFormat={}{0:N0}行}">
														<TextBlock.Style>
															<Style BasedOn="{StaticResource {x:Type TextBlock}}"
																TargetType="TextBlock">
																<Style.Triggers>
																	<DataTrigger Binding="{Binding PreviewExpandRowsWarning}"
																		Value="True">
																		<Setter Property="Foreground" Value="{DynamicResource MaterialDesignValidationErrorBrush}" />
																	</DataTrigger>
																</Style.Triggers>
															</Style>
														</TextBlock.Style>
													</TextBlock>
												</StackPanel>
											</materialDesign:Card>
											<materialDesign:Card Margin="0,0,8,8" Padding="10,6"
												materialDesign:ElevationAssist.Elevation="Dp0" UniformCornerRadius="6">
												<StackPanel>
													<TextBlock FontSize="11"
														Foreground="{DynamicResource MaterialDesignBodyLight}"
														Text="競合件数(C1〜C6)" />
													<TextBlock FontSize="16" FontWeight="SemiBold"
														Text="{Binding PreviewConflictCount, StringFormat={}{0:N0}件}" />
												</StackPanel>
											</materialDesign:Card>
											<materialDesign:Card Margin="0,0,8,8" Padding="10,6"
												materialDesign:ElevationAssist.Elevation="Dp0" UniformCornerRadius="6">
												<StackPanel>
													<TextBlock FontSize="11"
														Foreground="{DynamicResource MaterialDesignBodyLight}"
														Text="原価割れ件数(C7)" />
													<TextBlock FontSize="16" FontWeight="SemiBold"
														Text="{Binding PreviewBelowCostCount, StringFormat={}{0:N0}件}" />
												</StackPanel>
											</materialDesign:Card>
											<materialDesign:Card Margin="0,0,8,8" Padding="10,6"
												materialDesign:ElevationAssist.Elevation="Dp0" UniformCornerRadius="6">
												<StackPanel>
													<TextBlock FontSize="11"
														Foreground="{DynamicResource MaterialDesignBodyLight}"
														Text="最低価格違反(C8)" />
													<TextBlock FontSize="16" FontWeight="SemiBold"
														Text="{Binding PreviewBelowMinPriceCount, StringFormat={}{0:N0}件}" />
												</StackPanel>
											</materialDesign:Card>
										</WrapPanel>

										<TextBlock Margin="0,4,0,0"
											Foreground="{DynamicResource MaterialDesignValidationErrorBrush}"
											Text="C1/C2（エラー）があるため確定できません。「② 適用範囲」でScopeの重なりを見直してください。"
											Visibility="{Binding HasBlockingConflicts, Converter={StaticResource BooleanToVisibilityConverter}}" />
									</StackPanel>
								</materialDesign:Card>

								<!--  競合一覧（設計書2.8・5.5）  -->
								<materialDesign:Card Grid.Row="1"
									Margin="0,0,0,8" Padding="0"
									materialDesign:ElevationAssist.Elevation="Dp1" UniformCornerRadius="8">
									<DataGrid MinHeight="160"
										materialDesign:DataGridAssist.CellPadding="8,4" materialDesign:DataGridAssist.ColumnHeaderPadding="8,6"
										AlternatingRowBackground="{DynamicResource DataGridAlternatingRowBackgroundBrush}"
										AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" GridLinesVisibility="All" HeadersVisibility="Column"
										HorizontalGridLinesBrush="{DynamicResource MaterialDesignDivider}"
										IsReadOnly="True"
										ItemsSource="{Binding ConflictRows}"
										Style="{StaticResource MaterialDesignDataGrid}"
										VerticalGridLinesBrush="{DynamicResource MaterialDesignDivider}">
										<DataGrid.Columns>
											<DataGridTextColumn Width="50"
												Binding="{Binding KindLabel}"
												Header="種別" />
											<DataGridTextColumn Width="70"
												Binding="{Binding SeverityLabel}"
												Header="深刻度">
												<DataGridTextColumn.CellStyle>
													<Style BasedOn="{StaticResource {x:Type DataGridCell}}"
														TargetType="DataGridCell">
														<Style.Triggers>
															<DataTrigger Binding="{Binding SeverityLabel}"
																Value="エラー">
																<Setter Property="Foreground" Value="{DynamicResource MaterialDesignValidationErrorBrush}" />
																<Setter Property="FontWeight" Value="Bold" />
															</DataTrigger>
															<DataTrigger Binding="{Binding SeverityLabel}"
																Value="警告">
																<Setter Property="Foreground" Value="#B8860B" />
																<Setter Property="FontWeight" Value="Bold" />
															</DataTrigger>
														</Style.Triggers>
													</Style>
												</DataGridTextColumn.CellStyle>
											</DataGridTextColumn>
											<DataGridTextColumn Width="60"
												Binding="{Binding Count, StringFormat={}{0:N0}}"
												ElementStyle="{StaticResource DataGridRightTextBlock}"
												Header="件数" />
											<DataGridTextColumn Width="*" MinWidth="300"
												Binding="{Binding Message}"
												Header="明細" />
										</DataGrid.Columns>
										<DataGrid.ColumnHeaderStyle>
											<Style BasedOn="{StaticResource MenteDataGridColumnHeader}"
												TargetType="DataGridColumnHeader" />
										</DataGrid.ColumnHeaderStyle>
									</DataGrid>
								</materialDesign:Card>

								<!--  Timeline（設計書5.5）  -->
								<materialDesign:Card Grid.Row="2"
									Padding="12"
									materialDesign:ElevationAssist.Elevation="Dp1" UniformCornerRadius="8">
									<Grid>
										<Grid.RowDefinitions>
											<RowDefinition Height="Auto" />
											<RowDefinition Height="*" />
										</Grid.RowDefinitions>

										<StackPanel Grid.Row="0"
											Orientation="Horizontal">
											<TextBlock VerticalAlignment="Center"
												FontWeight="SemiBold" Text="Timeline（実効価格の推移）" />
											<TextBlock Margin="16,0,0,0" VerticalAlignment="Center"
												Text="商品:" />
											<ComboBox Width="220"
												Margin="6,0,0,0"
												DisplayMemberPath="Display"
												ItemsSource="{Binding TimelineShohinOptions}"
												SelectedItem="{Binding SelectedTimelineShohin, Mode=TwoWay}"
												Style="{StaticResource FormComboBox}" />
											<TextBlock Margin="16,0,0,0" VerticalAlignment="Center"
												Text="店舗:" />
											<ComboBox Width="220"
												Margin="6,0,0,0"
												DisplayMemberPath="Display"
												ItemsSource="{Binding TimelineTenpoOptions}"
												SelectedItem="{Binding SelectedTimelineTenpo, Mode=TwoWay}"
												Style="{StaticResource FormComboBox}" />
											<Button Margin="16,0,0,0"
												Command="{Binding BuildTimelineCommand}"
												IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
												Style="{StaticResource MaterialDesignOutlinedButton}">
												<TextBlock Text="表示" />
											</Button>
										</StackPanel>

										<ItemsControl Grid.Row="1"
											Margin="0,12,0,0"
											ItemsSource="{Binding TimelineSegments}">
											<ItemsControl.ItemsPanel>
												<ItemsPanelTemplate>
													<!--  期間の長さに比例した幅の区間を並べる（チャートライブラリは導入しない。タスク指示）  -->
													<UniformGrid Columns="1" />
												</ItemsPanelTemplate>
											</ItemsControl.ItemsPanel>
											<ItemsControl.ItemTemplate>
												<DataTemplate>
													<Grid Margin="0,2">
														<Grid.ColumnDefinitions>
															<ColumnDefinition Width="90" />
															<ColumnDefinition Width="*" />
															<ColumnDefinition Width="90" />
														</Grid.ColumnDefinitions>
														<TextBlock Grid.Column="0"
															VerticalAlignment="Center"
															FontSize="11"
															Text="{Binding DayFrom}" />
														<Border Grid.Column="1"
															Height="26"
															Padding="6,2"
															Background="{DynamicResource MaterialDesignDivider}"
															CornerRadius="4">
															<Border.Style>
																<Style TargetType="Border">
																	<Style.Triggers>
																		<DataTrigger Binding="{Binding IsFallback}"
																			Value="True">
																			<Setter Property="Background" Value="{DynamicResource MaterialDesignChipBackground}" />
																		</DataTrigger>
																		<DataTrigger Binding="{Binding IsOtherSlip}"
																			Value="True">
																			<Setter Property="BorderBrush" Value="#B8860B" />
																			<Setter Property="BorderThickness" Value="0,2,0,2" />
																		</DataTrigger>
																	</Style.Triggers>
																</Style>
															</Border.Style>
															<TextBlock VerticalAlignment="Center"
																FontSize="11"
																Text="{Binding Source, StringFormat={}{0}}" />
														</Border>
														<TextBlock Grid.Column="2"
															HorizontalAlignment="Right" VerticalAlignment="Center"
															FontSize="12" FontWeight="SemiBold"
															Text="{Binding Jodai, StringFormat={}{0:N0}円}" />
													</Grid>
												</DataTemplate>
											</ItemsControl.ItemTemplate>
										</ItemsControl>
									</Grid>
								</materialDesign:Card>
							</Grid>
						</TabItem>
					</TabControl>

					<!--  操作ボタン（内側タブの外＝常時表示）  -->
					<Grid Grid.Row="3"
						Margin="0,10,0,4">
						<StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
							<TextBlock Style="{StaticResource StatusTextBlockStyle}"
								Text="[登録] は伝票の保存のみ。[確定] で適用上代が展開され、売上・POS・在庫評価に反映されます" TextTrimming="CharacterEllipsis" />
							<TextBlock Style="{StaticResource StatusTextBlockStyle}"
								Text="商品マスタの上代は書き換えません。期間が過ぎれば自動的に元価格へ戻ります" TextTrimming="CharacterEllipsis" />
						</StackPanel>
						<StackPanel HorizontalAlignment="Right"
							Orientation="Horizontal">
							<Button Command="{Binding GoPrevStepCommand}"
								Style="{StaticResource MaterialDesignOutlinedButton}"
								ToolTip="内側タブを1つ戻る">
								<TextBlock FontSize="16" Text="◀ 前へ" />
							</Button>
							<Button Margin="8,0,0,0"
								Command="{Binding GoNextStepCommand}"
								Style="{StaticResource MaterialDesignOutlinedButton}"
								ToolTip="内側タブを1つ進める">
								<TextBlock FontSize="16" Text="次へ ▶" />
							</Button>
							<Border Width="1"
								Margin="12,4"
								Background="{DynamicResource MaterialDesignDivider}" />
							<Button Command="{Binding DoMarkSentCommand}"
								Style="{StaticResource MaterialDesignOutlinedButton}"
								ToolTip="値札･棚札の差し替えが完了したことを記録する（価格配信ではありません）">
								<TextBlock FontSize="16" Text="送信済" />
							</Button>
							<Button Margin="12,0,0,0"
								Command="{Binding DoCancelDenCommand}"
								Style="{StaticResource MaterialDesignOutlinedButton}"
								ToolTip="確定済みの伝票を取消し、展開済みの適用上代を削除">
								<TextBlock FontSize="16" Text="取消" />
							</Button>
							<Button Margin="12,0,0,0"
								Command="{Binding DoRegisterCommand}"
								IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
								Style="{StaticResource MaterialDesignOutlinedButton}"
								ToolTip="伝票を保存する（この時点では価格には反映されません） (F8)">
								<StackPanel Orientation="Horizontal">
									<materialDesign:PackIcon VerticalAlignment="Center"
										Kind="ContentSave" />
									<TextBlock Margin="8,0,0,0" VerticalAlignment="Center"
										FontSize="16" Text="登録(F8)" />
								</StackPanel>
							</Button>
							<Button Margin="12,0,0,0"
								Command="{Binding DoFixCommand}"
								IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
								Style="{StaticResource MaterialDesignRaisedButton}"
								ToolTip="確定して適用上代を展開する">
								<StackPanel Orientation="Horizontal">
									<materialDesign:PackIcon VerticalAlignment="Center"
										Kind="CheckBold" />
									<TextBlock Margin="8,0,0,0" VerticalAlignment="Center"
										FontSize="16" Text="確定" />
								</StackPanel>
							</Button>
							<Button Margin="12,0,0,0"
								Command="{Binding BackToSearchCommand}"
								Style="{StaticResource MaterialDesignOutlinedButton}"
								ToolTip="検索画面へ戻る (Esc)">
								<TextBlock FontSize="16" Text="検索画面へ戻る(ESC)" />
							</Button>
						</StackPanel>
					</Grid>
				</Grid>
			</TabItem>
		</TabControl>

		<!--  ステータス  -->
		<Border Grid.Row="2"
			Padding="12,6"
			Background="{DynamicResource MaterialDesignChipBackground}">
			<TextBlock Style="{StaticResource StatusTextBlockStyle}"
				Text="{Binding Message}"
				TextTrimming="CharacterEllipsis" />
		</Border>
	</Grid>
</helpers:BaseWindow>
