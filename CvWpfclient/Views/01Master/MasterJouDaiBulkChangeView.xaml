<helpers:BaseWindow x:Class="CvWpfclient.Views._01Master.MasterJouDaiBulkChangeView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:helpers="clr-namespace:CvWpfclient.Helpers" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:vm="clr-namespace:CvWpfclient.ViewModels._01Master"
	Title="上代一括変更"
	Width="1440" Height="900"
	Background="{DynamicResource AppCommonBackgroundBrush}"
	FontSize="14"
	Foreground="{DynamicResource MaterialDesignBody}"
	TextOptions.TextFormattingMode="Display" WindowStartupLocation="CenterScreen"
	mc:Ignorable="d">
	<helpers:BaseWindow.DataContext>
		<vm:MasterJouDaiBulkChangeViewModel />
	</helpers:BaseWindow.DataContext>

	<helpers:BaseWindow.InputBindings>
		<KeyBinding Command="{Binding DoSearchCommand}"
			Gesture="F5" />
		<KeyBinding Command="{Binding DoRegisterCommand}"
			Gesture="F8" />
	</helpers:BaseWindow.InputBindings>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<!--  ヘッダ  -->
		<materialDesign:ColorZone Grid.Row="0"
			Padding="12,8"
			materialDesign:ElevationAssist.Elevation="Dp4" Mode="PrimaryMid">
			<DockPanel>
				<StackPanel VerticalAlignment="Center"
					DockPanel.Dock="Right" Orientation="Horizontal">
					<TextBlock VerticalAlignment="Center"
						Text="伝票No:" />
					<TextBlock Margin="4,0,0,0" VerticalAlignment="Center"
						FontWeight="SemiBold"
						Text="{Binding DenNoText}" />
					<TextBlock Margin="16,0,0,0" VerticalAlignment="Center"
						Text="状態:" />
					<TextBlock Margin="4,0,0,0" VerticalAlignment="Center"
						FontWeight="SemiBold"
						Text="{Binding StatusName}" />
					<TextBlock Margin="16,0,0,0" VerticalAlignment="Center"
						Text="送信:" />
					<TextBlock Margin="4,0,0,0" VerticalAlignment="Center"
						FontWeight="SemiBold"
						Text="{Binding SendFlgName}"
						ToolTip="店頭の値札･棚札を差し替えたかどうかの運用管理。価格自体はPOSがサーバから直接引きます" />
				</StackPanel>
				<StackPanel Orientation="Horizontal">
					<Button Margin="0,0,8,0"
						Command="{Binding ExitCommand}"
						Style="{StaticResource ToolCommandButton}"
						ToolTip="閉じる (Esc)">
						<materialDesign:PackIcon Kind="ArrowLeft" />
					</Button>
					<materialDesign:PackIcon Width="26" Height="26"
						VerticalAlignment="Center"
						Kind="TagMultiple" />
					<TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
						FontSize="18" FontWeight="SemiBold" Text="上代一括変更" />
				</StackPanel>
			</DockPanel>
		</materialDesign:ColorZone>

		<TabControl Grid.Row="1"
			Margin="12,10,12,0"
			SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}"
			Style="{StaticResource MaterialDesignTabControl}">

			<!--  ================= タブ1: 検索画面 =================  -->
			<TabItem Header="検索画面">
				<Grid Margin="0,10,0,0">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>

					<materialDesign:Card Grid.Row="0"
						Padding="14,12"
						materialDesign:ElevationAssist.Elevation="Dp1" UniformCornerRadius="8">
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition Width="*" MinWidth="200" />
								<ColumnDefinition Width="Auto" />
							</Grid.ColumnDefinitions>

							<TextBlock Grid.Column="0"
								Style="{StaticResource FormLabel}"
								Text="登録日" />
							<DatePicker Grid.Column="1"
								MinWidth="150"
								Margin="0,4,8,4"
								helpers:DatePickerTodayButtonBehavior.IsEnabled="True" IsTodayHighlighted="False"
								SelectedDate="{Binding SearchDayFrom, Mode=TwoWay}"
								Style="{StaticResource FormDatePicker}" />
							<TextBlock Grid.Column="2"
								VerticalAlignment="Center"
								Style="{StaticResource FormLabel}"
								Text="～" />
							<DatePicker Grid.Column="3"
								MinWidth="150"
								Margin="0,4,16,4"
								helpers:DatePickerTodayButtonBehavior.IsEnabled="True" IsTodayHighlighted="False"
								SelectedDate="{Binding SearchDayTo, Mode=TwoWay}"
								Style="{StaticResource FormDatePicker}" />

							<TextBlock Grid.Column="4"
								Style="{StaticResource FormLabel}"
								Text="タイトル" />
							<TextBox Grid.Column="5"
								Margin="0,4,16,4"
								Style="{StaticResource FormTextBox}"
								Text="{Binding SearchTitle, UpdateSourceTrigger=PropertyChanged}"
								ToolTip="タイトルの部分一致で絞り込みます" />

							<Button Grid.Column="6"
								Command="{Binding DoSearchCommand}"
								IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
								Style="{StaticResource MaterialDesignRaisedButton}"
								ToolTip="上代変更伝票を検索 (F5)">
								<StackPanel Orientation="Horizontal">
									<materialDesign:PackIcon VerticalAlignment="Center"
										Kind="DatabaseSearch" />
									<TextBlock Margin="8,0,0,0" VerticalAlignment="Center"
										FontSize="16" Text="検索(F5)" />
								</StackPanel>
							</Button>
						</Grid>
					</materialDesign:Card>

					<materialDesign:Card Grid.Row="1"
						Margin="0,8,0,0" Padding="0"
						materialDesign:ElevationAssist.Elevation="Dp1" UniformCornerRadius="8">
						<DataGrid d:ItemsSource="{d:SampleData ItemCount=5}"
							helpers:DataGridSelectionBehavior.AutoScrollToSelectedItem="True" materialDesign:DataGridAssist.CellPadding="12,6" materialDesign:DataGridAssist.ColumnHeaderPadding="12,8"
							AlternatingRowBackground="{DynamicResource DataGridAlternatingRowBackgroundBrush}"
							AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" EnableRowVirtualization="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
							HorizontalGridLinesBrush="{DynamicResource MaterialDesignDivider}"
							IsReadOnly="True"
							ItemsSource="{Binding ListRows}"
							SelectedItem="{Binding SelectedListRow, Mode=TwoWay}"
							Style="{StaticResource MaterialDesignDataGrid}"
							VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
							<DataGrid.Columns>
								<DataGridTextColumn Width="80"
									Binding="{Binding Id, StringFormat={}{0:N0}}"
									ElementStyle="{StaticResource DataGridRightTextBlock}"
									Header="伝票No" />
								<DataGridTextColumn Width="90"
									Binding="{Binding DenDay}"
									Header="登録日" />
								<DataGridTextColumn Width="70"
									Binding="{Binding KubunName}"
									Header="P/S" />
								<DataGridTextColumn Width="80"
									Binding="{Binding TaishoName}"
									Header="対象" />
								<DataGridTextColumn Width="140"
									Binding="{Binding SaleName}"
									Header="セールCD" />
								<DataGridTextColumn Width="*" MinWidth="160"
									Binding="{Binding Title}"
									Header="タイトル" />
								<DataGridTextColumn Width="170"
									Binding="{Binding Period}"
									Header="期間" />
								<DataGridTextColumn Width="70"
									Binding="{Binding ShopCnt, StringFormat={}{0:N0}}"
									ElementStyle="{StaticResource DataGridRightTextBlock}"
									Header="対象数" />
								<DataGridTextColumn Width="70"
									Binding="{Binding MeisaiCnt, StringFormat={}{0:N0}}"
									ElementStyle="{StaticResource DataGridRightTextBlock}"
									Header="明細数" />
								<DataGridTextColumn Width="80"
									Binding="{Binding ExpandCnt, StringFormat={}{0:N0}}"
									ElementStyle="{StaticResource DataGridRightTextBlock}"
									Header="展開数" />
								<DataGridTextColumn Width="70"
									Binding="{Binding StatusName}"
									Header="状態" />
								<DataGridTextColumn Width="70"
									Binding="{Binding SendFlgName}"
									Header="送信" />
								<DataGridTextColumn Width="130"
									Binding="{Binding ShainName}"
									Header="入力者" />
							</DataGrid.Columns>
							<DataGrid.ColumnHeaderStyle>
								<Style BasedOn="{StaticResource MenteDataGridColumnHeader}"
									TargetType="DataGridColumnHeader" />
							</DataGrid.ColumnHeaderStyle>
						</DataGrid>
					</materialDesign:Card>

					<Grid Grid.Row="2"
						Margin="0,10,0,4">
						<StackPanel HorizontalAlignment="Left"
							Orientation="Horizontal">
							<TextBlock VerticalAlignment="Center"
								Style="{StaticResource StatusTextBlockStyle}"
								Text="行を選んで [修正・登録画面へ]。JSON明細は一覧では読み込まないため、件数のみ表示しています" TextTrimming="CharacterEllipsis" />
						</StackPanel>
						<StackPanel HorizontalAlignment="Right"
							Orientation="Horizontal">
							<Button Command="{Binding DoNewCommand}"
								Style="{StaticResource MaterialDesignOutlinedButton}"
								ToolTip="新しい上代変更伝票を作成">
								<TextBlock FontSize="16" Text="新規" />
							</Button>
							<Button Margin="12,0,0,0"
								Command="{Binding GoToEditCommand}"
								Style="{StaticResource MaterialDesignRaisedButton}"
								ToolTip="選択した伝票を修正・登録画面で開く">
								<TextBlock FontSize="16" Text="修正・登録画面へ" />
							</Button>
						</StackPanel>
					</Grid>
				</Grid>
			</TabItem>

			<!--  ================= タブ2: 修正・登録画面 =================  -->
			<TabItem Header="修正・登録画面">
				<Grid Margin="0,10,0,0">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>

					<!--  伝票ヘッダ（内側タブの外＝常時表示）  -->
					<materialDesign:Card Grid.Row="0"
						Padding="14,12"
						materialDesign:ElevationAssist.Elevation="Dp1" UniformCornerRadius="8">
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition Width="*" MinWidth="200" />
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition Width="*" MinWidth="200" />
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition Width="*" MinWidth="200" />
							</Grid.ColumnDefinitions>
							<Grid.RowDefinitions>
								<RowDefinition Height="Auto" />
								<RowDefinition Height="Auto" />
								<RowDefinition Height="Auto" />
							</Grid.RowDefinitions>

							<TextBlock Grid.Row="0" Grid.Column="0"
								Style="{StaticResource FormLabel}"
								Text="P/S区分" />
							<ComboBox Grid.Row="0" Grid.Column="1"
								Margin="0,4,16,4"
								DisplayMemberPath="Name"
								ItemsSource="{Binding KubunOptions}"
								SelectedValue="{Binding EditKubun, Mode=TwoWay}"
								SelectedValuePath="Value"
								Style="{StaticResource FormComboBox}"
								ToolTip="プロパーは無期限(終了日 99991231)のオーバーレイとして登録されます" />

							<TextBlock Grid.Row="0" Grid.Column="2"
								Style="{StaticResource FormLabel}"
								Text="対象" />
							<ComboBox Grid.Row="0" Grid.Column="3"
								Margin="0,4,16,4"
								DisplayMemberPath="Name"
								ItemsSource="{Binding TaishoOptions}"
								SelectedValue="{Binding EditTaishoType, Mode=TwoWay}"
								SelectedValuePath="Value"
								Style="{StaticResource FormComboBox}"
								ToolTip="店舗用は直営店(TenType=6)、本部売上用は卸先・売仕店(TenType=1,3)が対象になります" />

							<TextBlock Grid.Row="0" Grid.Column="4"
								Style="{StaticResource FormLabel}"
								Text="セールCD" />
							<Grid Grid.Row="0" Grid.Column="5">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="Auto" />
								</Grid.ColumnDefinitions>
								<ComboBox Margin="0,4"
									DisplayMemberPath="Display"
									ItemsSource="{Binding SaleOptions}"
									SelectedItem="{Binding SelectedSale, Mode=TwoWay}"
									Style="{StaticResource FormComboBox}"
									ToolTip="名称マスタの区分 SLE" />
								<Button Grid.Column="1"
									Command="{Binding SelectSaleDialogCommand}"
									Content="&lt;&lt;"
									Style="{StaticResource BudgetActionButtonStyle}"
									ToolTip="セールCDを検索して選択" />
							</Grid>

							<TextBlock Grid.Row="1" Grid.Column="0"
								Style="{StaticResource FormLabel}"
								Text="タイトル" />
							<TextBox Grid.Row="1" Grid.Column="1"
								Margin="0,4,16,4"
								Style="{StaticResource FormTextBox}"
								Text="{Binding EditTitle, UpdateSourceTrigger=PropertyChanged}" />

							<TextBlock Grid.Row="1" Grid.Column="2"
								Style="{StaticResource FormLabel}"
								Text="開始日" />
							<DatePicker Grid.Row="1" Grid.Column="3"
								Margin="0,4,16,4"
								helpers:DatePickerTodayButtonBehavior.IsEnabled="True" IsTodayHighlighted="False"
								SelectedDate="{Binding EditDayFrom, Mode=TwoWay}"
								Style="{StaticResource FormDatePicker}"
								ToolTip="店舗別に期間を変える場合は下の対象一覧で個別に設定します" />

							<TextBlock Grid.Row="1" Grid.Column="4"
								Style="{StaticResource FormLabel}"
								Text="終了日" />
							<DatePicker Grid.Row="1" Grid.Column="5"
								Margin="0,4"
								helpers:DatePickerTodayButtonBehavior.IsEnabled="True" IsTodayHighlighted="False"
								SelectedDate="{Binding EditDayTo, Mode=TwoWay}"
								Style="{StaticResource FormDatePicker}" />

							<TextBlock Grid.Row="2" Grid.Column="0"
								Style="{StaticResource FormLabel}"
								Text="入力者" />
							<Grid Grid.Row="2" Grid.Column="1"
								Margin="0,0,16,0">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="Auto" />
								</Grid.ColumnDefinitions>
								<ComboBox Margin="0,4"
									DisplayMemberPath="Display"
									ItemsSource="{Binding ShainOptions}"
									SelectedItem="{Binding SelectedShain, Mode=TwoWay}"
									Style="{StaticResource FormComboBox}" />
								<Button Grid.Column="1"
									Command="{Binding SelectShainDialogCommand}"
									Content="&lt;&lt;"
									Style="{StaticResource BudgetActionButtonStyle}"
									ToolTip="入力者を検索して選択" />
							</Grid>

							<TextBlock Grid.Row="2" Grid.Column="2"
								InputMethod.IsInputMethodEnabled="True"
								Style="{StaticResource FormLabel}"
								Text="備考" />
							<TextBox Grid.Row="2" Grid.Column="3" Grid.ColumnSpan="3"
								Margin="0,4"
								Style="{StaticResource FormTextBox}"
								Text="{Binding EditMemo, UpdateSourceTrigger=PropertyChanged}" />
						</Grid>
					</materialDesign:Card>

					<!--  内側タブ：① 対象商品 ② 適用範囲 ③ 価格（設計書5.1。前進・後退の強制はしない）  -->
					<TabControl Grid.Row="1"
						Margin="0,8,0,0"
						Style="{StaticResource MaterialDesignTabControl}">

						<!--  ================= ① 対象商品 =================  -->
						<TabItem Header="① 対象商品">
							<Grid Margin="0,10,0,0">
								<materialDesign:Card Padding="14,12"
									materialDesign:ElevationAssist.Elevation="Dp1" UniformCornerRadius="8">
									<Grid>
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="*" />
											<ColumnDefinition Width="Auto" />
										</Grid.ColumnDefinitions>
										<Grid.RowDefinitions>
											<RowDefinition Height="Auto" />
											<RowDefinition Height="Auto" />
											<RowDefinition Height="Auto" />
										</Grid.RowDefinitions>

										<DockPanel Grid.Row="0" Grid.Column="0"
											Margin="0,0,0,4">
											<StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
												<Border Padding="8,2"
													Background="{DynamicResource MaterialDesignDivider}"
													CornerRadius="10">
													<TextBlock FontSize="12" FontWeight="SemiBold"
														Text="{Binding MeisaiCount, StringFormat={}Style {0:N0} 件}" />
												</Border>
												<Border Margin="6,0,0,0" Padding="8,2"
													Background="{DynamicResource MaterialDesignDivider}"
													CornerRadius="10">
													<TextBlock FontSize="12" FontWeight="SemiBold"
														Text="{Binding TargetSkuCount, StringFormat={}SKU {0:N0} 件}"
														ToolTip="DerivedShohinColSiz（色×サイズ展開）の件数" />
												</Border>
											</StackPanel>
											<TextBlock VerticalAlignment="Center"
												FontWeight="SemiBold" Text="抽出条件（対象商品の絞り込み）" />
										</DockPanel>

										<DataGrid Grid.Row="1" Grid.Column="0"
											MaxHeight="260"
											Margin="0,0,12,0"
											materialDesign:DataGridAssist.CellPadding="8,4" materialDesign:DataGridAssist.ColumnHeaderPadding="8,4" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
											GridLinesVisibility="Horizontal" HeadersVisibility="Column"
											HorizontalGridLinesBrush="{DynamicResource MaterialDesignDivider}"
											ItemsSource="{Binding CondRows}"
											Style="{StaticResource MaterialDesignDataGrid}">
											<DataGrid.Columns>
												<DataGridTextColumn Width="40"
													Binding="{Binding No}"
													Header="行" IsReadOnly="True" />
												<DataGridTemplateColumn Width="60"
													Header="結合">
													<DataGridTemplateColumn.CellTemplate>
														<DataTemplate>
															<!--  1行目は繋ぐ相手が無いため空表示にする（誤解防止）  -->
															<TextBlock Margin="4,0" VerticalAlignment="Center">
																<TextBlock.Style>
																	<Style BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="TextBlock">
																		<Setter Property="Text" Value="{Binding Ope, Converter={StaticResource JodaiOpeDisplayConverter}}" />
																		<Style.Triggers>
																			<DataTrigger Binding="{Binding No}" Value="1">
																				<Setter Property="Text" Value="" />
																			</DataTrigger>
																		</Style.Triggers>
																	</Style>
																</TextBlock.Style>
															</TextBlock>
														</DataTemplate>
													</DataGridTemplateColumn.CellTemplate>
													<DataGridTemplateColumn.CellEditingTemplate>
														<DataTemplate>
															<ComboBox DisplayMemberPath="Name"
																ItemsSource="{Binding DataContext.OpeOptions, RelativeSource={RelativeSource AncestorType=DataGrid}}"
																SelectedValue="{Binding Ope, Mode=TwoWay}"
																SelectedValuePath="Value">
																<ComboBox.Style>
																	<Style BasedOn="{StaticResource {x:Type ComboBox}}" TargetType="ComboBox">
																		<Style.Triggers>
																			<DataTrigger Binding="{Binding No}" Value="1">
																				<Setter Property="IsEnabled" Value="False" />
																			</DataTrigger>
																		</Style.Triggers>
																	</Style>
																</ComboBox.Style>
															</ComboBox>
														</DataTemplate>
													</DataGridTemplateColumn.CellEditingTemplate>
												</DataGridTemplateColumn>
												<DataGridTemplateColumn Width="170"
													Header="検索項目">
													<DataGridTemplateColumn.CellTemplate>
														<DataTemplate>
															<TextBlock Margin="4,0" VerticalAlignment="Center"
																Text="{Binding Field.Name}" />
														</DataTemplate>
													</DataGridTemplateColumn.CellTemplate>
													<DataGridTemplateColumn.CellEditingTemplate>
														<DataTemplate>
															<!--  FieldOptionsはJsubの枠を実行時に読み込むため非static。DataGridComboBoxColumnは
															      視覚ツリーの外にありDataContextを辿れないため、ここはTemplateColumn+ComboBoxで
															      DataContext.FieldOptionsをAncestorType=DataGrid経由で参照する  -->
															<ComboBox DisplayMemberPath="Name"
																ItemsSource="{Binding DataContext.FieldOptions, RelativeSource={RelativeSource AncestorType=DataGrid}}"
																SelectedItem="{Binding Field, Mode=TwoWay}" />
														</DataTemplate>
													</DataGridTemplateColumn.CellEditingTemplate>
												</DataGridTemplateColumn>
												<DataGridTextColumn Width="*" MinWidth="110"
													Binding="{Binding CdFrom, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
													Header="コード(FROM)" />
												<DataGridTextColumn Width="*" MinWidth="110"
													Binding="{Binding CdTo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
													Header="コード(TO)" />
												<DataGridTemplateColumn Width="50"
													Header="削除">
													<DataGridTemplateColumn.CellTemplate>
														<DataTemplate>
															<Button Padding="4"
																Command="{Binding DataContext.RemoveCondRowCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
																CommandParameter="{Binding}"
																Style="{StaticResource MaterialDesignIconButton}">
																<materialDesign:PackIcon Kind="Delete" />
															</Button>
														</DataTemplate>
													</DataGridTemplateColumn.CellTemplate>
												</DataGridTemplateColumn>
											</DataGrid.Columns>
											<DataGrid.ColumnHeaderStyle>
												<Style BasedOn="{StaticResource MenteDataGridColumnHeader}"
													TargetType="DataGridColumnHeader" />
											</DataGrid.ColumnHeaderStyle>
										</DataGrid>

										<Button Grid.Row="2" Grid.Column="0"
											Width="140"
											Margin="0,6,0,0" HorizontalAlignment="Left"
											Command="{Binding AddCondRowCommand}"
											Style="{StaticResource MaterialDesignOutlinedButton}">
											<StackPanel Orientation="Horizontal">
												<materialDesign:PackIcon VerticalAlignment="Center"
													Kind="Plus" />
												<TextBlock Margin="8,0,0,0" VerticalAlignment="Center"
													FontSize="14" Text="条件行追加" />
											</StackPanel>
										</Button>

										<StackPanel Grid.Row="1" Grid.RowSpan="2" Grid.Column="1"
											VerticalAlignment="Top">
											<Grid>
												<Grid.ColumnDefinitions>
													<ColumnDefinition Width="Auto" />
													<ColumnDefinition Width="*" MinWidth="120" />
												</Grid.ColumnDefinitions>
												<TextBlock Style="{StaticResource FormLabel}"
													Text="在庫" />
												<ComboBox Grid.Column="1"
													Margin="0,4"
													DisplayMemberPath="Name"
													ItemsSource="{Binding ZaikoOptions}"
													SelectedValue="{Binding ZaikoJoken, Mode=TwoWay}"
													SelectedValuePath="Value"
													Style="{StaticResource FormComboBox}" />
											</Grid>
											<Grid Margin="0,4,0,6">
												<Grid.ColumnDefinitions>
													<ColumnDefinition Width="Auto" />
													<ColumnDefinition Width="*" MinWidth="120" />
												</Grid.ColumnDefinitions>
												<TextBlock VerticalAlignment="Center"
													Style="{StaticResource FormLabel}"
													Text="上限" />
												<TextBox Grid.Column="1"
													Style="{StaticResource NumericFormTextBox}"
													Text="{Binding MaxCountText, UpdateSourceTrigger=PropertyChanged}" />
											</Grid>
											<Button Command="{Binding GetMeisaiCommand}"
												IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
												Style="{StaticResource MaterialDesignRaisedButton}"
												ToolTip="抽出条件に一致する商品を明細として取得">
												<StackPanel Orientation="Horizontal">
													<materialDesign:PackIcon VerticalAlignment="Center"
														Kind="DatabaseSearch" />
													<TextBlock Margin="8,0,0,0" VerticalAlignment="Center"
														FontSize="15" Text="明細取得" />
												</StackPanel>
											</Button>
										</StackPanel>
									</Grid>
								</materialDesign:Card>
							</Grid>
						</TabItem>

						<!--  ================= ② 適用範囲（Scope） =================  -->
						<TabItem Header="② 適用範囲">
							<Grid Margin="0,10,0,0">
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto" />
									<RowDefinition Height="2*" />
									<RowDefinition Height="1*" />
								</Grid.RowDefinitions>

								<!--  新規Scope作成時の既定値（旧:一括変更条件。設計書3.6）  -->
								<materialDesign:Card Grid.Row="0"
									Padding="14,12"
									materialDesign:ElevationAssist.Elevation="Dp1" UniformCornerRadius="8">
									<Grid>
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="Auto" />
											<ColumnDefinition Width="*" MinWidth="130" />
											<ColumnDefinition Width="Auto" />
											<ColumnDefinition Width="*" MinWidth="130" />
											<ColumnDefinition Width="Auto" />
										</Grid.ColumnDefinitions>
										<Grid.RowDefinitions>
											<RowDefinition Height="Auto" />
											<RowDefinition Height="Auto" />
											<RowDefinition Height="Auto" />
										</Grid.RowDefinitions>

										<TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="5"
											Margin="0,0,0,4"
											FontWeight="SemiBold" Text="新規Scope作成時の既定値（[Scope追加]・[段を追加]で使う初期値）" />

										<TextBlock Grid.Row="1" Grid.Column="0"
											Style="{StaticResource FormLabel}"
											Text="変更方法" />
										<ComboBox Grid.Row="1" Grid.Column="1"
											Margin="0,4,12,4"
											DisplayMemberPath="Name"
											ItemsSource="{Binding CalcTypeOptions}"
											SelectedValue="{Binding CalcType, Mode=TwoWay}"
											SelectedValuePath="Value"
											Style="{StaticResource FormComboBox}" />

										<TextBlock Grid.Row="1" Grid.Column="2"
											Style="{StaticResource FormLabel}"
											Text="率(%)" />
										<TextBox Grid.Row="1" Grid.Column="3"
											Margin="0,4,12,4"
											Style="{StaticResource NumericFormTextBox}"
											Text="{Binding CalcRateText, UpdateSourceTrigger=PropertyChanged}"
											ToolTip="上代からのOFF率。例 14.28 なら 上代×85.72%" />

										<TextBlock Grid.Row="2" Grid.Column="0"
											Style="{StaticResource FormLabel}"
											Text="丸め" />
										<ComboBox Grid.Row="2" Grid.Column="1"
											Margin="0,4,12,4"
											DisplayMemberPath="Name"
											ItemsSource="{Binding RoundUnitOptions}"
											SelectedValue="{Binding RoundUnit, Mode=TwoWay}"
											SelectedValuePath="Value"
											Style="{StaticResource FormComboBox}" />
										<ComboBox Grid.Row="2" Grid.Column="3"
											Margin="0,4,12,4"
											DisplayMemberPath="Name"
											ItemsSource="{Binding RoundTypeOptions}"
											SelectedValue="{Binding RoundType, Mode=TwoWay}"
											SelectedValuePath="Value"
											Style="{StaticResource FormComboBox}" />

										<TextBlock Grid.Row="2" Grid.Column="2"
											Style="{StaticResource FormLabel}"
											Text="金額" />

										<StackPanel Grid.Row="1" Grid.RowSpan="2" Grid.Column="4"
											VerticalAlignment="Center">
											<TextBox MinWidth="90"
												Margin="0,0,0,6"
												Style="{StaticResource NumericFormTextBox}"
												Text="{Binding CalcValueText, UpdateSourceTrigger=PropertyChanged}"
												ToolTip="変更方法が「金額指定」のとき、新販売価格に一律で設定する金額" />
											<Button Command="{Binding ApplyCalcAllCommand}"
												Style="{StaticResource MaterialDesignOutlinedButton}"
												ToolTip="明細の新販売価格をまとめて再計算（旧Scope1件運用の互換用）">
												<TextBlock FontSize="15" Text="変更" />
											</Button>
										</StackPanel>
									</Grid>
								</materialDesign:Card>

								<!--  適用範囲（Scope）一覧（設計書5.3）  -->
								<materialDesign:Card Grid.Row="1"
									Margin="0,8,0,0" Padding="12,10"
									materialDesign:ElevationAssist.Elevation="Dp1" UniformCornerRadius="8">
									<Grid>
										<Grid.RowDefinitions>
											<RowDefinition Height="Auto" />
											<RowDefinition Height="*" />
										</Grid.RowDefinitions>

										<DockPanel Grid.Row="0"
											Margin="0,0,0,6">
											<StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
												<Button Margin="0,0,6,0"
													Command="{Binding AddScopeRowCommand}"
													Style="{StaticResource MaterialDesignOutlinedButton}"
													ToolTip="全店/対象のScopeを1件追加する">
													<TextBlock FontSize="14" Text="Scope追加" />
												</Button>
												<Button Margin="0,0,6,0"
													Command="{Binding AddScopeStageCommand}"
													Style="{StaticResource MaterialDesignOutlinedButton}"
													ToolTip="選択中のScopeの範囲を引き継ぎ、期間だけ後ろにずらして複製する（段階値下げ）">
													<TextBlock FontSize="14" Text="段を追加" />
												</Button>
												<Button Margin="0,0,12,0"
													Command="{Binding RemoveScopeRowCommand}"
													CommandParameter="{Binding SelectedScopeRow}"
													Style="{StaticResource MaterialDesignOutlinedButton}"
													ToolTip="選択中のScopeを削除する（最後の1件は残る）">
													<TextBlock FontSize="14" Text="Scope削除" />
												</Button>
												<Button Command="{Binding ResolveScopeCommand}"
													IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
													Style="{StaticResource MaterialDesignRaisedButton}"
													ToolTip="Scopeを実店舗へ解決し、店舗→採用Scopeの対応と競合を表示する">
													<TextBlock FontSize="14" Text="解決結果を確認" />
												</Button>
											</StackPanel>
											<TextBlock VerticalAlignment="Center"
												FontWeight="SemiBold" Text="適用範囲（Scope）一覧　※1行＝1 Scope。Price Matrixの列にも対応します" />
										</DockPanel>

										<DataGrid Grid.Row="1"
											d:ItemsSource="{d:SampleData ItemCount=3}"
											helpers:DataGridCellEnterNavigation.IsEnabled="True" materialDesign:DataGridAssist.CellPadding="6,4" materialDesign:DataGridAssist.ColumnHeaderPadding="6,6"
											AlternatingRowBackground="{DynamicResource DataGridAlternatingRowBackgroundBrush}"
											AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" EnableRowVirtualization="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
											HorizontalGridLinesBrush="{DynamicResource MaterialDesignDivider}"
											ItemsSource="{Binding ScopeRows}"
											SelectedItem="{Binding SelectedScopeRow, Mode=TwoWay}"
											Style="{StaticResource MaterialDesignDataGrid}"
											VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
											<DataGrid.Columns>
												<DataGridTextColumn Width="36"
													Binding="{Binding No}"
													ElementStyle="{StaticResource DataGridRightTextBlock}"
													Header="No" IsReadOnly="True" />
												<DataGridTextColumn Width="110"
													Binding="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
													Header="表示名" />
												<DataGridTemplateColumn Width="100"
													Header="範囲種別">
													<DataGridTemplateColumn.CellTemplate>
														<DataTemplate>
															<TextBlock Margin="4,0" VerticalAlignment="Center"
																Text="{Binding RangeType, Converter={StaticResource JodaiRangeTypeDisplayConverter}}" />
														</DataTemplate>
													</DataGridTemplateColumn.CellTemplate>
													<DataGridTemplateColumn.CellEditingTemplate>
														<DataTemplate>
															<ComboBox DisplayMemberPath="Name"
																ItemsSource="{Binding DataContext.RangeTypeOptions, RelativeSource={RelativeSource AncestorType=DataGrid}}"
																SelectedValue="{Binding RangeType, Mode=TwoWay}"
																SelectedValuePath="Value" />
														</DataTemplate>
													</DataGridTemplateColumn.CellEditingTemplate>
												</DataGridTemplateColumn>
												<DataGridTemplateColumn Width="90"
													Header="軸">
													<DataGridTemplateColumn.CellTemplate>
														<DataTemplate>
															<TextBlock Margin="4,0" VerticalAlignment="Center"
																Text="{Binding GroupAxis, Converter={StaticResource JodaiGroupAxisDisplayConverter}}" />
														</DataTemplate>
													</DataGridTemplateColumn.CellTemplate>
													<DataGridTemplateColumn.CellEditingTemplate>
														<DataTemplate>
															<ComboBox DisplayMemberPath="Name"
																ItemsSource="{Binding DataContext.GroupAxisOptions, RelativeSource={RelativeSource AncestorType=DataGrid}}"
																IsEnabled="{Binding RangeType, Converter={StaticResource JodaiIsPriceGroupConverter}}"
																SelectedValue="{Binding GroupAxis, Mode=TwoWay}"
																SelectedValuePath="Value" />
														</DataTemplate>
													</DataGridTemplateColumn.CellEditingTemplate>
												</DataGridTemplateColumn>
												<DataGridTemplateColumn Width="150"
													Header="グループ or 店舗">
													<DataGridTemplateColumn.CellTemplate>
														<DataTemplate>
															<TextBlock Margin="4,0" VerticalAlignment="Center"
																Text="{Binding GroupOrStoreDisplay}" />
														</DataTemplate>
													</DataGridTemplateColumn.CellTemplate>
													<DataGridTemplateColumn.CellEditingTemplate>
														<DataTemplate>
															<!--  ItemsSourceはRangeType/GroupAxisにより切り替える（価格グループ3軸 or 店舗）。
															      Id_Group/Id_Tenpoとコード・名称(時点値)の同時更新はJodaiScopeRow.SelectedGroupOrStoreOptionが行う  -->
															<ComboBox DisplayMemberPath="Display"
																SelectedItem="{Binding SelectedGroupOrStoreOption, Mode=TwoWay}">
																<ComboBox.Style>
																	<Style TargetType="ComboBox">
																		<Setter Property="ItemsSource" Value="{Binding DataContext.PriceGroupOptions, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
																		<Style.Triggers>
																			<MultiDataTrigger>
																				<MultiDataTrigger.Conditions>
																					<Condition Binding="{Binding RangeType}" Value="1" />
																					<Condition Binding="{Binding GroupAxis}" Value="1" />
																				</MultiDataTrigger.Conditions>
																				<Setter Property="ItemsSource" Value="{Binding DataContext.PriceAreaOptions, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
																			</MultiDataTrigger>
																			<MultiDataTrigger>
																				<MultiDataTrigger.Conditions>
																					<Condition Binding="{Binding RangeType}" Value="1" />
																					<Condition Binding="{Binding GroupAxis}" Value="2" />
																				</MultiDataTrigger.Conditions>
																				<Setter Property="ItemsSource" Value="{Binding DataContext.PriceChannelOptions, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
																			</MultiDataTrigger>
																			<DataTrigger Binding="{Binding RangeType}" Value="2">
																				<Setter Property="ItemsSource" Value="{Binding DataContext.ScopeStoreOptions, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
																			</DataTrigger>
																			<DataTrigger Binding="{Binding RangeType}" Value="0">
																				<Setter Property="IsEnabled" Value="False" />
																			</DataTrigger>
																		</Style.Triggers>
																	</Style>
																</ComboBox.Style>
															</ComboBox>
														</DataTemplate>
													</DataGridTemplateColumn.CellEditingTemplate>
												</DataGridTemplateColumn>
												<DataGridTemplateColumn Width="80"
													Header="対象/除外">
													<DataGridTemplateColumn.CellTemplate>
														<DataTemplate>
															<TextBlock Margin="4,0" VerticalAlignment="Center"
																Text="{Binding IncExc, Converter={StaticResource JodaiIncExcDisplayConverter}}" />
														</DataTemplate>
													</DataGridTemplateColumn.CellTemplate>
													<DataGridTemplateColumn.CellEditingTemplate>
														<DataTemplate>
															<ComboBox DisplayMemberPath="Name"
																ItemsSource="{Binding DataContext.IncExcOptions, RelativeSource={RelativeSource AncestorType=DataGrid}}"
																SelectedValue="{Binding IncExc, Mode=TwoWay}"
																SelectedValuePath="Value" />
														</DataTemplate>
													</DataGridTemplateColumn.CellEditingTemplate>
												</DataGridTemplateColumn>
												<DataGridTextColumn Width="85"
													Binding="{Binding DayFrom, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
													Header="開始日" />
												<DataGridTextColumn Width="85"
													Binding="{Binding DayTo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
													Header="終了日" />
												<DataGridTemplateColumn Width="140"
													Header="価格方式">
													<DataGridTemplateColumn.CellTemplate>
														<DataTemplate>
															<TextBlock Margin="4,0" VerticalAlignment="Center"
																Text="{Binding PriceMethod, Converter={StaticResource JodaiPriceMethodDisplayConverter}}" />
														</DataTemplate>
													</DataGridTemplateColumn.CellTemplate>
													<DataGridTemplateColumn.CellEditingTemplate>
														<DataTemplate>
															<ComboBox DisplayMemberPath="Name"
																ItemsSource="{Binding DataContext.PriceMethodOptions, RelativeSource={RelativeSource AncestorType=DataGrid}}"
																SelectedValue="{Binding PriceMethod, Mode=TwoWay}"
																SelectedValuePath="Value" />
														</DataTemplate>
													</DataGridTemplateColumn.CellEditingTemplate>
												</DataGridTemplateColumn>
												<DataGridTextColumn Width="80"
													Binding="{Binding FixedPrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
													ElementStyle="{StaticResource DataGridRightTextBlock}"
													Header="固定額" />
												<DataGridTextColumn Width="80"
													Binding="{Binding RateOff, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:0.00}}"
													ElementStyle="{StaticResource DataGridRightTextBlock}"
													Header="値下率%" />
												<DataGridTextColumn Width="80"
													Binding="{Binding Amount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
													ElementStyle="{StaticResource DataGridRightTextBlock}"
													Header="値引額" />
												<DataGridTextColumn Width="80"
													Binding="{Binding RateOn, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:0.00}}"
													ElementStyle="{StaticResource DataGridRightTextBlock}"
													Header="掛率%" />
												<DataGridTemplateColumn Width="130"
													Header="価格ポイント表">
													<DataGridTemplateColumn.CellTemplate>
														<DataTemplate>
															<TextBlock Margin="4,0" VerticalAlignment="Center"
																Text="{Binding Id_PricePoint}" />
														</DataTemplate>
													</DataGridTemplateColumn.CellTemplate>
													<DataGridTemplateColumn.CellEditingTemplate>
														<DataTemplate>
															<ComboBox DisplayMemberPath="Display"
																ItemsSource="{Binding DataContext.PricePointOptions, RelativeSource={RelativeSource AncestorType=DataGrid}}"
																SelectedValue="{Binding Id_PricePoint, Mode=TwoWay}"
																SelectedValuePath="Id"
																ToolTip="価格方式=価格ポイントのとき使用" />
														</DataTemplate>
													</DataGridTemplateColumn.CellEditingTemplate>
												</DataGridTemplateColumn>
												<DataGridTemplateColumn Width="90"
													Header="丸め単位">
													<DataGridTemplateColumn.CellTemplate>
														<DataTemplate>
															<TextBlock Margin="4,0" VerticalAlignment="Center"
																Text="{Binding RoundUnit, Converter={StaticResource JodaiRoundUnitDisplayConverter}}" />
														</DataTemplate>
													</DataGridTemplateColumn.CellTemplate>
													<DataGridTemplateColumn.CellEditingTemplate>
														<DataTemplate>
															<ComboBox DisplayMemberPath="Name"
																ItemsSource="{Binding DataContext.RoundUnitOptions, RelativeSource={RelativeSource AncestorType=DataGrid}}"
																SelectedValue="{Binding RoundUnit, Mode=TwoWay}"
																SelectedValuePath="Value" />
														</DataTemplate>
													</DataGridTemplateColumn.CellEditingTemplate>
												</DataGridTemplateColumn>
												<DataGridTemplateColumn Width="90"
													Header="丸め方法">
													<DataGridTemplateColumn.CellTemplate>
														<DataTemplate>
															<TextBlock Margin="4,0" VerticalAlignment="Center"
																Text="{Binding RoundType, Converter={StaticResource JodaiRoundTypeDisplayConverter}}" />
														</DataTemplate>
													</DataGridTemplateColumn.CellTemplate>
													<DataGridTemplateColumn.CellEditingTemplate>
														<DataTemplate>
															<ComboBox DisplayMemberPath="Name"
																ItemsSource="{Binding DataContext.RoundTypeOptions, RelativeSource={RelativeSource AncestorType=DataGrid}}"
																SelectedValue="{Binding RoundType, Mode=TwoWay}"
																SelectedValuePath="Value" />
														</DataTemplate>
													</DataGridTemplateColumn.CellEditingTemplate>
												</DataGridTemplateColumn>
											</DataGrid.Columns>
											<DataGrid.ColumnHeaderStyle>
												<Style BasedOn="{StaticResource MenteDataGridColumnHeader}"
													TargetType="DataGridColumnHeader" />
											</DataGrid.ColumnHeaderStyle>
										</DataGrid>
									</Grid>
								</materialDesign:Card>

								<!--  対象店舗（Scope解決の候補選択。設計書3.3・U5）  -->
								<materialDesign:Card Grid.Row="2"
									Margin="0,8,0,0" Padding="12,10"
									materialDesign:ElevationAssist.Elevation="Dp1" UniformCornerRadius="8">
									<Grid>
										<Grid.RowDefinitions>
											<RowDefinition Height="Auto" />
											<RowDefinition Height="Auto" />
											<RowDefinition Height="*" />
										</Grid.RowDefinitions>

										<DockPanel Grid.Row="0"
											Margin="0,0,0,6">
											<Border Padding="8,2"
												Background="{DynamicResource MaterialDesignDivider}"
												CornerRadius="10" DockPanel.Dock="Right">
												<TextBlock FontSize="12" FontWeight="SemiBold"
													Text="{Binding TargetShopCount, StringFormat={}選択 {0:N0} 件}" />
											</Border>
											<TextBlock VerticalAlignment="Center"
												FontWeight="SemiBold" Text="対象店舗（Scope解決の候補。チェックした店舗だけがResolveの対象になります）" />
										</DockPanel>

										<WrapPanel Grid.Row="1"
											Margin="0,0,0,6">
											<Button Margin="0,0,6,0"
												Command="{Binding LoadShopsCommand}"
												Style="{StaticResource MaterialDesignOutlinedButton}"
												ToolTip="対象区分に応じた対象候補を読み込む">
												<TextBlock FontSize="14" Text="一覧取得" />
											</Button>
											<Button Margin="0,0,6,0"
												Command="{Binding ShopAllOnCommand}"
												Style="{StaticResource MaterialDesignOutlinedButton}">
												<TextBlock FontSize="14" Text="全てON" />
											</Button>
											<Button Margin="0,0,12,0"
												Command="{Binding ShopAllOffCommand}"
												Style="{StaticResource MaterialDesignOutlinedButton}">
												<TextBlock FontSize="14" Text="全てOFF" />
											</Button>
											<DatePicker Width="130"
												Margin="0,0,4,0"
												helpers:DatePickerTodayButtonBehavior.IsEnabled="True" IsTodayHighlighted="False"
												SelectedDate="{Binding ShopDayFrom, Mode=TwoWay}"
												Style="{StaticResource FormDatePicker}" />
											<DatePicker Width="130"
												Margin="0,0,6,0"
												helpers:DatePickerTodayButtonBehavior.IsEnabled="True" IsTodayHighlighted="False"
												SelectedDate="{Binding ShopDayTo, Mode=TwoWay}"
												Style="{StaticResource FormDatePicker}" />
											<Button Command="{Binding ApplyShopPeriodCommand}"
												Style="{StaticResource MaterialDesignOutlinedButton}"
												ToolTip="チェック済みの対象へ期間をまとめて設定（Scope1件の互換運用向け。手動の期間微調整は保存時に維持されます）">
												<TextBlock FontSize="14" Text="期間設定" />
											</Button>
										</WrapPanel>

										<DataGrid Grid.Row="2"
											d:ItemsSource="{d:SampleData ItemCount=5}"
											helpers:DataGridCellEnterNavigation.IsEnabled="True" materialDesign:DataGridAssist.CellPadding="8,4" materialDesign:DataGridAssist.ColumnHeaderPadding="8,6"
											AlternatingRowBackground="{DynamicResource DataGridAlternatingRowBackgroundBrush}"
											AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" EnableRowVirtualization="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
											HorizontalGridLinesBrush="{DynamicResource MaterialDesignDivider}"
											ItemsSource="{Binding ShopRows}"
											Style="{StaticResource MaterialDesignDataGrid}"
											VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
											<DataGrid.Columns>
												<DataGridCheckBoxColumn Width="46"
													Binding="{Binding IsTarget, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
													Header="対象" />
												<DataGridTextColumn Width="80"
													Binding="{Binding Code_Tenpo}"
													Header="CD" IsReadOnly="True" />
												<DataGridTextColumn Width="*" MinWidth="120"
													Binding="{Binding Mei_Tenpo}"
													Header="名称" IsReadOnly="True" />
												<DataGridTextColumn Width="90"
													Binding="{Binding DayFrom, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
													Header="開始日" />
												<DataGridTextColumn Width="90"
													Binding="{Binding DayTo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
													Header="終了日" />
											</DataGrid.Columns>
											<DataGrid.ColumnHeaderStyle>
												<Style BasedOn="{StaticResource MenteDataGridColumnHeader}"
													TargetType="DataGridColumnHeader" />
											</DataGrid.ColumnHeaderStyle>
										</DataGrid>
									</Grid>
								</materialDesign:Card>
							</Grid>
						</TabItem>

						<!--  ================= ③ 価格 =================  -->
						<TabItem Header="③ 価格">
							<Grid Margin="0,10,0,0">
								<materialDesign:Card Padding="12,10"
									materialDesign:ElevationAssist.Elevation="Dp1" UniformCornerRadius="8">
									<Grid>
										<Grid.RowDefinitions>
											<RowDefinition Height="Auto" />
											<RowDefinition Height="*" />
										</Grid.RowDefinitions>

										<DockPanel Grid.Row="0"
											Margin="0,0,0,6">
											<StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
												<Border Padding="8,2"
													Background="{DynamicResource MaterialDesignDivider}"
													CornerRadius="10">
													<TextBlock FontSize="12" FontWeight="SemiBold"
														Text="{Binding MeisaiCount, StringFormat={}明細 {0:N0} 件}" />
												</Border>
												<Border Margin="6,0,0,0" Padding="8,2"
													Background="{DynamicResource MaterialDesignDivider}"
													CornerRadius="10">
													<TextBlock FontSize="12" FontWeight="SemiBold"
														Text="{Binding ExpandEstimate, StringFormat={}展開見込 {0:N0} 行}"
														ToolTip="確定すると DerivedJodai にこの行数が作成されます" />
												</Border>
											</StackPanel>
											<TextBlock VerticalAlignment="Center"
												FontWeight="SemiBold" Text="対象明細（商品マスタ単位）" />
										</DockPanel>

										<DataGrid Grid.Row="1"
											d:ItemsSource="{d:SampleData ItemCount=5}"
											helpers:DataGridCellEnterNavigation.IsEnabled="True" helpers:DataGridSelectionBehavior.AutoScrollToSelectedItem="True" materialDesign:DataGridAssist.CellPadding="8,4"
											materialDesign:DataGridAssist.ColumnHeaderPadding="8,6"
											AlternatingRowBackground="{DynamicResource DataGridAlternatingRowBackgroundBrush}"
											AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" EnableRowVirtualization="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
											HorizontalGridLinesBrush="{DynamicResource MaterialDesignDivider}"
											ItemsSource="{Binding MeisaiRows}"
											SelectedItem="{Binding SelectedMeisaiRow, Mode=TwoWay}"
											Style="{StaticResource MaterialDesignDataGrid}"
											VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
											<DataGrid.Columns>
												<DataGridTextColumn Width="50"
													Binding="{Binding No}"
													ElementStyle="{StaticResource DataGridRightTextBlock}"
													Header="行" IsReadOnly="True" />
												<DataGridTextColumn Width="120"
													Binding="{Binding Code_Shohin}"
													Header="商品CD" IsReadOnly="True" />
												<DataGridTextColumn Width="*" MinWidth="160"
													Binding="{Binding Mei_Shohin}"
													Header="商品名" IsReadOnly="True" />
												<DataGridTextColumn Width="95"
													Binding="{Binding DayTento}"
													Header="店頭投入日" IsReadOnly="True" />
												<DataGridTextColumn Width="90"
													Binding="{Binding DayChange}"
													Header="変更日" IsReadOnly="True" />
												<DataGridTextColumn Width="90"
													Binding="{Binding JodaiOld, StringFormat={}{0:N0}}"
													ElementStyle="{StaticResource DataGridRightTextBlock}"
													Header="上代" IsReadOnly="True" />
												<DataGridTextColumn Width="105"
													Binding="{Binding JodaiNew, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N0}}"
													EditingElementStyle="{StaticResource DataGridRightTextBox}"
													ElementStyle="{StaticResource DataGridRightTextBlock}"
													Header="新販売価格" />
												<DataGridTextColumn Width="85"
													Binding="{Binding RateOff, StringFormat={}{0:N2}}"
													ElementStyle="{StaticResource DataGridRightTextBlock}"
													Header="新割引率" IsReadOnly="True" />
												<DataGridTextColumn Width="95"
													Binding="{Binding PriceInTax, StringFormat={}{0:N0}}"
													ElementStyle="{StaticResource DataGridRightTextBlock}"
													Header="税込価格" IsReadOnly="True" />
											</DataGrid.Columns>
											<DataGrid.ColumnHeaderStyle>
												<Style BasedOn="{StaticResource MenteDataGridColumnHeader}"
													TargetType="DataGridColumnHeader" />
											</DataGrid.ColumnHeaderStyle>
										</DataGrid>
									</Grid>
								</materialDesign:Card>
							</Grid>
						</TabItem>
					</TabControl>

					<!--  操作ボタン（内側タブの外＝常時表示）  -->
					<Grid Grid.Row="2"
						Margin="0,10,0,4">
						<StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
							<TextBlock Style="{StaticResource StatusTextBlockStyle}"
								Text="[登録] は伝票の保存のみ。[確定] で適用上代が展開され、売上・POS・在庫評価に反映されます" TextTrimming="CharacterEllipsis" />
							<TextBlock Style="{StaticResource StatusTextBlockStyle}"
								Text="商品マスタの上代は書き換えません。期間が過ぎれば自動的に元価格へ戻ります" TextTrimming="CharacterEllipsis" />
						</StackPanel>
						<StackPanel HorizontalAlignment="Right"
							Orientation="Horizontal">
							<Button Command="{Binding DoMarkSentCommand}"
								Style="{StaticResource MaterialDesignOutlinedButton}"
								ToolTip="値札･棚札の差し替えが完了したことを記録する（価格配信ではありません）">
								<TextBlock FontSize="16" Text="送信済" />
							</Button>
							<Button Margin="12,0,0,0"
								Command="{Binding DoCancelDenCommand}"
								Style="{StaticResource MaterialDesignOutlinedButton}"
								ToolTip="確定済みの伝票を取消し、展開済みの適用上代を削除">
								<TextBlock FontSize="16" Text="取消" />
							</Button>
							<Button Margin="12,0,0,0"
								Command="{Binding DoRegisterCommand}"
								IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
								Style="{StaticResource MaterialDesignOutlinedButton}"
								ToolTip="伝票を保存する（この時点では価格には反映されません） (F8)">
								<StackPanel Orientation="Horizontal">
									<materialDesign:PackIcon VerticalAlignment="Center"
										Kind="ContentSave" />
									<TextBlock Margin="8,0,0,0" VerticalAlignment="Center"
										FontSize="16" Text="登録(F8)" />
								</StackPanel>
							</Button>
							<Button Margin="12,0,0,0"
								Command="{Binding DoFixCommand}"
								IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
								Style="{StaticResource MaterialDesignRaisedButton}"
								ToolTip="確定して適用上代を展開する">
								<StackPanel Orientation="Horizontal">
									<materialDesign:PackIcon VerticalAlignment="Center"
										Kind="CheckBold" />
									<TextBlock Margin="8,0,0,0" VerticalAlignment="Center"
										FontSize="16" Text="確定" />
								</StackPanel>
							</Button>
							<Button Margin="12,0,0,0"
								Command="{Binding ExitCommand}"
								Style="{StaticResource MaterialDesignOutlinedButton}"
								ToolTip="閉じる (Esc)">
								<TextBlock FontSize="16" Text="戻る(ESC)" />
							</Button>
						</StackPanel>
					</Grid>
				</Grid>
			</TabItem>
		</TabControl>

		<!--  ステータス  -->
		<Border Grid.Row="2"
			Padding="12,6"
			Background="{DynamicResource MaterialDesignChipBackground}">
			<TextBlock Style="{StaticResource StatusTextBlockStyle}"
				Text="{Binding Message}"
				TextTrimming="CharacterEllipsis" />
		</Border>
	</Grid>
</helpers:BaseWindow>
