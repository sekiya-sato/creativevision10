<helpers:BaseWindow x:Class="CvWpfclient.Views._01Master.PrintMasterShainCardView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:helpers="clr-namespace:CvWpfclient.Helpers"
	xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:vm="clr-namespace:CvWpfclient.ViewModels._01Master"
	Title="{Binding Title}"
	Width="800" Height="500"
	Background="{DynamicResource AppCommonBackgroundBrush}"
	FontSize="16"
	Foreground="{DynamicResource MaterialDesignBody}"
	TextOptions.TextFormattingMode="Display" WindowStartupLocation="CenterScreen"
	mc:Ignorable="d">
	<helpers:BaseWindow.DataContext>
		<vm:PrintMasterShainCardViewModel />
	</helpers:BaseWindow.DataContext>

	<helpers:BaseWindow.InputBindings>
		<KeyBinding Command="{Binding DoOutputPdfCommand}"
			Gesture="F6" />
		<KeyBinding Command="{Binding ExitCommand}"
			Gesture="Esc" />
	</helpers:BaseWindow.InputBindings>

	<helpers:BaseWindow.Resources>
		<Style x:Key="MenteSearchTextBox"
			TargetType="{x:Type TextBox}"
			BasedOn="{StaticResource SearchTextBox}">
			<Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Window}}" />
			<Setter Property="Background" Value="{DynamicResource MaterialDesignPaper}" />
			<Setter Property="helpers:SearchTextBoxAssist.ButtonBackground" Value="{DynamicResource SearchButtonBackgroundBrush}" />
		</Style>

		<Style x:Key="FormLabel"
			TargetType="TextBlock">
			<Setter Property="VerticalAlignment" Value="Center" />
			<Setter Property="FontWeight" Value="Medium" />
			<Setter Property="Foreground" Value="{DynamicResource MaterialDesignBodyLight}" />
			<Setter Property="Margin" Value="4,0,8,0" />
		</Style>

		<Style x:Key="FormTextBox"
			BasedOn="{StaticResource MaterialDesignOutlinedTextBox}"
			TargetType="TextBox">
			<Setter Property="Margin" Value="0,4" />
			<Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}" />
			<Setter Property="materialDesign:HintAssist.FloatingScale" Value="0.7" />
		</Style>
	</helpers:BaseWindow.Resources>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<materialDesign:ColorZone Grid.Row="0"
			Padding="12,8"
			materialDesign:ElevationAssist.Elevation="Dp4" Mode="PrimaryMid">
			<DockPanel>
				<StackPanel Orientation="Horizontal">
					<Button Margin="0,0,8,0"
						Command="{Binding ExitCommand}"
						Style="{StaticResource MaterialDesignToolForegroundButton}"
						ToolTip="閉じる (Esc)">
						<materialDesign:PackIcon Kind="ArrowLeft" />
					</Button>
					<materialDesign:PackIcon Width="28" Height="28"
						VerticalAlignment="Center"
						Kind="AccountBox" />
					<TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
						FontSize="20" FontWeight="SemiBold"
						Text="{Binding Title}" />
				</StackPanel>
			</DockPanel>
		</materialDesign:ColorZone>

		<Grid Grid.Row="1"
			Margin="24">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
			</Grid.RowDefinitions>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="120" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>

			<!--  社員CD  -->
			<TextBlock Grid.Row="0" Grid.Column="0"
				Style="{StaticResource FormLabel}"
				Text="社員CD" />
			<TextBox Grid.Row="0" Grid.Column="1"
				Width="200" Height="36"
				HorizontalAlignment="Left"
				BorderThickness="0,0,0,1"
				helpers:SearchTextBoxAssist.Command="{Binding SelectShainCodeFromCommand}"
				Style="{StaticResource MenteSearchTextBox}"
				Text="{Binding ShainCodeFrom, UpdateSourceTrigger=PropertyChanged}"
				HorizontalContentAlignment="Left" />
			<TextBlock Grid.Row="0" Grid.Column="2"
				Margin="8,0" VerticalAlignment="Center"
				Text="～" />
			<TextBox Grid.Row="0" Grid.Column="3"
				Width="200" Height="36"
				HorizontalAlignment="Left"
				BorderThickness="0,0,0,1"
				helpers:SearchTextBoxAssist.Command="{Binding SelectShainCodeToCommand}"
				Style="{StaticResource MenteSearchTextBox}"
				Text="{Binding ShainCodeTo, UpdateSourceTrigger=PropertyChanged}"
				HorizontalContentAlignment="Left" />

			<!--  店舗CD  -->
			<TextBlock Grid.Row="1" Grid.Column="0"
				Style="{StaticResource FormLabel}"
				Text="店舗CD" />
			<TextBox Grid.Row="1" Grid.Column="1"
				Width="200" Height="36"
				HorizontalAlignment="Left"
				BorderThickness="0,0,0,1"
				helpers:SearchTextBoxAssist.Command="{Binding SelectTenpoCodeFromCommand}"
				Style="{StaticResource MenteSearchTextBox}"
				Text="{Binding TenpoCodeFrom, UpdateSourceTrigger=PropertyChanged}"
				HorizontalContentAlignment="Left" />
			<TextBlock Grid.Row="1" Grid.Column="2"
				Margin="8,0" VerticalAlignment="Center"
				Text="～" />
			<TextBox Grid.Row="1" Grid.Column="3"
				Width="200" Height="36"
				HorizontalAlignment="Left"
				BorderThickness="0,0,0,1"
				helpers:SearchTextBoxAssist.Command="{Binding SelectTenpoCodeToCommand}"
				Style="{StaticResource MenteSearchTextBox}"
				Text="{Binding TenpoCodeTo, UpdateSourceTrigger=PropertyChanged}"
				HorizontalContentAlignment="Left" />

			<!--  バーコード種類  -->
			<TextBlock Grid.Row="2" Grid.Column="0"
				Margin="0,10,0,10"
				Style="{StaticResource FormLabel}"
				Text="バーコード" />
			<StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3"
				Margin="100,20,0,10"
				Orientation="Horizontal">
				<RadioButton Margin="0,4"
					Content="NW7"
					IsChecked="{Binding IsCode39, Converter={StaticResource InverseBooleanConverter}}" />
				<RadioButton Margin="16,4,0,4"
					Content="CODE39"
					IsChecked="{Binding IsCode39}" />
			</StackPanel>

			<!--  実行ボタン  -->
			<Button Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="4"
				Margin="0,24" HorizontalAlignment="Center"
				Command="{Binding DoOutputPdfCommand}"
				Style="{StaticResource MaterialDesignFlatMidBgButton}"
				ToolTip="印刷実行 (F6)">
				<StackPanel Orientation="Horizontal">
					<materialDesign:PackIcon VerticalAlignment="Center"
						Kind="Printer" />
					<TextBlock Margin="8,0,0,0" VerticalAlignment="Center"
						FontSize="20" Text="印刷実行" />
				</StackPanel>
			</Button>

			<!--  対応ラベル情報  -->
			<TextBlock Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3"
				Margin="0,8"
				Foreground="{DynamicResource MaterialDesignBodyLight}"
				Text="対応ラベル：A-one 品番28919(A4版2列6段)" />
		</Grid>
	</Grid>
</helpers:BaseWindow>
