<helpers:BaseWindow x:Class="CvWpfclient.Views._01Master.MasterShainMenteView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:helpers="clr-namespace:CvWpfclient.Helpers"
	xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:vm="clr-namespace:CvWpfclient.ViewModels._01Master"
	Title="{Binding Title}"
	Width="1280" Height="920"
	d:Height="1200"
	Background="{DynamicResource AppCommonBackgroundBrush}"
	FontSize="16"
	Foreground="{DynamicResource MaterialDesignBody}"
	TextOptions.TextFormattingMode="Display" WindowStartupLocation="CenterScreen"
	mc:Ignorable="d">
	<helpers:BaseWindow.DataContext>
		<vm:MasterShainMenteViewModel />
	</helpers:BaseWindow.DataContext>

	<helpers:BaseWindow.InputBindings>
		<KeyBinding Command="{Binding DoUpdateCommand}"
			Gesture="F2" />
		<KeyBinding Command="{Binding DoDeleteCommand}"
			Gesture="F3" />
		<KeyBinding Command="{Binding DoInsertCommand}"
			Gesture="F4" />
		<KeyBinding Command="{Binding DoListCommand}"
			Gesture="F5" />
		<KeyBinding Command="{Binding DoOutputPdfCommand}"
			Gesture="F6" />
	</helpers:BaseWindow.InputBindings>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<materialDesign:ColorZone Grid.Row="0"
			Padding="12,8"
			materialDesign:ElevationAssist.Elevation="Dp4" Mode="PrimaryMid">
			<DockPanel>
				<StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
					<Button Margin="4,0"
						Command="{Binding DoUpdateCommand}"
						Style="{StaticResource ToolCommandButton}"
						ToolTip="修正 (F2)">
						<StackPanel Orientation="Horizontal">
							<materialDesign:PackIcon VerticalAlignment="Center"
								Kind="Pencil" />
							<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
								Text="修正" />
						</StackPanel>
					</Button>
					<Button Margin="4,0"
						Command="{Binding DoDeleteCommand}"
						Style="{StaticResource ToolCommandButton}"
						ToolTip="削除 (F3)">
						<StackPanel Orientation="Horizontal">
							<materialDesign:PackIcon VerticalAlignment="Center"
								Kind="Delete" />
							<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
								Text="削除" />
						</StackPanel>
					</Button>
					<Button Margin="4,0"
						Command="{Binding DoInsertCommand}"
						Style="{StaticResource ToolCommandButton}"
						ToolTip="追加 (F4)">
						<StackPanel Orientation="Horizontal">
							<materialDesign:PackIcon VerticalAlignment="Center"
								Kind="Plus" />
							<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
								Text="追加" />
						</StackPanel>
					</Button>
					<Rectangle Width="1"
						Margin="8,4"
						Fill="{DynamicResource PrimaryHueMidForegroundBrush}"
						Opacity="0.3" />
					<Button Margin="4,0"
						Command="{Binding DoOutputPdfCommand}"
						Style="{StaticResource ToolCommandButton}"
						ToolTip="印刷 (F6)">
						<StackPanel Orientation="Horizontal">
							<materialDesign:PackIcon VerticalAlignment="Center"
								Kind="Printer" />
							<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
								Text="印刷" />
						</StackPanel>
					</Button>
				</StackPanel>

				<StackPanel Orientation="Horizontal">
					<Button Margin="0,0,8,0"
						Command="{Binding ExitCommand}"
						Style="{StaticResource ToolCommandButton}"
						ToolTip="閉じる (Esc)">
						<materialDesign:PackIcon Kind="ArrowLeft" />
					</Button>
					<materialDesign:PackIcon Width="28" Height="28"
						VerticalAlignment="Center"
						Kind="AccountBox" />
					<TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
						FontSize="20" FontWeight="SemiBold"
						Text="{Binding Title}" />
					<Rectangle Width="1"
						Margin="16,4"
						Fill="{DynamicResource PrimaryHueMidForegroundBrush}"
						Opacity="0.3" />
					<Button Command="{Binding DoListCommand}"
						Style="{StaticResource ToolCommandButton}"
						ToolTip="一覧取得 (F5)">
						<StackPanel Orientation="Horizontal">
							<materialDesign:PackIcon VerticalAlignment="Center"
								Kind="DatabaseSearch" />
							<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
								Text="一覧取得" />
						</StackPanel>
					</Button>
				</StackPanel>
			</DockPanel>
		</materialDesign:ColorZone>

		<Grid Grid.Row="1"
			Margin="12">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="45*" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="55*" />
			</Grid.ColumnDefinitions>

			<materialDesign:Card Grid.Column="0"
				Padding="0"
				materialDesign:ElevationAssist.Elevation="Dp2" UniformCornerRadius="8">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
					</Grid.RowDefinitions>

					<Border Grid.Row="0"
						Padding="12,8"
						Background="{DynamicResource MaterialDesignToolBarBackground}"
						CornerRadius="8,8,0,0">
						<DockPanel>
							<TextBlock VerticalAlignment="Center"
								DockPanel.Dock="Right" FontSize="13"
								Foreground="{DynamicResource MaterialDesignBodyLight}"
								Text="{Binding Count, StringFormat={}件数: {0:N0}}" />
							<TextBlock VerticalAlignment="Center"
								FontSize="13"
								Foreground="{DynamicResource MaterialDesignBodyLight}"
								Text="{Binding Message}"
								TextTrimming="CharacterEllipsis" />
						</DockPanel>
					</Border>

					<DataGrid x:Name="ShainGrid"
						Grid.Row="1"
						d:ItemsSource="{d:SampleData ItemCount=5}"
						helpers:DataGridSelectionBehavior.AutoScrollToSelectedItem="True" materialDesign:DataGridAssist.CellPadding="12,6" materialDesign:DataGridAssist.ColumnHeaderPadding="12,8"
						AutoGenerateColumns="False" EnableRowVirtualization="True" FrozenColumnCount="3" GridLinesVisibility="Horizontal"
						HorizontalGridLinesBrush="{DynamicResource MaterialDesignDivider}"
						IsReadOnly="True" IsSynchronizedWithCurrentItem="True"
						ItemsSource="{Binding ListData}"
						SelectedItem="{Binding Current}"
						Style="{StaticResource MaterialDesignDataGrid}"
						VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
						<DataGrid.Columns>
							<DataGridTextColumn Width="70"
								Binding="{Binding Id, StringFormat={}({0})}"
								Header="Id" />
							<DataGridTextColumn Width="120"
								Binding="{Binding Code}"
								Header="コード" />
							<DataGridTextColumn Width="220"
								Binding="{Binding Name}"
								Header="名前" />
							<DataGridTextColumn Width="140"
								Binding="{Binding Ryaku}"
								Header="略称" />
							<DataGridTextColumn Width="140"
								Binding="{Binding Kana}"
								Header="カナ" />
							<DataGridTextColumn Width="220"
								Binding="{Binding Mail}"
								Header="メール" />
							<DataGridTextColumn Width="120"
								Binding="{Binding ExpireDate, Converter={StaticResource DateYmd8Converter}}"
								Header="有効期限" />
							<DataGridTextColumn Width="160"
								Binding="{Binding VTenpo.Name}"
								Header="店舗" />
							<DataGridTextColumn Width="160"
								Binding="{Binding VBumon.Name}"
								Header="部門" />
						</DataGrid.Columns>
						<DataGrid.ColumnHeaderStyle>
							<Style BasedOn="{StaticResource MenteDataGridColumnHeader}"
								TargetType="DataGridColumnHeader" />
						</DataGrid.ColumnHeaderStyle>
					</DataGrid>
				</Grid>
			</materialDesign:Card>

			<GridSplitter Grid.Column="1"
				Width="6"
				Margin="3,0" HorizontalAlignment="Center" VerticalAlignment="Stretch"
				Background="Transparent" />

			<materialDesign:Card Grid.Column="2"
				Padding="0"
				materialDesign:ElevationAssist.Elevation="Dp2" UniformCornerRadius="8">
				<TabControl Style="{StaticResource MaterialDesignTabControl}">
					<TabItem>
						<TabItem.Header>
							<StackPanel Orientation="Horizontal">
								<materialDesign:PackIcon Margin="0,0,6,0" VerticalAlignment="Center"
									Kind="InformationOutline" />
								<TextBlock Text="{Binding CurrentEdit.Id, StringFormat={}Id:{0}}" />
							</StackPanel>
						</TabItem.Header>
						<ScrollViewer Padding="10,10,20,20"
							VerticalScrollBarVisibility="Auto">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="110" />
									<ColumnDefinition Width="*" />
								</Grid.ColumnDefinitions>
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
								</Grid.RowDefinitions>

								<TextBlock Grid.Row="1"
									Style="{StaticResource FormLabel}"
									Text="コード" />
								<TextBox Grid.Row="1" Grid.Column="1"
									Width="200"
									HorizontalAlignment="Left"
									materialDesign:HintAssist.Hint="コード"
									Style="{StaticResource FormTextBox}"
									Text="{Binding CurrentEdit.Code}" />

								<TextBlock Grid.Row="2"
									Style="{StaticResource FormLabel}"
									Text="名前" />
								<TextBox Grid.Row="2" Grid.Column="1"
									materialDesign:HintAssist.Hint="名前"
									Style="{StaticResource FormTextBox}"
									Text="{Binding CurrentEdit.Name}" />

								<TextBlock Grid.Row="3"
									Style="{StaticResource FormLabel}"
									Text="略称" />
								<TextBox Grid.Row="3" Grid.Column="1"
									materialDesign:HintAssist.Hint="略称"
									Style="{StaticResource FormTextBox}"
									Text="{Binding CurrentEdit.Ryaku}" />

								<TextBlock Grid.Row="4"
									Style="{StaticResource FormLabel}"
									Text="カナ" />
								<TextBox Grid.Row="4" Grid.Column="1"
									materialDesign:HintAssist.Hint="カナ"
									Style="{StaticResource FormTextBox}"
									Text="{Binding CurrentEdit.Kana}" />

								<TextBlock Grid.Row="5"
									Style="{StaticResource FormLabel}"
									Text="メール" />
								<DockPanel Grid.Row="5" Grid.Column="1">
									<Button Margin="8,0,0,0"
										Command="{Binding CheckMailCommand}"
										DockPanel.Dock="Right"
										Style="{StaticResource MaterialDesignOutlinedButton}">
										<TextBlock Text="確認" />
									</Button>
									<TextBox materialDesign:HintAssist.Hint="メール"
										Style="{StaticResource FormTextBox}"
										Text="{Binding CurrentEdit.Mail}" />
								</DockPanel>

								<TextBlock Grid.Row="6"
									Style="{StaticResource FormLabel}"
									Text="有効期限" />
								<DatePicker Grid.Row="6" Grid.Column="1"
									Width="180"
									HorizontalAlignment="Left"
									helpers:DatePickerTodayButtonBehavior.IsEnabled="True" materialDesign:HintAssist.Hint="有効期限" IsTodayHighlighted="False"
									SelectedDate="{Binding CurrentEdit.ExpireDate, Converter={StaticResource DateYmd8Converter}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
									Style="{StaticResource FormDatePicker}" />

								<TextBlock Grid.Row="7"
									Style="{StaticResource FormLabel}"
									Text="店舗" />
								<DockPanel Grid.Row="7" Grid.Column="1"
									Margin="0,4">
									<TextBox Width="120" Height="36"
										HorizontalContentAlignment="Left"
										helpers:SearchTextBoxAssist.Command="{Binding DoSelectTenpoCommand}"
										BorderThickness="0,0,0,1" DockPanel.Dock="Left"
										Style="{StaticResource MenteSearchTextBox}"
										Text="{Binding CurrentEdit.Id_Tenpo, UpdateSourceTrigger=PropertyChanged}" />
									<TextBlock Style="{StaticResource MasterRefText}"
										Text="{Binding CurrentEdit.VTenpo, Converter={StaticResource CodeNameViewDisplayConverter}, ConverterParameter=NoId}" />
								</DockPanel>

								<TextBlock Grid.Row="8"
									Style="{StaticResource FormLabel}"
									Text="部門" />
								<DockPanel Grid.Row="8" Grid.Column="1"
									Margin="0,4">
									<TextBox Width="120" Height="36"
										HorizontalContentAlignment="Left"
										helpers:SearchTextBoxAssist.Command="{Binding DoSelectBumonCommand}"
										BorderThickness="0,0,0,1" DockPanel.Dock="Left"
										Style="{StaticResource MenteSearchTextBox}"
										Text="{Binding CurrentEdit.Id_Bumon, UpdateSourceTrigger=PropertyChanged}" />
									<TextBlock Style="{StaticResource MasterRefText}"
										Text="{Binding CurrentEdit.VBumon, Converter={StaticResource CodeNameViewDisplayConverter}, ConverterParameter=NoId}" />
								</DockPanel>

								<TextBlock Grid.Row="9"
									Style="{StaticResource FormLabel}"
									Text="担当区分" />
								<ComboBox Grid.Row="9" Grid.Column="1"
									Width="220"
									HorizontalAlignment="Left"
									materialDesign:HintAssist.Hint="担当区分"
									SelectedValue="{Binding CurrentEdit.ResponsibilityScope, Mode=TwoWay}"
									SelectedValuePath="Tag"
									Style="{StaticResource FormComboBox}">
									<ComboBoxItem Content="未設定" Tag="0" />
									<ComboBoxItem Content="店舗スタッフ" Tag="1" />
									<ComboBoxItem Content="店舗責任者" Tag="2" />
									<ComboBoxItem Content="エリアマネージャ" Tag="3" />
									<ComboBoxItem Content="全社担当者" Tag="4" />
								</ComboBox>

								<TextBlock Grid.Row="10"
									Style="{StaticResource FormLabel}"
									Text="権限プロファイルId" />
								<TextBox Grid.Row="10" Grid.Column="1"
									Width="180"
									HorizontalAlignment="Left"
									materialDesign:HintAssist.Hint="権限プロファイルId"
									Style="{StaticResource FormTextBox}"
									Text="{Binding CurrentEdit.Id_PermissionProfile, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

								<TextBlock Grid.Row="12" Grid.Column="1"
									Margin="20"
									Foreground="{DynamicResource MaterialDesignBody}"
									TextWrapping="Wrap">
									<TextBlock.Text>
										<MultiBinding StringFormat="{}登録日={0}  修正日={1}">
											<Binding Path="CurrentEdit.VdateC" />
											<Binding Path="CurrentEdit.VdateU" />
										</MultiBinding>
									</TextBlock.Text>
								</TextBlock>
							</Grid>
						</ScrollViewer>
					</TabItem>
					<TabItem>
						<TabItem.Header>
							<StackPanel Orientation="Horizontal">
								<materialDesign:PackIcon Margin="0,0,6,0" VerticalAlignment="Center"
									Kind="FormatListBulleted" />
								<TextBlock Text="名称" />
							</StackPanel>
						</TabItem.Header>
						<Grid>
							<Grid.RowDefinitions>
								<RowDefinition Height="Auto" />
								<RowDefinition Height="*" />
							</Grid.RowDefinitions>
							<StackPanel Grid.Row="0"
								Margin="8,8,8,0" HorizontalAlignment="Center"
								Orientation="Horizontal">
								<Button Margin="8,0"
									Command="{Binding DeleteJsubCommand}"
									Style="{StaticResource MaterialDesignOutlinedButton}">
									<StackPanel Orientation="Horizontal">
										<materialDesign:PackIcon VerticalAlignment="Center"
											Kind="Delete" />
										<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
											Text="削除" />
									</StackPanel>
								</Button>
								<Button Margin="8,0"
									Command="{Binding AddJsubCommand}"
									Style="{StaticResource MaterialDesignOutlinedButton}">
									<StackPanel Orientation="Horizontal">
										<materialDesign:PackIcon VerticalAlignment="Center"
											Kind="Plus" />
										<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
											Text="追加" />
									</StackPanel>
								</Button>
							</StackPanel>
							<DataGrid x:Name="JsubGrid"
								Grid.Row="1"
								Margin="8"
								d:ItemsSource="{d:SampleData ItemCount=3}"
								helpers:DataGridSelectionBehavior.AutoScrollToSelectedItem="True" materialDesign:DataGridAssist.CellPadding="12,6" materialDesign:DataGridAssist.ColumnHeaderPadding="12,8"
								AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" EnableRowVirtualization="True" GridLinesVisibility="Horizontal"
								HorizontalGridLinesBrush="{DynamicResource MaterialDesignDivider}"
								IsSynchronizedWithCurrentItem="True"
								ItemsSource="{Binding EditJsub}"
								SelectedItem="{Binding SelectedJsub, Mode=TwoWay}"
								Style="{StaticResource MaterialDesignDataGrid}"
								VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
								<DataGrid.Columns>
									<DataGridTemplateColumn Width="100"
										Header="区分">
										<DataGridTemplateColumn.CellTemplate>
											<DataTemplate>
												<ComboBox Margin="2"
													ItemsSource="{Binding DataContext.KubunOptions, RelativeSource={RelativeSource AncestorType=Window}}"
													SelectedItem="{Binding Kb, UpdateSourceTrigger=PropertyChanged}"
													Style="{StaticResource MaterialDesignComboBox}" />
											</DataTemplate>
										</DataGridTemplateColumn.CellTemplate>
									</DataGridTemplateColumn>
									<DataGridTextColumn Width="180"
										Binding="{Binding Kbname}"
										Header="区分名" />
									<DataGridTemplateColumn Width="150"
										Header="コード">
										<DataGridTemplateColumn.CellTemplate>
											<DataTemplate>
												<Grid Margin="2,1">
													<Grid.ColumnDefinitions>
														<ColumnDefinition Width="*" />
														<ColumnDefinition Width="30" />
													</Grid.ColumnDefinitions>
													<TextBox Grid.Column="0"
														Height="28"
														VerticalAlignment="Center"
														Foreground="{DynamicResource MaterialDesignBody}"
														IsReadOnly="True"
														Text="{Binding Cd, UpdateSourceTrigger=PropertyChanged}" />
													<Button Grid.Column="1"
														Width="26" Height="26"
														Margin="2,0,0,0" Padding="0" VerticalAlignment="Center"
														Background="{DynamicResource PrimaryButtonColor}"
														BorderThickness="0"
														Command="{Binding DataContext.DoSelectJsubCodeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
														Cursor="Hand" Foreground="White">
														<Button.Content>
															<materialDesign:PackIcon Width="16" Height="16"
																HorizontalAlignment="Center" VerticalAlignment="Center"
																Foreground="White" Kind="Magnify" />
														</Button.Content>
													</Button>
												</Grid>
											</DataTemplate>
										</DataGridTemplateColumn.CellTemplate>
									</DataGridTemplateColumn>
									<DataGridTextColumn Width="*"
										Binding="{Binding Mei}"
										Header="名称" IsReadOnly="True" />
								</DataGrid.Columns>
								<DataGrid.ColumnHeaderStyle>
									<Style BasedOn="{StaticResource MenteDataGridColumnHeader}"
										TargetType="DataGridColumnHeader" />
								</DataGrid.ColumnHeaderStyle>
							</DataGrid>
						</Grid>
					</TabItem>
					<TabItem>
						<TabItem.Header>
							<StackPanel Orientation="Horizontal">
								<materialDesign:PackIcon Margin="0,0,6,0" VerticalAlignment="Center"
									Kind="TextBoxMultiple" />
								<TextBlock Text="詳細" />
							</StackPanel>
						</TabItem.Header>
						<Grid Margin="16">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="110" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<Grid.RowDefinitions>
								<RowDefinition Height="Auto" />
								<RowDefinition Height="Auto" />
							</Grid.RowDefinitions>

							<TextBlock Grid.Row="0"
								Style="{StaticResource FormLabel}"
								Text="予備項目1" />
							<TextBox Grid.Row="0" Grid.Column="1"
								materialDesign:HintAssist.Hint="予備項目1"
								Style="{StaticResource FormTextBox}"
								Text="{Binding CurrentEdit.Jdetail.Yobi1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

							<TextBlock Grid.Row="1"
								Style="{StaticResource FormLabel}"
								Text="予備項目2" />
							<TextBox Grid.Row="1" Grid.Column="1"
								materialDesign:HintAssist.Hint="予備項目2"
								Style="{StaticResource FormTextBox}"
								Text="{Binding CurrentEdit.Jdetail.Yobi2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
						</Grid>
					</TabItem>
				</TabControl>
			</materialDesign:Card>
		</Grid>
	</Grid>
</helpers:BaseWindow>
