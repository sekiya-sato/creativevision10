<helpers:BaseWindow x:Class="CvWpfclient.Views._01Master.MasterShiireMenteView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:helpers="clr-namespace:CvWpfclient.Helpers" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:vm="clr-namespace:CvWpfclient.ViewModels._01Master"
	Title="{Binding Title}"
	Width="{StaticResource StandardWindowWidth}" Height="{StaticResource StandardWindowHeight}"
	d:Height="1200"
	Background="{DynamicResource AppCommonBackgroundBrush}"
	FontSize="18"
	Foreground="{DynamicResource MaterialDesignBody}"
	TextOptions.TextFormattingMode="Display" WindowStartupLocation="CenterScreen"
	mc:Ignorable="d">
	<helpers:BaseWindow.DataContext>
		<vm:MasterShiireMenteViewModel />
	</helpers:BaseWindow.DataContext>

	<helpers:BaseWindow.InputBindings>
		<KeyBinding Command="{Binding DoUpdateCommand}"
			Gesture="F2" />
		<KeyBinding Command="{Binding DoDeleteCommand}"
			Gesture="F3" />
		<KeyBinding Command="{Binding DoInsertCommand}"
			Gesture="F4" />
		<KeyBinding Command="{Binding DoListCommand}"
			Gesture="F5" />
		<KeyBinding Command="{Binding DoOutputPdfCommand}"
			Gesture="F6" />
	</helpers:BaseWindow.InputBindings>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<!--  ===== ヘッダー: ColorZone ツールバー =====  -->
		<materialDesign:ColorZone Grid.Row="0"
			Padding="12,8"
			materialDesign:ElevationAssist.Elevation="Dp4" Mode="PrimaryMid">
			<DockPanel>
				<!--  右側: CRUD ボタン群  -->
				<StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
					<Button Margin="4,0"
						Command="{Binding DoUpdateCommand}"
						Style="{StaticResource ToolCommandButton}"
						ToolTip="修正 (F2)">
						<StackPanel Orientation="Horizontal">
							<materialDesign:PackIcon VerticalAlignment="Center"
								Kind="Pencil" />
							<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
								Text="修正" />
						</StackPanel>
					</Button>
					<Button Margin="4,0"
						Command="{Binding DoDeleteCommand}"
						Style="{StaticResource ToolCommandButton}"
						ToolTip="削除 (F3)">
						<StackPanel Orientation="Horizontal">
							<materialDesign:PackIcon VerticalAlignment="Center"
								Kind="Delete" />
							<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
								Text="削除" />
						</StackPanel>
					</Button>
					<Button Margin="4,0"
						Command="{Binding DoInsertCommand}"
						Style="{StaticResource ToolCommandButton}"
						ToolTip="追加 (F4)">
						<StackPanel Orientation="Horizontal">
							<materialDesign:PackIcon VerticalAlignment="Center"
								Kind="Plus" />
							<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
								Text="追加" />
						</StackPanel>
					</Button>
					<Rectangle Width="1"
						Margin="8,4"
						Fill="{DynamicResource PrimaryHueMidForegroundBrush}"
						Opacity="0.3" />
					<Button Margin="4,0"
						Command="{Binding DoOutputPdfCommand}"
						Style="{StaticResource ToolCommandButton}"
						ToolTip="印刷 (F6)">
						<StackPanel Orientation="Horizontal">
							<materialDesign:PackIcon VerticalAlignment="Center"
								Kind="Printer" />
							<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
								Text="印刷" />
						</StackPanel>
					</Button>
				</StackPanel>

				<!--  左側: タイトル + 操作  -->
				<StackPanel Orientation="Horizontal">
					<Button Margin="0,0,8,0"
						Command="{Binding ExitCommand}"
						Style="{StaticResource ToolCommandButton}"
						ToolTip="閉じる (Esc)">
						<materialDesign:PackIcon Kind="ArrowLeft" />
					</Button>
					<materialDesign:PackIcon Width="28" Height="28"
						VerticalAlignment="Center"
						Kind="TruckDelivery" />
					<TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
						FontSize="20" FontWeight="SemiBold"
						Text="{Binding Title}" />
					<Rectangle Width="1"
						Margin="16,4"
						Fill="{DynamicResource PrimaryHueMidForegroundBrush}"
						Opacity="0.3" />
					<Button Command="{Binding DoListCommand}"
						Style="{StaticResource ToolCommandButton}"
						ToolTip="一覧取得 (F5)">
						<StackPanel Orientation="Horizontal">
							<materialDesign:PackIcon VerticalAlignment="Center"
								Kind="DatabaseSearch" />
							<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
								Text="一覧取得" />
						</StackPanel>
					</Button>
				</StackPanel>
			</DockPanel>
		</materialDesign:ColorZone>

		<!--  ===== メインコンテンツ =====  -->
		<Grid Grid.Row="1"
			Margin="12">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="45*" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="55*" />
			</Grid.ColumnDefinitions>

			<!--  ===== 左パネル: 一覧グリッド (Card) =====  -->
			<materialDesign:Card Grid.Column="0"
				Padding="0"
				materialDesign:ElevationAssist.Elevation="Dp2" UniformCornerRadius="8">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
					</Grid.RowDefinitions>

					<!--  カードヘッダー: 件数 + メッセージ  -->
					<Border Grid.Row="0"
						Padding="12,8"
						Background="{DynamicResource MaterialDesignToolBarBackground}"
						CornerRadius="8,8,0,0">
						<DockPanel>
							<TextBlock VerticalAlignment="Center"
								DockPanel.Dock="Right" FontSize="13"
								Foreground="{DynamicResource MaterialDesignBodyLight}"
								Text="{Binding Count, StringFormat={}件数: {0:N0}}" />
							<TextBlock VerticalAlignment="Center"
								FontSize="13"
								Foreground="{DynamicResource MaterialDesignBodyLight}"
								Text="{Binding Message}"
								TextTrimming="CharacterEllipsis" />
						</DockPanel>
					</Border>

					<!--  DataGrid 一覧  -->
					<DataGrid x:Name="ShiireGrid"
						Grid.Row="1"
						d:ItemsSource="{d:SampleData ItemCount=5}"
						helpers:DataGridSelectionBehavior.AutoScrollToSelectedItem="True" materialDesign:DataGridAssist.CellPadding="12,6" materialDesign:DataGridAssist.ColumnHeaderPadding="12,8"
						AutoGenerateColumns="False" EnableRowVirtualization="True" FrozenColumnCount="2" GridLinesVisibility="Horizontal"
						HorizontalGridLinesBrush="{DynamicResource MaterialDesignDivider}"
						IsReadOnly="True" IsSynchronizedWithCurrentItem="True"
						ItemsSource="{Binding ListData}"
						SelectedItem="{Binding Current}"
						Style="{StaticResource MaterialDesignDataGrid}"
						VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
						<DataGrid.Columns>
							<DataGridTextColumn Width="140"
								Binding="{Binding Code}"
								Header="コード" />
							<DataGridTextColumn Width="240"
								Binding="{Binding Name}"
								Header="名前" />
							<DataGridTextColumn Width="150"
								Binding="{Binding Ryaku}"
								Header="略称" />
							<DataGridTextColumn Width="150"
								Binding="{Binding Kana}"
								Header="カナ" />
						</DataGrid.Columns>
						<DataGrid.ColumnHeaderStyle>
							<Style BasedOn="{StaticResource MenteDataGridColumnHeader}"
								TargetType="DataGridColumnHeader" />
						</DataGrid.ColumnHeaderStyle>
					</DataGrid>
				</Grid>
			</materialDesign:Card>

			<!--  スプリッタ  -->
			<GridSplitter Grid.Column="1"
				Width="6"
				Margin="3,0" HorizontalAlignment="Center" VerticalAlignment="Stretch"
				Background="Transparent" />

			<!--  ===== 右パネル: 編集エリア (Card + TabControl) =====  -->
			<materialDesign:Card Grid.Column="2"
				Padding="0"
				materialDesign:ElevationAssist.Elevation="Dp2" UniformCornerRadius="8">
				<TabControl Style="{StaticResource MaterialDesignTabControl}">

					<!--  タブ1: 基本情報  -->
					<TabItem>
						<TabItem.Header>
							<StackPanel Orientation="Horizontal">
								<materialDesign:PackIcon Margin="0,0,6,0" VerticalAlignment="Center"
									Kind="InformationOutline" />
								<TextBlock>
									<TextBlock.Text>
										<Binding Path="CurrentEdit.Id" StringFormat="Id:{0}" />
									</TextBlock.Text>
								</TextBlock>
							</StackPanel>
						</TabItem.Header>
						<ScrollViewer Padding="10,10,20,20"
							VerticalScrollBarVisibility="Auto">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="110" />
									<ColumnDefinition Width="*" />
								</Grid.ColumnDefinitions>
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
								</Grid.RowDefinitions>

								<!--  コード  -->
								<TextBlock Grid.Row="0"
									Style="{StaticResource FormLabel}"
									Text="コード" />
								<TextBox Grid.Row="0" Grid.Column="1"
									materialDesign:HintAssist.Hint="コード"
									Style="{StaticResource FormTextBox}"
									Text="{Binding CurrentEdit.Code}" />

								<!--  名前  -->
								<TextBlock Grid.Row="1"
									Style="{StaticResource FormLabel}"
									Text="名前" />
								<TextBox Grid.Row="1" Grid.Column="1"
									materialDesign:HintAssist.Hint="名前"
									Style="{StaticResource FormTextBox}"
									Text="{Binding CurrentEdit.Name}" />

								<!--  略称  -->
								<TextBlock Grid.Row="2"
									Style="{StaticResource FormLabel}"
									Text="略称" />
								<TextBox Grid.Row="2" Grid.Column="1"
									materialDesign:HintAssist.Hint="略称"
									Style="{StaticResource FormTextBox}"
									Text="{Binding CurrentEdit.Ryaku}" />

								<!--  カナ  -->
								<TextBlock Grid.Row="3"
									Style="{StaticResource FormLabel}"
									Text="カナ" />
								<TextBox Grid.Row="3" Grid.Column="1"
									materialDesign:HintAssist.Hint="カナ"
									Style="{StaticResource FormTextBox}"
									Text="{Binding CurrentEdit.Kana}" />

								<!--  担当者  -->
								<TextBlock Grid.Row="4"
									Style="{StaticResource FormLabel}"
									Text="担当者" />
								<DockPanel Grid.Row="4" Grid.Column="1"
									Margin="0,4">
									<TextBox Width="120" Height="36"
										HorizontalContentAlignment="Left"
										helpers:SearchTextBoxAssist.Command="{Binding DoSelectShainCommand}"
										BorderThickness="0,0,0,1" DockPanel.Dock="Left"
										Style="{StaticResource MenteSearchTextBox}"
										Text="{Binding CurrentEdit.Id_Shain, UpdateSourceTrigger=PropertyChanged}" />
									<TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
										Foreground="{DynamicResource MaterialDesignBody}">
										<TextBlock.Text>
											<MultiBinding StringFormat="{}{0} {1}">
												<Binding Path="CurrentEdit.VShain.Cd" />
												<Binding Path="CurrentEdit.VShain.Mei" />
											</MultiBinding>
										</TextBlock.Text>
									</TextBlock>
								</DockPanel>

								<!--  掛率  -->
								<TextBlock Grid.Row="5"
									Style="{StaticResource FormLabel}"
									Text="掛率" />
								<TextBox Grid.Row="5" Grid.Column="1"
									materialDesign:HintAssist.Hint="掛率"
									Style="{StaticResource FormTextBox}"
									Text="{Binding CurrentEdit.RateProper}" />

								<!--  セール掛率  -->
								<TextBlock Grid.Row="6"
									Style="{StaticResource FormLabel}"
									Text="セール掛率" />
								<TextBox Grid.Row="6" Grid.Column="1"
									materialDesign:HintAssist.Hint="セール掛率"
									Style="{StaticResource FormTextBox}"
									Text="{Binding CurrentEdit.RateSale}" />

								<!--  郵便番号  -->
								<TextBlock Grid.Row="7"
									Style="{StaticResource FormLabel}"
									Text="郵便番号" />
								<Grid Grid.Row="7" Grid.Column="1">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="170" />
										<ColumnDefinition Width="Auto" />
										<ColumnDefinition Width="*" />
									</Grid.ColumnDefinitions>
									<TextBox Grid.Column="0"
										materialDesign:HintAssist.Hint="郵便番号"
										Style="{StaticResource FormTextBox}"
										Text="{Binding CurrentEdit.PostalCode, UpdateSourceTrigger=PropertyChanged}" />
									<Button Grid.Column="1"
										Command="{Binding SearchPostalCodeCommand}"
										Style="{StaticResource PostalSearchButton}"
										ToolTip="郵便番号から住所を検索">
										<StackPanel Orientation="Horizontal">
											<materialDesign:PackIcon Margin="0,0,6,0" VerticalAlignment="Center"
												Kind="Magnify" />
											<TextBlock VerticalAlignment="Center"
												Text="〒API検索" />
										</StackPanel>
									</Button>
								</Grid>

								<!--  住所1  -->
								<TextBlock Grid.Row="8"
									Style="{StaticResource FormLabel}"
									Text="住所1" />
								<TextBox Grid.Row="8" Grid.Column="1"
									materialDesign:HintAssist.Hint="住所1"
									Style="{StaticResource FormTextBox}"
									Text="{Binding CurrentEdit.Address1}" />

								<!--  住所2  -->
								<TextBlock Grid.Row="9"
									Style="{StaticResource FormLabel}"
									Text="住所2" />
								<TextBox Grid.Row="9" Grid.Column="1"
									materialDesign:HintAssist.Hint="住所2"
									Style="{StaticResource FormTextBox}"
									Text="{Binding CurrentEdit.Address2}" />

								<!--  住所3  -->
								<TextBlock Grid.Row="10"
									Style="{StaticResource FormLabel}"
									Text="住所3" />
								<TextBox Grid.Row="10" Grid.Column="1"
									materialDesign:HintAssist.Hint="住所3"
									Style="{StaticResource FormTextBox}"
									Text="{Binding CurrentEdit.Address3}" />

								<!--  電話番号  -->
								<TextBlock Grid.Row="11"
									Style="{StaticResource FormLabel}"
									Text="電話番号" />
								<TextBox Grid.Row="11" Grid.Column="1"
									materialDesign:HintAssist.Hint="電話番号"
									Style="{StaticResource FormTextBox}"
									Text="{Binding CurrentEdit.Tel}" />
								<TextBlock Grid.Row="12"
									Style="{StaticResource FormLabel}"
									Text="事業者登録番号" />
								<TextBox Grid.Row="12" Grid.Column="1"
									materialDesign:HintAssist.Hint="事業者登録番号"
									Style="{StaticResource FormTextBox}"
									Text="{Binding CurrentEdit.TaxRegistrationNumber}" />
							</Grid>
						</ScrollViewer>
					</TabItem>

					<TabItem Header="支払情報">
						<ScrollViewer VerticalScrollBarVisibility="Auto">
							<Grid Margin="10">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="30*" />
									<ColumnDefinition Width="70*" />
								</Grid.ColumnDefinitions>
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
								</Grid.RowDefinitions>

								<TextBlock Grid.Row="0"
									Style="{StaticResource FormLabel}"
									Text="締日1" />
								<ComboBox Grid.Row="0" Grid.Column="1"
									Margin="0,4"
									materialDesign:HintAssist.Hint="締日1"
									ItemsSource="{Binding ShimeBiItems}"
									SelectedItem="{Binding CurrentEdit.EnShime1, Mode=TwoWay}"
									Style="{StaticResource FormComboBox}">
									<ComboBox.ItemTemplate>
										<DataTemplate>
											<TextBlock Foreground="{DynamicResource MaterialDesignBody}"
												Text="{Binding Converter={StaticResource EnumShimeDisplayConverter}}" />
										</DataTemplate>
									</ComboBox.ItemTemplate>
								</ComboBox>

								<TextBlock Grid.Row="1"
									Style="{StaticResource FormLabel}"
									Text="締日2" />
								<ComboBox Grid.Row="1" Grid.Column="1"
									Margin="0,4"
									materialDesign:HintAssist.Hint="締日2"
									ItemsSource="{Binding ShimeBiItems}"
									SelectedItem="{Binding CurrentEdit.EnShime2, Mode=TwoWay}"
									Style="{StaticResource FormComboBox}">
									<ComboBox.ItemTemplate>
										<DataTemplate>
											<TextBlock Foreground="{DynamicResource MaterialDesignBody}"
												Text="{Binding Converter={StaticResource EnumShimeDisplayConverter}}" />
										</DataTemplate>
									</ComboBox.ItemTemplate>
								</ComboBox>

								<TextBlock Grid.Row="2"
									Style="{StaticResource FormLabel}"
									Text="締日3" />
								<ComboBox Grid.Row="2" Grid.Column="1"
									Margin="0,4"
									materialDesign:HintAssist.Hint="締日3"
									ItemsSource="{Binding ShimeBiItems}"
									SelectedItem="{Binding CurrentEdit.EnShime3, Mode=TwoWay}"
									Style="{StaticResource FormComboBox}">
									<ComboBox.ItemTemplate>
										<DataTemplate>
											<TextBlock Foreground="{DynamicResource MaterialDesignBody}"
												Text="{Binding Converter={StaticResource EnumShimeDisplayConverter}}" />
										</DataTemplate>
									</ComboBox.ItemTemplate>
								</ComboBox>

								<TextBlock Grid.Row="3"
									Style="{StaticResource FormLabel}"
									Text="支払月" />
								<ComboBox Grid.Row="3" Grid.Column="1"
									Margin="0,4"
									materialDesign:HintAssist.Hint="支払月" DisplayMemberPath="Text"
									ItemsSource="{Binding PayMonthItems}"
									SelectedValue="{Binding CurrentEdit.PayMonth, Mode=TwoWay}"
									SelectedValuePath="Value"
									Style="{StaticResource FormComboBox}" />

								<TextBlock Grid.Row="4"
									Style="{StaticResource FormLabel}"
									Text="支払日" />
								<ComboBox Grid.Row="4" Grid.Column="1"
									Margin="0,4"
									materialDesign:HintAssist.Hint="支払日"
									ItemsSource="{Binding ShimeBiItems}"
									SelectedItem="{Binding CurrentEdit.EnPayDay, Mode=TwoWay}"
									Style="{StaticResource FormComboBox}">
									<ComboBox.ItemTemplate>
										<DataTemplate>
											<TextBlock Foreground="{DynamicResource MaterialDesignBody}"
												Text="{Binding Converter={StaticResource EnumShimeDisplayConverter}}" />
										</DataTemplate>
									</ComboBox.ItemTemplate>
								</ComboBox>

								<TextBlock Grid.Row="5"
									Style="{StaticResource FormLabel}"
									Text="支払フラグ" />
								<ComboBox Grid.Row="5" Grid.Column="1"
									Margin="0,4"
									SelectedIndex="{Binding CurrentEdit.IsPay, Mode=TwoWay}"
									Style="{StaticResource FormComboBox}">
									<ComboBoxItem Content="しない" />
									<ComboBoxItem Content="する" />
								</ComboBox>

								<TextBlock Grid.Row="6"
									Style="{StaticResource FormLabel}"
									Text="支払方法" />
								<DockPanel Grid.Row="6" Grid.Column="1"
									Margin="0,4">
									<TextBox Width="120" Height="36"
										HorizontalContentAlignment="Left"
										helpers:SearchTextBoxAssist.Command="{Binding DoSelectPayMethodCommand}"
										BorderThickness="0,0,0,1" DockPanel.Dock="Left"
										Style="{StaticResource MenteSearchTextBox}"
										Text="{Binding CurrentEdit.Id_PayMethod, UpdateSourceTrigger=PropertyChanged}" />
									<TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
										Foreground="{DynamicResource MaterialDesignBody}">
										<TextBlock.Text>
											<MultiBinding StringFormat="{}{0} {1}">
												<Binding Path="CurrentEdit.VPayMethod.Cd" />
												<Binding Path="CurrentEdit.VPayMethod.Mei" />
											</MultiBinding>
										</TextBlock.Text>
									</TextBlock>
								</DockPanel>

								<TextBlock Grid.Row="7"
									Style="{StaticResource FormLabel}"><Run Text="支払" /><Run Language="ja-jp" Text="先" /></TextBlock>
								<DockPanel Grid.Row="7" Grid.Column="1"
									Margin="0,4">
									<TextBox Width="120" Height="36"
										HorizontalContentAlignment="Left"
										helpers:SearchTextBoxAssist.Command="{Binding DoSelectPaysakiCommand}"
										BorderThickness="0,0,0,1" DockPanel.Dock="Left"
										Style="{StaticResource MenteSearchTextBox}"
										Text="{Binding CurrentEdit.Id_Paysaki, UpdateSourceTrigger=PropertyChanged}" />
									<TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
										Foreground="{DynamicResource MaterialDesignBody}">
										<TextBlock.Text>
											<MultiBinding StringFormat="{}{0} {1}">
												<Binding Path="CurrentEdit.VPaysaki.Cd" />
												<Binding Path="CurrentEdit.VPaysaki.Mei" />
											</MultiBinding>
										</TextBlock.Text>
									</TextBlock>
								</DockPanel>
							</Grid>
						</ScrollViewer>
					</TabItem>

					<TabItem Header="名称リスト">
						<Grid>
							<Grid.RowDefinitions>
								<RowDefinition Height="Auto" />
								<RowDefinition Height="*" />
							</Grid.RowDefinitions>
							<StackPanel Grid.Row="0"
								Margin="8,8,8,0" HorizontalAlignment="Center"
								Orientation="Horizontal">
								<Button Margin="8,0"
									Command="{Binding DeleteJsubCommand}"
									Style="{StaticResource MaterialDesignOutlinedButton}">
									<StackPanel Orientation="Horizontal">
										<materialDesign:PackIcon VerticalAlignment="Center"
											Kind="Delete" />
										<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
											Text="削除" />
									</StackPanel>
								</Button>
								<Button Margin="8,0"
									Command="{Binding AddJsubCommand}"
									Style="{StaticResource MaterialDesignOutlinedButton}">
									<StackPanel Orientation="Horizontal">
										<materialDesign:PackIcon VerticalAlignment="Center"
											Kind="Plus" />
										<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
											Text="追加" />
									</StackPanel>
								</Button>
							</StackPanel>
							<DataGrid x:Name="JsubGrid"
								Grid.Row="1"
								Margin="8"
							d:ItemsSource="{d:SampleData ItemCount=3}"
							helpers:DataGridSelectionBehavior.AutoScrollToSelectedItem="True" materialDesign:DataGridAssist.CellPadding="12,6" materialDesign:DataGridAssist.ColumnHeaderPadding="12,8"
							AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" EnableRowVirtualization="True" GridLinesVisibility="Horizontal"
							HorizontalGridLinesBrush="{DynamicResource MaterialDesignDivider}"
							IsSynchronizedWithCurrentItem="True"
							ItemsSource="{Binding EditJsub}"
							SelectedItem="{Binding SelectedJsub, Mode=TwoWay}"
							Style="{StaticResource MaterialDesignDataGrid}"
							VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
							<DataGrid.Columns>
								<DataGridTemplateColumn Width="100"
									Header="区分">
									<DataGridTemplateColumn.CellTemplate>
										<DataTemplate>
											<ComboBox Margin="2"
												ItemsSource="{Binding DataContext.KubunOptions, RelativeSource={RelativeSource AncestorType=Window}}"
												SelectedItem="{Binding Kb, UpdateSourceTrigger=PropertyChanged}"
												Style="{StaticResource MaterialDesignComboBox}" />
										</DataTemplate>
									</DataGridTemplateColumn.CellTemplate>
								</DataGridTemplateColumn>
								<DataGridTextColumn Width="180"
									Binding="{Binding Kbname}"
									Header="区分名" />
								<DataGridTemplateColumn Width="150"
									Header="コード">
									<DataGridTemplateColumn.CellTemplate>
										<DataTemplate>
											<Grid Margin="2,1">
												<Grid.ColumnDefinitions>
													<ColumnDefinition Width="*" />
													<ColumnDefinition Width="30" />
												</Grid.ColumnDefinitions>
												<TextBox Grid.Column="0"
													Height="28"
													VerticalAlignment="Center"
													Foreground="{DynamicResource MaterialDesignBody}"
													IsReadOnly="True"
													Text="{Binding Cd, UpdateSourceTrigger=PropertyChanged}" />
												<Button Grid.Column="1"
													Width="26" Height="26"
													Margin="2,0,0,0" Padding="0" VerticalAlignment="Center"
													Background="{DynamicResource PrimaryButtonColor}"
													BorderThickness="0"
													Command="{Binding DataContext.DoSelectJsubCodeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
													Cursor="Hand" Foreground="White">
													<Button.Content>
														<materialDesign:PackIcon Width="16" Height="16"
															HorizontalAlignment="Center" VerticalAlignment="Center"
															Foreground="White" Kind="Magnify" />
													</Button.Content>
												</Button>
											</Grid>
										</DataTemplate>
									</DataGridTemplateColumn.CellTemplate>
								</DataGridTemplateColumn>
								<DataGridTextColumn Width="*"
									Binding="{Binding Mei}"
									Header="名称" IsReadOnly="True" />
							</DataGrid.Columns>
							<DataGrid.ColumnHeaderStyle>
								<Style BasedOn="{StaticResource MenteDataGridColumnHeader}"
									TargetType="DataGridColumnHeader" />
							</DataGrid.ColumnHeaderStyle>
							</DataGrid>
						</Grid>
					</TabItem>

					<TabItem Header="詳細内容">
						<Grid Margin="10">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="30*" />
								<ColumnDefinition Width="70*" />
							</Grid.ColumnDefinitions>
							<Grid.RowDefinitions>
								<RowDefinition Height="Auto" />
								<RowDefinition Height="Auto" />
								<RowDefinition Height="Auto" />
								<RowDefinition Height="Auto" />
							</Grid.RowDefinitions>

							<TextBlock Grid.Row="0"
								Style="{StaticResource FormLabel}"
								Text="振込先1" />
							<TextBox Grid.Row="0" Grid.Column="1"
								materialDesign:HintAssist.Hint="振込先1"
								Style="{StaticResource FormTextBox}"
								Text="{Binding CurrentEdit.Jdetail.BankAccount1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

							<TextBlock Grid.Row="1"
								Style="{StaticResource FormLabel}"
								Text="振込先2" />
							<TextBox Grid.Row="1" Grid.Column="1"
								materialDesign:HintAssist.Hint="振込先2"
								Style="{StaticResource FormTextBox}"
								Text="{Binding CurrentEdit.Jdetail.BankAccount2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

							<TextBlock Grid.Row="2"
								Style="{StaticResource FormLabel}"
								Text="振込先3" />
							<TextBox Grid.Row="2" Grid.Column="1"
								materialDesign:HintAssist.Hint="振込先3"
								Style="{StaticResource FormTextBox}"
								Text="{Binding CurrentEdit.Jdetail.BankAccount3, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

							<TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
								Margin="20"
								Foreground="{DynamicResource MaterialDesignBody}"
								TextWrapping="Wrap">
								<TextBlock.Text>
									<MultiBinding StringFormat="{}登録日={0}  修正日={1}">
										<Binding Path="CurrentEdit.VdateC" />
										<Binding Path="CurrentEdit.VdateU" />
									</MultiBinding>
								</TextBlock.Text>
							</TextBlock>
						</Grid>
					</TabItem>
				</TabControl>
			</materialDesign:Card>
		</Grid>
	</Grid>
</helpers:BaseWindow>
