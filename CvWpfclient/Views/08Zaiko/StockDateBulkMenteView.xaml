<helpers:BaseWindow x:Class="CvWpfclient.Views._08Zaiko.StockDateBulkMenteView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:helpers="clr-namespace:CvWpfclient.Helpers"
	xmlns:local="clr-namespace:CvWpfclient.Views" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:vm="clr-namespace:CvWpfclient.ViewModels._08Zaiko"
	Title="棚卸日一括メンテナンス"
	Width="1180" Height="760"
	Background="{DynamicResource AppCommonBackgroundBrush}"
	Foreground="{DynamicResource MaterialDesignBody}"
	TextOptions.TextFormattingMode="Display" WindowStartupLocation="CenterScreen"
	mc:Ignorable="d">
	<helpers:BaseWindow.DataContext>
		<vm:StockDateBulkMenteViewModel />
	</helpers:BaseWindow.DataContext>
	<helpers:BaseWindow.InputBindings>
		<KeyBinding Command="{Binding DoListCommand}"
			Gesture="F5" />
		<KeyBinding Command="{Binding UpdateSelectedCommand}"
			Gesture="F2" />
		<KeyBinding Command="{Binding ExitCommand}"
			Gesture="Esc" />
	</helpers:BaseWindow.InputBindings>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<materialDesign:ColorZone Grid.Row="0"
			Padding="12,8"
			materialDesign:ElevationAssist.Elevation="Dp4" Mode="PrimaryMid">
			<DockPanel>
				<StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
					<Button Margin="4,0"
						Command="{Binding DoListCommand}"
						Style="{StaticResource ToolCommandButton}"
						ToolTip="一覧取得 (F5)">
						<StackPanel Orientation="Horizontal">
							<materialDesign:PackIcon VerticalAlignment="Center"
								Kind="DatabaseSearch" />
							<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
								Text="一覧取得" />
						</StackPanel>
					</Button>
					<Button Margin="4,0"
						Command="{Binding UpdateSelectedCommand}"
						Style="{StaticResource ToolCommandButton}"
						ToolTip="更新実行 (F2)">
						<StackPanel Orientation="Horizontal">
							<materialDesign:PackIcon VerticalAlignment="Center"
								Kind="ContentSave" />
							<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
								Text="更新実行" />
						</StackPanel>
					</Button>
				</StackPanel>

				<StackPanel Orientation="Horizontal">
					<Button Margin="0,0,8,0"
						Command="{Binding ExitCommand}"
						Style="{StaticResource ToolCommandButton}"
						ToolTip="戻る (Esc)">
						<materialDesign:PackIcon Kind="ArrowLeft" />
					</Button>
					<materialDesign:PackIcon Width="28" Height="28"
						VerticalAlignment="Center"
						Kind="CalendarEdit" />
					<TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
						FontSize="20" FontWeight="SemiBold" Text="棚卸日一括メンテナンス" />
				</StackPanel>
			</DockPanel>
		</materialDesign:ColorZone>

		<materialDesign:Card Grid.Row="1"
			Margin="12,10,12,8" Padding="12"
			materialDesign:ElevationAssist.Elevation="Dp2">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="170" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>

				<TextBlock Grid.Column="0"
					Margin="4,0,8,0" VerticalAlignment="Center"
					Text="得意先" />
				<TextBox Grid.Column="1"
					MinWidth="260"
					materialDesign:HintAssist.Hint="一覧取得で複数選択" IsReadOnly="True"
					Style="{StaticResource FormTextBox}"
					Text="{Binding SelectedTokuiText}" />

				<TextBlock Grid.Column="2"
					Margin="18,0,8,0" VerticalAlignment="Center"
					Text="一括棚卸日" />
				<DatePicker Grid.Column="3"
					Width="160"
					helpers:DatePickerTodayButtonBehavior.IsEnabled="True" IsTodayHighlighted="False"
					SelectedDate="{Binding BulkTanaDay, Converter={StaticResource DateYmd8Converter}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
					Style="{StaticResource FormDatePicker}" />
				<Button Grid.Column="4"
					Margin="8,0,0,0"
					Command="{Binding ApplyBulkTanaDayCommand}"
					Style="{StaticResource ToolCommandButton}"
					ToolTip="チェック行へ棚卸日を設定">
					<StackPanel Orientation="Horizontal">
						<materialDesign:PackIcon VerticalAlignment="Center"
							Kind="CalendarImport" />
						<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
							Text="設定" />
					</StackPanel>
				</Button>
				<Button Grid.Column="5"
					Margin="8,0,0,0"
					Command="{Binding SelectAllTargetsCommand}"
					Style="{StaticResource ToolCommandButton}"
					ToolTip="全行を更新対象にする">
					<materialDesign:PackIcon Kind="CheckboxMarkedOutline" />
				</Button>
				<Button Grid.Column="6"
					Margin="4,0,0,0"
					Command="{Binding ClearAllTargetsCommand}"
					Style="{StaticResource ToolCommandButton}"
					ToolTip="全行の更新対象を外す">
					<materialDesign:PackIcon Kind="CheckboxBlankOffOutline" />
				</Button>
				<TextBlock Grid.Column="7"
					Margin="12,0,4,0" VerticalAlignment="Center"
					Foreground="{DynamicResource MaterialDesignBodyLight}">
					<TextBlock.Text>
						<MultiBinding StringFormat="{}対象 {0:N0} / {1:N0} 件">
							<Binding Path="TargetCount" />
							<Binding Path="Count" />
						</MultiBinding>
					</TextBlock.Text>
				</TextBlock>
			</Grid>
		</materialDesign:Card>

		<materialDesign:Card Grid.Row="2"
			Margin="12,0,12,8" Padding="0"
			materialDesign:ElevationAssist.Elevation="Dp2">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="*" />
				</Grid.RowDefinitions>
				<Border Grid.Row="0"
					Padding="12,8"
					Background="{DynamicResource MaterialDesignToolBarBackground}">
					<DockPanel>
						<TextBlock VerticalAlignment="Center"
							DockPanel.Dock="Right"
							Foreground="{DynamicResource MaterialDesignBodyLight}"
							Text="{Binding Count, StringFormat={}件数: {0:N0}}" />
						<TextBlock VerticalAlignment="Center"
							Foreground="{DynamicResource MaterialDesignBodyLight}"
							Text="{Binding Message}"
							TextTrimming="CharacterEllipsis" />
					</DockPanel>
				</Border>

				<DataGrid Grid.Row="1"
					d:ItemsSource="{d:SampleData ItemCount=5}"
					helpers:DataGridSelectionBehavior.AutoScrollToSelectedItem="True" materialDesign:DataGridAssist.CellPadding="8,4" materialDesign:DataGridAssist.ColumnHeaderPadding="8,6"
					AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" EnableRowVirtualization="True" FrozenColumnCount="3" GridLinesVisibility="Horizontal"
					HorizontalGridLinesBrush="{DynamicResource MaterialDesignDivider}"
					IsReadOnly="False" IsSynchronizedWithCurrentItem="True"
					ItemsSource="{Binding ListData}"
					SelectedItem="{Binding Current}"
					Style="{StaticResource MaterialDesignDataGrid}"
					VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
					<DataGrid.Columns>
						<DataGridTextColumn Width="48"
							Binding="{Binding RowNo}"
							Header="行" IsReadOnly="True" />
						<DataGridCheckBoxColumn Width="58"
							Binding="{Binding IsTarget, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
							Header="設定" />
						<DataGridTextColumn Width="90"
							Binding="{Binding Id_Shop}"
							Header="得意先Id" IsReadOnly="True" />
						<DataGridTextColumn Width="100"
							Binding="{Binding TokuiCode}"
							Header="Cd" IsReadOnly="True" />
						<DataGridTextColumn Width="220"
							Binding="{Binding TokuiName}"
							Header="名称" IsReadOnly="True" />
						<DataGridTextColumn Width="120"
							Binding="{Binding FixDay, Converter={StaticResource DateYmd8Converter}, StringFormat=yyyy/MM/dd}"
							Header="最終確定日" IsReadOnly="True" />
						<DataGridTemplateColumn Width="150"
							Header="棚卸日">
							<DataGridTemplateColumn.CellTemplate>
								<DataTemplate>
									<DatePicker Margin="0"
										helpers:DatePickerTodayButtonBehavior.IsEnabled="True" IsTodayHighlighted="False"
										SelectedDate="{Binding TanaDay, Converter={StaticResource DateYmd8Converter}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
										Style="{StaticResource FormDatePicker}" />
								</DataTemplate>
							</DataGridTemplateColumn.CellTemplate>
						</DataGridTemplateColumn>
						<DataGridTemplateColumn Width="220"
							Header="自動補充フラグ">
							<DataGridTemplateColumn.CellTemplate>
								<DataTemplate>
									<DockPanel LastChildFill="True">
										<Button Width="36" Height="30"
											Margin="0,0,8,0"
											Command="{Binding DataContext.SelectAutoHojuCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
											CommandParameter="{Binding}"
											DockPanel.Dock="Left"
											Style="{StaticResource ToolCommandButton}"
											ToolTip="自動補充曜日を選択">
											<materialDesign:PackIcon Kind="CalendarWeek" />
										</Button>
										<TextBox MinWidth="90"
											IsReadOnly="True"
											Style="{StaticResource FormTextBox}"
											Text="{Binding AutoHoju, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
									</DockPanel>
								</DataTemplate>
							</DataGridTemplateColumn.CellTemplate>
						</DataGridTemplateColumn>
					</DataGrid.Columns>
					<DataGrid.ColumnHeaderStyle>
						<Style BasedOn="{StaticResource MenteDataGridColumnHeader}"
							TargetType="DataGridColumnHeader" />
					</DataGrid.ColumnHeaderStyle>
				</DataGrid>
			</Grid>
		</materialDesign:Card>

		<Border Grid.Row="3"
			Padding="12,8"
			Background="{DynamicResource MaterialDesignToolBarBackground}">
			<DockPanel>
				<TextBlock VerticalAlignment="Center"
					Foreground="{DynamicResource MaterialDesignBodyLight}"
					Text="{Binding Message}"
					TextTrimming="CharacterEllipsis" />
				<StackPanel HorizontalAlignment="Right"
					DockPanel.Dock="Right" Orientation="Horizontal">
					<Button Margin="4,0"
						Command="{Binding UpdateSelectedCommand}"
						Style="{StaticResource ToolCommandButton}"
						ToolTip="更新実行 (F2)">
						<TextBlock Text="更新実行" />
					</Button>
					<Button Margin="4,0"
						Command="{Binding ExitCommand}"
						Style="{StaticResource ToolCommandButton}"
						ToolTip="戻る (Esc)">
						<TextBlock Text="戻る(ESC)" />
					</Button>
				</StackPanel>
			</DockPanel>
		</Border>
	</Grid>
</helpers:BaseWindow>
