<helpers:BaseWindow x:Class="CvWpfclient.Views._08Zaiko.StockInputListView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:helpers="clr-namespace:CvWpfclient.Helpers"
	xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:vm="clr-namespace:CvWpfclient.ViewModels._08Zaiko"
	Title="{Binding Title}"
	Width="1280" Height="800"
	Background="{DynamicResource AppCommonBackgroundBrush}"
	FontSize="14"
	Foreground="{DynamicResource MaterialDesignBody}"
	TextOptions.TextFormattingMode="Display" WindowStartupLocation="CenterScreen"
	mc:Ignorable="d">
	<helpers:BaseWindow.DataContext>
		<vm:StockInputListViewModel />
	</helpers:BaseWindow.DataContext>

	<helpers:BaseWindow.InputBindings>
		<KeyBinding Command="{Binding SearchCommand}"
			Gesture="F5" />
		<KeyBinding Command="{Binding RegisterCommand}"
			Gesture="F4" />
		<KeyBinding Command="{Binding ExitCommand}"
			Gesture="Esc" />
	</helpers:BaseWindow.InputBindings>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<materialDesign:ColorZone Grid.Row="0"
			Padding="12,8"
			materialDesign:ElevationAssist.Elevation="Dp4" Mode="PrimaryMid">
			<DockPanel>
				<StackPanel DockPanel.Dock="Right" VerticalAlignment="Center"
					Orientation="Horizontal">
					<TextBlock Margin="16,0,0,0" VerticalAlignment="Center"
						Text="件数:" />
					<TextBlock Margin="4,0,0,0" VerticalAlignment="Center"
						FontWeight="SemiBold"
						Text="{Binding RowCount, StringFormat={}{0:N0}}" />
					<TextBlock Margin="16,0,0,0" VerticalAlignment="Center"
						Text="実棚数計:" />
					<TextBlock Margin="4,0,0,0" VerticalAlignment="Center"
						FontWeight="SemiBold"
						Text="{Binding InputSuTotal, StringFormat={}{0:N0}}" />
					<TextBlock Margin="16,0,0,0" VerticalAlignment="Center"
						Text="伝票No:" />
					<TextBlock Margin="4,0,0,0" VerticalAlignment="Center"
						FontWeight="SemiBold"
						Text="{Binding RegisteredDenId}" />
					<Button Margin="16,0,0,0"
						Command="{Binding RegisterCommand}"
						IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
						Style="{StaticResource MaterialDesignRaisedButton}"
						ToolTip="実棚数を入力した行を棚卸伝票(Tran60Tana)として登録 (F4)">
						<StackPanel Orientation="Horizontal">
							<materialDesign:PackIcon VerticalAlignment="Center"
								Kind="ContentSave" />
							<TextBlock Margin="8,0,0,0" VerticalAlignment="Center"
								FontSize="16" Text="棚卸登録" />
						</StackPanel>
					</Button>
				</StackPanel>
				<StackPanel Orientation="Horizontal">
					<Button Margin="0,0,8,0"
						Command="{Binding ExitCommand}"
						Style="{StaticResource ToolCommandButton}"
						ToolTip="閉じる (Esc)">
						<materialDesign:PackIcon Kind="ArrowLeft" />
					</Button>
					<materialDesign:PackIcon Width="26" Height="26"
						VerticalAlignment="Center"
						Kind="ClipboardListOutline" />
					<TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
						FontSize="18" FontWeight="SemiBold"
						Text="{Binding Title}" />
				</StackPanel>
			</DockPanel>
		</materialDesign:ColorZone>

		<Border Grid.Row="1"
			Margin="12,12,12,0" Padding="12"
			BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1"
			CornerRadius="4">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="120" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" />
				</Grid.ColumnDefinitions>

				<!--  棚卸日  -->
				<TextBlock Grid.Row="0" Grid.Column="0"
					Margin="0,4" VerticalAlignment="Center"
					Text="棚卸日" />
				<TextBox Grid.Row="0" Grid.Column="1"
					Width="180" Height="32" Margin="0,4"
					HorizontalAlignment="Left" HorizontalContentAlignment="Left"
					Style="{StaticResource MaterialDesignTextBox}"
					Text="{Binding DenDayText, UpdateSourceTrigger=PropertyChanged}" />

				<!--  対象倉庫  -->
				<TextBlock Grid.Row="1" Grid.Column="0"
					Margin="0,4" VerticalAlignment="Center"
					Text="対象倉庫" />
				<TextBox Grid.Row="1" Grid.Column="1"
					Width="180" Height="32" Margin="0,4"
					HorizontalAlignment="Left" HorizontalContentAlignment="Left"
					helpers:SearchTextBoxAssist.Command="{Binding SelectSokoCommand}"
					BorderThickness="0,0,0,1"
					Style="{StaticResource MenteSearchTextBox}"
					Text="{Binding SokoCode, UpdateSourceTrigger=PropertyChanged}" />
				<TextBlock Grid.Row="1" Grid.Column="2"
					Margin="8,0" VerticalAlignment="Center"
					Text="{Binding SokoName}" />

				<!--  品番  -->
				<TextBlock Grid.Row="2" Grid.Column="0"
					Margin="0,4" VerticalAlignment="Center"
					Text="品番" />
				<TextBox Grid.Row="2" Grid.Column="1"
					Width="180" Height="32" Margin="0,4"
					HorizontalAlignment="Left" HorizontalContentAlignment="Left"
					helpers:SearchTextBoxAssist.Command="{Binding SelectShohinFromCommand}"
					BorderThickness="0,0,0,1"
					Style="{StaticResource MenteSearchTextBox}"
					Text="{Binding ShohinCodeFrom, UpdateSourceTrigger=PropertyChanged}" />
				<TextBlock Grid.Row="2" Grid.Column="2"
					Margin="8,0" VerticalAlignment="Center"
					Text="～" />
				<TextBox Grid.Row="2" Grid.Column="3"
					Width="180" Height="32" Margin="0,4"
					HorizontalAlignment="Left" HorizontalContentAlignment="Left"
					helpers:SearchTextBoxAssist.Command="{Binding SelectShohinToCommand}"
					BorderThickness="0,0,0,1"
					Style="{StaticResource MenteSearchTextBox}"
					Text="{Binding ShohinCodeTo, UpdateSourceTrigger=PropertyChanged}" />

				<!--  棚番  -->
				<TextBlock Grid.Row="3" Grid.Column="0"
					Margin="0,4" VerticalAlignment="Center"
					Text="棚番" />
				<TextBox Grid.Row="3" Grid.Column="1"
					Width="180" Height="32" Margin="0,4"
					HorizontalAlignment="Left" HorizontalContentAlignment="Left"
					Style="{StaticResource MaterialDesignTextBox}"
					Text="{Binding TanaNo, UpdateSourceTrigger=PropertyChanged}" />

				<!--  担当者  -->
				<TextBlock Grid.Row="4" Grid.Column="0"
					Margin="0,4" VerticalAlignment="Center"
					Text="担当者" />
				<TextBox Grid.Row="4" Grid.Column="1"
					Width="180" Height="32" Margin="0,4"
					HorizontalAlignment="Left" HorizontalContentAlignment="Left"
					helpers:SearchTextBoxAssist.Command="{Binding SelectShainCommand}"
					BorderThickness="0,0,0,1"
					Style="{StaticResource MenteSearchTextBox}"
					Text="{Binding ShainCode, UpdateSourceTrigger=PropertyChanged}" />
				<TextBlock Grid.Row="4" Grid.Column="2"
					Margin="8,0" VerticalAlignment="Center"
					Text="{Binding ShainName}" />

				<!--  メモ  -->
				<TextBlock Grid.Row="5" Grid.Column="0"
					Margin="0,4" VerticalAlignment="Center"
					Text="メモ" />
				<TextBox Grid.Row="5" Grid.Column="1"
					Width="180" Height="32" Margin="0,4"
					HorizontalAlignment="Left" HorizontalContentAlignment="Left"
					Style="{StaticResource MaterialDesignTextBox}"
					Text="{Binding Memo, UpdateSourceTrigger=PropertyChanged}" />

				<!--  表示条件  -->
				<TextBlock Grid.Row="6" Grid.Column="0"
					Margin="0,4" VerticalAlignment="Center"
					Text="表示条件" />
				<StackPanel Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="3"
					Margin="0,4"
					Orientation="Horizontal">
					<CheckBox Margin="0,4"
						Content="在庫0を除く"
						IsChecked="{Binding IsZeroExcluded}"
						ToolTip="理論在庫0のSKUを一覧から除く" />
					<CheckBox Margin="16,4,0,4"
						Content="実棚数に理論在庫を入れる"
						IsChecked="{Binding IsPrefillTheoretical}"
						ToolTip="差異のある行だけ直す運用向け。外すと0から入力する" />
				</StackPanel>

				<StackPanel Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="3"
					Margin="0,4">
					<TextBlock Foreground="{DynamicResource MaterialDesignValidationErrorBrush}"
						Text="品番範囲を指定すると在庫レコードが無いSKUも一覧に出ます（理論在庫0なのに現物があった場合の記録用）。" TextWrapping="Wrap" />
					<TextBlock Foreground="{DynamicResource MaterialDesignValidationErrorBrush}"
						Text="棚卸伝票を登録しても在庫数は変わりません（棚卸確定処理で反映）。差異は棚卸差異問合せで確認します。" TextWrapping="Wrap" />
				</StackPanel>

				<StackPanel Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="4"
					Margin="0,12,0,0" HorizontalAlignment="Left"
					Orientation="Horizontal">
					<TextBlock Margin="0,0,8,0" VerticalAlignment="Center"
						Text="取得件数上限" />
					<TextBox Width="80" Height="32" Margin="0,0,16,0"
						Style="{StaticResource MaterialDesignTextBox}"
						Text="{Binding MaxCountText, UpdateSourceTrigger=PropertyChanged}" />
					<Button Command="{Binding SearchCommand}"
						IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
						Style="{StaticResource MaterialDesignFlatMidBgButton}"
						ToolTip="対象SKUを一覧に表示 (F5)">
						<StackPanel Orientation="Horizontal">
							<materialDesign:PackIcon VerticalAlignment="Center"
								Kind="Magnify" />
							<TextBlock Margin="8,0,0,0" VerticalAlignment="Center"
								FontSize="16" Text="一覧表示" />
						</StackPanel>
					</Button>
					<Button Margin="12,0,0,0"
						Command="{Binding ClearConditionsCommand}"
						Style="{StaticResource MaterialDesignOutlinedButton}"
						ToolTip="入力条件をクリア">
						<TextBlock FontSize="16" Text="条件クリア" />
					</Button>
				</StackPanel>
			</Grid>
		</Border>

		<DataGrid Grid.Row="2"
			Margin="12"
			AutoGenerateColumns="False"
			CanUserAddRows="False" CanUserDeleteRows="False"
			ItemsSource="{Binding Rows}"
			SelectedItem="{Binding SelectedRow}"
			SelectionMode="Single" SelectionUnit="CellOrRowHeader"
			VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
			<DataGrid.Columns>
				<DataGridTextColumn Width="110"
					Binding="{Binding Code_Shohin}"
					Header="品番" IsReadOnly="True">
				</DataGridTextColumn>
				<DataGridTextColumn Width="220"
					Binding="{Binding Mei_Shohin}"
					Header="商品名" IsReadOnly="True">
				</DataGridTextColumn>
				<DataGridTextColumn Width="70"
					Binding="{Binding Code_Col}"
					Header="色CD" IsReadOnly="True">
				</DataGridTextColumn>
				<DataGridTextColumn Width="110"
					Binding="{Binding Mei_Col}"
					Header="色名" IsReadOnly="True">
				</DataGridTextColumn>
				<DataGridTextColumn Width="70"
					Binding="{Binding Code_Siz}"
					Header="ｻｲｽﾞCD" IsReadOnly="True">
				</DataGridTextColumn>
				<DataGridTextColumn Width="90"
					Binding="{Binding Mei_Siz}"
					Header="ｻｲｽﾞ名" IsReadOnly="True">
				</DataGridTextColumn>
				<DataGridTextColumn Width="120"
					Binding="{Binding JanCode}"
					Header="JAN" IsReadOnly="True">
				</DataGridTextColumn>
				<DataGridTextColumn Width="90"
					Binding="{Binding TheoreticalSu, StringFormat={}{0:N0}}"
					Header="理論在庫" IsReadOnly="True">
					<DataGridTextColumn.ElementStyle>
						<Style TargetType="TextBlock">
							<Setter Property="HorizontalAlignment" Value="Right" />
						</Style>
					</DataGridTextColumn.ElementStyle>
				</DataGridTextColumn>
				<DataGridTextColumn Width="90"
					Binding="{Binding InputSu, StringFormat={}{0:N0}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
					Header="実棚数" IsReadOnly="False">
					<DataGridTextColumn.ElementStyle>
						<Style TargetType="TextBlock">
							<Setter Property="HorizontalAlignment" Value="Right" />
						</Style>
					</DataGridTextColumn.ElementStyle>
					<DataGridTextColumn.EditingElementStyle>
						<Style TargetType="TextBox">
							<Setter Property="HorizontalContentAlignment" Value="Right" />
						</Style>
					</DataGridTextColumn.EditingElementStyle>
				</DataGridTextColumn>
				<DataGridTextColumn Width="90"
					Binding="{Binding DiffSu, StringFormat={}{0:N0}}"
					Header="差異" IsReadOnly="True">
					<DataGridTextColumn.ElementStyle>
						<Style TargetType="TextBlock">
							<Setter Property="HorizontalAlignment" Value="Right" />
						</Style>
					</DataGridTextColumn.ElementStyle>
				</DataGridTextColumn>
				<DataGridTextColumn Width="80"
					Binding="{Binding TankaGenka, StringFormat={}{0:N0}}"
					Header="原価" IsReadOnly="True">
					<DataGridTextColumn.ElementStyle>
						<Style TargetType="TextBlock">
							<Setter Property="HorizontalAlignment" Value="Right" />
						</Style>
					</DataGridTextColumn.ElementStyle>
				</DataGridTextColumn>
				<DataGridTextColumn Width="80"
					Binding="{Binding TankaJodai, StringFormat={}{0:N0}}"
					Header="上代" IsReadOnly="True">
					<DataGridTextColumn.ElementStyle>
						<Style TargetType="TextBlock">
							<Setter Property="HorizontalAlignment" Value="Right" />
						</Style>
					</DataGridTextColumn.ElementStyle>
				</DataGridTextColumn>
			</DataGrid.Columns>
		</DataGrid>

		<Border Grid.Row="3"
			Padding="12,6"
			Background="{DynamicResource MaterialDesignChipBackground}">
			<TextBlock VerticalAlignment="Center"
				Text="{Binding Message}" TextTrimming="CharacterEllipsis" />
		</Border>
	</Grid>
</helpers:BaseWindow>
