<helpers:BaseWindow x:Class="CvWpfclient.Views._08Zaiko.StockForceHistoryView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:helpers="clr-namespace:CvWpfclient.Helpers" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:vm="clr-namespace:CvWpfclient.ViewModels._08Zaiko"
	Title="{Binding Title}"
	Width="1280" Height="800"
	Background="{DynamicResource AppCommonBackgroundBrush}"
	FontSize="14"
	Foreground="{DynamicResource MaterialDesignBody}"
	TextOptions.TextFormattingMode="Display" WindowStartupLocation="CenterScreen"
	mc:Ignorable="d">
	<helpers:BaseWindow.DataContext>
		<vm:StockForceHistoryViewModel />
	</helpers:BaseWindow.DataContext>

	<helpers:BaseWindow.InputBindings>
		<KeyBinding Command="{Binding SearchCommand}"
			Gesture="F5" />
		<KeyBinding Command="{Binding ExitCommand}"
			Gesture="Esc" />
	</helpers:BaseWindow.InputBindings>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="220" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<materialDesign:ColorZone Grid.Row="0"
			Padding="12,8"
			materialDesign:ElevationAssist.Elevation="Dp4" Mode="PrimaryMid">
			<StackPanel Orientation="Horizontal">
				<Button Margin="0,0,8,0"
					Command="{Binding ExitCommand}"
					Style="{StaticResource ToolCommandButton}"
					ToolTip="閉じる (Esc)">
					<materialDesign:PackIcon Kind="ArrowLeft" />
				</Button>
				<materialDesign:PackIcon Width="26" Height="26"
					VerticalAlignment="Center"
					Kind="ClipboardTextClockOutline" />
				<TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
					FontSize="18" FontWeight="SemiBold"
					Text="{Binding Title}" />
				<TextBlock Margin="16,0,0,0" VerticalAlignment="Center"
					Opacity="0.8" Text="強制調整の伝票を照会し、取消すと在庫が調整前へ戻ります。" />
			</StackPanel>
		</materialDesign:ColorZone>

		<Border Grid.Row="1"
			Padding="12"
			Background="{DynamicResource MaterialDesignPaper}">
			<StackPanel Orientation="Horizontal">
				<TextBlock Margin="0,0,8,0" VerticalAlignment="Center"
					Text="倉庫" />
				<Button Width="60"
					Command="{Binding SelectSokoCommand}"
					Content="選択"
					Style="{StaticResource MaterialDesignOutlinedButton}" />
				<TextBox Width="120" Height="32"
					Margin="8,0,0,0"
					Style="{StaticResource MaterialDesignTextBox}"
					Text="{Binding SokoCode, UpdateSourceTrigger=PropertyChanged}" />
				<TextBlock Margin="24,0,8,0" VerticalAlignment="Center"
					Text="調整日" />
				<TextBox Width="140" Height="32"
					Style="{StaticResource MaterialDesignTextBox}"
					Text="{Binding DenFromText, UpdateSourceTrigger=PropertyChanged}" />
				<TextBlock Margin="8,0" VerticalAlignment="Center"
					Text="～" />
				<TextBox Width="140" Height="32"
					Style="{StaticResource MaterialDesignTextBox}"
					Text="{Binding DenToText, UpdateSourceTrigger=PropertyChanged}" />
				<TextBlock Margin="24,0,8,0" VerticalAlignment="Center"
					Text="件数上限" />
				<TextBox Width="70" Height="32"
					Style="{StaticResource MaterialDesignTextBox}"
					Text="{Binding MaxCountText, UpdateSourceTrigger=PropertyChanged}" />
				<Button Margin="16,0,0,0"
					Command="{Binding SearchCommand}"
					IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
					Style="{StaticResource MaterialDesignFlatMidBgButton}"
					ToolTip="検索 (F5)">
					<StackPanel Orientation="Horizontal">
						<materialDesign:PackIcon VerticalAlignment="Center"
							Kind="Magnify" />
						<TextBlock Margin="8,0,0,0" VerticalAlignment="Center"
							FontSize="16" Text="検索実行" />
					</StackPanel>
				</Button>
				<Button Margin="24,0,0,0"
					Command="{Binding CancelChoseiCommand}"
					IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
					Style="{StaticResource MaterialDesignOutlinedButton}"
					ToolTip="選択した強制調整伝票を取り消し在庫を戻す">
					<StackPanel Orientation="Horizontal">
						<materialDesign:PackIcon VerticalAlignment="Center"
							Kind="DeleteOutline" />
						<TextBlock Margin="8,0,0,0" VerticalAlignment="Center"
							FontSize="16" Text="取消" />
					</StackPanel>
				</Button>
				<Button Margin="12,0,0,0"
					Command="{Binding ClearConditionsCommand}"
					Style="{StaticResource MaterialDesignOutlinedButton}">
					<TextBlock FontSize="16" Text="条件クリア" />
				</Button>
			</StackPanel>
		</Border>

		<DataGrid Grid.Row="2"
			Margin="12,12,12,0"
			AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
			ItemsSource="{Binding Rows}"
			SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
			SelectionMode="Single" SelectionUnit="FullRow" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
			<DataGrid.Columns>
				<DataGridTextColumn Width="90"
					Binding="{Binding Id}"
					Header="伝票No">
					<DataGridTextColumn.ElementStyle>
						<Style TargetType="TextBlock">
							<Setter Property="HorizontalAlignment" Value="Right" />
						</Style>
					</DataGridTextColumn.ElementStyle>
				</DataGridTextColumn>
				<DataGridTextColumn Width="110"
					Binding="{Binding DenDayDisplay}"
					Header="調整日" />
				<DataGridTextColumn Width="240"
					Binding="{Binding SokoDisplay}"
					Header="倉庫" />
				<DataGridTextColumn Width="100"
					Binding="{Binding RiyuDisplay}"
					Header="調整理由" />
				<DataGridTextColumn Width="100"
					Binding="{Binding SuTotal, StringFormat={}{0:N0}}"
					Header="調整数計">
					<DataGridTextColumn.ElementStyle>
						<Style TargetType="TextBlock">
							<Setter Property="HorizontalAlignment" Value="Right" />
						</Style>
					</DataGridTextColumn.ElementStyle>
				</DataGridTextColumn>
				<DataGridTextColumn Width="80"
					Binding="{Binding MeisaiCount, StringFormat={}{0:N0}}"
					Header="明細数">
					<DataGridTextColumn.ElementStyle>
						<Style TargetType="TextBlock">
							<Setter Property="HorizontalAlignment" Value="Right" />
						</Style>
					</DataGridTextColumn.ElementStyle>
				</DataGridTextColumn>
				<DataGridTextColumn Width="200"
					Binding="{Binding ShainDisplay}"
					Header="入力社員" />
				<DataGridTextColumn Width="*"
					Binding="{Binding Memo}"
					Header="メモ" />
			</DataGrid.Columns>
		</DataGrid>

		<TextBlock Grid.Row="3"
			Margin="12,8,12,0"
			FontWeight="SemiBold" Text="選択伝票の明細" />

		<DataGrid Grid.Row="4"
			Margin="12,4,12,0"
			AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
			ItemsSource="{Binding SelectedRow.Chosei.Jmeisai}"
			VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
			<DataGrid.Columns>
				<DataGridTextColumn Width="60"
					Binding="{Binding No}"
					Header="No" />
				<DataGridTextColumn Width="120"
					Binding="{Binding Code_Shohin}"
					Header="品番" />
				<DataGridTextColumn Width="240"
					Binding="{Binding Mei_Shohin}"
					Header="商品名" />
				<DataGridTextColumn Width="140"
					Binding="{Binding Mei_Col}"
					Header="色" />
				<DataGridTextColumn Width="120"
					Binding="{Binding Mei_Siz}"
					Header="サイズ" />
				<DataGridTextColumn Width="100"
					Binding="{Binding Su, StringFormat={}{0:N0}}"
					Header="調整数">
					<DataGridTextColumn.ElementStyle>
						<Style TargetType="TextBlock">
							<Setter Property="HorizontalAlignment" Value="Right" />
						</Style>
					</DataGridTextColumn.ElementStyle>
				</DataGridTextColumn>
			</DataGrid.Columns>
		</DataGrid>

		<Border Grid.Row="5"
			Padding="12,6"
			Background="{DynamicResource MaterialDesignChipBackground}">
			<TextBlock VerticalAlignment="Center"
				Text="{Binding Message}"
				TextTrimming="CharacterEllipsis" />
		</Border>
	</Grid>
</helpers:BaseWindow>
