<helpers:BaseWindow x:Class="CvWpfclient.Views._30HHT.IdoDetailBookPrintView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:helpers="clr-namespace:CvWpfclient.Helpers"
	xmlns:local="clr-namespace:CvWpfclient.Views" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:vm="clr-namespace:CvWpfclient.ViewModels._30HHT"
	Title="{Binding Title}"
	Width="820" Height="620"
	Background="{DynamicResource AppCommonBackgroundBrush}"
	FontSize="16"
	Foreground="{DynamicResource MaterialDesignBody}"
	TextOptions.TextFormattingMode="Display" WindowStartupLocation="CenterScreen"
	mc:Ignorable="d">
	<helpers:BaseWindow.DataContext>
		<vm:IdoDetailBookPrintViewModel />
	</helpers:BaseWindow.DataContext>

	<helpers:BaseWindow.InputBindings>
		<KeyBinding Command="{Binding PrintCommand}"
			Gesture="F6" />
		<KeyBinding Command="{Binding ExitCommand}"
			Gesture="Esc" />
	</helpers:BaseWindow.InputBindings>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<materialDesign:ColorZone Grid.Row="0"
			Padding="12,8"
			materialDesign:ElevationAssist.Elevation="Dp4" Mode="PrimaryMid">
			<StackPanel Orientation="Horizontal">
				<Button Margin="0,0,8,0"
					Command="{Binding ExitCommand}"
					Style="{StaticResource ToolCommandButton}"
					ToolTip="閉じる (Esc)">
					<materialDesign:PackIcon Kind="ArrowLeft" />
				</Button>
				<materialDesign:PackIcon Width="28" Height="28"
					VerticalAlignment="Center"
					Kind="Printer" />
				<TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
					FontSize="20" FontWeight="SemiBold"
					Text="{Binding Title}" />
			</StackPanel>
		</materialDesign:ColorZone>

		<!--  縮小時も最下部の操作ボタンへ到達できるようスクロール可能にする  -->
		<ScrollViewer Grid.Row="1"
			HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
			<Grid Margin="24">
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="*" />
				</Grid.RowDefinitions>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="140" />
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" />
				</Grid.ColumnDefinitions>

				<!--  印刷区分  -->
				<TextBlock Grid.Row="0" Grid.Column="0"
					Style="{StaticResource FormLabel}"
					Text="印刷区分" />
				<StackPanel Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3"
					Margin="0,8" Orientation="Horizontal">
					<RadioButton Margin="0,0,24,0"
						Content="通常発行"
						GroupName="IssueType"
						IsChecked="{Binding IsNormalIssue}" />
					<RadioButton Content="再発行" GroupName="IssueType" />
				</StackPanel>

				<!--  出庫元  -->
				<TextBlock Grid.Row="1" Grid.Column="0"
					Style="{StaticResource FormLabel}"
					Text="出庫元" />
				<TextBox Grid.Row="1" Grid.Column="1"
					Width="200" Height="36"
					HorizontalAlignment="Left" HorizontalContentAlignment="Left"
					helpers:SearchTextBoxAssist.Command="{Binding SelectSokoFromCommand}"
					BorderThickness="0,0,0,1"
					Style="{StaticResource MenteSearchTextBox}"
					Text="{Binding SokoCodeFrom, UpdateSourceTrigger=PropertyChanged}" />
				<TextBlock Grid.Row="1" Grid.Column="2"
					Margin="8,0" VerticalAlignment="Center"
					Text="～" />
				<TextBox Grid.Row="1" Grid.Column="3"
					Width="200" Height="36"
					HorizontalAlignment="Left" HorizontalContentAlignment="Left"
					helpers:SearchTextBoxAssist.Command="{Binding SelectSokoToCommand}"
					BorderThickness="0,0,0,1"
					Style="{StaticResource MenteSearchTextBox}"
					Text="{Binding SokoCodeTo, UpdateSourceTrigger=PropertyChanged}" />

				<!--  入庫先  -->
				<TextBlock Grid.Row="2" Grid.Column="0"
					Style="{StaticResource FormLabel}"
					Text="入庫先" />
				<TextBox Grid.Row="2" Grid.Column="1"
					Width="200" Height="36"
					HorizontalAlignment="Left" HorizontalContentAlignment="Left"
					helpers:SearchTextBoxAssist.Command="{Binding SelectIdoFromCommand}"
					BorderThickness="0,0,0,1"
					Style="{StaticResource MenteSearchTextBox}"
					Text="{Binding IdoCodeFrom, UpdateSourceTrigger=PropertyChanged}" />
				<TextBlock Grid.Row="2" Grid.Column="2"
					Margin="8,0" VerticalAlignment="Center"
					Text="～" />
				<TextBox Grid.Row="2" Grid.Column="3"
					Width="200" Height="36"
					HorizontalAlignment="Left" HorizontalContentAlignment="Left"
					helpers:SearchTextBoxAssist.Command="{Binding SelectIdoToCommand}"
					BorderThickness="0,0,0,1"
					Style="{StaticResource MenteSearchTextBox}"
					Text="{Binding IdoCodeTo, UpdateSourceTrigger=PropertyChanged}" />

				<!--  移動日  -->
				<TextBlock Grid.Row="3" Grid.Column="0"
					Style="{StaticResource FormLabel}"
					Text="移動日" />
				<TextBox Grid.Row="3" Grid.Column="1"
					Width="200" Height="36"
					HorizontalAlignment="Left" HorizontalContentAlignment="Left"
					Style="{StaticResource MaterialDesignTextBox}"
					Text="{Binding DenDayFrom, UpdateSourceTrigger=PropertyChanged}" />
				<TextBlock Grid.Row="3" Grid.Column="2"
					Margin="8,0" VerticalAlignment="Center"
					Text="～" />
				<TextBox Grid.Row="3" Grid.Column="3"
					Width="200" Height="36"
					HorizontalAlignment="Left" HorizontalContentAlignment="Left"
					Style="{StaticResource MaterialDesignTextBox}"
					Text="{Binding DenDayTo, UpdateSourceTrigger=PropertyChanged}" />

				<!--  伝票NO  -->
				<TextBlock Grid.Row="4" Grid.Column="0"
					Style="{StaticResource FormLabel}"
					Text="伝票NO" />
				<TextBox Grid.Row="4" Grid.Column="1"
					Width="200" Height="36"
					HorizontalAlignment="Left" HorizontalContentAlignment="Left"
					Style="{StaticResource MaterialDesignTextBox}"
					Text="{Binding DenNoFrom, UpdateSourceTrigger=PropertyChanged}" />
				<TextBlock Grid.Row="4" Grid.Column="2"
					Margin="8,0" VerticalAlignment="Center"
					Text="～" />
				<TextBox Grid.Row="4" Grid.Column="3"
					Width="200" Height="36"
					HorizontalAlignment="Left" HorizontalContentAlignment="Left"
					Style="{StaticResource MaterialDesignTextBox}"
					Text="{Binding DenNoTo, UpdateSourceTrigger=PropertyChanged}" />

				<!--  注意書き  -->
				<StackPanel Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="3"
					Margin="0,8">
					<TextBlock Foreground="{DynamicResource MaterialDesignValidationErrorBrush}"
						Text="※通常発行は未発行の伝票を印刷し、発行済みにします。再発行は発行済みの伝票を印刷します。" TextWrapping="Wrap" />
				</StackPanel>

				<!--  実行ボタン  -->
				<StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="4"
					Margin="0,24" HorizontalAlignment="Center"
					Orientation="Horizontal">
					<Button Command="{Binding PrintCommand}"
						Style="{StaticResource MaterialDesignFlatMidBgButton}"
						ToolTip="印刷 (F6)">
						<StackPanel Orientation="Horizontal">
							<materialDesign:PackIcon VerticalAlignment="Center"
								Kind="Printer" />
							<TextBlock Margin="8,0,0,0" VerticalAlignment="Center"
								FontSize="20" Text="印刷" />
						</StackPanel>
					</Button>
					<Button Margin="16,0,0,0"
						Command="{Binding ClearConditionsCommand}"
						Style="{StaticResource MaterialDesignOutlinedButton}">
						<TextBlock FontSize="16" Text="条件クリア" />
					</Button>
				</StackPanel>
			</Grid>
		</ScrollViewer>

		<Border Grid.Row="2"
			Padding="12,8"
			Background="{DynamicResource MaterialDesignPaper}">
			<TextBlock VerticalAlignment="Center"
				Text="{Binding Message}"
				TextWrapping="Wrap" />
		</Border>
	</Grid>
</helpers:BaseWindow>
