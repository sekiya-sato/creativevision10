<helpers:BaseWindow x:Class="CvWpfclient.Views._30HHT.HhtDataUpdateView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:helpers="clr-namespace:CvWpfclient.Helpers"
	xmlns:local="clr-namespace:CvWpfclient.Views" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:vm="clr-namespace:CvWpfclient.ViewModels._30HHT"
	Title="HHTデータ更新"
	Width="800" Height="620"
	Background="{DynamicResource AppCommonBackgroundBrush}"
	FontSize="16"
	Foreground="{DynamicResource MaterialDesignBody}"
	ResizeMode="NoResize" TextOptions.TextFormattingMode="Display"
	mc:Ignorable="d">
	<helpers:BaseWindow.DataContext>
		<vm:HhtDataUpdateViewModel />
	</helpers:BaseWindow.DataContext>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<materialDesign:ColorZone Grid.Row="0"
			Padding="14,10"
			materialDesign:ElevationAssist.Elevation="Dp4" Mode="PrimaryMid">
			<StackPanel Orientation="Horizontal">
				<materialDesign:PackIcon Width="30" Height="30"
					VerticalAlignment="Center"
					Kind="DatabaseArrowRight" />
				<TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
					FontSize="20" FontWeight="SemiBold" Text="HHTデータ更新" />
			</StackPanel>
		</materialDesign:ColorZone>

		<Grid Grid.Row="1"
			Margin="18">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
			</Grid.RowDefinitions>

			<materialDesign:Card Grid.Row="0"
				Padding="24"
				materialDesign:ElevationAssist.Elevation="Dp2" UniformCornerRadius="8">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="140" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>

					<StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
						Margin="0,0,0,16"
						Orientation="Horizontal">
						<materialDesign:PackIcon Width="24" Height="24"
							VerticalAlignment="Center"
							Kind="CalendarRange" />
						<TextBlock Margin="8,0,0,0" VerticalAlignment="Center"
							FontSize="17" FontWeight="SemiBold" Text="変換対象の指定" />
					</StackPanel>

					<TextBlock Grid.Row="1" Grid.Column="0"
						Style="{StaticResource SettingLabel}"
						Text="対象日付" />
					<StackPanel Grid.Row="1" Grid.Column="1"
						VerticalAlignment="Center"
						Orientation="Horizontal">
						<TextBox Width="140"
							VerticalAlignment="Center"
							IsEnabled="{Binding IsProcessing, Converter={StaticResource InverseBooleanConverter}}"
							MaxLength="10"
							Style="{StaticResource MaterialDesignOutlinedTextBox}"
							Text="{Binding DateFrom, UpdateSourceTrigger=PropertyChanged}" />
						<TextBlock Margin="12,0" VerticalAlignment="Center"
							FontWeight="Bold" Text="-" />
						<TextBox Width="140"
							VerticalAlignment="Center"
							IsEnabled="{Binding IsProcessing, Converter={StaticResource InverseBooleanConverter}}"
							MaxLength="10"
							Style="{StaticResource MaterialDesignOutlinedTextBox}"
							Text="{Binding DateTo, UpdateSourceTrigger=PropertyChanged}" />
						<TextBlock Margin="12,0,0,0" VerticalAlignment="Center"
							FontSize="13" Opacity="0.7" Text="空欄で期間指定なし" />
					</StackPanel>

					<TextBlock Grid.Row="2" Grid.Column="0"
						Margin="0,16,0,0"
						Style="{StaticResource SettingLabel}"
						Text="区分" />
					<ComboBox Grid.Row="2" Grid.Column="1"
						Width="200"
						Margin="0,16,0,0" HorizontalAlignment="Left"
						materialDesign:HintAssist.Hint="区分" DisplayMemberPath="Name"
						IsEnabled="{Binding IsProcessing, Converter={StaticResource InverseBooleanConverter}}"
						ItemsSource="{Binding TypeFilters}"
						SelectedItem="{Binding TypeFilter}"
						Style="{StaticResource FormComboBox}" />

					<TextBlock Grid.Row="3" Grid.Column="0"
						Margin="0,16,0,0"
						Style="{StaticResource SettingLabel}"
						Text="エラーデータ" />
					<CheckBox Grid.Row="3" Grid.Column="1"
						Margin="0,16,0,0" VerticalAlignment="Center"
						Content="前回エラーになったデータも再試行する"
						IsChecked="{Binding RetryError}"
						IsEnabled="{Binding IsProcessing, Converter={StaticResource InverseBooleanConverter}}" />

					<TextBlock Grid.Row="4" Grid.Column="0"
						Margin="0,16,0,0"
						Style="{StaticResource SettingLabel}"
						Text="対象件数" />
					<StackPanel Grid.Row="4" Grid.Column="1"
						Margin="0,16,0,0" VerticalAlignment="Center"
						Orientation="Horizontal">
						<TextBlock VerticalAlignment="Center"
							FontWeight="SemiBold"
							Text="{Binding TargetSummary}" />
						<Button Margin="16,0,0,0"
							Command="{Binding RefreshCountCommand}"
							Content="再集計"
							IsEnabled="{Binding IsProcessing, Converter={StaticResource InverseBooleanConverter}}"
							Style="{StaticResource MaterialDesignOutlinedButton}" />
					</StackPanel>

					<TextBlock Grid.Row="5" Grid.Column="0"
						Margin="0,16,0,0"
						Style="{StaticResource SettingLabel}"
						Text="進捗" />
					<ProgressBar Grid.Row="5" Grid.Column="1"
						Height="18"
						Margin="0,16,0,0"
						Maximum="100" Minimum="0"
						Value="{Binding ProgressValue}" />
				</Grid>
			</materialDesign:Card>

			<GroupBox Grid.Row="1"
				Margin="0,18,0,0"
				Header="処理メッセージ">
				<TextBox Margin="8"
					IsReadOnly="True"
					Style="{StaticResource MaterialDesignTextBox}"
					Text="{Binding StatusMessage, UpdateSourceTrigger=PropertyChanged}"
					TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
			</GroupBox>
		</Grid>

		<Border Grid.Row="2"
			Padding="18,12"
			Background="{DynamicResource MaterialDesignPaper}">
			<StackPanel HorizontalAlignment="Right"
				Orientation="Horizontal">
				<Button Width="128" Height="38"
					Margin="0,0,10,0"
					Command="{Binding ExecuteCommand}"
					IsDefault="True"
					Style="{StaticResource MaterialDesignRaisedButton}">
					<StackPanel Orientation="Horizontal">
						<materialDesign:PackIcon VerticalAlignment="Center"
							Kind="Play" />
						<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
							Text="更新" />
					</StackPanel>
				</Button>
				<Button Width="128" Height="38"
					Margin="0,0,10,0"
					Command="{Binding ExecuteCancelCommand}"
					IsEnabled="{Binding IsProcessing}"
					Style="{StaticResource MaterialDesignOutlinedButton}">
					<StackPanel Orientation="Horizontal">
						<materialDesign:PackIcon VerticalAlignment="Center"
							Kind="Stop" />
						<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
							Text="中止" />
					</StackPanel>
				</Button>
				<Button Width="128" Height="38"
					Command="{Binding ExitCommand}"
					IsCancel="True"
					Style="{StaticResource MaterialDesignOutlinedButton}">
					<StackPanel Orientation="Horizontal">
						<materialDesign:PackIcon VerticalAlignment="Center"
							Kind="ArrowLeft" />
						<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
							Text="戻る" />
					</StackPanel>
				</Button>
			</StackPanel>
		</Border>
	</Grid>
</helpers:BaseWindow>
