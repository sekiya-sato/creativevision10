<Window x:Class="CvWpfclient.Views.MainMenuView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors" xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:models="clr-namespace:CvWpfclient.Models"
	xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" xmlns:vm="clr-namespace:CvWpfclient.ViewModels"
	Title="{Binding HeaderTitle}"
	Width="1024" Height="760"
	Background="Transparent"
	Icon="{DynamicResource WindowIcon}"
	ResizeMode="CanResizeWithGrip" SnapsToDevicePixels="True" UseLayoutRounding="True" WindowStartupLocation="CenterScreen" WindowStyle="SingleBorderWindow"
	mc:Ignorable="d">

	<Window.DataContext>
		<vm:MainMenuViewModel />
	</Window.DataContext>

	<Window.InputBindings>
		<KeyBinding Key="F12"
			Command="{Binding ShowLoginCommand}" />
		<KeyBinding Key="F11"
			Command="{Binding ShowRefreshCommand}" />
		<KeyBinding Key="F10"
			Command="{Binding ShowSettingCommand}" />
		<KeyBinding Key="F9"
			Command="{Binding ShowUpgradeCommand}" />
	</Window.InputBindings>

	<shell:WindowChrome.WindowChrome>
		<shell:WindowChrome CaptionHeight="120" CornerRadius="80" GlassFrameThickness="0" ResizeBorderThickness="8" UseAeroCaptionButtons="False" />
	</shell:WindowChrome.WindowChrome>

	<behaviors:Interaction.Triggers>
		<behaviors:EventTrigger EventName="ContentRendered">
			<behaviors:InvokeCommandAction Command="{Binding InitCommand}" />
		</behaviors:EventTrigger>
	</behaviors:Interaction.Triggers>

	<Border Padding="2"
		Background="{DynamicResource OuterWindowBackground}"
		CornerRadius="40">
		<Border Background="{DynamicResource CvnetMainBackgroundBrush}"
			BorderThickness="2" CornerRadius="40">
			<Border.BorderBrush>
				<LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
					<GradientStop Offset="0" Color="{DynamicResource winBorderColor1}" />
					<GradientStop Offset="0.6" Color="{DynamicResource winBorderColor2}" />
					<GradientStop Offset="1" Color="{DynamicResource winBorderColor3}" />
				</LinearGradientBrush>
			</Border.BorderBrush>
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="*" />
				</Grid.RowDefinitions>

				<Grid Grid.Row="0"
					Margin="24,16,24,8">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>

					<StackPanel Orientation="Vertical">
						<TextBlock Padding="20,0,0,0"
							FontSize="40" FontWeight="Bold"
							Foreground="{DynamicResource TitleColor}"
							Text="{Binding HeaderTitle}">
							<TextBlock.Effect>
								<DropShadowEffect BlurRadius="4" Direction="315" Opacity="1" ShadowDepth="3"
									Color="{DynamicResource MainMenuHeaderShadowColor}" />
							</TextBlock.Effect>
						</TextBlock>
						<TextBlock Padding="25,0,0,0"
							FontSize="14"
							Foreground="{DynamicResource SubTitleColor}"
							Opacity="0.6">
							<TextBlock.Text>
								<MultiBinding StringFormat="{}{0}{1}">
									<Binding Path="SubTitle" />
									<Binding Path="HolidayName" />
								</MultiBinding>
							</TextBlock.Text>
						</TextBlock>
					</StackPanel>

					<StackPanel Grid.Column="1"
						Margin="0,0,4,0" VerticalAlignment="Center"
						shell:WindowChrome.IsHitTestVisibleInChrome="True">
						<Border Width="44" Height="44"
							Style="{StaticResource StatusChip}"
							ToolTip="{Binding MoonPhaseToolTip}">
							<Viewbox Width="30" Height="30"
								HorizontalAlignment="Center" VerticalAlignment="Center"
								Stretch="Uniform">
								<Grid Width="24" Height="24">
									<Grid.Clip>
										<EllipseGeometry Center="12,12" RadiusX="12" RadiusY="12" />
									</Grid.Clip>
									<Ellipse Width="24" Height="24"
										Fill="#FFD51F" />
									<Ellipse Width="24" Height="24"
										Fill="#245C88">
										<Ellipse.RenderTransform>
											<TranslateTransform X="{Binding MoonShadowOffset}" />
										</Ellipse.RenderTransform>
									</Ellipse>
									<Ellipse Width="24" Height="24"
										Opacity="0.55" Stroke="#4B718C" StrokeThickness="0.8" />
								</Grid>
							</Viewbox>
						</Border>
						<TextBlock Margin="0,2,0,0" HorizontalAlignment="Center"
							d:Text="春分"
							Foreground="{DynamicResource plainTextColor0}"
							Text="{Binding SolarTerm}" />
					</StackPanel>

					<StackPanel Grid.Column="2"
						Margin="0" VerticalAlignment="Center"
						shell:WindowChrome.IsHitTestVisibleInChrome="True" Orientation="Horizontal">
						<Border Margin="0,0,4,0"
							Style="{StaticResource StatusChip}">
							<StackPanel Orientation="Vertical">
								<TextBlock Foreground="{DynamicResource SubTitleColor}"
									Style="{StaticResource MetricLabel}"
									Text="アクセス有効期限" />
								<!--  アクセス有効期限  -->
								<TextBlock HorizontalAlignment="Center"
									d:Text="2024/12/31 23:59:59"
									Foreground="{DynamicResource plainTextColor0}"
									Text="{Binding ExpireDate}" />
								<StackPanel Orientation="Horizontal">
									<Button Margin="0,0,8,0"
										Command="{Binding ToggleThemeCommand}"
										Style="{StaticResource MainMenuWindowButton}"
										ToolTip="テーマ切り替え (Light/Dark)">
										<Button.Content>
											<Grid>
												<Ellipse Width="20" Height="20"
													Fill="{DynamicResource MainMenuThemeTogglePreviewBrush}" />
												<Path Width="14" Height="14"
													HorizontalAlignment="Center" VerticalAlignment="Center"
													Data="M12,2L14,5H10L12,2M12,22L10,19H14L12,22M22,12L19,10V14L22,12M2,12L5,14V10L2,12M19.07,4.93L17,7.07L16.31,6.38L18.38,4.31L19.07,4.93M4.93,19.07L7.07,17L7.76,17.69L5.69,19.76L4.93,19.07M19.07,19.07L17,16.93L16.31,17.62L18.38,19.69L19.07,19.07M4.93,4.93L7.07,7.07L7.76,6.38L5.69,4.31L4.93,4.93M12,8A4,4 0 0,0 8,12A4,4 0 0,0 12,16A4,4 0 0,0 16,12A4,4 0 0,0 12,8Z"
													Fill="{DynamicResource TitleColor}"
													Stretch="Uniform" />
											</Grid>
										</Button.Content>
									</Button>

									<Button Command="{Binding WinMenuOnlyCommand}"
										Opacity="0.6"
										Style="{StaticResource MinimizeWinBtn}"
										ToolTip="メニューのみ表示">
										<materialDesign:PackIcon Width="24" Height="24"
											HorizontalAlignment="Center" VerticalAlignment="Center"
											Kind="WindowMinimize" />
									</Button>
									<Button Command="{Binding WinSmallCommand}"
										Opacity="0.6"
										Style="{StaticResource MenuonlyWinBtn}"
										ToolTip="小サイズ表示">
										<materialDesign:PackIcon Width="19" Height="20"
											HorizontalAlignment="Center" VerticalAlignment="Center"
											Kind="ViewList" />
									</Button>
									<Button Command="{Binding ExitCommand}"
										Opacity="0.6"
										Style="{StaticResource CloseWinBtn}"
										ToolTip="終了">
										<materialDesign:PackIcon Width="24" Height="24"
											HorizontalAlignment="Center" VerticalAlignment="Center"
											Kind="Close" />
									</Button>
								</StackPanel>
							</StackPanel>
						</Border>
						<Border HorizontalAlignment="Center"
							Style="{StaticResource StatusChip}">
							<StackPanel Orientation="Vertical">
								<TextBlock Width="100"
									HorizontalAlignment="Center"
									d:Text="99/12/31"
									Foreground="{DynamicResource SubTitleColor}"
									Style="{StaticResource MetricLabel}"
									Text="{Binding CurrentDate, FallbackValue='00/00/00'}" />

								<StackPanel HorizontalAlignment="Center"
									Orientation="Horizontal">
									<TextBlock HorizontalAlignment="Center"
										d:Text="Sun " FontSize="18" FontWeight="Bold"
										Foreground="{Binding CurrentTimeDayForeground}"
										Text="{Binding CurrentTimeDay, FallbackValue='Sun '}" />
									<TextBlock HorizontalAlignment="Center"
										d:Text="00:00:00" FontSize="18" FontWeight="Bold"
										Foreground="{DynamicResource TitleColor}"
										Text="{Binding CurrentTimeClock, FallbackValue='00:00:00'}" />
								</StackPanel>
								<TextBlock Margin="10,0,0,0"
									d:Text="旧暦xx月xx日" FontSize="12"
									Foreground="{DynamicResource TitleColor}"
									Opacity="0.8"
									Text="{Binding Kyureki}" />
							</StackPanel>
						</Border>
					</StackPanel>

				</Grid>

				<Grid Grid.Row="1"
					Margin="24">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="300" />
						<ColumnDefinition Width="20" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>

					<Border Grid.Column="0"
						Padding="10,4,4,4"
						Background="{DynamicResource panelColor}"
						CornerRadius="6">
						<TreeView x:Name="MenuTree"
							d:ItemsSource="{d:SampleData ItemCount=5}"
							Background="Transparent" BorderThickness="0"
							ItemContainerStyle="{StaticResource MenuTreeItemStyle}"
							ItemsSource="{Binding MenuItems}"
							PreviewKeyDown="MenuTree_PreviewKeyDown" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
							Style="{StaticResource MenuTreeView}">

							<TreeView.ItemTemplate>
								<HierarchicalDataTemplate DataType="{x:Type models:MenuData}"
									ItemsSource="{Binding SubItems}">
									<StackPanel>
										<TextBlock FontSize="15"
											Foreground="{DynamicResource plainTextColor0}"
											Text="{Binding Header}" />
										<!--
                                        <TextBlock Text="{Binding AddInfo}" FontSize="12" Opacity="0.65" Foreground="{DynamicResource plainTextColor0}"/>
										-->
									</StackPanel>
								</HierarchicalDataTemplate>
							</TreeView.ItemTemplate>

							<behaviors:Interaction.Triggers>
								<behaviors:EventTrigger EventName="MouseDoubleClick">
									<behaviors:InvokeCommandAction Command="{Binding DoMenuCommand}" />
								</behaviors:EventTrigger>
								<behaviors:EventTrigger EventName="SelectedItemChanged">
									<behaviors:InvokeCommandAction Command="{Binding SelectMenuCommand}"
										CommandParameter="{Binding SelectedItem, ElementName=MenuTree}" />
								</behaviors:EventTrigger>
							</behaviors:Interaction.Triggers>
						</TreeView>
					</Border>
					<Grid Grid.Column="2">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="2*" MinHeight="120" />
							<RowDefinition Height="*" MinHeight="160" />
							<RowDefinition Height="Auto" />
						</Grid.RowDefinitions>
						<Grid MaxHeight="180"
							ClipToBounds="True">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<Border Grid.Column="0"
								Margin="0,0,4,0" Padding="4,2,4,8"
								MaxHeight="180"
								ClipToBounds="True"
								Style="{StaticResource MainMenuDashboardCard}">
								<StackPanel>
									<TextBlock Margin="10,0,0,0"
										FontSize="14"
										Foreground="{DynamicResource MenuTitleColor}"
										Style="{StaticResource SectionTitleText}"
										Text="Server Status" />
									<TextBlock Margin="10,0,10,0"
										FontSize="14"
										Foreground="{DynamicResource plainTextColor0}"
										Text="{Binding ServerStatus}"
										TextWrapping="Wrap"
										ToolTip="{Binding ServerStatus}" />
								</StackPanel>
							</Border>
							<Border Grid.Column="1"
								Margin="4,0,0,0" Padding="4,2,4,8"
								MaxHeight="180"
								ClipToBounds="True"
								Style="{StaticResource MainMenuDashboardCard}">
								<StackPanel>
									<TextBlock Margin="10,0,0,0"
										FontSize="14"
										Foreground="{DynamicResource MenuTitleColor}"
										Style="{StaticResource SectionTitleText}"
										Text="Client Status" />
									<TextBlock Margin="10,0,10,0"
										FontSize="14"
										Foreground="{DynamicResource plainTextColor0}"
										Text="{Binding ClientStatus}"
										TextWrapping="Wrap"
										ToolTip="{Binding ClientStatus}" />
								</StackPanel>
							</Border>
						</Grid>
						<Border Grid.Row="1"
							Margin="0,10,0,0" Padding="8"
							Style="{StaticResource MainMenuDashboardCard}"
							ToolTip="{Binding FunctionToolTip}">
							<StackPanel>
								<StackPanel Orientation="Horizontal">
									<TextBlock FontSize="15"
										Foreground="{DynamicResource MenuTitleColor}"
										Style="{StaticResource SectionTitleText}"
										Text="選択中メニュー" />
									<TextBlock Margin="20,0,0,0"
										FontSize="14"
										Foreground="{DynamicResource plainTextColor0}"
										Opacity="0.6" Text="メニューをダブルクリックまたはEnterキーで画面が起動します。" TextWrapping="Wrap" />
								</StackPanel>
								<TextBlock x:Name="SelectedParent"
									Margin="0"
									Foreground="{DynamicResource plainTextColor0}"
									Opacity="0.8"
									Text="{Binding SelectedMenuParentHeader, FallbackValue=''}" />
								<TextBlock x:Name="SelectedHeader"
									FontSize="22" FontWeight="Bold"
									Foreground="{DynamicResource plainTextColor0}"
									Text="{Binding SelectedMenu.Header}" />
								<TextBlock Margin="0,4,0,0"
									Foreground="{DynamicResource plainTextColor0}"
									Opacity="0.8"
									Text="{Binding SelectedMenu.AddInfo}" />
								<TextBlock Margin="0,2,0,2"
									d:Text="マルチウィンドウ画面"
									Foreground="{DynamicResource plainTextColor0}"
									Opacity="0.7" TextWrapping="Wrap">
									<TextBlock.Style>
										<Style TargetType="TextBlock">
											<Setter Property="Text" Value="" />
											<Style.Triggers>
												<DataTrigger Binding="{Binding SelectedMenu.IsDialog}"
													Value="True">
													<Setter Property="Text" Value="ダイアログ画面" />
												</DataTrigger>
												<DataTrigger Binding="{Binding SelectedMenu.IsDialog}"
													Value="False">
													<Setter Property="Text" Value="マルチウィンドウ画面" />
												</DataTrigger>
											</Style.Triggers>
										</Style>
									</TextBlock.Style>
								</TextBlock>
							</StackPanel>
						</Border>
						<!--    -->
						<Grid x:Name="WeatherPanel"
							Grid.Row="2"
							MinHeight="40"
							Margin="0,10,0,0">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>

							<!--  天気アイコン＋気温  -->
							<materialDesign:Card Grid.Column="0"
								Margin="0,0,8,0" Padding="1"
								Background="{DynamicResource panelColor}">
								<StackPanel VerticalAlignment="Center"
									Orientation="Horizontal">
									<StackPanel.ToolTip>
										<ToolTip MaxWidth="560">
											<TextBlock Text="{Binding JmaWeatherOverviewToolTip}"
												TextWrapping="Wrap" />
										</ToolTip>
									</StackPanel.ToolTip>
									<materialDesign:PackIcon Width="90" Height="90"
										VerticalAlignment="Center"
										Foreground="{DynamicResource plainTextColor0}"
										Kind="{Binding WeatherIconKind}" />

									<StackPanel Margin="4,0,4,0" VerticalAlignment="Center"
										Opacity="0.8">
										<TextBlock FontSize="14"
											Foreground="{DynamicResource plainTextColor0}"
											Text="{Binding WeatherLocation, FallbackValue='Tokyo'}" />
										<TextBlock FontSize="30" FontWeight="Bold"
											Foreground="{DynamicResource plainTextColor0}"
											Text="{Binding WeatherTemperature, FallbackValue='--℃'}" />
										<TextBlock FontSize="12"
											Foreground="{DynamicResource plainTextColor0}"
											Opacity="0.7"
											Text="{Binding WeatherDescription, FallbackValue='取得中...'}" />
										<StackPanel Margin="1"
											Opacity="0.7" Orientation="Vertical">
											<TextBlock d:Text="日の出 06:00" FontSize="10"
												Foreground="{DynamicResource plainTextColor0}"
												Text="{Binding Sunrise}" />
											<TextBlock d:Text="日の入 18:00" FontSize="10"
												Foreground="{DynamicResource plainTextColor0}"
												Text="{Binding Sunset}" />
										</StackPanel>
										<StackPanel Margin="1"
											Opacity="0.7" Orientation="Vertical">
											<TextBlock d:Text="湿度 30%" FontSize="10"
												Foreground="{DynamicResource plainTextColor0}"
												Text="{Binding Humidity}" />
											<TextBlock d:Text="風速 10m/s" FontSize="10"
												Foreground="{DynamicResource plainTextColor0}"
												Text="{Binding WindSpeed}" />
										</StackPanel>
										<Button Height="20" MinWidth="0"
											Margin="0" Padding="0" HorizontalAlignment="Left"
											Command="{Binding OpenJmaWeatherOverviewSourceCommand}"
											Foreground="{DynamicResource plainTextColor0}"
											Opacity="0.8"
											Style="{StaticResource MaterialDesignFlatButton}"
											ToolTip="{Binding JmaWeatherOverviewSourceUrl}">
											<StackPanel Orientation="Horizontal">
												<TextBlock VerticalAlignment="Center"
													FontSize="10" Text="気象庁" />
												<materialDesign:PackIcon Width="11" Height="11"
													Margin="2,0,0,0" VerticalAlignment="Center"
													Kind="OpenInNew" />
											</StackPanel>
										</Button>

									</StackPanel>
								</StackPanel>
							</materialDesign:Card>

							<!--  気温推移チャート  -->
							<materialDesign:Card Grid.Column="1"
								Padding="4"
								Background="{DynamicResource panelColor}">
								<Grid>
									<!--  "℃" ラベル(ForecastYAxesを使うと横に寝てしまうため)  -->
									<TextBlock Margin="4,4,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Panel.ZIndex="1"
										FontSize="11"
										Foreground="{DynamicResource MainMenuChartTextColor}"
										Text="&#x0a;℃" />
									<!--  チャート  -->
									<lvc:CartesianChart MinHeight="130"
										Background="{DynamicResource MainMenuChartBackgroundBrush}"
										DrawMargin="{Binding ForecastMargin}"
										Opacity="0.9"
										Series="{Binding ForecastSeries}"
										XAxes="{Binding ForecastXAxes}"
										YAxes="{Binding ForecastYAxes}" />
								</Grid>
							</materialDesign:Card>
						</Grid>
						<Border Grid.Row="3"
							Margin="0,10,0,0" Padding="10"
							Style="{StaticResource MainMenuDashboardCard}">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="Auto" />
								</Grid.ColumnDefinitions>
								<StackPanel>
									<ScrollViewer Margin="0,0,0,8" HorizontalAlignment="Stretch"
										HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
										<StackPanel HorizontalAlignment="Left"
											Orientation="Horizontal">
											<Button Margin="4,0"
												Background="{DynamicResource PrimaryButtonColor}"
												Command="{Binding ShowUpgradeCommand}"
												Content="VersionUp(F9)" Opacity="0.8"
												Style="{StaticResource MainMenuActionButton}"
												ToolTip="システムアップデート" />
											<Button Margin="4,0"
												Background="{DynamicResource PrimaryButtonColor}"
												Command="{Binding ShowSettingCommand}"
												Content="環境設定(F10)" Opacity="0.8"
												Style="{StaticResource MainMenuActionButton}"
												ToolTip="環境設定" />
											<Button Margin="4,0"
												Background="{DynamicResource PrimaryButtonColor}"
												Command="{Binding ShowRefreshCommand}"
												Content="RefreshToken(F11)" Opacity="0.8"
												Style="{StaticResource MainMenuActionButton}"
												ToolTip="トークンリフレッシュ" />
											<Button Margin="4,0"
												Background="{DynamicResource PrimaryButtonColor}"
												Command="{Binding ShowLoginCommand}"
												Content="ログイン(F12)" Opacity="0.8"
												Style="{StaticResource MainMenuActionButton}"
												ToolTip="ログイン画面" />
											<Button Margin="4,0"
												Background="{DynamicResource PrimaryButtonColor}"
												Command="{Binding ToggleMainThemeCommand}"
												Content="{Binding MainThemeButtonLabel}"
												Opacity="0.8"
												Style="{StaticResource MainMenuActionButton}"
												ToolTip="メインメニュー配色切替" />
										</StackPanel>
									</ScrollViewer>
									<TextBlock FontSize="14"
										Foreground="{DynamicResource plainTextColor0}"
										Opacity="0.7"
										Text="{Binding StatusMessage}"
										TextWrapping="Wrap" />
								</StackPanel>
							</Grid>
						</Border>
					</Grid>
				</Grid>
			</Grid>
		</Border>
	</Border>
</Window>
