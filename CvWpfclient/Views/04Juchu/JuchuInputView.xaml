<helpers:BaseWindow x:Class="CvWpfclient.Views._04Juchu.JuchuInputView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:helpers="clr-namespace:CvWpfclient.Helpers"
	xmlns:local="clr-namespace:CvWpfclient.Views" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:vm="clr-namespace:CvWpfclient.ViewModels._04Juchu"
	Title="受注入力"
	Width="1400" Height="900"
	Background="{DynamicResource AppCommonBackgroundBrush}"
	Foreground="{DynamicResource MaterialDesignBody}"
	TextOptions.TextFormattingMode="Display"
	mc:Ignorable="d">
	<helpers:BaseWindow.DataContext>
		<vm:JuchuInputViewModel />
	</helpers:BaseWindow.DataContext>

	<helpers:BaseWindow.InputBindings>
		<KeyBinding Command="{Binding DoUpdateOnDetailTabCommand}"
			Gesture="F2" />
		<KeyBinding Command="{Binding DoDeleteOnDetailTabCommand}"
			Gesture="F3" />
		<KeyBinding Command="{Binding DoInsertOnDetailTabCommand}"
			Gesture="F4" />
		<KeyBinding Command="{Binding DoListOnListTabCommand}"
			Gesture="F5" />
	</helpers:BaseWindow.InputBindings>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<materialDesign:ColorZone Grid.Row="0"
			Padding="12,8"
			materialDesign:ElevationAssist.Elevation="Dp4" Mode="PrimaryMid">
			<StackPanel Orientation="Horizontal">
				<Button Margin="0,0,8,0"
					Command="{Binding ExitCommand}"
					Style="{StaticResource ToolCommandButton}"
					ToolTip="閉じる (Esc)">
					<materialDesign:PackIcon Kind="ArrowLeft" />
				</Button>
				<materialDesign:PackIcon Width="28" Height="28"
					VerticalAlignment="Center"
					Kind="ShoppingBasket" />
				<TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
					FontSize="20" FontWeight="SemiBold" Text="受注入力" />
			</StackPanel>
		</materialDesign:ColorZone>

		<TabControl x:Name="TabControlMain"
			Grid.Row="1"
			SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}"
			Style="{StaticResource MaterialDesignTabControl}">

			<TabItem x:Name="tabList"
				Height="0"
				d:Header="d:一覧" d:Height="40" Header="">
				<Grid Margin="12">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
					</Grid.RowDefinitions>

					<DockPanel Grid.Row="0"
						Margin="8,0,8,8">
						<StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
							<Button Command="{Binding DoListOnListTabCommand}"
								Style="{StaticResource MaterialDesignOutlinedButton}"
								ToolTip="一覧取得 (F5)">
								<StackPanel Orientation="Horizontal">
									<materialDesign:PackIcon VerticalAlignment="Center"
										Kind="DatabaseSearch" />
									<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
										Text="一覧取得" />
								</StackPanel>
							</Button>
							<Button Margin="8,0,0,0"
								Command="{Binding DoPrintListCommand}"
								Style="{StaticResource MaterialDesignOutlinedButton}"
								ToolTip="受注一覧を印刷">
								<StackPanel Orientation="Horizontal">
									<materialDesign:PackIcon VerticalAlignment="Center"
										Kind="Printer" />
									<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
										Text="一覧印刷" />
								</StackPanel>
							</Button>
							<Button Margin="8,0,0,0"
								Command="{Binding DoPrintDetailCommand}"
								Style="{StaticResource MaterialDesignOutlinedButton}"
								ToolTip="受注明細を印刷">
								<StackPanel Orientation="Horizontal">
									<materialDesign:PackIcon VerticalAlignment="Center"
										Kind="Printer" />
									<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
										Text="明細印刷" />
								</StackPanel>
							</Button>
						</StackPanel>
						<StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
							<materialDesign:PackIcon Margin="0,0,6,0" VerticalAlignment="Center"
								Kind="FormatListBulleted" />
							<TextBlock Margin="0,0,16,0" VerticalAlignment="Center"
								FontSize="16" FontWeight="SemiBold" Text="一覧" />
							<Button Command="{Binding GoToDetailCommand}"
								CommandParameter="{Binding Current}"
								Style="{StaticResource MaterialDesignOutlinedButton}"
								ToolTip="選択中の受注を表示">
								<StackPanel Orientation="Horizontal">
									<materialDesign:PackIcon VerticalAlignment="Center"
										Kind="FileDocumentEdit" />
									<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
										Text="受注詳細" />
								</StackPanel>
							</Button>
						</StackPanel>
					</DockPanel>

					<materialDesign:Card Grid.Row="1"
						Padding="0"
						materialDesign:ElevationAssist.Elevation="Dp2" UniformCornerRadius="8">
						<Grid>
							<Grid.RowDefinitions>
								<RowDefinition Height="Auto" />
								<RowDefinition Height="*" />
							</Grid.RowDefinitions>
							<Border Grid.Row="0"
								Padding="12,8"
								Background="{DynamicResource MaterialDesignToolBarBackground}"
								CornerRadius="8,8,0,0">
								<DockPanel>
									<TextBlock Margin="0,0,12,0" VerticalAlignment="Center"
										DockPanel.Dock="Right" FontSize="13"
										Foreground="{DynamicResource MaterialDesignBodyLight}"
										Text="{Binding Count, StringFormat={}件数: {0:N0}}" />
									<TextBlock VerticalAlignment="Center"
										FontSize="13"
										Foreground="{DynamicResource MaterialDesignBodyLight}"
										Text="{Binding Message}"
										TextTrimming="CharacterEllipsis" />
								</DockPanel>
							</Border>

							<DataGrid x:Name="ListGrid"
								Grid.Row="1"
								helpers:DataGridDoubleClick.Command="{Binding GoToDetailCommand}"
								helpers:DataGridSelectionBehavior.AutoScrollToSelectedItem="True" materialDesign:DataGridAssist.CellPadding="12,6" materialDesign:DataGridAssist.ColumnHeaderPadding="12,8"
								AutoGenerateColumns="False" EnableRowVirtualization="True" FrozenColumnCount="3" GridLinesVisibility="Horizontal"
								HorizontalGridLinesBrush="{DynamicResource MaterialDesignDivider}"
								IsReadOnly="True" IsSynchronizedWithCurrentItem="True"
								ItemsSource="{Binding ListData}"
								SelectedItem="{Binding Current, Mode=TwoWay}"
								Style="{StaticResource MaterialDesignDataGrid}"
								VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
								<DataGrid.Columns>
									<DataGridTextColumn Width="90"
										Binding="{Binding Id}"
										Header="受注No" />
									<DataGridTextColumn Width="120"
										Binding="{Binding DenDay, Converter={StaticResource DateYmd8Converter}, StringFormat=yyyy/MM/dd}"
										Header="受注日" />
									<DataGridTextColumn Width="80"
										Binding="{Binding EnKubun}"
										Header="区分" />
									<DataGridTextColumn Width="90"
										Binding="{Binding VTokui.Cd}"
										Header="得意先CD" />
									<DataGridTextColumn Width="180"
										Binding="{Binding VTokui.Mei}"
										Header="得意先名" />
									<DataGridTextColumn Width="90"
										Binding="{Binding VSoko.Cd}"
										Header="倉庫CD" />
									<DataGridTextColumn Width="160"
										Binding="{Binding VSoko.Mei}"
										Header="倉庫名" />
									<DataGridTextColumn Width="100"
										Binding="{Binding SuTotal, StringFormat={}{0:N0}}"
										ElementStyle="{StaticResource DataGridRightTextBlock}"
										Header="数量計" />
									<DataGridTextColumn Width="120"
										Binding="{Binding KingakuTotal, StringFormat={}{0:N0}}"
										ElementStyle="{StaticResource DataGridRightTextBlock}"
										Header="金額計" />
									<DataGridTextColumn Width="100"
										Binding="{Binding Tax, StringFormat={}{0:N0}}"
										ElementStyle="{StaticResource DataGridRightTextBlock}"
										Header="消費税" />
									<DataGridTextColumn Width="120"
										Binding="{Binding Total, StringFormat={}{0:N0}}"
										ElementStyle="{StaticResource DataGridRightTextBlock}"
										Header="総合計" />
								</DataGrid.Columns>
								<DataGrid.ColumnHeaderStyle>
									<Style BasedOn="{StaticResource MenteDataGridColumnHeader}"
										TargetType="DataGridColumnHeader" />
								</DataGrid.ColumnHeaderStyle>
							</DataGrid>
						</Grid>
					</materialDesign:Card>
				</Grid>
			</TabItem>

			<TabItem x:Name="tabDetail"
				Height="0"
				d:Header="d:詳細" d:Height="40" Header="">
				<Grid Margin="12">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
					</Grid.RowDefinitions>

					<DockPanel Grid.Row="0"
						Margin="8,0,8,8">
						<StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
							<Button Margin="4,0"
								Command="{Binding DoUpdateOnDetailTabCommand}"
								Style="{StaticResource MaterialDesignOutlinedButton}"
								ToolTip="修正 (F2)">
								<StackPanel Orientation="Horizontal">
									<materialDesign:PackIcon VerticalAlignment="Center"
										Kind="Pencil" />
									<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
										Text="修正" />
								</StackPanel>
							</Button>
							<Button Margin="4,0"
								Command="{Binding DoDeleteOnDetailTabCommand}"
								Style="{StaticResource MaterialDesignOutlinedButton}"
								ToolTip="削除 (F3)">
								<StackPanel Orientation="Horizontal">
									<materialDesign:PackIcon VerticalAlignment="Center"
										Kind="Delete" />
									<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
										Text="削除" />
								</StackPanel>
							</Button>
							<Button Margin="4,0"
								Command="{Binding DoInsertOnDetailTabCommand}"
								Style="{StaticResource MaterialDesignOutlinedButton}"
								ToolTip="追加 (F4)">
								<StackPanel Orientation="Horizontal">
									<materialDesign:PackIcon VerticalAlignment="Center"
										Kind="Plus" />
									<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
										Text="追加" />
								</StackPanel>
							</Button>
						</StackPanel>
						<StackPanel Orientation="Horizontal">
							<materialDesign:PackIcon Margin="0,0,6,0" VerticalAlignment="Center"
								Kind="FileDocumentEdit" />
							<TextBlock Margin="0,0,16,0" VerticalAlignment="Center"
								FontSize="16" FontWeight="SemiBold"
								Text="{Binding CurrentEdit.Id, StringFormat={}受注No:{0}}" />
							<Button Command="{Binding GoToListCommand}"
								Style="{StaticResource MaterialDesignOutlinedButton}"
								ToolTip="一覧へ戻る">
								<StackPanel Orientation="Horizontal">
									<materialDesign:PackIcon VerticalAlignment="Center"
										Kind="FormatListBulleted" />
									<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
										Text="一覧に戻る" />
								</StackPanel>
							</Button>
						</StackPanel>
					</DockPanel>

					<ScrollViewer Grid.Row="1"
						MaxHeight="270"
						Padding="10,10,20,18"
						VerticalScrollBarVisibility="Auto">
						<StackPanel>
							<WrapPanel Margin="0,4"
								Orientation="Horizontal">
								<StackPanel Margin="0,0,16,0"
									Orientation="Horizontal">
									<TextBlock Style="{StaticResource FormLabel}"
										Text="受注日" />
									<DatePicker Width="150"
										Margin="0,4"
										helpers:DatePickerTodayButtonBehavior.IsEnabled="True" materialDesign:HintAssist.Hint="受注日" FontSize="20" IsTodayHighlighted="False"
										SelectedDate="{Binding CurrentEdit.DenDay, Converter={StaticResource DateYmd8Converter}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
										Style="{StaticResource FormDatePicker}" />
								</StackPanel>
								<StackPanel Margin="0,0,16,0"
									Orientation="Horizontal">
									<TextBlock Style="{StaticResource FormLabel}"
										Text="区分" />
									<ComboBox Width="140"
										Margin="0,4"
										DisplayMemberPath="Name"
										ItemsSource="{Binding KubunOptions}"
										SelectedValue="{Binding CurrentEdit.EnKubun, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
										SelectedValuePath="Value"
										Style="{StaticResource FormComboBox}" />
								</StackPanel>
								<StackPanel Margin="0,0,16,0"
									Orientation="Horizontal">
									<TextBlock Style="{StaticResource FormLabel}"
										Text="関連No" />
									<TextBox Width="110"
										Margin="0,4" HorizontalContentAlignment="Right"
										Style="{StaticResource FormTextBox}"
										Text="{Binding CurrentEdit.RelateNo1, UpdateSourceTrigger=PropertyChanged}" />
								</StackPanel>
								<StackPanel Margin="0,0,16,0"
									Orientation="Horizontal">
									<TextBlock Style="{StaticResource FormLabel}"
										Text="掛率" />
									<TextBox Width="90"
										Margin="0,4" HorizontalContentAlignment="Right"
										Style="{StaticResource FormTextBox}"
										Text="{Binding CurrentEdit.Rate, UpdateSourceTrigger=PropertyChanged}" />
								</StackPanel>
								<StackPanel Margin="0,0,16,0"
									Orientation="Horizontal">
									<TextBlock Style="{StaticResource FormLabel}"
										Text="数量計" />
									<TextBox Width="110"
										Margin="0,4" HorizontalContentAlignment="Right"
										IsReadOnly="True"
										Style="{StaticResource FormTextBox}"
										Text="{Binding CurrentEdit.SuTotal, StringFormat={}{0:N0}}" />
								</StackPanel>
								<StackPanel Margin="0,0,16,0"
									Orientation="Horizontal">
									<TextBlock Style="{StaticResource FormLabel}"
										Text="金額計" />
									<TextBox Width="120"
										Margin="0,4" HorizontalContentAlignment="Right"
										IsReadOnly="True"
										Style="{StaticResource FormTextBox}"
										Text="{Binding CurrentEdit.KingakuTotal, StringFormat={}{0:N0}}" />
								</StackPanel>
								<StackPanel Margin="0,0,16,0"
									Orientation="Horizontal">
									<TextBlock Style="{StaticResource FormLabel}"
										Text="消費税" />
									<TextBox Width="110"
										Margin="0,4" HorizontalContentAlignment="Right"
										Style="{StaticResource FormTextBox}"
										Text="{Binding CurrentEdit.Tax, UpdateSourceTrigger=PropertyChanged}" />
								</StackPanel>
								<StackPanel Orientation="Horizontal">
									<TextBlock Style="{StaticResource FormLabel}"
										Text="総合計" />
									<TextBox Width="120"
										Margin="0,4" HorizontalContentAlignment="Right"
										IsReadOnly="True"
										Style="{StaticResource FormTextBox}"
										Text="{Binding CurrentEdit.Total, StringFormat={}{0:N0}}" />
								</StackPanel>
							</WrapPanel>

							<Grid Margin="0,4,0,0">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="110" />
									<ColumnDefinition Width="420" />
									<ColumnDefinition Width="120" />
									<ColumnDefinition Width="*" />
								</Grid.ColumnDefinitions>
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
								</Grid.RowDefinitions>

								<TextBlock Grid.Row="0"
									Style="{StaticResource FormLabel}"
									Text="得意先Id" />
								<DockPanel Grid.Row="0" Grid.Column="1"
									Margin="0,4">
									<TextBox Width="120" Height="36"
										HorizontalContentAlignment="Left"
										helpers:SearchTextBoxAssist.Command="{Binding DoSelectTokuiCommand}"
										BorderThickness="0,0,0,1" DockPanel.Dock="Left"
										Style="{StaticResource MenteSearchTextBox}"
										Text="{Binding CurrentEdit.Id_Tokui, UpdateSourceTrigger=PropertyChanged}" />
									<TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
										Foreground="{DynamicResource MaterialDesignBody}">
										<TextBlock.Text>
											<MultiBinding StringFormat="{}{0} {1}">
												<Binding Path="CurrentEdit.VTokui.Cd" />
												<Binding Path="CurrentEdit.VTokui.Mei" />
											</MultiBinding>
										</TextBlock.Text>
									</TextBlock>
								</DockPanel>

								<TextBlock Grid.Row="0" Grid.Column="2"
									Style="{StaticResource FormLabel}"
									Text="入力者Id" />
								<DockPanel Grid.Row="0" Grid.Column="3"
									Margin="0,4">
									<TextBox Width="120" Height="36"
										HorizontalContentAlignment="Left"
										helpers:SearchTextBoxAssist.Command="{Binding DoSelectShainCommand}"
										BorderThickness="0,0,0,1" DockPanel.Dock="Left"
										Style="{StaticResource MenteSearchTextBox}"
										Text="{Binding CurrentEdit.Id_Shain, UpdateSourceTrigger=PropertyChanged}" />
									<TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
										Foreground="{DynamicResource MaterialDesignBody}">
										<TextBlock.Text>
											<MultiBinding StringFormat="{}{0} {1}">
												<Binding Path="CurrentEdit.VShain.Cd" />
												<Binding Path="CurrentEdit.VShain.Mei" />
											</MultiBinding>
										</TextBlock.Text>
									</TextBlock>
								</DockPanel>

								<TextBlock Grid.Row="1"
									Style="{StaticResource FormLabel}"
									Text="倉庫Id" />
								<DockPanel Grid.Row="1" Grid.Column="1"
									Margin="0,4">
									<TextBox Width="120" Height="36"
										HorizontalContentAlignment="Left"
										helpers:SearchTextBoxAssist.Command="{Binding DoSelectSokoCommand}"
										BorderThickness="0,0,0,1" DockPanel.Dock="Left"
										Style="{StaticResource MenteSearchTextBox}"
										Text="{Binding CurrentEdit.Id_Soko, UpdateSourceTrigger=PropertyChanged}" />
									<TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
										Foreground="{DynamicResource MaterialDesignBody}">
										<TextBlock.Text>
											<MultiBinding StringFormat="{}{0} {1}">
												<Binding Path="CurrentEdit.VSoko.Cd" />
												<Binding Path="CurrentEdit.VSoko.Mei" />
											</MultiBinding>
										</TextBlock.Text>
									</TextBlock>
								</DockPanel>

								<TextBlock Grid.Row="2"
									InputMethod.IsInputMethodEnabled="True"
									Style="{StaticResource FormLabel}"
									Text="メモ" />
								<TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3"
									MinHeight="48"
									materialDesign:HintAssist.Hint="メモ" AcceptsReturn="True"
									Style="{StaticResource FormTextBox}"
									Text="{Binding CurrentEdit.Memo}"
									TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
							</Grid>
						</StackPanel>
					</ScrollViewer>

					<StackPanel Grid.Row="2"
						Margin="8,0,8,0" HorizontalAlignment="Center"
						Orientation="Horizontal">
						<Button Margin="8,0"
							Command="{Binding AddMeisaiCommand}"
							Style="{StaticResource MaterialDesignOutlinedButton}">
							<StackPanel Orientation="Horizontal">
								<materialDesign:PackIcon VerticalAlignment="Center"
									Kind="Plus" />
								<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
									Text="明細行追加" />
							</StackPanel>
						</Button>
						<Button Margin="8,0"
							Command="{Binding DeleteMeisaiCommand}"
							Style="{StaticResource MaterialDesignOutlinedButton}">
							<StackPanel Orientation="Horizontal">
								<materialDesign:PackIcon VerticalAlignment="Center"
									Kind="Delete" />
								<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
									Text="明細行削除" />
							</StackPanel>
						</Button>
						<Button Margin="40,0,10,0"
							Command="{Binding DoInputBarcodeCommand}"
							Style="{StaticResource MaterialDesignOutlinedButton}">
							<StackPanel Orientation="Horizontal">
								<materialDesign:PackIcon VerticalAlignment="Center"
									Kind="BarcodeScan" />
								<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
									Text="バーコード入力" />
							</StackPanel>
						</Button>
					</StackPanel>

					<DataGrid x:Name="MeisaiGrid"
						Grid.Row="3"
						Margin="0,8,0,0"
						d:ItemsSource="{d:SampleData ItemCount=5}"
						helpers:DataGridCellEnterNavigation.IsEnabled="True" helpers:DataGridSelectionBehavior.AutoScrollToSelectedItem="True" materialDesign:DataGridAssist.CellPadding="12,6"
						materialDesign:DataGridAssist.ColumnHeaderPadding="12,8" AlternatingRowBackground="Beige" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
						EnableRowVirtualization="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
						HorizontalGridLinesBrush="{DynamicResource MaterialDesignDivider}"
						IsSynchronizedWithCurrentItem="True"
						ItemsSource="{Binding EditMeisai}"
						SelectedItem="{Binding SelectedMeisai, Mode=TwoWay}"
						Style="{StaticResource MaterialDesignDataGrid}"
						VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
						<DataGrid.Columns>
							<DataGridTextColumn Width="58"
								Binding="{Binding No}"
								ElementStyle="{StaticResource DataGridRightTextBlock}"
								Header="行No" />
							<DataGridTemplateColumn Width="120"
								Header="商品Id">
								<DataGridTemplateColumn.CellTemplate>
									<DataTemplate>
										<Grid Margin="2,1">
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="*" />
												<ColumnDefinition Width="30" />
											</Grid.ColumnDefinitions>
											<TextBox Height="28"
												IsReadOnly="True"
												Text="{Binding Id_Shohin, UpdateSourceTrigger=PropertyChanged}" />
											<Button Grid.Column="1"
												Width="26" Height="26"
												Margin="2,0,0,0" Padding="0"
												Command="{Binding DataContext.DoSelectShohinCommand, RelativeSource={RelativeSource AncestorType=Window}}"
												CommandParameter="{Binding}">
												<materialDesign:PackIcon Width="16" Height="16"
													Kind="Magnify" />
											</Button>
										</Grid>
									</DataTemplate>
								</DataGridTemplateColumn.CellTemplate>
							</DataGridTemplateColumn>
							<DataGridTextColumn Width="100"
								Binding="{Binding Code_Shohin}"
								Header="商品CD"
								IsReadOnly="True" />
							<DataGridTextColumn Width="180"
								Binding="{Binding Mei_Shohin}"
								Header="商品名"
								IsReadOnly="True" />
							<DataGridTemplateColumn Width="110"
								Header="色Id">
								<DataGridTemplateColumn.CellTemplate>
									<DataTemplate>
										<Grid Margin="2,1">
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="*" />
												<ColumnDefinition Width="30" />
											</Grid.ColumnDefinitions>
											<TextBox Height="28"
												IsReadOnly="True"
												Text="{Binding Id_Col, UpdateSourceTrigger=PropertyChanged}" />
											<Button Grid.Column="1"
												Width="26" Height="26"
												Margin="2,0,0,0" Padding="0"
												Command="{Binding DataContext.DoSelectColCommand, RelativeSource={RelativeSource AncestorType=Window}}"
												CommandParameter="{Binding}">
												<materialDesign:PackIcon Width="16" Height="16"
													Kind="Magnify" />
											</Button>
										</Grid>
									</DataTemplate>
								</DataGridTemplateColumn.CellTemplate>
							</DataGridTemplateColumn>
							<DataGridTextColumn Width="90"
								Binding="{Binding Mei_Col}"
								Header="色"
								IsReadOnly="True" />
							<DataGridTemplateColumn Width="110"
								Header="サイズId">
								<DataGridTemplateColumn.CellTemplate>
									<DataTemplate>
										<Grid Margin="2,1">
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="*" />
												<ColumnDefinition Width="30" />
											</Grid.ColumnDefinitions>
											<TextBox Height="28"
												IsReadOnly="True"
												Text="{Binding Id_Siz, UpdateSourceTrigger=PropertyChanged}" />
											<Button Grid.Column="1"
												Width="26" Height="26"
												Margin="2,0,0,0" Padding="0"
												Command="{Binding DataContext.DoSelectSizCommand, RelativeSource={RelativeSource AncestorType=Window}}"
												CommandParameter="{Binding}">
												<materialDesign:PackIcon Width="16" Height="16"
													Kind="Magnify" />
											</Button>
										</Grid>
									</DataTemplate>
								</DataGridTemplateColumn.CellTemplate>
							</DataGridTemplateColumn>
							<DataGridTextColumn Width="90"
								Binding="{Binding Mei_Siz}"
								Header="サイズ"
								IsReadOnly="True" />
							<DataGridTextColumn Width="70"
								Binding="{Binding Su, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N0}}"
								EditingElementStyle="{StaticResource DataGridRightTextBox}"
								ElementStyle="{StaticResource DataGridRightTextBlock}"
								Header="数量" />
							<DataGridTextColumn Width="90"
								Binding="{Binding Tanka, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N0}}"
								EditingElementStyle="{StaticResource DataGridRightTextBox}"
								ElementStyle="{StaticResource DataGridRightTextBlock}"
								Header="単価" />
							<DataGridTextColumn Width="100"
								Binding="{Binding Kingaku, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N0}}"
								EditingElementStyle="{StaticResource DataGridRightTextBox}"
								ElementStyle="{StaticResource DataGridRightTextBlock}"
								Header="金額" />
							<DataGridTextColumn Width="90"
								Binding="{Binding Jodai, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N0}}"
								EditingElementStyle="{StaticResource DataGridRightTextBox}"
								ElementStyle="{StaticResource DataGridRightTextBlock}"
								Header="上代" />
							<DataGridTextColumn Width="90"
								Binding="{Binding Gedai, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N0}}"
								EditingElementStyle="{StaticResource DataGridRightTextBox}"
								ElementStyle="{StaticResource DataGridRightTextBlock}"
								Header="下代" />
							<DataGridTemplateColumn Width="120"
								Header="担当Id">
								<DataGridTemplateColumn.CellTemplate>
									<DataTemplate>
										<Grid Margin="2,1">
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="*" />
												<ColumnDefinition Width="30" />
											</Grid.ColumnDefinitions>
											<TextBox Height="28"
												IsReadOnly="True"
												Text="{Binding Id_Shain, UpdateSourceTrigger=PropertyChanged}" />
											<Button Grid.Column="1"
												Width="26" Height="26"
												Margin="2,0,0,0" Padding="0"
												Command="{Binding DataContext.DoSelectMeisaiShainCommand, RelativeSource={RelativeSource AncestorType=Window}}"
												CommandParameter="{Binding}">
												<materialDesign:PackIcon Width="16" Height="16"
													Kind="Magnify" />
											</Button>
										</Grid>
									</DataTemplate>
								</DataGridTemplateColumn.CellTemplate>
							</DataGridTemplateColumn>
							<DataGridTextColumn Width="130"
								Binding="{Binding Mei_Shain}"
								Header="担当"
								IsReadOnly="True" />
							<DataGridTextColumn Width="220"
								Binding="{Binding Memo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
								Header="明細メモ" />
						</DataGrid.Columns>
						<DataGrid.ColumnHeaderStyle>
							<Style BasedOn="{StaticResource MenteDataGridColumnHeader}"
								TargetType="DataGridColumnHeader" />
						</DataGrid.ColumnHeaderStyle>
					</DataGrid>
				</Grid>
			</TabItem>
		</TabControl>
	</Grid>
</helpers:BaseWindow>
