<helpers:BaseWindow x:Class="CvWpfclient.Views._03Hatchu.HachuHaibunInputView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:helpers="clr-namespace:CvWpfclient.Helpers" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:vm="clr-namespace:CvWpfclient.ViewModels._03Hatchu"
	Title="発注配分入力"
	Width="1400" Height="900"
	Background="{DynamicResource AppCommonBackgroundBrush}"
	Foreground="{DynamicResource MaterialDesignBody}"
	TextOptions.TextFormattingMode="Display"
	mc:Ignorable="d">
	<helpers:BaseWindow.DataContext>
		<vm:HachuHaibunInputViewModel />
	</helpers:BaseWindow.DataContext>

	<helpers:BaseWindow.Resources>
		<!--  クロス表の SKU 列ヘッダ。旧システムの固定ヘッダ（発注数／残／計）に対応する  -->
		<DataTemplate x:Key="SkuColumnHeaderTemplate">
			<!--  幅は列側(SkuColumnWidth)で決める。MinWidth を付けると内側幅を超えて数値が切れる  -->
			<StackPanel>
				<TextBlock HorizontalAlignment="Center"
					FontWeight="SemiBold"
					Text="{Binding Code_Col}"
					ToolTip="{Binding ColDisplay}" />
				<TextBlock HorizontalAlignment="Center"
					FontWeight="SemiBold"
					Text="{Binding Code_Siz}"
					ToolTip="{Binding SizDisplay}" />
				<Separator Margin="0,2"
					Opacity="0.4" />
				<TextBlock HorizontalAlignment="Right"
					FontSize="11"
					Text="{Binding HachuSu, StringFormat={}発注 {0:N0}}" />
				<TextBlock HorizontalAlignment="Right"
					FontSize="11"
					Text="{Binding NokoriSu, StringFormat={}残 {0:N0}}" />
				<TextBlock HorizontalAlignment="Right"
					FontSize="11" FontWeight="SemiBold"
					Text="{Binding HaibunTotalSu, StringFormat={}計 {0:N0}}" />
			</StackPanel>
		</DataTemplate>
	</helpers:BaseWindow.Resources>

	<helpers:BaseWindow.InputBindings>
		<KeyBinding Command="{Binding DoRegisterCommand}"
			Gesture="F2" />
		<KeyBinding Command="{Binding DoSearchCommand}"
			Gesture="F5" />
		<KeyBinding Command="{Binding GoToEditCommand}"
			Gesture="F6" />
		<KeyBinding Command="{Binding DoDeleteCommand}"
			Gesture="F7" />
		<KeyBinding Command="{Binding GoToSearchCommand}"
			Gesture="Shift+F1" />
		<KeyBinding Command="{Binding ClearAllCommand}"
			Gesture="Shift+F6" />
	</helpers:BaseWindow.InputBindings>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<!--  ===== ヘッダー: ColorZone ツールバー =====  -->
		<materialDesign:ColorZone Grid.Row="0"
			Padding="12,8"
			materialDesign:ElevationAssist.Elevation="Dp4" Mode="PrimaryMid">
			<StackPanel Orientation="Horizontal">
				<Button Margin="0,0,8,0"
					Command="{Binding ExitCommand}"
					Style="{StaticResource ToolCommandButton}"
					ToolTip="閉じる (Esc)">
					<materialDesign:PackIcon Kind="ArrowLeft" />
				</Button>
				<materialDesign:PackIcon Width="28" Height="28"
					VerticalAlignment="Center"
					Kind="CallSplit" />
				<TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
					FontSize="20" FontWeight="SemiBold" Text="発注配分入力" />
				<TextBlock Margin="24,0,0,0" VerticalAlignment="Center"
					FontSize="13" Opacity="0.85"
					Text="{Binding Message}" />
			</StackPanel>
		</materialDesign:ColorZone>

		<!--  ===== メインコンテンツ =====  -->
		<TabControl x:Name="TabControlMain"
			Grid.Row="1"
			SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}"
			Style="{StaticResource MaterialDesignTabControl}">

			<!--  ================= タブ1: 検索画面 =================  -->
			<TabItem x:Name="tabSearch"
				Height="0"
				d:Header="d:検索画面" d:Height="40" Header="">
				<Grid Margin="12">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
					</Grid.RowDefinitions>

					<!--  検索条件（旧システムに合わせて画面内に直接置く）  -->
					<materialDesign:Card Grid.Row="0"
						Margin="0,0,0,8" Padding="12,8"
						materialDesign:ElevationAssist.Elevation="Dp2" UniformCornerRadius="8">
						<Grid>
							<Grid.RowDefinitions>
								<RowDefinition Height="Auto" />
								<RowDefinition Height="Auto" />
							</Grid.RowDefinitions>

							<WrapPanel Grid.Row="0"
								Orientation="Horizontal">
								<StackPanel Margin="0,4,20,4"
									Orientation="Horizontal">
									<TextBlock Style="{StaticResource FormLabel}"
										Text="発注No" />
									<TextBox Width="90"
										HorizontalContentAlignment="Right"
										Style="{StaticResource FormTextBox}"
										Text="{Binding HachuNoFrom, UpdateSourceTrigger=PropertyChanged}" />
									<TextBlock Margin="6,0" VerticalAlignment="Center"
										Text="～" />
									<TextBox Width="90"
										HorizontalContentAlignment="Right"
										Style="{StaticResource FormTextBox}"
										Text="{Binding HachuNoTo, UpdateSourceTrigger=PropertyChanged}" />
								</StackPanel>
								<StackPanel Margin="0,4,20,4"
									Orientation="Horizontal">
									<TextBlock Style="{StaticResource FormLabel}"
										Text="発注日" />
									<DatePicker Width="140"
										helpers:DatePickerTodayButtonBehavior.IsEnabled="True"
										SelectedDate="{Binding HachuDayFrom, Mode=TwoWay}"
										Style="{StaticResource FormDatePicker}" />
									<TextBlock Margin="6,0" VerticalAlignment="Center"
										Text="～" />
									<DatePicker Width="140"
										helpers:DatePickerTodayButtonBehavior.IsEnabled="True"
										SelectedDate="{Binding HachuDayTo, Mode=TwoWay}"
										Style="{StaticResource FormDatePicker}" />
								</StackPanel>
								<StackPanel Margin="0,4,20,4"
									Orientation="Horizontal">
									<TextBlock Style="{StaticResource FormLabel}"
										Text="指示日" />
									<DatePicker Width="140"
										helpers:DatePickerTodayButtonBehavior.IsEnabled="True"
										SelectedDate="{Binding ShijiDayFrom, Mode=TwoWay}"
										Style="{StaticResource FormDatePicker}" />
									<TextBlock Margin="6,0" VerticalAlignment="Center"
										Text="～" />
									<DatePicker Width="140"
										helpers:DatePickerTodayButtonBehavior.IsEnabled="True"
										SelectedDate="{Binding ShijiDayTo, Mode=TwoWay}"
										Style="{StaticResource FormDatePicker}" />
								</StackPanel>
								<StackPanel Margin="0,4,20,4"
									Orientation="Horizontal">
									<TextBlock Style="{StaticResource FormLabel}"
										Text="納品日" />
									<DatePicker Width="140"
										helpers:DatePickerTodayButtonBehavior.IsEnabled="True"
										SelectedDate="{Binding NouhinDayFrom, Mode=TwoWay}"
										Style="{StaticResource FormDatePicker}" />
									<TextBlock Margin="6,0" VerticalAlignment="Center"
										Text="～" />
									<DatePicker Width="140"
										helpers:DatePickerTodayButtonBehavior.IsEnabled="True"
										SelectedDate="{Binding NouhinDayTo, Mode=TwoWay}"
										Style="{StaticResource FormDatePicker}" />
								</StackPanel>
							</WrapPanel>

							<WrapPanel Grid.Row="1"
								Orientation="Horizontal">
								<StackPanel Margin="0,4,20,4"
									Orientation="Horizontal">
									<TextBlock Style="{StaticResource FormLabel}"
										Text="仕入先" />
									<TextBox Width="200"
										helpers:SearchTextBoxAssist.Command="{Binding SelectCondShiireCommand}"
										IsReadOnly="True"
										Style="{StaticResource MenteSearchTextBox}"
										Text="{Binding CondShiireDisplay, Mode=OneWay}" />
								</StackPanel>
								<StackPanel Margin="0,4,20,4"
									Orientation="Horizontal">
									<TextBlock Style="{StaticResource FormLabel}"
										Text="入力者" />
									<TextBox Width="180"
										helpers:SearchTextBoxAssist.Command="{Binding SelectCondShainCommand}"
										IsReadOnly="True"
										Style="{StaticResource MenteSearchTextBox}"
										Text="{Binding CondShainDisplay, Mode=OneWay}" />
								</StackPanel>
								<StackPanel Margin="0,4,20,4"
									Orientation="Horizontal">
									<TextBlock Style="{StaticResource FormLabel}"
										Text="商品CD" />
									<TextBox Width="130"
										Style="{StaticResource FormTextBox}"
										Text="{Binding CondShohinCodeFrom, UpdateSourceTrigger=PropertyChanged}" />
									<TextBlock Margin="6,0" VerticalAlignment="Center"
										Text="～" />
									<TextBox Width="130"
										Style="{StaticResource FormTextBox}"
										Text="{Binding CondShohinCodeTo, UpdateSourceTrigger=PropertyChanged}" />
								</StackPanel>
								<StackPanel Margin="0,4,20,4"
									Orientation="Horizontal">
									<TextBlock Style="{StaticResource FormLabel}"
										Text="取引区分" />
									<ComboBox Width="120"
										DisplayMemberPath="Label"
										ItemsSource="{Binding KubunOptions}"
										SelectedValue="{Binding CondKubun, Mode=TwoWay}" SelectedValuePath="Value" />
								</StackPanel>
								<StackPanel Margin="0,4,20,4"
									Orientation="Horizontal">
									<TextBlock Style="{StaticResource FormLabel}"
										Text="配分状況" />
									<ComboBox Width="120"
										ItemsSource="{Binding HaibunJokyoOptions}"
										SelectedIndex="{Binding CondHaibunJokyo, Mode=TwoWay}" />
								</StackPanel>
								<StackPanel Margin="0,4,20,4"
									Orientation="Horizontal">
									<TextBlock Style="{StaticResource FormLabel}"
										Text="最大件数" />
									<TextBox Width="80"
										HorizontalContentAlignment="Right"
										Style="{StaticResource FormTextBox}"
										Text="{Binding CondMaxCount, UpdateSourceTrigger=PropertyChanged}" />
								</StackPanel>
								<StackPanel Margin="0,4"
									Orientation="Horizontal">
									<Button Margin="0,0,8,0"
										Command="{Binding DoSearchCommand}"
										Style="{StaticResource MaterialDesignRaisedButton}"
										ToolTip="条件で一覧を取得 (F5)">
										<StackPanel Orientation="Horizontal">
											<materialDesign:PackIcon VerticalAlignment="Center"
												Kind="DatabaseSearch" />
											<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
												Text="一覧取得" />
										</StackPanel>
									</Button>
									<Button Command="{Binding ClearConditionsCommand}"
										Style="{StaticResource MaterialDesignOutlinedButton}"
										ToolTip="検索条件を初期状態へ戻す">
										<TextBlock Text="条件クリア" />
									</Button>
								</StackPanel>
							</WrapPanel>
						</Grid>
					</materialDesign:Card>

					<!--  配分一覧カード  -->
					<materialDesign:Card Grid.Row="1"
						Padding="0"
						materialDesign:ElevationAssist.Elevation="Dp2" UniformCornerRadius="8">
						<Grid>
							<Grid.RowDefinitions>
								<RowDefinition Height="Auto" />
								<RowDefinition Height="*" />
							</Grid.RowDefinitions>

							<Border Grid.Row="0"
								Padding="12,8"
								Background="{DynamicResource MaterialDesignToolBarBackground}"
								CornerRadius="8,8,0,0">
								<DockPanel>
									<StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
										<Button Margin="4,0"
											Command="{Binding DoDeleteCommand}"
											Style="{StaticResource MaterialDesignOutlinedButton}"
											ToolTip="選択した発注の配分をまとめて削除 (F7)">
											<StackPanel Orientation="Horizontal">
												<materialDesign:PackIcon VerticalAlignment="Center"
													Kind="DeleteOutline" />
												<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
													Text="削除" />
											</StackPanel>
										</Button>
										<Button Margin="4,0"
											Command="{Binding GoToEditCommand}"
											Style="{StaticResource MaterialDesignRaisedButton}"
											ToolTip="選択した発注の配分入力へ (F6)">
											<StackPanel Orientation="Horizontal">
												<materialDesign:PackIcon VerticalAlignment="Center"
													Kind="FileDocumentEdit" />
												<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
													Text="配分入力へ" />
											</StackPanel>
										</Button>
									</StackPanel>
									<TextBlock VerticalAlignment="Center"
										FontSize="13"
										Foreground="{DynamicResource MaterialDesignBodyLight}"
										Text="{Binding SearchCount, StringFormat={}対象発注: {0:N0} 件}" />
								</DockPanel>
							</Border>

							<DataGrid x:Name="SearchGrid"
								Grid.Row="1"
								helpers:DataGridDoubleClick.Command="{Binding GoToEditCommand}"
								helpers:DataGridSelectionBehavior.AutoScrollToSelectedItem="True" materialDesign:DataGridAssist.CellPadding="12,6" materialDesign:DataGridAssist.ColumnHeaderPadding="12,8"
								AutoGenerateColumns="False" EnableRowVirtualization="True" FrozenColumnCount="1" GridLinesVisibility="Horizontal"
								HorizontalGridLinesBrush="{DynamicResource MaterialDesignDivider}"
								IsReadOnly="True" IsSynchronizedWithCurrentItem="True"
								ItemsSource="{Binding SearchRows}"
								SelectedItem="{Binding SelectedSearchRow, Mode=TwoWay}"
								SelectionMode="Single" SelectionUnit="FullRow"
								Style="{StaticResource MaterialDesignDataGrid}"
								VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
								<DataGrid.Columns>
									<DataGridTextColumn Width="90"
										Binding="{Binding Id, StringFormat={}{0:N0}}"
										ElementStyle="{StaticResource DataGridRightTextBlock}"
										Header="発注No" />
									<DataGridTextColumn Width="100"
										Binding="{Binding HachuDay}"
										Header="発注日" />
									<DataGridTextColumn Width="100"
										Binding="{Binding ShijiDay}"
										Header="指示日" />
									<DataGridTextColumn Width="100"
										Binding="{Binding NouhinDay}"
										Header="納品日" />
									<DataGridTextColumn Width="200"
										Binding="{Binding ShiireDisplay}"
										Header="仕入先" />
									<DataGridTextColumn Width="160"
										Binding="{Binding SokoDisplay}"
										Header="入荷倉庫" />
									<DataGridTextColumn Width="90"
										Binding="{Binding KubunDisplay}"
										Header="取引区分" />
									<DataGridTextColumn Width="80"
										Binding="{Binding JokyoDisplay}"
										Header="配分状況" />
									<DataGridTextColumn Width="80"
										Binding="{Binding HachuSu, StringFormat={}{0:N0}}"
										ElementStyle="{StaticResource DataGridRightTextBlock}"
										Header="発注数" />
									<DataGridTextColumn Width="80"
										Binding="{Binding HaibunSu, StringFormat={}{0:N0}}"
										ElementStyle="{StaticResource DataGridRightTextBlock}"
										Header="配分数" />
									<DataGridTextColumn Width="80"
										Binding="{Binding ZanSu, StringFormat={}{0:N0}}"
										ElementStyle="{StaticResource DataGridRightTextBlock}"
										Header="残" />
									<DataGridTextColumn Width="90"
										Binding="{Binding TenpoCount, StringFormat={}{0:N0}}"
										ElementStyle="{StaticResource DataGridRightTextBlock}"
										Header="配分先数" />
									<DataGridTextColumn Width="*"
										Binding="{Binding Memo}"
										Header="メモ" />
								</DataGrid.Columns>
								<DataGrid.ColumnHeaderStyle>
									<Style BasedOn="{StaticResource MenteDataGridColumnHeader}"
										TargetType="DataGridColumnHeader" />
								</DataGrid.ColumnHeaderStyle>
							</DataGrid>
						</Grid>
					</materialDesign:Card>
				</Grid>
			</TabItem>

			<!--  ================= タブ2: 修正・登録画面 =================  -->
			<TabItem x:Name="tabEdit"
				Height="0"
				d:Header="d:修正・登録画面" d:Height="40" Header="">
				<Grid Margin="12">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>

					<!--  操作ボタン  -->
					<DockPanel Grid.Row="0"
						Margin="0,0,0,8">
						<StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
							<Button Margin="4,0"
								Command="{Binding GoToSearchCommand}"
								Style="{StaticResource MaterialDesignOutlinedButton}"
								ToolTip="検索画面へ戻る (Shift+F1)">
								<StackPanel Orientation="Horizontal">
									<materialDesign:PackIcon VerticalAlignment="Center"
										Kind="Magnify" />
									<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
										Text="一覧へ" />
								</StackPanel>
							</Button>
							<Button Margin="4,0"
								Command="{Binding ClearAllCommand}"
								Style="{StaticResource MaterialDesignOutlinedButton}"
								ToolTip="入力した配分数をすべて0に戻す (Shift+F6)">
								<StackPanel Orientation="Horizontal">
									<materialDesign:PackIcon VerticalAlignment="Center"
										Kind="EraserVariant" />
									<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
										Text="全クリア" />
								</StackPanel>
							</Button>
							<Button Margin="4,0"
								Command="{Binding DoRegisterCommand}"
								Style="{StaticResource MaterialDesignRaisedButton}"
								ToolTip="配分を登録 (F2)">
								<StackPanel Orientation="Horizontal">
									<materialDesign:PackIcon VerticalAlignment="Center"
										Kind="ContentSaveOutline" />
									<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
										Text="登録" />
								</StackPanel>
							</Button>
						</StackPanel>
						<StackPanel Orientation="Horizontal">
							<materialDesign:PackIcon Margin="0,0,6,0" VerticalAlignment="Center"
								Kind="CallSplit" />
							<TextBlock VerticalAlignment="Center"
								FontSize="16" FontWeight="SemiBold"
								Text="{Binding HachuNo, StringFormat={}発注No {0:N0}}" />
							<TextBlock Margin="16,0,0,0" VerticalAlignment="Center"
								FontSize="13"
								Foreground="{DynamicResource MaterialDesignBodyLight}"
								Text="{Binding ShiireDisplay}" />
						</StackPanel>
					</DockPanel>

					<!--  配分情報カード  -->
					<materialDesign:Card Grid.Row="1"
						Margin="0,0,0,8" Padding="12,8"
						materialDesign:ElevationAssist.Elevation="Dp2" UniformCornerRadius="8">
						<WrapPanel Orientation="Horizontal">
							<StackPanel Margin="0,4,20,4"
								Orientation="Horizontal">
								<TextBlock Style="{StaticResource FormLabel}"
									Text="発注No" />
								<TextBox Width="110"
									helpers:SearchTextBoxAssist.Command="{Binding SelectHachuCommand}"
									HorizontalContentAlignment="Right"
									IsReadOnly="True"
									Style="{StaticResource MenteSearchTextBox}"
									Text="{Binding HachuNo, Mode=OneWay, StringFormat={}{0:N0}}"
									ToolTip="発注を選び直す" />
							</StackPanel>
							<StackPanel Margin="0,4,20,4"
								Orientation="Horizontal">
								<TextBlock Style="{StaticResource FormLabel}"
									Text="発注日" />
								<TextBox Width="100"
									IsReadOnly="True"
									Style="{StaticResource FormTextBox}"
									Text="{Binding HachuDayDisplay, Mode=OneWay}" />
							</StackPanel>
							<StackPanel Margin="0,4,20,4"
								Orientation="Horizontal">
								<TextBlock Style="{StaticResource FormLabel}"
									Text="入荷倉庫" />
								<TextBox Width="170"
									IsReadOnly="True"
									Style="{StaticResource FormTextBox}"
									Text="{Binding SokoDisplay, Mode=OneWay}" />
							</StackPanel>
							<StackPanel Margin="0,4,20,4"
								Orientation="Horizontal">
								<TextBlock Style="{StaticResource FormLabel}"
									Text="取引区分" />
								<TextBox Width="100"
									IsReadOnly="True"
									Style="{StaticResource FormTextBox}"
									Text="{Binding KubunDisplay, Mode=OneWay}" />
							</StackPanel>
							<StackPanel Margin="0,4,20,4"
								Orientation="Horizontal">
								<TextBlock Style="{StaticResource FormLabel}"
									Text="指示日" />
								<DatePicker Width="140"
									helpers:DatePickerTodayButtonBehavior.IsEnabled="True"
									SelectedDate="{Binding ShijiDay, Mode=TwoWay}"
									Style="{StaticResource FormDatePicker}" />
							</StackPanel>
							<StackPanel Margin="0,4,20,4"
								Orientation="Horizontal">
								<TextBlock Style="{StaticResource FormLabel}"
									Text="納品日" />
								<DatePicker Width="140"
									helpers:DatePickerTodayButtonBehavior.IsEnabled="True"
									SelectedDate="{Binding NouhinDay, Mode=TwoWay}"
									Style="{StaticResource FormDatePicker}" />
							</StackPanel>
							<StackPanel Margin="0,4,20,4"
								Orientation="Horizontal">
								<TextBlock Style="{StaticResource FormLabel}"
									Text="入力者" />
								<TextBox Width="170"
									helpers:SearchTextBoxAssist.Command="{Binding SelectShainCommand}"
									IsReadOnly="True"
									Style="{StaticResource MenteSearchTextBox}"
									Text="{Binding ShainDisplay, Mode=OneWay}" />
							</StackPanel>
							<StackPanel Margin="0,4,20,4"
								Orientation="Horizontal">
								<TextBlock Style="{StaticResource FormLabel}"
									Text="発注数" />
								<TextBox Width="80"
									HorizontalContentAlignment="Right"
									IsReadOnly="True"
									Style="{StaticResource FormTextBox}"
									Text="{Binding HachuTotalSu, Mode=OneWay, StringFormat={}{0:N0}}" />
							</StackPanel>
							<StackPanel Margin="0,4,20,4"
								Orientation="Horizontal">
								<TextBlock Style="{StaticResource FormLabel}"
									Text="総配分数" />
								<TextBox Width="80"
									HorizontalContentAlignment="Right"
									IsReadOnly="True"
									Style="{StaticResource FormTextBox}"
									Text="{Binding GrandTotalSu, Mode=OneWay, StringFormat={}{0:N0}}" />
							</StackPanel>
							<StackPanel Margin="0,4"
								Orientation="Horizontal">
								<TextBlock Style="{StaticResource FormLabel}"
									Text="備考" />
								<TextBox Width="260"
									Style="{StaticResource FormTextBox}"
									Text="{Binding Memo, UpdateSourceTrigger=PropertyChanged}" />
							</StackPanel>
						</WrapPanel>
					</materialDesign:Card>

					<!--  商品セレクタ（伝票内の商品を切り替えるとクロス表の列が入れ替わる）  -->
					<materialDesign:Card Grid.Row="2"
						Margin="0,0,0,8" Padding="0"
						materialDesign:ElevationAssist.Elevation="Dp2" UniformCornerRadius="8">
						<Grid>
							<Grid.RowDefinitions>
								<RowDefinition Height="Auto" />
								<RowDefinition Height="Auto" />
							</Grid.RowDefinitions>

							<Border Grid.Row="0"
								Padding="12,6"
								Background="{DynamicResource MaterialDesignToolBarBackground}"
								CornerRadius="8,8,0,0">
								<DockPanel>
									<StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
										<TextBlock Margin="0,0,8,0" VerticalAlignment="Center"
											Style="{StaticResource FormLabel}"
											Text="展開基準" />
										<RadioButton Margin="0,0,12,0" VerticalAlignment="Center"
											Content="色"
											GroupName="Tenkai"
											IsChecked="{Binding IsTenkaiByColor, Mode=TwoWay}"
											ToolTip="クロス表の列を色順に並べる" />
										<RadioButton VerticalAlignment="Center"
											Content="サイズ"
											GroupName="Tenkai"
											IsChecked="{Binding IsTenkaiByColor, Mode=OneWay, Converter={StaticResource InverseBooleanConverter}}"
											ToolTip="クロス表の列をサイズ順に並べる" />
									</StackPanel>
									<TextBlock VerticalAlignment="Center"
										FontSize="13" FontWeight="SemiBold" Text="発注明細（商品を選ぶと下の配分表が切り替わります）" />
								</DockPanel>
							</Border>

							<DataGrid x:Name="ShohinGrid"
								Grid.Row="1"
								helpers:DataGridSelectionBehavior.AutoScrollToSelectedItem="True" materialDesign:DataGridAssist.CellPadding="12,4" materialDesign:DataGridAssist.ColumnHeaderPadding="12,6"
								AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
								GridLinesVisibility="Horizontal"
								HorizontalGridLinesBrush="{DynamicResource MaterialDesignDivider}"
								IsReadOnly="True" MaxHeight="140"
								ItemsSource="{Binding ShohinRows}"
								SelectedItem="{Binding SelectedShohin, Mode=TwoWay}"
								SelectionMode="Single" SelectionUnit="FullRow"
								Style="{StaticResource MaterialDesignDataGrid}">
								<DataGrid.Columns>
									<DataGridTextColumn Width="150"
										Binding="{Binding Code}"
										Header="商品CD" />
									<DataGridTextColumn Width="220"
										Binding="{Binding Name}"
										Header="商品名" />
									<DataGridTextColumn Width="150"
										Binding="{Binding MakerHin}"
										Header="メーカー品番" />
									<DataGridTextColumn Width="90"
										Binding="{Binding TankaJodai, StringFormat={}{0:N0}}"
										ElementStyle="{StaticResource DataGridRightTextBlock}"
										Header="上代" />
									<DataGridTextColumn Width="90"
										Binding="{Binding TankaGenka, StringFormat={}{0:N0}}"
										ElementStyle="{StaticResource DataGridRightTextBlock}"
										Header="原価" />
									<DataGridTextColumn Width="80"
										Binding="{Binding HachuSu, StringFormat={}{0:N0}}"
										ElementStyle="{StaticResource DataGridRightTextBlock}"
										Header="発注数" />
									<DataGridTextColumn Width="80"
										Binding="{Binding HaibunSu, StringFormat={}{0:N0}}"
										ElementStyle="{StaticResource DataGridRightTextBlock}"
										Header="配分計" />
									<DataGridTextColumn Width="80"
										Binding="{Binding ZanSu, StringFormat={}{0:N0}}"
										ElementStyle="{StaticResource DataGridRightTextBlock}"
										Header="残" />
									<DataGridTextColumn Width="110"
										Binding="{Binding JodaiKingaku, StringFormat={}{0:N0}}"
										ElementStyle="{StaticResource DataGridRightTextBlock}"
										Header="上代金額" />
									<DataGridTextColumn Width="110"
										Binding="{Binding GenkaKingaku, StringFormat={}{0:N0}}"
										ElementStyle="{StaticResource DataGridRightTextBlock}"
										Header="原価金額" />
									<DataGridTextColumn Width="*"
										Header=" " />
								</DataGrid.Columns>
								<DataGrid.ColumnHeaderStyle>
									<Style BasedOn="{StaticResource MenteDataGridColumnHeader}"
										TargetType="DataGridColumnHeader" />
								</DataGrid.ColumnHeaderStyle>
							</DataGrid>
						</Grid>
					</materialDesign:Card>

					<!--  配分クロス表: 行=入庫先 / 列=色サイズ（列は xaml.cs で動的生成）  -->
					<materialDesign:Card Grid.Row="3"
						Padding="0"
						materialDesign:ElevationAssist.Elevation="Dp2" UniformCornerRadius="8">
						<DataGrid x:Name="HaibunGrid"
							helpers:DataGridCellEnterNavigation.IsEnabled="True" materialDesign:DataGridAssist.CellPadding="8,4" materialDesign:DataGridAssist.ColumnHeaderPadding="8,6"
							AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False"
							CurrentCellChanged="HaibunGrid_CurrentCellChanged" EnableRowVirtualization="True"
							FrozenColumnCount="4" GridLinesVisibility="All"
							HorizontalGridLinesBrush="{DynamicResource MaterialDesignDivider}"
							ItemsSource="{Binding TenpoRows}"
							SelectionUnit="Cell"
							Style="{StaticResource MaterialDesignDataGrid}"
							VerticalGridLinesBrush="{DynamicResource MaterialDesignDivider}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
							<DataGrid.Columns>
								<DataGridTextColumn Width="44"
									Binding="{Binding LineNo}"
									ElementStyle="{StaticResource DataGridRightTextBlock}"
									Header="行" IsReadOnly="True" />
								<DataGridTextColumn Width="90"
									Binding="{Binding TenpoCode}"
									Header="入庫先CD" IsReadOnly="True" />
								<DataGridTextColumn Width="180"
									Binding="{Binding TenpoName}"
									Header="入庫先名" IsReadOnly="True" />
								<DataGridTextColumn Width="70"
									Binding="{Binding TotalSu, StringFormat={}{0:N0}}"
									ElementStyle="{StaticResource DataGridRightTextBlock}"
									Header="合計" IsReadOnly="True" />
							</DataGrid.Columns>
							<DataGrid.ColumnHeaderStyle>
								<Style BasedOn="{StaticResource MenteDataGridColumnHeader}"
									TargetType="DataGridColumnHeader">
									<Setter Property="VerticalContentAlignment" Value="Bottom" />
								</Style>
							</DataGrid.ColumnHeaderStyle>
						</DataGrid>
					</materialDesign:Card>

					<!--  選択セルの色・サイズ（旧画面の下部表示に対応）  -->
					<Border Grid.Row="4"
						Margin="0,8,0,0" Padding="12,6"
						Background="{DynamicResource MaterialDesignToolBarBackground}"
						CornerRadius="8">
						<TextBlock VerticalAlignment="Center"
							FontSize="13"
							Text="{Binding SelectedCellInfo}" />
					</Border>
				</Grid>
			</TabItem>

		</TabControl>
	</Grid>
</helpers:BaseWindow>
