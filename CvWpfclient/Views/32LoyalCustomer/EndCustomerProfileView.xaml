<helpers:BaseWindow x:Class="CvWpfclient.Views._32LoyalCustomer.EndCustomerProfileView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:helpers="clr-namespace:CvWpfclient.Helpers" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:vm="clr-namespace:CvWpfclient.ViewModels._32LoyalCustomer"
	Title="顧客カルテ"
	Width="1244" Height="860" MinWidth="980" MinHeight="600"
	Background="{DynamicResource AppCommonBackgroundBrush}"
	FontSize="16"
	Foreground="{DynamicResource MaterialDesignBody}"
	TextOptions.TextFormattingMode="Display" WindowStartupLocation="CenterScreen"
	mc:Ignorable="d">
	<helpers:BaseWindow.DataContext>
		<vm:EndCustomerProfileViewModel />
	</helpers:BaseWindow.DataContext>
	<helpers:BaseWindow.InputBindings>
		<KeyBinding Command="{Binding DoSearchCommand}"
			Gesture="F5" />
	</helpers:BaseWindow.InputBindings>
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>
		<materialDesign:ColorZone Grid.Row="0"
			Padding="12,8"
			materialDesign:ElevationAssist.Elevation="Dp4" Mode="PrimaryMid">
			<DockPanel>
				<StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
					<Button Margin="4,0,0,0"
						Command="{Binding ExitCommand}"
						Style="{StaticResource ToolCommandButton}"
						ToolTip="閉じる (Esc)">
						<StackPanel Orientation="Horizontal">
							<materialDesign:PackIcon VerticalAlignment="Center"
								Kind="ExitToApp" />
							<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
								Text="閉じる" />
						</StackPanel>
					</Button>
				</StackPanel>
				<StackPanel Orientation="Horizontal">
					<materialDesign:PackIcon Width="28" Height="28"
						VerticalAlignment="Center"
						Kind="CardAccountDetailsOutline" />
					<TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
						FontSize="20" FontWeight="SemiBold" Text="顧客カルテ" />
					<Rectangle Width="1"
						Margin="16,4"
						Fill="{DynamicResource PrimaryHueMidForegroundBrush}"
						Opacity="0.3" />
					<Button Command="{Binding DoSearchCommand}"
						Style="{StaticResource ToolCommandButton}"
						ToolTip="検索 (F5)">
						<StackPanel Orientation="Horizontal">
							<materialDesign:PackIcon VerticalAlignment="Center"
								Kind="DatabaseSearch" />
							<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
								Text="検索" />
						</StackPanel>
					</Button>
				</StackPanel>
			</DockPanel>
		</materialDesign:ColorZone>
		<Grid Grid.Row="1"
			Margin="12">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="40*" MinWidth="360" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="60*" MinWidth="480" />
			</Grid.ColumnDefinitions>
			<!--  左: 顧客検索条件・顧客一覧（条件変更で旧結果を外す）  -->
			<materialDesign:Card Grid.Column="0"
				Padding="0"
				materialDesign:ElevationAssist.Elevation="Dp2" UniformCornerRadius="8">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
					</Grid.RowDefinitions>
					<Border Grid.Row="0"
						Padding="12,4"
						Background="{DynamicResource MaterialDesignToolBarBackground}"
						CornerRadius="8,8,0,0">
						<Grid IsEnabled="{Binding IsIdle}">
							<Grid.InputBindings>
								<KeyBinding Command="{Binding DoSearchCommand}"
									Key="Return" />
							</Grid.InputBindings>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="8" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<Grid.RowDefinitions>
								<RowDefinition Height="Auto" />
								<RowDefinition Height="Auto" />
								<RowDefinition Height="Auto" />
								<RowDefinition Height="Auto" />
							</Grid.RowDefinitions>
							<TextBox Grid.Row="0" Grid.Column="0"
								Margin="0,4"
								materialDesign:HintAssist.Hint="顧客コード" materialDesign:TextFieldAssist.CharacterCounterVisibility="Collapsed" MaxLength="12"
								Style="{StaticResource FormTextBox}"
								Text="{Binding SearchCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
								ToolTip="前方一致。Enter で検索" />
							<TextBox Grid.Row="0" Grid.Column="2"
								Margin="0,4"
								materialDesign:HintAssist.Hint="電話番号" materialDesign:TextFieldAssist.CharacterCounterVisibility="Collapsed" MaxLength="20"
								Style="{StaticResource FormTextBox}"
								Text="{Binding SearchTel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
								ToolTip="部分一致（ハイフンも含めて入力）。Enter で検索" />
							<TextBox Grid.Row="1" Grid.Column="0"
								Margin="0,4"
								materialDesign:HintAssist.Hint="氏名" materialDesign:TextFieldAssist.CharacterCounterVisibility="Collapsed" MaxLength="80"
								Style="{StaticResource FormTextBox}"
								Text="{Binding SearchName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
								ToolTip="部分一致。Enter で検索" />
							<TextBox Grid.Row="1" Grid.Column="2"
								Margin="0,4"
								materialDesign:HintAssist.Hint="カナ" materialDesign:TextFieldAssist.CharacterCounterVisibility="Collapsed" MaxLength="100"
								Style="{StaticResource FormTextBox}"
								Text="{Binding SearchKana, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
								ToolTip="部分一致。Enter で検索" />
							<!--  所属店舗（コード入力または選択）  -->
							<Grid Grid.Row="2" Grid.ColumnSpan="3">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="120" />
									<ColumnDefinition Width="Auto" />
									<ColumnDefinition Width="*" />
								</Grid.ColumnDefinitions>
								<TextBox Grid.Column="0"
									Margin="0,4"
									materialDesign:HintAssist.Hint="所属店舗" materialDesign:TextFieldAssist.CharacterCounterVisibility="Collapsed" MaxLength="12"
									Style="{StaticResource FormTextBox}"
									Text="{Binding SearchTenpoCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
								<Button Grid.Column="1"
									Margin="4,0,8,0"
									Command="{Binding SelectSearchTenpoCommand}"
									Style="{StaticResource ToolCommandButton}"
									ToolTip="店舗を選択">
									<materialDesign:PackIcon Kind="StoreSearchOutline" />
								</Button>
								<TextBlock Grid.Column="2"
									Style="{StaticResource SelectionResultText}"
									Text="{Binding SearchTenpoName}"
									ToolTip="{Binding SearchTenpoName}" />
							</Grid>
							<DockPanel Grid.Row="3" Grid.ColumnSpan="3">
								<Button Height="36"
									Margin="8,4,0,4"
									Command="{Binding DoSearchCommand}"
									DockPanel.Dock="Right"
									Style="{StaticResource MaterialDesignOutlinedButton}"
									ToolTip="検索 (F5 / Enter)">
									<StackPanel Orientation="Horizontal">
										<materialDesign:PackIcon VerticalAlignment="Center"
											Kind="Magnify" />
										<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
											Text="検索" />
									</StackPanel>
								</Button>
								<CheckBox VerticalAlignment="Center"
									Content="退会者を含む"
									IsChecked="{Binding IncludeWithdrawn, Mode=TwoWay}"
									ToolTip="退会した会員も一覧に表示する" />
							</DockPanel>
						</Grid>
					</Border>
					<DockPanel Grid.Row="1"
						Margin="12,6">
						<TextBlock VerticalAlignment="Center"
							DockPanel.Dock="Right" FontSize="13"
							Foreground="{DynamicResource MaterialDesignBodyLight}"
							Text="{Binding CustomerCount, StringFormat={}件数: {0:N0}}" />
						<TextBlock Margin="0,0,8,0" VerticalAlignment="Center"
							FontSize="13"
							Foreground="{DynamicResource MaterialDesignBodyLight}"
							Text="{Binding Message}"
							TextTrimming="CharacterEllipsis"
							ToolTip="{Binding Message}" />
					</DockPanel>
					<DataGrid Grid.Row="2"
						materialDesign:DataGridAssist.CellPadding="10,6" materialDesign:DataGridAssist.ColumnHeaderPadding="10,8" AutoGenerateColumns="False" CanUserAddRows="False"
						CanUserDeleteRows="False" EnableRowVirtualization="True" FontSize="14" FrozenColumnCount="1" GridLinesVisibility="Horizontal"
						HorizontalGridLinesBrush="{DynamicResource MaterialDesignDivider}"
						HorizontalScrollBarVisibility="Auto"
						IsEnabled="{Binding IsIdle}"
						IsReadOnly="True"
						ItemsSource="{Binding Customers}"
						SelectedItem="{Binding SelectedCustomer, Mode=TwoWay}"
						SelectionMode="Single"
						Style="{StaticResource MaterialDesignDataGrid}"
						VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
						<DataGrid.Columns>
							<DataGridTextColumn Width="100"
								Binding="{Binding Customer.Code}"
								Header="コード" />
							<DataGridTextColumn Width="170"
								Binding="{Binding Customer.Name}"
								Header="氏名" />
							<DataGridTextColumn Width="200"
								Binding="{Binding Customer.Kana}"
								Header="カナ" />
							<DataGridTextColumn Width="130"
								Binding="{Binding Customer.Tel}"
								Header="電話" />
							<DataGridTextColumn Width="150"
								Binding="{Binding TenpoText}"
								Header="所属店舗" />
							<DataGridTextColumn Width="130"
								Binding="{Binding WithdrawnText}"
								Header="退会" />
						</DataGrid.Columns>
						<DataGrid.ColumnHeaderStyle>
							<Style BasedOn="{StaticResource MenteDataGridColumnHeader}"
								TargetType="DataGridColumnHeader" />
						</DataGrid.ColumnHeaderStyle>
					</DataGrid>
				</Grid>
			</materialDesign:Card>
			<GridSplitter Grid.Column="1"
				Width="6"
				Margin="3,0" HorizontalAlignment="Center" VerticalAlignment="Stretch"
				Background="Transparent" />
			<!--  右: 顧客情報・残高・ポイント履歴（照会専用）  -->
			<materialDesign:Card Grid.Column="2"
				Padding="0"
				materialDesign:ElevationAssist.Elevation="Dp2" UniformCornerRadius="8">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
					</Grid.RowDefinitions>
					<Border Grid.Row="0"
						Padding="12,8"
						Background="{DynamicResource MaterialDesignToolBarBackground}"
						CornerRadius="8,8,0,0">
						<StackPanel>
							<TextBlock FontSize="18" FontWeight="SemiBold"
								Foreground="{DynamicResource PrimaryHueMidBrush}"
								Text="{Binding CustomerTitle}"
								TextTrimming="CharacterEllipsis"
								ToolTip="{Binding CustomerTitle}" />
							<TextBlock Margin="0,4,0,0"
								FontSize="14"
								Text="{Binding CustomerInfo}"
								TextWrapping="Wrap" />
							<TextBlock Margin="0,4,0,0"
								FontWeight="SemiBold"
								Text="{Binding BalanceText}"
								TextWrapping="Wrap">
								<TextBlock.Style>
									<Style TargetType="TextBlock">
										<Setter Property="Foreground" Value="{DynamicResource PrimaryHueMidBrush}" />
										<Style.Triggers>
											<DataTrigger Binding="{Binding IsBalanceMismatch}" Value="True">
												<Setter Property="Foreground" Value="{DynamicResource MaterialDesignValidationErrorBrush}" />
											</DataTrigger>
										</Style.Triggers>
									</Style>
								</TextBlock.Style>
							</TextBlock>
						</StackPanel>
					</Border>
					<!--  表示の絞込み（取得済みの全履歴に対して行う）  -->
					<Grid Grid.Row="1"
						Margin="12,4"
						IsEnabled="{Binding HasCustomer}">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" MaxWidth="170" />
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="*" MaxWidth="170" />
							<ColumnDefinition Width="*" MaxWidth="160" />
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>
						<DatePicker Grid.Column="0"
							Margin="0,4"
							helpers:DatePickerTodayButtonBehavior.IsEnabled="True" materialDesign:HintAssist.Hint="計上日 開始" IsTodayHighlighted="False"
							SelectedDate="{Binding FilterDayFrom, Converter={StaticResource DateYmd8Converter}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
							Style="{StaticResource FormDatePicker}" />
						<TextBlock Grid.Column="1"
							Margin="8,0" VerticalAlignment="Center"
							Text="～" />
						<DatePicker Grid.Column="2"
							Margin="0,4"
							helpers:DatePickerTodayButtonBehavior.IsEnabled="True" materialDesign:HintAssist.Hint="計上日 終了" IsTodayHighlighted="False"
							SelectedDate="{Binding FilterDayTo, Converter={StaticResource DateYmd8Converter}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
							Style="{StaticResource FormDatePicker}" />
						<ComboBox Grid.Column="3"
							Margin="12,4,0,4"
							materialDesign:HintAssist.Hint="種別" DisplayMemberPath="Value"
							ItemsSource="{Binding FilterTypeOptions}"
							SelectedValue="{Binding FilterType, Mode=TwoWay}"
							SelectedValuePath="Key"
							Style="{StaticResource FormComboBox}" />
						<Button Grid.Column="4"
							Margin="8,0,0,0"
							Command="{Binding ClearFilterCommand}"
							Style="{StaticResource ToolCommandButton}"
							ToolTip="期間・種別の絞込みを解除">
							<materialDesign:PackIcon Kind="FilterRemoveOutline" />
						</Button>
					</Grid>
					<DockPanel Grid.Row="2"
						Margin="12,2,12,6">
						<TextBlock VerticalAlignment="Center"
							DockPanel.Dock="Right" FontSize="13"
							Foreground="{DynamicResource MaterialDesignBodyLight}"
							Text="{Binding HistoryCountText}" />
						<TextBlock Margin="0,0,8,0" VerticalAlignment="Center"
							FontSize="13"
							Foreground="{DynamicResource MaterialDesignBodyLight}"
							Text="{Binding DetailMessage}"
							TextTrimming="CharacterEllipsis"
							ToolTip="{Binding DetailMessage}" />
					</DockPanel>
					<DataGrid Grid.Row="3"
						materialDesign:DataGridAssist.CellPadding="10,6" materialDesign:DataGridAssist.ColumnHeaderPadding="10,8" AutoGenerateColumns="False" CanUserAddRows="False"
						CanUserDeleteRows="False" CanUserSortColumns="False" EnableRowVirtualization="True" FontSize="14" FrozenColumnCount="1"
						GridLinesVisibility="Horizontal"
						HorizontalGridLinesBrush="{DynamicResource MaterialDesignDivider}"
						HorizontalScrollBarVisibility="Auto" IsReadOnly="True"
						ItemsSource="{Binding History}"
						SelectionMode="Single"
						Style="{StaticResource MaterialDesignDataGrid}"
						VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
						<DataGrid.Columns>
							<DataGridTextColumn Width="105"
								Binding="{Binding DayText}"
								Header="計上日" />
							<DataGridTextColumn Width="90"
								Binding="{Binding Ledger.TypeName}"
								Header="種別" />
							<DataGridTextColumn Width="90"
								Binding="{Binding Ledger.PointText}"
								ElementStyle="{StaticResource DataGridRightTextBlock}"
								Header="増減" />
							<DataGridTextColumn Width="100"
								Binding="{Binding BalanceText}"
								ElementStyle="{StaticResource DataGridRightTextBlock}"
								Header="累計残高" />
							<DataGridTextColumn Width="80"
								Binding="{Binding Ledger.GrantPointText}"
								ElementStyle="{StaticResource DataGridRightTextBlock}"
								Header="付与" />
							<DataGridTextColumn Width="80"
								Binding="{Binding Ledger.UsePointText}"
								ElementStyle="{StaticResource DataGridRightTextBlock}"
								Header="使用" />
							<DataGridTextColumn Width="80"
								Binding="{Binding Ledger.ExpirePointText}"
								ElementStyle="{StaticResource DataGridRightTextBlock}"
								Header="失効" />
							<DataGridTextColumn Width="150"
								Binding="{Binding TenpoText}"
								Header="店舗" />
							<DataGridTextColumn Width="115"
								Binding="{Binding TenuriText}"
								ElementStyle="{StaticResource DataGridRightTextBlock}"
								Header="売上伝票Id" />
							<DataGridTextColumn Width="70"
								Binding="{Binding Ledger.CancelledText}"
								Header="取消" />
							<DataGridTextColumn Width="90"
								Binding="{Binding OriginalText}"
								ElementStyle="{StaticResource DataGridRightTextBlock}"
								Header="取消元Id" />
							<DataGridTextColumn Width="220"
								Binding="{Binding Ledger.Event.Memo}"
								Header="摘要" />
							<DataGridTextColumn Width="80"
								Binding="{Binding Ledger.Event.Id}"
								ElementStyle="{StaticResource DataGridRightTextBlock}"
								Header="Id" />
						</DataGrid.Columns>
						<DataGrid.ColumnHeaderStyle>
							<Style BasedOn="{StaticResource MenteDataGridColumnHeader}"
								TargetType="DataGridColumnHeader" />
						</DataGrid.ColumnHeaderStyle>
					</DataGrid>
				</Grid>
			</materialDesign:Card>
		</Grid>
	</Grid>
</helpers:BaseWindow>
