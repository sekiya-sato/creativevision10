<helpers:BaseWindow x:Class="CvWpfclient.Views._32LoyalCustomer.PointMasterBonusView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:helpers="clr-namespace:CvWpfclient.Helpers" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
	xmlns:vm="clr-namespace:CvWpfclient.ViewModels._32LoyalCustomer"
	Title="{Binding Title}" Width="1244" Height="860" MinWidth="900" MinHeight="600"
	Background="{DynamicResource AppCommonBackgroundBrush}" Foreground="{DynamicResource MaterialDesignBody}"
	FontSize="16" TextOptions.TextFormattingMode="Display" WindowStartupLocation="CenterScreen">
	<helpers:BaseWindow.DataContext><vm:PointMasterBonusViewModel /></helpers:BaseWindow.DataContext>
	<helpers:BaseWindow.InputBindings>
		<KeyBinding Command="{Binding DoUpdateCommand}" Gesture="F2" />
		<KeyBinding Command="{Binding DoDeleteCommand}" Gesture="F3" />
		<KeyBinding Command="{Binding DoInsertCommand}" Gesture="F4" />
		<KeyBinding Command="{Binding DoListCommand}" Gesture="F5" />
	</helpers:BaseWindow.InputBindings>
	<Grid>
		<Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
		<materialDesign:ColorZone Padding="12,8" Mode="PrimaryMid" materialDesign:ElevationAssist.Elevation="Dp4">
			<DockPanel>
				<StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
					<Button Margin="4,0" Command="{Binding DoUpdateCommand}" Content="修正(F2)" Style="{StaticResource ToolCommandButton}" />
					<Button Margin="4,0" Command="{Binding DoDeleteCommand}" Content="削除(F3)" Style="{StaticResource ToolCommandButton}" />
					<Button Margin="4,0" Command="{Binding DoInsertCommand}" Content="追加(F4)" Style="{StaticResource ToolCommandButton}" />
				</StackPanel>
				<StackPanel Orientation="Horizontal">
					<Button Margin="0,0,12,0" Command="{Binding ExitCommand}" Content="閉じる" Style="{StaticResource ToolCommandButton}" />
					<TextBlock VerticalAlignment="Center" Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" />
					<Button Margin="12,0,0,0" Command="{Binding DoListCommand}" Content="一覧(F5)" Style="{StaticResource ToolCommandButton}" />
				</StackPanel>
			</DockPanel>
		</materialDesign:ColorZone>
		<Grid Grid.Row="1" Margin="12">
			<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="480" /></Grid.ColumnDefinitions>
			<materialDesign:Card UniformCornerRadius="8" materialDesign:ElevationAssist.Elevation="Dp2">
				<DataGrid ItemsSource="{Binding ListData}" SelectedItem="{Binding Current}" IsReadOnly="True"
					AutoGenerateColumns="False" EnableRowVirtualization="True" IsSynchronizedWithCurrentItem="True" SelectionMode="Single"
					helpers:DataGridSelectionBehavior.AutoScrollToSelectedItem="True" Style="{StaticResource MaterialDesignDataGrid}">
					<DataGrid.ColumnHeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MenteDataGridColumnHeader}" /></DataGrid.ColumnHeaderStyle>
					<DataGrid.Columns>
						<DataGridTextColumn Header="Id" Width="65" Binding="{Binding Id}" />
						<DataGridTextColumn Header="コード" Width="100" Binding="{Binding Code}" />
						<DataGridTextColumn Header="名称" Width="180" Binding="{Binding Name}" />
						<DataGridTextColumn Header="版" Width="65" Binding="{Binding Version}" />
						<DataGridTextColumn Header="親ベースId" Width="100" Binding="{Binding Id_PointBase}" />
						<DataGridTextColumn Header="開始日" Width="110" Binding="{Binding DayFrom, Converter={StaticResource DateYmd8Converter}, StringFormat=yyyy/MM/dd}" />
						<DataGridTextColumn Header="終了日" Width="110" Binding="{Binding DayTo, Converter={StaticResource DateYmd8Converter}, StringFormat=yyyy/MM/dd}" />
						<DataGridTextColumn Header="有効" Width="80" Binding="{Binding EnIsEnabled, Converter={StaticResource EnumCommentDisplayConverter}}" />
						<DataGridTextColumn Header="契機" Width="120" Binding="{Binding EnTriggerType, Converter={StaticResource EnumCommentDisplayConverter}}" />
						<DataGridTextColumn Header="追加ポイント" Width="120" Binding="{Binding PointAmount}" />

					</DataGrid.Columns>
				</DataGrid>
			</materialDesign:Card>
			<GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" Background="Transparent" />
			<materialDesign:Card Grid.Column="2" UniformCornerRadius="8" materialDesign:ElevationAssist.Elevation="Dp2">
				<ScrollViewer Padding="16" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
					<StackPanel>
						<TextBlock Margin="0,0,0,12" FontWeight="SemiBold" Text="入力条件を追加、または選択した行を修正します" TextWrapping="Wrap" />
						<TextBlock Text="Id" Style="{StaticResource FormLabel}" />
						<TextBox Text="{Binding CurrentEdit.Id}" IsReadOnly="True" Style="{StaticResource NumericFormTextBox}" />
						<TextBlock Margin="0,8,0,0" Text="コード" Style="{StaticResource FormLabel}" />
						<TextBox MaxLength="20" Text="{Binding CurrentEdit.Code, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Style="{StaticResource FormTextBox}" />
						<TextBlock Margin="0,8,0,0" Text="名称" Style="{StaticResource FormLabel}" />
						<TextBox MaxLength="80" Text="{Binding CurrentEdit.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Style="{StaticResource FormTextBox}" />
						<TextBlock Margin="0,8,0,0" Text="版番号" Style="{StaticResource FormLabel}" />
						<TextBox Text="{Binding CurrentEdit.Version, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Style="{StaticResource NumericFormTextBox}" />
						<TextBlock Margin="0,8,0,0" Text="親ベース(制度・名称・版)" Style="{StaticResource FormLabel}" />
						<ComboBox ItemsSource="{Binding BaseOptions}" SelectedValuePath="Id" SelectedValue="{Binding CurrentEdit.Id_PointBase, Mode=TwoWay}" Style="{StaticResource FormComboBox}">
							<ComboBox.ItemTemplate><DataTemplate><TextBlock><TextBlock.Text><MultiBinding StringFormat="{}{0} {1} (版{2})"><Binding Path="Code" /><Binding Path="Name" /><Binding Path="Version" /></MultiBinding></TextBlock.Text></TextBlock></DataTemplate></ComboBox.ItemTemplate>
						</ComboBox>
						<TextBlock Text="親Id=0は移行設定待ちです。保存前に親の版を選択してください。" TextWrapping="Wrap" FontSize="13" />
						<TextBlock Margin="0,8,0,0" Text="開始日" Style="{StaticResource FormLabel}" />
						<DatePicker SelectedDate="{Binding CurrentEdit.DayFrom, Converter={StaticResource DateYmd8Converter}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormDatePicker}" />
						<TextBlock Margin="0,8,0,0" Text="終了日" Style="{StaticResource FormLabel}" />
						<DatePicker SelectedDate="{Binding CurrentEdit.DayTo, Converter={StaticResource DateYmd8Converter}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormDatePicker}" />
						<TextBlock Margin="0,8,0,0" Text="有効" Style="{StaticResource FormLabel}" />
						<ComboBox ItemsSource="{Binding YesNoOptions}" SelectedItem="{Binding CurrentEdit.EnIsEnabled, Mode=TwoWay}" Style="{StaticResource FormComboBox}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumCommentDisplayConverter}}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
						<TextBlock Margin="0,8,0,0" Text="付与契機" Style="{StaticResource FormLabel}" />
						<ComboBox ItemsSource="{Binding TriggerOptions}" SelectedItem="{Binding CurrentEdit.EnTriggerType, Mode=TwoWay}" Style="{StaticResource FormComboBox}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumCommentDisplayConverter}}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
						<TextBlock Margin="0,8,0,0" Text="追加ポイント数" Style="{StaticResource FormLabel}" />
						<TextBox Text="{Binding CurrentEdit.PointAmount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Style="{StaticResource NumericFormTextBox}" />
						<TextBlock Margin="0,8,0,0" Text="最低購入金額" Style="{StaticResource FormLabel}" />
						<TextBox Text="{Binding CurrentEdit.MinimumKingaku, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Style="{StaticResource NumericFormTextBox}" />
						<TextBlock Margin="0,8,0,0" Text="全ランク対象" Style="{StaticResource FormLabel}" />
						<ComboBox ItemsSource="{Binding YesNoOptions}" SelectedItem="{Binding CurrentEdit.EnIsAllRanks, Mode=TwoWay}" Style="{StaticResource FormComboBox}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumCommentDisplayConverter}}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
						<TextBlock Margin="0,8,0,0" Text="対象ランクコード(全ランクは0)" Style="{StaticResource FormLabel}" />
						<TextBox Text="{Binding CurrentEdit.RankKubun, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Style="{StaticResource NumericFormTextBox}" />
						<TextBlock Margin="0,8,0,0" Text="回数制限期間" Style="{StaticResource FormLabel}" />
						<ComboBox ItemsSource="{Binding LimitPeriodOptions}" SelectedItem="{Binding CurrentEdit.EnLimitPeriodType, Mode=TwoWay}" Style="{StaticResource FormComboBox}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumCommentDisplayConverter}}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
						<TextBlock Margin="0,8,0,0" Text="回数上限" Style="{StaticResource FormLabel}" />
						<TextBox Text="{Binding CurrentEdit.LimitCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Style="{StaticResource NumericFormTextBox}" />

						<TextBlock Margin="0,16,0,0" Foreground="{DynamicResource MaterialDesignBodyLight}" TextWrapping="Wrap"
							Text="使用済み条件は新版を追加してください。有効の切替以外の変更・削除はサーバで保護されます。" />
					</StackPanel>
				</ScrollViewer>
			</materialDesign:Card>
		</Grid>
		<TextBlock Grid.Row="2" Margin="16,0,16,12" Text="{Binding Message}" TextWrapping="Wrap" />
	</Grid>
</helpers:BaseWindow>
