<helpers:BaseWindow x:Class="CvWpfclient.Views._32LoyalCustomer.PointMasterBaseAdminView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:helpers="clr-namespace:CvWpfclient.Helpers" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:vm="clr-namespace:CvWpfclient.ViewModels._32LoyalCustomer"
	Title="{Binding Title}"
	Width="1244" Height="860" MinWidth="900" MinHeight="600"
	Background="{DynamicResource AppCommonBackgroundBrush}"
	FontSize="16"
	Foreground="{DynamicResource MaterialDesignBody}"
	TextOptions.TextFormattingMode="Display" WindowStartupLocation="CenterScreen"
	mc:Ignorable="d">
	<helpers:BaseWindow.DataContext>
		<vm:PointMasterBaseAdminViewModel />
	</helpers:BaseWindow.DataContext>
	<helpers:BaseWindow.InputBindings>
		<KeyBinding Command="{Binding DoUpdateCommand}"
			Gesture="F2" />
		<KeyBinding Command="{Binding DoDeleteCommand}"
			Gesture="F3" />
		<KeyBinding Command="{Binding DoInsertCommand}"
			Gesture="F4" />
		<KeyBinding Command="{Binding DoListCommand}"
			Gesture="F5" />
	</helpers:BaseWindow.InputBindings>
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>
		<materialDesign:ColorZone Grid.Row="0"
			Padding="12,8"
			materialDesign:ElevationAssist.Elevation="Dp4" Mode="PrimaryMid">
			<DockPanel>
				<StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
					<Button Margin="4,0"
						Command="{Binding DoUpdateCommand}"
						Style="{StaticResource ToolCommandButton}"
						ToolTip="修正 (F2)">
						<StackPanel Orientation="Horizontal">
							<materialDesign:PackIcon VerticalAlignment="Center"
								Kind="Pencil" />
							<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
								Text="修正" />
						</StackPanel>
					</Button>
					<Button Margin="4,0"
						Command="{Binding DoDeleteCommand}"
						Style="{StaticResource ToolCommandButton}"
						ToolTip="削除 (F3)">
						<StackPanel Orientation="Horizontal">
							<materialDesign:PackIcon VerticalAlignment="Center"
								Kind="Delete" />
							<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
								Text="削除" />
						</StackPanel>
					</Button>
					<Button Margin="4,0"
						Command="{Binding DoInsertCommand}"
						Style="{StaticResource ToolCommandButton}"
						ToolTip="追加 (F4)">
						<StackPanel Orientation="Horizontal">
							<materialDesign:PackIcon VerticalAlignment="Center"
								Kind="Plus" />
							<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
								Text="追加" />
						</StackPanel>
					</Button>
				</StackPanel>
				<StackPanel Orientation="Horizontal">
					<Button Margin="0,0,8,0"
						Command="{Binding ExitCommand}"
						Style="{StaticResource ToolCommandButton}"
						ToolTip="閉じる (Esc)">
						<materialDesign:PackIcon Kind="ArrowLeft" />
					</Button>
					<materialDesign:PackIcon Width="28" Height="28"
						VerticalAlignment="Center"
						Kind="StarCircleOutline" />
					<TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
						FontSize="20" FontWeight="SemiBold"
						Text="{Binding Title}" />
					<Rectangle Width="1"
						Margin="16,4"
						Fill="{DynamicResource PrimaryHueMidForegroundBrush}"
						Opacity="0.3" />
					<Button Command="{Binding DoListCommand}"
						Style="{StaticResource ToolCommandButton}"
						ToolTip="一覧取得 (F5)">
						<StackPanel Orientation="Horizontal">
							<materialDesign:PackIcon VerticalAlignment="Center"
								Kind="DatabaseSearch" />
							<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
								Text="一覧取得" />
						</StackPanel>
					</Button>
				</StackPanel>
			</DockPanel>
		</materialDesign:ColorZone>
		<Grid Grid.Row="1"
			Margin="12">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="52*" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="48*" />
			</Grid.ColumnDefinitions>
			<materialDesign:Card Grid.Column="0"
				Padding="0"
				materialDesign:ElevationAssist.Elevation="Dp2" UniformCornerRadius="8">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
					</Grid.RowDefinitions>
					<Border Grid.Row="0"
						Padding="12,8"
						Background="{DynamicResource MaterialDesignToolBarBackground}"
						CornerRadius="8,8,0,0">
						<DockPanel>
							<TextBlock VerticalAlignment="Center"
								DockPanel.Dock="Right" FontSize="13"
								Foreground="{DynamicResource MaterialDesignBodyLight}"
								Text="{Binding Count, StringFormat={}件数: {0:N0}}" />
							<TextBlock VerticalAlignment="Center"
								FontSize="13"
								Foreground="{DynamicResource MaterialDesignBodyLight}"
								Text="{Binding Message}"
								TextTrimming="CharacterEllipsis"
								ToolTip="{Binding Message}" />
						</DockPanel>
					</Border>
					<DataGrid Grid.Row="1"
						d:ItemsSource="{d:SampleData ItemCount=5}"
						helpers:DataGridSelectionBehavior.AutoScrollToSelectedItem="True" materialDesign:DataGridAssist.CellPadding="12,6" materialDesign:DataGridAssist.ColumnHeaderPadding="12,8"
						AutoGenerateColumns="False" EnableRowVirtualization="True" FrozenColumnCount="2" GridLinesVisibility="Horizontal"
						HorizontalGridLinesBrush="{DynamicResource MaterialDesignDivider}"
						IsReadOnly="True" IsSynchronizedWithCurrentItem="True"
						ItemsSource="{Binding ListData}"
						SelectedItem="{Binding Current}"
						SelectionMode="Single"
						Style="{StaticResource MaterialDesignDataGrid}"
						VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
						<DataGrid.Columns>
							<DataGridTextColumn Width="70"
								Binding="{Binding Id}"
								Header="Id" />
							<DataGridTextColumn Width="110"
								Binding="{Binding Code}"
								Header="制度コード" />
							<DataGridTextColumn Width="180"
								Binding="{Binding Name}"
								Header="名称" />
							<DataGridTextColumn Width="60"
								Binding="{Binding Version}"
								Header="版" />
							<DataGridTextColumn Width="110"
								Binding="{Binding DayFrom, Converter={StaticResource DateYmd8Converter}, StringFormat=yyyy/MM/dd}"
								Header="開始日" />
							<DataGridTextColumn Width="110"
								Binding="{Binding DayTo, Converter={StaticResource DateYmd8Converter}, StringFormat=yyyy/MM/dd}"
								Header="終了日" />
							<DataGridTextColumn Width="80"
								Binding="{Binding EnIsEnabled, Converter={StaticResource EnumCommentDisplayConverter}}"
								Header="有効" />
							<DataGridTextColumn Width="90"
								Binding="{Binding PointUnitPrice}"
								Header="単価" />
							<DataGridTextColumn Width="80"
								Binding="{Binding PointAmountProper}"
								Header="P付与" />
							<DataGridTextColumn Width="80"
								Binding="{Binding PointAmountSale}"
								Header="S付与" />
						</DataGrid.Columns>
						<DataGrid.ColumnHeaderStyle>
							<Style BasedOn="{StaticResource MenteDataGridColumnHeader}"
								TargetType="DataGridColumnHeader" />
						</DataGrid.ColumnHeaderStyle>
					</DataGrid>
				</Grid>
			</materialDesign:Card>
			<GridSplitter Grid.Column="1"
				Width="6"
				Margin="3,0" HorizontalAlignment="Center" VerticalAlignment="Stretch"
				Background="Transparent" />
			<materialDesign:Card Grid.Column="2"
				Padding="0"
				materialDesign:ElevationAssist.Elevation="Dp2" UniformCornerRadius="8">
				<TabControl Style="{StaticResource MaterialDesignTabControl}">
					<TabItem>
						<TabItem.Header>
							<StackPanel Orientation="Horizontal">
								<materialDesign:PackIcon Margin="0,0,6,0" VerticalAlignment="Center"
									Kind="InformationOutline" />
								<TextBlock Text="{Binding CurrentEdit.Id, StringFormat={}Id:{0}}" />
							</StackPanel>
						</TabItem.Header>
						<ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
							<Grid Margin="4,8,4,12">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="160" />
									<ColumnDefinition Width="*" />
								</Grid.ColumnDefinitions>
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
								</Grid.RowDefinitions>
								<TextBlock Grid.Row="0" Grid.ColumnSpan="2"
									Margin="0,0,0,4"
									FontWeight="SemiBold"
									Foreground="{DynamicResource PrimaryHueMidBrush}"
									Text="制度・適用期間" />
								<TextBlock Grid.Row="1"
									Style="{StaticResource FormLabel}"
									Text="Id" />
								<TextBox Grid.Row="1" Grid.Column="1"
									Width="160"
									HorizontalAlignment="Left"
									materialDesign:HintAssist.Hint="Id" IsReadOnly="True"
									Style="{StaticResource NumericFormTextBox}"
									Text="{Binding CurrentEdit.Id}" />
								<TextBlock Grid.Row="2"
									Style="{StaticResource FormLabel}"
									Text="制度コード" />
								<TextBox Grid.Row="2" Grid.Column="1"
									Width="220"
									HorizontalAlignment="Left"
									materialDesign:HintAssist.Hint="制度コード" materialDesign:TextFieldAssist.CharacterCounterVisibility="Collapsed" MaxLength="20"
									Style="{StaticResource FormTextBox}"
									Text="{Binding CurrentEdit.Code, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
								<TextBlock Grid.Row="3"
									Style="{StaticResource FormLabel}"
									Text="名称" />
								<TextBox Grid.Row="3" Grid.Column="1"
									materialDesign:HintAssist.Hint="名称" materialDesign:TextFieldAssist.CharacterCounterVisibility="Collapsed" MaxLength="80"
									Style="{StaticResource FormTextBox}"
									Text="{Binding CurrentEdit.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
								<TextBlock Grid.Row="4"
									Style="{StaticResource FormLabel}"
									Text="版番号" />
								<TextBox Grid.Row="4" Grid.Column="1"
									Width="180"
									HorizontalAlignment="Left"
									materialDesign:HintAssist.Hint="版番号"
									Style="{StaticResource NumericFormTextBox}"
									Text="{Binding CurrentEdit.Version, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" />
								<TextBlock Grid.Row="5"
									Style="{StaticResource FormLabel}"
									Text="開始日" />
								<DatePicker Grid.Row="5" Grid.Column="1"
									Width="180"
									Margin="0,4" HorizontalAlignment="Left"
									helpers:DatePickerTodayButtonBehavior.IsEnabled="True" materialDesign:HintAssist.Hint="開始日" IsTodayHighlighted="False"
									SelectedDate="{Binding CurrentEdit.DayFrom, Converter={StaticResource DateYmd8Converter}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
									Style="{StaticResource FormDatePicker}" />
								<TextBlock Grid.Row="6"
									Style="{StaticResource FormLabel}"
									Text="終了日" />
								<DatePicker Grid.Row="6" Grid.Column="1"
									Width="180"
									Margin="0,4" HorizontalAlignment="Left"
									helpers:DatePickerTodayButtonBehavior.IsEnabled="True" materialDesign:HintAssist.Hint="終了日" IsTodayHighlighted="False"
									SelectedDate="{Binding CurrentEdit.DayTo, Converter={StaticResource DateYmd8Converter}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
									Style="{StaticResource FormDatePicker}" />
								<TextBlock Grid.Row="7"
									Style="{StaticResource FormLabel}"
									Text="有効" />
								<ComboBox Grid.Row="7" Grid.Column="1"
									Width="220"
									HorizontalAlignment="Left"
									materialDesign:HintAssist.Hint="有効"
									ItemsSource="{Binding YesNoOptions}"
									SelectedItem="{Binding CurrentEdit.EnIsEnabled, Mode=TwoWay}"
									Style="{StaticResource FormComboBox}">
									<ComboBox.ItemTemplate>
										<DataTemplate>
											<TextBlock Foreground="{DynamicResource MaterialDesignBody}"
												Text="{Binding Converter={StaticResource EnumCommentDisplayConverter}}" />
										</DataTemplate>
									</ComboBox.ItemTemplate>
								</ComboBox>
								<TextBlock Grid.Row="8" Grid.ColumnSpan="2"
									Margin="0,12,0,4"
									FontWeight="SemiBold"
									Foreground="{DynamicResource PrimaryHueMidBrush}"
									Text="付与条件" />
								<TextBlock Grid.Row="9"
									Style="{StaticResource FormLabel}"
									Text="付与単価(円)" />
								<TextBox Grid.Row="9" Grid.Column="1"
									Width="180"
									HorizontalAlignment="Left"
									materialDesign:HintAssist.Hint="付与単価(円)"
									Style="{StaticResource NumericFormTextBox}"
									Text="{Binding CurrentEdit.PointUnitPrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" />
								<TextBlock Grid.Row="10"
									Style="{StaticResource FormLabel}"
									Text="プロパー付与数" />
								<TextBox Grid.Row="10" Grid.Column="1"
									Width="180"
									HorizontalAlignment="Left"
									materialDesign:HintAssist.Hint="プロパー付与数"
									Style="{StaticResource NumericFormTextBox}"
									Text="{Binding CurrentEdit.PointAmountProper, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" />
								<TextBlock Grid.Row="11"
									Style="{StaticResource FormLabel}"
									Text="セール付与数" />
								<TextBox Grid.Row="11" Grid.Column="1"
									Width="180"
									HorizontalAlignment="Left"
									materialDesign:HintAssist.Hint="セール付与数"
									Style="{StaticResource NumericFormTextBox}"
									Text="{Binding CurrentEdit.PointAmountSale, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" />
								<TextBlock Grid.Row="12"
									Style="{StaticResource FormLabel}"
									Text="対象金額の税基準" />
								<ComboBox Grid.Row="12" Grid.Column="1"
									Width="220"
									Margin="0,4" HorizontalAlignment="Left"
									materialDesign:HintAssist.Hint="対象金額の税基準"
									ItemsSource="{Binding TaxBasisOptions}"
									SelectedItem="{Binding CurrentEdit.EnTaxBasis, Mode=TwoWay}"
									Style="{StaticResource FormComboBox}">
									<ComboBox.ItemTemplate>
										<DataTemplate>
											<TextBlock Foreground="{DynamicResource MaterialDesignBody}"
												Text="{Binding Converter={StaticResource EnumCommentDisplayConverter}}" />
										</DataTemplate>
									</ComboBox.ItemTemplate>
								</ComboBox>
								<TextBlock Grid.Row="13"
									Style="{StaticResource FormLabel}"
									Text="計算単位" />
								<ComboBox Grid.Row="13" Grid.Column="1"
									Width="220"
									Margin="0,4" HorizontalAlignment="Left"
									materialDesign:HintAssist.Hint="計算単位"
									ItemsSource="{Binding CalcUnitOptions}"
									SelectedItem="{Binding CurrentEdit.EnCalcUnit, Mode=TwoWay}"
									Style="{StaticResource FormComboBox}">
									<ComboBox.ItemTemplate>
										<DataTemplate>
											<TextBlock Foreground="{DynamicResource MaterialDesignBody}"
												Text="{Binding Converter={StaticResource EnumCommentDisplayConverter}}" />
										</DataTemplate>
									</ComboBox.ItemTemplate>
								</ComboBox>
								<TextBlock Grid.Row="14"
									Style="{StaticResource FormLabel}"
									Text="端数処理" />
								<ComboBox Grid.Row="14" Grid.Column="1"
									Width="220"
									Margin="0,4" HorizontalAlignment="Left"
									materialDesign:HintAssist.Hint="端数処理"
									ItemsSource="{Binding RoundingOptions}"
									SelectedItem="{Binding CurrentEdit.EnRounding, Mode=TwoWay}"
									Style="{StaticResource FormComboBox}">
									<ComboBox.ItemTemplate>
										<DataTemplate>
											<TextBlock Foreground="{DynamicResource MaterialDesignBody}"
												Text="{Binding Converter={StaticResource EnumCommentDisplayConverter}}" />
										</DataTemplate>
									</ComboBox.ItemTemplate>
								</ComboBox>
								<TextBlock Grid.Row="15"
									Style="{StaticResource FormLabel}"
									Text="利用ポイント控除" />
								<ComboBox Grid.Row="15" Grid.Column="1"
									Width="220"
									Margin="0,4" HorizontalAlignment="Left"
									materialDesign:HintAssist.Hint="利用ポイント控除"
									ItemsSource="{Binding YesNoOptions}"
									SelectedItem="{Binding CurrentEdit.EnDeductPointUse, Mode=TwoWay}"
									Style="{StaticResource FormComboBox}">
									<ComboBox.ItemTemplate>
										<DataTemplate>
											<TextBlock Foreground="{DynamicResource MaterialDesignBody}"
												Text="{Binding Converter={StaticResource EnumCommentDisplayConverter}}" />
										</DataTemplate>
									</ComboBox.ItemTemplate>
								</ComboBox>
								<TextBlock Grid.Row="16"
									Style="{StaticResource FormLabel}"
									Text="失効月数" />
								<TextBox Grid.Row="16" Grid.Column="1"
									Width="180"
									HorizontalAlignment="Left"
									materialDesign:HintAssist.Hint="最終購入から(0=失効しない)"
									Style="{StaticResource NumericFormTextBox}"
									Text="{Binding CurrentEdit.ExpireMonths, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" />
								<TextBlock Grid.Row="17" Grid.ColumnSpan="2"
									Margin="0,16,0,0"
									Foreground="{DynamicResource MaterialDesignBodyLight}"
									Text="使用済み条件は新版を追加してください。有効の切替・失効月数以外の変更・削除はサーバで保護されます。" TextWrapping="Wrap" />
								<TextBlock Grid.Row="18" Grid.ColumnSpan="2"
									Margin="0,8,0,0"
									Foreground="{DynamicResource MaterialDesignBodyLight}"
									TextWrapping="Wrap">
									<TextBlock.Text>
										<MultiBinding StringFormat="{}登録日={0}  修正日={1}">
											<Binding Path="CurrentEdit.VdateC" />
											<Binding Path="CurrentEdit.VdateU" />
										</MultiBinding>
									</TextBlock.Text>
								</TextBlock>
							</Grid>
						</ScrollViewer>
					</TabItem>
				</TabControl>
			</materialDesign:Card>
		</Grid>
	</Grid>
</helpers:BaseWindow>
