<helpers:BaseWindow x:Class="CvWpfclient.Views._32LoyalCustomer.RfmCrossAnalysisTableView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:helpers="clr-namespace:CvWpfclient.Helpers"
	xmlns:local="clr-namespace:CvWpfclient.Views" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:vm="clr-namespace:CvWpfclient.ViewModels._32LoyalCustomer"
	Title="{Binding Title}"
	Width="{StaticResource StandardWindowWidth}"
	Height="{StaticResource StandardWindowHeight}"
	Background="{DynamicResource AppCommonBackgroundBrush}"
	FontSize="14"
	Foreground="{DynamicResource MaterialDesignBody}"
	TextOptions.TextFormattingMode="Display" WindowStartupLocation="CenterScreen"
	mc:Ignorable="d">
	<helpers:BaseWindow.DataContext>
		<vm:RfmCrossAnalysisTableViewModel />
	</helpers:BaseWindow.DataContext>

	<helpers:BaseWindow.Resources>
		<Style x:Key="RfmColumnHeaderStyle"
			BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}"
			TargetType="DataGridColumnHeader">
			<Setter Property="Background" Value="#FF1B2A4A" />
			<Setter Property="Foreground" Value="White" />
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="HorizontalContentAlignment" Value="Center" />
			<Setter Property="Padding" Value="8,6" />
		</Style>
		<Style x:Key="RfmNumberCell"
			TargetType="TextBlock">
			<Setter Property="HorizontalAlignment" Value="Right" />
		</Style>
		<Style x:Key="RfmThresholdBox"
			BasedOn="{StaticResource MaterialDesignTextBox}"
			TargetType="TextBox">
			<Setter Property="Width" Value="90" />
			<Setter Property="Margin" Value="0,2,8,2" />
			<Setter Property="HorizontalContentAlignment" Value="Right" />
		</Style>

		<!--  クロス表の1セル。見出しは濃色帯に白字、データは白地に濃色文字と人数に応じた淡い青、合計は薄灰、選択中は枠線で示す。
		     セルはButtonのため既定の白字を継承しないよう文字色を固定し、テーマに依存せず読めるようにする  -->
		<DataTemplate x:Key="RfmGridCellTemplate"
			DataType="{x:Type vm:RfmGridCell}">
			<Button MinWidth="128" MinHeight="58"
				Margin="0" Padding="0"
				Command="{Binding DataContext.SelectCellCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
				CommandParameter="{Binding}"
				Cursor="Hand" Focusable="False"
				IsHitTestVisible="{Binding IsSelectable}">
				<Button.Template>
					<ControlTemplate TargetType="Button">
						<ContentPresenter />
					</ControlTemplate>
				</Button.Template>
				<Border x:Name="CellBorder"
					BorderBrush="{DynamicResource MaterialDesignDivider}"
					BorderThickness="0,0,1,1">
					<Grid>
						<Rectangle x:Name="CellBack"
							Fill="White" />
						<Rectangle Fill="#FF60A5FA"
							Opacity="{Binding Intensity}" />
						<!--  見出し  -->
						<StackPanel Margin="4" HorizontalAlignment="Center" VerticalAlignment="Center"
							Visibility="{Binding IsHeader, Converter={StaticResource BooleanToVisibilityConverter}}">
							<TextBlock HorizontalAlignment="Center"
								FontWeight="SemiBold" Foreground="White"
								Text="{Binding Title}" />
							<TextBlock HorizontalAlignment="Center"
								FontSize="12" Foreground="White"
								Text="{Binding SubTitle}" />
						</StackPanel>
						<!--  データ・合計  -->
						<StackPanel Margin="8,2" VerticalAlignment="Center"
							TextElement.Foreground="#FF1F2937"
							Visibility="{Binding IsHeader, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
							<DockPanel>
								<TextBlock DockPanel.Dock="Right"
									VerticalAlignment="Bottom"
									FontSize="12" Foreground="#FF1F2937"
									Text="{Binding RatioText}" />
								<TextBlock FontSize="15" FontWeight="SemiBold"
									Foreground="#FF111827"
									Text="{Binding CountText}" />
							</DockPanel>
							<TextBlock HorizontalAlignment="Right"
								FontSize="12" Foreground="#FF1F2937"
								Text="{Binding AmountText}" />
							<TextBlock HorizontalAlignment="Right"
								FontSize="12" Foreground="#FF4B5563"
								Text="{Binding AverageText}" />
						</StackPanel>
					</Grid>
				</Border>
			</Button>
			<DataTemplate.Triggers>
				<DataTrigger Binding="{Binding IsHeader}" Value="True">
					<Setter TargetName="CellBack" Property="Fill" Value="#FF1B2A4A" />
				</DataTrigger>
				<DataTrigger Binding="{Binding IsTotal}" Value="True">
					<Setter TargetName="CellBack" Property="Fill" Value="#FFEEF1F5" />
				</DataTrigger>
				<DataTrigger Binding="{Binding IsSelected}" Value="True">
					<Setter TargetName="CellBorder" Property="BorderBrush" Value="#FFF59E0B" />
					<Setter TargetName="CellBorder" Property="BorderThickness" Value="3" />
				</DataTrigger>
			</DataTemplate.Triggers>
		</DataTemplate>
	</helpers:BaseWindow.Resources>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<!--  ヘッダ帯: 閉じる＋タイトル、右に検索・CSV出力  -->
		<materialDesign:ColorZone Grid.Row="0"
			Padding="12,8"
			materialDesign:ElevationAssist.Elevation="Dp4" Mode="PrimaryMid">
			<DockPanel>
				<StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
					<Button Margin="4,0"
						Command="{Binding SearchCommand}"
						IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
						Style="{StaticResource ToolCommandButton}"
						ToolTip="検索">
						<StackPanel Orientation="Horizontal">
							<materialDesign:PackIcon Kind="Magnify" />
							<TextBlock Margin="4,0,0,0"
								Text="検索" />
						</StackPanel>
					</Button>
					<Button Margin="4,0"
						Command="{Binding ExportCsvCommand}"
						Style="{StaticResource ToolCommandButton}"
						ToolTip="クロス表をCSV出力（顧客一覧は出力しません）">
						<StackPanel Orientation="Horizontal">
							<materialDesign:PackIcon Kind="FileDelimitedOutline" />
							<TextBlock Margin="4,0,0,0"
								Text="CSV出力" />
						</StackPanel>
					</Button>
				</StackPanel>
				<StackPanel Orientation="Horizontal">
					<Button Margin="0,0,8,0"
						Command="{Binding ExitCommand}"
						Style="{StaticResource ToolCommandButton}"
						ToolTip="閉じる (Esc)">
						<materialDesign:PackIcon Kind="ArrowLeft" />
					</Button>
					<materialDesign:PackIcon Width="28" Height="28"
						VerticalAlignment="Center"
						Kind="TableLarge" />
					<TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
						FontSize="20" FontWeight="SemiBold"
						Text="{Binding Title}" />
				</StackPanel>
			</DockPanel>
		</materialDesign:ColorZone>

		<!--  上段の条件は固定し、下段のクロス表・顧客一覧だけを縦スクロールさせる  -->
		<Grid Grid.Row="1">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
			</Grid.RowDefinitions>

			<StackPanel Grid.Row="0"
				Margin="16,12,16,0">
				<!--  条件  -->
				<WrapPanel Orientation="Horizontal">
					<StackPanel Margin="0,4,24,4" Orientation="Horizontal">
						<TextBlock Style="{StaticResource FormLabel}"
							Text="対象年月" />
						<TextBox Width="90" Height="36"
							helpers:YearMonthInputBehavior.IsEnabled="True"
							Style="{StaticResource MaterialDesignTextBox}"
							Text="{Binding MonthFrom, UpdateSourceTrigger=PropertyChanged}" />
						<TextBlock Margin="8,0" VerticalAlignment="Center"
							Text="〜" />
						<TextBox Width="90" Height="36"
							helpers:YearMonthInputBehavior.IsEnabled="True"
							Style="{StaticResource MaterialDesignTextBox}"
							Text="{Binding MonthTo, UpdateSourceTrigger=PropertyChanged}" />
						<TextBlock Margin="8,0,0,0" VerticalAlignment="Center"
							Foreground="{DynamicResource MaterialDesignBodyLight}"
							Text="（最大12ヶ月）" />
					</StackPanel>
					<StackPanel Margin="0,4,24,4" Orientation="Horizontal">
						<TextBlock Style="{StaticResource FormLabel}"
							Text="購入店舗" />
						<TextBox Width="150" Height="36"
							HorizontalContentAlignment="Left"
							helpers:SearchTextBoxAssist.Command="{Binding SelectShopCommand}"
							materialDesign:HintAssist.Hint="空欄=全店"
							BorderThickness="0,0,0,1"
							Style="{StaticResource MenteSearchTextBox}"
							Text="{Binding ShopCode, UpdateSourceTrigger=PropertyChanged}" />
						<TextBlock MaxWidth="220"
							Margin="8,0,0,0" VerticalAlignment="Center"
							Text="{Binding ShopName}"
							TextTrimming="CharacterEllipsis" />
					</StackPanel>
					<CheckBox Margin="0,4,24,4" VerticalAlignment="Center"
						Content="退会者を含む"
						IsChecked="{Binding IncludeWithdrawn}" />
				</WrapPanel>

				<!--  閾値  -->
				<Border Margin="0,8,0,0" Padding="8,4"
					BorderBrush="{DynamicResource MaterialDesignDivider}"
					BorderThickness="1" CornerRadius="4">
					<StackPanel>
						<DockPanel>
							<Button DockPanel.Dock="Right"
								Command="{Binding ResetThresholdsCommand}"
								Style="{StaticResource MaterialDesignFlatButton}"
								ToolTip="R/F/M の閾値を既定値に戻す">
								<StackPanel Orientation="Horizontal">
									<materialDesign:PackIcon VerticalAlignment="Center"
										Kind="Restore" />
									<TextBlock Margin="4,0,0,0"
										Text="既定に戻す" />
								</StackPanel>
							</Button>
							<TextBlock VerticalAlignment="Center"
								FontWeight="Medium"
								Text="ランク閾値（左から ランク5/4/3/2 の境界。R は以内、F・M は以上で上位ランク）" TextWrapping="Wrap" />
						</DockPanel>
						<ItemsControl ItemsSource="{Binding Thresholds}">
							<ItemsControl.ItemTemplate>
								<DataTemplate DataType="{x:Type vm:RfmThresholdRow}">
									<StackPanel Margin="0,2" Orientation="Horizontal">
										<TextBlock Width="110"
											Style="{StaticResource FormLabel}"
											Text="{Binding Label}" />
										<TextBox Style="{StaticResource RfmThresholdBox}"
											Text="{Binding Value1, UpdateSourceTrigger=PropertyChanged}" />
										<TextBox Style="{StaticResource RfmThresholdBox}"
											Text="{Binding Value2, UpdateSourceTrigger=PropertyChanged}" />
										<TextBox Style="{StaticResource RfmThresholdBox}"
											Text="{Binding Value3, UpdateSourceTrigger=PropertyChanged}" />
										<TextBox Style="{StaticResource RfmThresholdBox}"
											Text="{Binding Value4, UpdateSourceTrigger=PropertyChanged}" />
										<TextBlock VerticalAlignment="Center"
											Foreground="{DynamicResource MaterialDesignBodyLight}"
											Text="{Binding Unit}" />
									</StackPanel>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</StackPanel>
				</Border>

				<!--  表示軸（再検索せずに組み替える）  -->
				<WrapPanel Margin="0,8,0,0" Orientation="Horizontal">
					<TextBlock Style="{StaticResource FormLabel}"
						Text="縦軸" />
					<ComboBox Width="70"
						ItemsSource="{Binding AxisItems}"
						SelectedItem="{Binding VerticalAxis}" />
					<TextBlock Margin="24,0,8,0"
						Style="{StaticResource FormLabel}"
						Text="横軸" />
					<ComboBox Width="70"
						ItemsSource="{Binding AxisItems}"
						SelectedItem="{Binding HorizontalAxis}" />
					<TextBlock Margin="24,0,0,0" VerticalAlignment="Center"
						Foreground="{DynamicResource MaterialDesignBodyLight}"
						Text="R=最終購入からの経過日数 / F=購入回数 / M=購入金額(税込)" />
				</WrapPanel>
			</StackPanel>

			<!--  結果。外側は縦スクロールのみとし、表は個別に横スクロールさせる  -->
			<ScrollViewer Grid.Row="1"
				HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
				<StackPanel Margin="16,0,16,12">
					<!--  集計サマリ  -->
					<TextBlock Margin="0,12,0,4"
						FontWeight="SemiBold"
						Text="{Binding SummaryText}"
						TextWrapping="Wrap" />

					<!--  クロス表  -->
					<ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
						<ItemsControl HorizontalAlignment="Left"
							BorderBrush="{DynamicResource MaterialDesignDivider}"
							BorderThickness="1,1,0,0"
							ItemTemplate="{StaticResource RfmGridCellTemplate}"
							ItemsSource="{Binding GridCells}">
							<ItemsControl.ItemsPanel>
								<ItemsPanelTemplate>
									<UniformGrid Columns="{Binding DataContext.GridColumns, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
								</ItemsPanelTemplate>
							</ItemsControl.ItemsPanel>
						</ItemsControl>
					</ScrollViewer>

					<!--  顧客一覧（画面表示のみ。CSVには出力しない）  -->
					<TextBlock Margin="0,16,0,4"
						FontWeight="SemiBold"
						Text="{Binding CustomerCaption}"
						TextWrapping="Wrap" />
					<DataGrid Height="320"
						materialDesign:DataGridAssist.CellPadding="8,4"
						AlternatingRowBackground="{DynamicResource DataGridAlternatingRowBackgroundBrush}"
						AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" GridLinesVisibility="All" HeadersVisibility="Column"
						HorizontalGridLinesBrush="{DynamicResource MaterialDesignDivider}"
						HorizontalScrollBarVisibility="Auto" IsReadOnly="True"
						ItemsSource="{Binding CustomerRows}"
						Style="{StaticResource MaterialDesignDataGrid}"
						VerticalGridLinesBrush="{DynamicResource MaterialDesignDivider}"
						VerticalScrollBarVisibility="Auto">
						<DataGrid.ColumnHeaderStyle>
							<Style BasedOn="{StaticResource RfmColumnHeaderStyle}"
								TargetType="DataGridColumnHeader" />
						</DataGrid.ColumnHeaderStyle>
						<DataGrid.Columns>
							<DataGridTextColumn Width="110"
								Binding="{Binding Code}"
								Header="コード" />
							<DataGridTextColumn Width="160"
								Binding="{Binding Name}"
								Header="氏名" />
							<DataGridTextColumn Width="160"
								Binding="{Binding Kana}"
								Header="カナ" />
							<DataGridTextColumn Width="110"
								Binding="{Binding LastDay}"
								Header="最終購入日" />
							<DataGridTextColumn Width="80"
								Binding="{Binding Days, StringFormat={}{0:N0}}"
								ElementStyle="{StaticResource RfmNumberCell}"
								Header="経過日数" />
							<DataGridTextColumn Width="70"
								Binding="{Binding Frequency, StringFormat={}{0:N0}}"
								ElementStyle="{StaticResource RfmNumberCell}"
								Header="回数" />
							<DataGridTextColumn Width="110"
								Binding="{Binding Amount, StringFormat={}{0:N0}}"
								ElementStyle="{StaticResource RfmNumberCell}"
								Header="金額" />
							<DataGridTextColumn Width="50"
								Binding="{Binding RRank}"
								ElementStyle="{StaticResource RfmNumberCell}"
								Header="R" />
							<DataGridTextColumn Width="50"
								Binding="{Binding FRank}"
								ElementStyle="{StaticResource RfmNumberCell}"
								Header="F" />
							<DataGridTextColumn Width="50"
								Binding="{Binding MRank}"
								ElementStyle="{StaticResource RfmNumberCell}"
								Header="M" />
						</DataGrid.Columns>
					</DataGrid>
				</StackPanel>
			</ScrollViewer>
		</Grid>

		<!--  ステータス帯  -->
		<Border Grid.Row="2"
			Padding="12,6"
			Background="{DynamicResource MaterialDesignToolBarBackground}">
			<TextBlock VerticalAlignment="Center"
				Foreground="{DynamicResource MaterialDesignBodyLight}"
				Text="{Binding Message}"
				TextTrimming="CharacterEllipsis" />
		</Border>
	</Grid>
</helpers:BaseWindow>
