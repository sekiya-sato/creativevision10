<helpers:BaseWindow x:Class="CvWpfclient.Views._32LoyalCustomer.PointMasterRankView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:helpers="clr-namespace:CvWpfclient.Helpers" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:vm="clr-namespace:CvWpfclient.ViewModels._32LoyalCustomer"
	Title="{Binding Title}"
	Width="1244" Height="860" MinWidth="900" MinHeight="600"
	Background="{DynamicResource AppCommonBackgroundBrush}"
	FontSize="16"
	Foreground="{DynamicResource MaterialDesignBody}"
	TextOptions.TextFormattingMode="Display" WindowStartupLocation="CenterScreen"
	mc:Ignorable="d">
	<helpers:BaseWindow.DataContext>
		<vm:PointMasterRankViewModel />
	</helpers:BaseWindow.DataContext>
	<helpers:BaseWindow.InputBindings>
		<KeyBinding Command="{Binding DoUpdateCommand}"
			Gesture="F2" />
		<KeyBinding Command="{Binding DoDeleteCommand}"
			Gesture="F3" />
		<KeyBinding Command="{Binding DoInsertCommand}"
			Gesture="F4" />
		<KeyBinding Command="{Binding DoListCommand}"
			Gesture="F5" />
	</helpers:BaseWindow.InputBindings>
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>
		<materialDesign:ColorZone Grid.Row="0"
			Padding="12,8"
			materialDesign:ElevationAssist.Elevation="Dp4" Mode="PrimaryMid">
			<DockPanel>
				<StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
					<Button Margin="4,0"
						Command="{Binding DoUpdateCommand}"
						Style="{StaticResource ToolCommandButton}"
						ToolTip="修正 (F2)">
						<StackPanel Orientation="Horizontal">
							<materialDesign:PackIcon VerticalAlignment="Center"
								Kind="Pencil" />
							<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
								Text="修正" />
						</StackPanel>
					</Button>
					<Button Margin="4,0"
						Command="{Binding DoDeleteCommand}"
						Style="{StaticResource ToolCommandButton}"
						ToolTip="削除 (F3)">
						<StackPanel Orientation="Horizontal">
							<materialDesign:PackIcon VerticalAlignment="Center"
								Kind="Delete" />
							<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
								Text="削除" />
						</StackPanel>
					</Button>
					<Button Margin="4,0"
						Command="{Binding DoInsertCommand}"
						Style="{StaticResource ToolCommandButton}"
						ToolTip="追加 (F4)">
						<StackPanel Orientation="Horizontal">
							<materialDesign:PackIcon VerticalAlignment="Center"
								Kind="Plus" />
							<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
								Text="追加" />
						</StackPanel>
					</Button>
				</StackPanel>
				<StackPanel Orientation="Horizontal">
					<Button Margin="0,0,8,0"
						Command="{Binding ExitCommand}"
						Style="{StaticResource ToolCommandButton}"
						ToolTip="閉じる (Esc)">
						<materialDesign:PackIcon Kind="ArrowLeft" />
					</Button>
					<materialDesign:PackIcon Width="28" Height="28"
						VerticalAlignment="Center"
						Kind="Podium" />
					<TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
						FontSize="20" FontWeight="SemiBold"
						Text="{Binding Title}" />
					<Rectangle Width="1"
						Margin="16,4"
						Fill="{DynamicResource PrimaryHueMidForegroundBrush}"
						Opacity="0.3" />
					<Button Command="{Binding DoListCommand}"
						Style="{StaticResource ToolCommandButton}"
						ToolTip="一覧取得 (F5)">
						<StackPanel Orientation="Horizontal">
							<materialDesign:PackIcon VerticalAlignment="Center"
								Kind="DatabaseSearch" />
							<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
								Text="一覧取得" />
						</StackPanel>
					</Button>
				</StackPanel>
			</DockPanel>
		</materialDesign:ColorZone>
		<Grid Grid.Row="1"
			Margin="12">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="52*" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="48*" />
			</Grid.ColumnDefinitions>
			<materialDesign:Card Grid.Column="0"
				Padding="0"
				materialDesign:ElevationAssist.Elevation="Dp2" UniformCornerRadius="8">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
					</Grid.RowDefinitions>
					<Border Grid.Row="0"
						Padding="12,8"
						Background="{DynamicResource MaterialDesignToolBarBackground}"
						CornerRadius="8,8,0,0">
						<DockPanel>
							<TextBlock VerticalAlignment="Center"
								DockPanel.Dock="Right" FontSize="13"
								Foreground="{DynamicResource MaterialDesignBodyLight}"
								Text="{Binding Count, StringFormat={}件数: {0:N0}}" />
							<TextBlock VerticalAlignment="Center"
								FontSize="13"
								Foreground="{DynamicResource MaterialDesignBodyLight}"
								Text="{Binding Message}"
								TextTrimming="CharacterEllipsis"
								ToolTip="{Binding Message}" />
						</DockPanel>
					</Border>
					<DataGrid Grid.Row="1"
						d:ItemsSource="{d:SampleData ItemCount=5}"
						helpers:DataGridSelectionBehavior.AutoScrollToSelectedItem="True" materialDesign:DataGridAssist.CellPadding="12,6" materialDesign:DataGridAssist.ColumnHeaderPadding="12,8"
						AutoGenerateColumns="False" EnableRowVirtualization="True" FrozenColumnCount="2" GridLinesVisibility="Horizontal"
						HorizontalGridLinesBrush="{DynamicResource MaterialDesignDivider}"
						IsReadOnly="True" IsSynchronizedWithCurrentItem="True"
						ItemsSource="{Binding ListData}"
						SelectedItem="{Binding Current}"
						SelectionMode="Single"
						Style="{StaticResource MaterialDesignDataGrid}"
						VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
						<DataGrid.Columns>
							<DataGridTextColumn Width="70"
								Binding="{Binding Id}"
								Header="Id" />
							<DataGridTextColumn Width="100"
								Binding="{Binding Id_PointBase}"
								Header="親ベースId" />
							<DataGridTextColumn Width="110"
								Binding="{Binding Kubun}"
								Header="ランクコード" />
							<DataGridTextColumn Width="180"
								Binding="{Binding Name}"
								Header="名称" />
							<DataGridTextColumn Width="90"
								Binding="{Binding PointUnitPrice}"
								Header="単価" />
							<DataGridTextColumn Width="80"
								Binding="{Binding PointAmountProper}"
								Header="P付与" />
							<DataGridTextColumn Width="80"
								Binding="{Binding PointAmountSale}"
								Header="S付与" />
							<DataGridTemplateColumn Width="140"
								Header="親状態">
								<DataGridTemplateColumn.CellTemplate>
									<DataTemplate>
										<TextBlock>
											<TextBlock.Style>
												<Style TargetType="TextBlock">
													<Setter Property="Text" Value="設定済み" />
													<Style.Triggers>
														<DataTrigger Binding="{Binding Id_PointBase}"
															Value="0">
															<Setter Property="Text" Value="移行設定待ち" />
														</DataTrigger>
													</Style.Triggers>
												</Style>
											</TextBlock.Style>
										</TextBlock>
									</DataTemplate>
								</DataGridTemplateColumn.CellTemplate>
							</DataGridTemplateColumn>
						</DataGrid.Columns>
						<DataGrid.ColumnHeaderStyle>
							<Style BasedOn="{StaticResource MenteDataGridColumnHeader}"
								TargetType="DataGridColumnHeader" />
						</DataGrid.ColumnHeaderStyle>
					</DataGrid>
				</Grid>
			</materialDesign:Card>
			<GridSplitter Grid.Column="1"
				Width="6"
				Margin="3,0" HorizontalAlignment="Center" VerticalAlignment="Stretch"
				Background="Transparent" />
			<materialDesign:Card Grid.Column="2"
				Padding="0"
				materialDesign:ElevationAssist.Elevation="Dp2" UniformCornerRadius="8">
				<TabControl Style="{StaticResource MaterialDesignTabControl}">
					<TabItem>
						<TabItem.Header>
							<StackPanel Orientation="Horizontal">
								<materialDesign:PackIcon Margin="0,0,6,0" VerticalAlignment="Center"
									Kind="InformationOutline" />
								<TextBlock Text="{Binding CurrentEdit.Id, StringFormat={}Id:{0}}" />
							</StackPanel>
						</TabItem.Header>
						<ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
							<Grid Margin="4,8,4,12">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="160" />
									<ColumnDefinition Width="*" />
								</Grid.ColumnDefinitions>
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
								</Grid.RowDefinitions>
								<TextBlock Grid.Row="0" Grid.ColumnSpan="2"
									Margin="0,0,0,4"
									FontWeight="SemiBold"
									Foreground="{DynamicResource PrimaryHueMidBrush}"
									Text="親ベース・ランク" />
								<TextBlock Grid.Row="1"
									Style="{StaticResource FormLabel}"
									Text="Id" />
								<TextBox Grid.Row="1" Grid.Column="1"
									Width="160"
									HorizontalAlignment="Left"
									materialDesign:HintAssist.Hint="Id" IsReadOnly="True"
									Style="{StaticResource NumericFormTextBox}"
									Text="{Binding CurrentEdit.Id}" />
								<TextBlock Grid.Row="2"
									Style="{StaticResource FormLabel}"
									Text="親ベース" />
								<ComboBox Grid.Row="2" Grid.Column="1"
									materialDesign:HintAssist.Hint="制度・名称・版"
									ItemsSource="{Binding BaseOptions}"
									SelectedValue="{Binding CurrentEdit.Id_PointBase, Mode=TwoWay}"
									SelectedValuePath="Id"
									Style="{StaticResource FormComboBox}">
									<ComboBox.ItemTemplate>
										<DataTemplate>
											<TextBlock Foreground="{DynamicResource MaterialDesignBody}">
												<TextBlock.Text>
													<MultiBinding StringFormat="{}{0} {1} (版{2})">
														<Binding Path="Code" />
														<Binding Path="Name" />
														<Binding Path="Version" />
													</MultiBinding>
												</TextBlock.Text>
											</TextBlock>
										</DataTemplate>
									</ComboBox.ItemTemplate>
								</ComboBox>
								<TextBlock Grid.Row="3" Grid.Column="1"
									Margin="0,0,0,4"
									FontSize="13"
									Foreground="{DynamicResource MaterialDesignBodyLight}"
									Text="親Id=0は移行設定待ちです。保存前に親の版を選択してください。" TextWrapping="Wrap" />
								<TextBlock Grid.Row="4"
									Style="{StaticResource FormLabel}"
									Text="ランクコード" />
								<TextBox Grid.Row="4" Grid.Column="1"
									Width="180"
									HorizontalAlignment="Left"
									materialDesign:HintAssist.Hint="ランクコード"
									Style="{StaticResource NumericFormTextBox}"
									Text="{Binding CurrentEdit.Kubun, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" />
								<TextBlock Grid.Row="5"
									Style="{StaticResource FormLabel}"
									Text="名称" />
								<TextBox Grid.Row="5" Grid.Column="1"
									materialDesign:HintAssist.Hint="名称" materialDesign:TextFieldAssist.CharacterCounterVisibility="Collapsed" MaxLength="40"
									Style="{StaticResource FormTextBox}"
									Text="{Binding CurrentEdit.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
								<TextBlock Grid.Row="6" Grid.ColumnSpan="2"
									Margin="0,12,0,4"
									FontWeight="SemiBold"
									Foreground="{DynamicResource PrimaryHueMidBrush}"
									Text="付与条件" />
								<TextBlock Grid.Row="7"
									Style="{StaticResource FormLabel}"
									Text="付与単価(円)" />
								<TextBox Grid.Row="7" Grid.Column="1"
									Width="180"
									HorizontalAlignment="Left"
									materialDesign:HintAssist.Hint="付与単価(円)"
									Style="{StaticResource NumericFormTextBox}"
									Text="{Binding CurrentEdit.PointUnitPrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" />
								<TextBlock Grid.Row="8"
									Style="{StaticResource FormLabel}"
									Text="プロパー付与数" />
								<TextBox Grid.Row="8" Grid.Column="1"
									Width="180"
									HorizontalAlignment="Left"
									materialDesign:HintAssist.Hint="プロパー付与数"
									Style="{StaticResource NumericFormTextBox}"
									Text="{Binding CurrentEdit.PointAmountProper, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" />
								<TextBlock Grid.Row="9"
									Style="{StaticResource FormLabel}"
									Text="セール付与数" />
								<TextBox Grid.Row="9" Grid.Column="1"
									Width="180"
									HorizontalAlignment="Left"
									materialDesign:HintAssist.Hint="セール付与数"
									Style="{StaticResource NumericFormTextBox}"
									Text="{Binding CurrentEdit.PointAmountSale, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" />
								<TextBlock Grid.Row="10" Grid.ColumnSpan="2"
									Margin="0,16,0,0"
									Foreground="{DynamicResource MaterialDesignBodyLight}"
									Text="使用済みランク条件は変更・削除できません。新しいベース版に登録してください。" TextWrapping="Wrap" />
								<TextBlock Grid.Row="11" Grid.ColumnSpan="2"
									Margin="0,8,0,0"
									Foreground="{DynamicResource MaterialDesignBodyLight}"
									TextWrapping="Wrap">
									<TextBlock.Text>
										<MultiBinding StringFormat="{}登録日={0}  修正日={1}">
											<Binding Path="CurrentEdit.VdateC" />
											<Binding Path="CurrentEdit.VdateU" />
										</MultiBinding>
									</TextBlock.Text>
								</TextBlock>
							</Grid>
						</ScrollViewer>
					</TabItem>
				</TabControl>
			</materialDesign:Card>
		</Grid>
	</Grid>
</helpers:BaseWindow>
