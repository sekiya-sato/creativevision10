<helpers:BaseWindow x:Class="CvWpfclient.Views._06Uriage.ShukkaUriageInputView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:helpers="clr-namespace:CvWpfclient.Helpers"
	xmlns:local="clr-namespace:CvWpfclient.Views" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:vm="clr-namespace:CvWpfclient.ViewModels._06Uriage"
	Title="出荷・売上入力"
	Width="1400" Height="900"
	Background="{DynamicResource AppCommonBackgroundBrush}"
	Foreground="{DynamicResource MaterialDesignBody}"
	TextOptions.TextFormattingMode="Display"
	mc:Ignorable="d">
	<helpers:BaseWindow.DataContext>
		<vm:ShukkaUriageInputViewModel />
	</helpers:BaseWindow.DataContext>

	<helpers:BaseWindow.InputBindings>
		<KeyBinding Command="{Binding DoUpdateOnDetailTabCommand}"
			Gesture="F2" />
		<KeyBinding Command="{Binding DoDeleteOnDetailTabCommand}"
			Gesture="F3" />
		<KeyBinding Command="{Binding DoInsertOnDetailTabCommand}"
			Gesture="F4" />
		<KeyBinding Command="{Binding DoListOnListTabCommand}"
			Gesture="F5" />
	</helpers:BaseWindow.InputBindings>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<!--  ===== ヘッダー: ColorZone ツールバー =====  -->
		<materialDesign:ColorZone Grid.Row="0"
			Padding="12,8"
			materialDesign:ElevationAssist.Elevation="Dp4" Mode="PrimaryMid">
			<StackPanel Orientation="Horizontal">
				<Button Margin="0,0,8,0"
					Command="{Binding ExitCommand}"
					Style="{StaticResource ToolCommandButton}"
					ToolTip="閉じる (Esc)">
					<materialDesign:PackIcon Kind="ArrowLeft" />
				</Button>
				<materialDesign:PackIcon Width="28" Height="28"
					VerticalAlignment="Center"
					Kind="TruckDelivery" />
				<TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
					FontSize="20" FontWeight="SemiBold" Text="出荷・売上入力" />
			</StackPanel>
		</materialDesign:ColorZone>

		<!--  ===== メインコンテンツ =====  -->
		<TabControl x:Name="TabControlMain"
			Grid.Row="1"
			SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}"
			Style="{StaticResource MaterialDesignTabControl}">

			<!--  タブ1: 一覧画面  -->
			<TabItem x:Name="tabList"
				Height="0"
				d:Header="d:一覧画面" d:Height="40" Header="">
				<Grid Margin="12">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
					</Grid.RowDefinitions>
					<DockPanel Grid.Row="0"
						Margin="8,0,8,8">
						<Button Command="{Binding DoListOnListTabCommand}"
							DockPanel.Dock="Right"
							Style="{StaticResource MaterialDesignOutlinedButton}"
							ToolTip="一覧取得 (F5)">
							<StackPanel Orientation="Horizontal">
								<materialDesign:PackIcon VerticalAlignment="Center"
									Kind="DatabaseSearch" />
								<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
									Text="一覧取得" />
							</StackPanel>
						</Button>
						<StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
							<materialDesign:PackIcon Margin="0,0,6,0" VerticalAlignment="Center"
								Kind="FormatListBulleted" />
							<TextBlock Margin="0,0,16,0" VerticalAlignment="Center"
								FontSize="16" FontWeight="SemiBold" Text="一覧画面" />
							<Button Command="{Binding GoToDetailCommand}"
								CommandParameter="{Binding Current}"
								Style="{StaticResource MaterialDesignOutlinedButton}"
								ToolTip="選択中の伝票を表示">
								<StackPanel Orientation="Horizontal">
									<materialDesign:PackIcon VerticalAlignment="Center"
										Kind="FileDocumentEdit" />
									<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
										Text="伝票詳細" />
								</StackPanel>
							</Button>
						</StackPanel>
					</DockPanel>
					<materialDesign:Card Grid.Row="1"
						Padding="0"
						materialDesign:ElevationAssist.Elevation="Dp2" UniformCornerRadius="8">
						<Grid>
							<Grid.RowDefinitions>
								<RowDefinition Height="Auto" />
								<RowDefinition Height="*" />
							</Grid.RowDefinitions>

							<!--  カードヘッダー: 件数 + メッセージ  -->
							<Border Grid.Row="0"
								Padding="12,8"
								Background="{DynamicResource MaterialDesignToolBarBackground}"
								CornerRadius="8,8,0,0">
								<DockPanel>
									<TextBlock Margin="0,0,12,0" VerticalAlignment="Center"
										DockPanel.Dock="Right" FontSize="13"
										Foreground="{DynamicResource MaterialDesignBodyLight}"
										Text="{Binding Count, StringFormat={}件数: {0:N0}}" />
									<TextBlock VerticalAlignment="Center"
										FontSize="13"
										Foreground="{DynamicResource MaterialDesignBodyLight}"
										Text="{Binding Message}"
										TextTrimming="CharacterEllipsis" />
								</DockPanel>
							</Border>

							<!--  DataGrid 一覧  -->
							<DataGrid x:Name="ListGrid"
								Grid.Row="1"
								helpers:DataGridDoubleClick.Command="{Binding GoToDetailCommand}"
								helpers:DataGridSelectionBehavior.AutoScrollToSelectedItem="True" materialDesign:DataGridAssist.CellPadding="12,6" materialDesign:DataGridAssist.ColumnHeaderPadding="12,8"
								AutoGenerateColumns="False" EnableRowVirtualization="True" FrozenColumnCount="3" GridLinesVisibility="Horizontal"
								HorizontalGridLinesBrush="{DynamicResource MaterialDesignDivider}"
								IsReadOnly="True" IsSynchronizedWithCurrentItem="True"
								ItemsSource="{Binding ListData}"
								SelectedItem="{Binding Current, Mode=TwoWay}"
								Style="{StaticResource MaterialDesignDataGrid}"
								VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
								<DataGrid.Columns>
									<DataGridTextColumn Width="100"
										Binding="{Binding Id}"
										Header="伝票No" />
									<DataGridTextColumn Width="120"
										Binding="{Binding DenDay, Converter={StaticResource DateYmd8Converter}, StringFormat=yyyy/MM/dd}"
										Header="計上日" />
									<DataGridTextColumn Width="120"
										Binding="{Binding KakeDay, Converter={StaticResource DateYmd8Converter}, StringFormat=yyyy/MM/dd}"
										Header="掛計上日" />
									<DataGridTextColumn Width="100"
										Binding="{Binding VTokui.Cd}"
										Header="得意先CD" />
									<DataGridTextColumn Width="150"
										Binding="{Binding VTokui.Mei}"
										Header="得意先名" />
									<DataGridTextColumn Width="100"
										Binding="{Binding VSoko.Cd}"
										Header="倉庫CD" />
									<DataGridTextColumn Width="150"
										Binding="{Binding VSoko.Mei}"
										Header="倉庫名" />
									<DataGridTextColumn Width="100"
										Binding="{Binding SuTotal, StringFormat={}{0:N0}}"
										ElementStyle="{StaticResource DataGridRightTextBlock}"
										Header="合計数量" />
									<DataGridTextColumn Width="120"
										Binding="{Binding KingakuTotal, StringFormat={}{0:N0}}"
										ElementStyle="{StaticResource DataGridRightTextBlock}"
										Header="合計金額" />
								</DataGrid.Columns>
								<DataGrid.ColumnHeaderStyle>
									<Style BasedOn="{StaticResource MenteDataGridColumnHeader}"
										TargetType="DataGridColumnHeader" />
								</DataGrid.ColumnHeaderStyle>
							</DataGrid>
						</Grid>
					</materialDesign:Card>
				</Grid>
			</TabItem>

			<!--  タブ2: 詳細画面  -->
			<TabItem x:Name="tabDetail"
				Height="0"
				d:Header="d:詳細画面" d:Height="40" Header="">
				<Grid Margin="12">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
					</Grid.RowDefinitions>

					<DockPanel Grid.Row="0"
						Margin="8,0,8,8">
						<StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
							<Button Margin="4,0"
								Command="{Binding DoUpdateOnDetailTabCommand}"
								Style="{StaticResource MaterialDesignRaisedButton}"
								ToolTip="修正 (F2)">
								<StackPanel Orientation="Horizontal">
									<materialDesign:PackIcon VerticalAlignment="Center"
										Kind="Pencil" />
									<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
										Text="修正" />
								</StackPanel>
							</Button>
							<Button Margin="4,0"
								Command="{Binding DoDeleteOnDetailTabCommand}"
								Style="{StaticResource MaterialDesignOutlinedButton}"
								ToolTip="削除 (F3)">
								<StackPanel Orientation="Horizontal">
									<materialDesign:PackIcon VerticalAlignment="Center"
										Kind="Delete" />
									<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
										Text="削除" />
								</StackPanel>
							</Button>
							<Button Margin="4,0"
								Command="{Binding DoInsertOnDetailTabCommand}"
								Style="{StaticResource MaterialDesignOutlinedButton}"
								ToolTip="追加 (F4)">
								<StackPanel Orientation="Horizontal">
									<materialDesign:PackIcon VerticalAlignment="Center"
										Kind="Plus" />
									<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
										Text="追加" />
								</StackPanel>
							</Button>
						</StackPanel>
						<StackPanel Orientation="Horizontal">
							<materialDesign:PackIcon Margin="0,0,6,0" VerticalAlignment="Center"
								Kind="FileDocumentEdit" />
							<StackPanel Margin="0,0,16,0">
								<TextBlock FontSize="12"
									Foreground="{DynamicResource MaterialDesignBodyLight}"
									Text="売上伝票" />
								<TextBlock FontSize="16" FontWeight="SemiBold"
									Text="{Binding DetailStatusText}" />
							</StackPanel>
							<Button Command="{Binding GoToListCommand}"
								Style="{StaticResource MaterialDesignOutlinedButton}"
								ToolTip="一覧画面へ戻る">
								<StackPanel Orientation="Horizontal">
									<materialDesign:PackIcon VerticalAlignment="Center"
										Kind="FormatListBulleted" />
									<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
										Text="一覧に戻る" />
								</StackPanel>
							</Button>
						</StackPanel>
					</DockPanel>

					<Grid Grid.Row="1">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<ScrollViewer Grid.Column="0"
							MaxHeight="370"
							Padding="10,10,20,20"
							VerticalScrollBarVisibility="Auto">
							<StackPanel>
								<!--  横並び: 計上日・掛計上日・区分・請求フラグ・合計  -->
								<WrapPanel Margin="0,4"
									Orientation="Horizontal">
									<StackPanel Margin="0,0,16,0"
										Orientation="Horizontal">
										<TextBlock Style="{StaticResource FormLabel}"
											Text="計上日" />
										<DatePicker Width="150"
											Margin="0,4"
											helpers:DatePickerTodayButtonBehavior.IsEnabled="True" materialDesign:HintAssist.Hint="計上日" FontSize="20" IsTodayHighlighted="False"
											SelectedDate="{Binding CurrentEdit.DenDay, Converter={StaticResource DateYmd8Converter}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
											Style="{StaticResource FormDatePicker}" />
									</StackPanel>
									<StackPanel Margin="0,0,16,0"
										Orientation="Horizontal">
										<TextBlock Style="{StaticResource FormLabel}"
											Text="掛計上日" />
										<DatePicker Width="150"
											Margin="0,4"
											helpers:DatePickerTodayButtonBehavior.IsEnabled="True" materialDesign:HintAssist.Hint="掛計上日" FontSize="20" IsTodayHighlighted="False"
											SelectedDate="{Binding CurrentEdit.KakeDay, Converter={StaticResource DateYmd8Converter}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
											Style="{StaticResource FormDatePicker}" />
									</StackPanel>
									<StackPanel Margin="0,0,16,0"
										Orientation="Horizontal">
										<TextBlock Style="{StaticResource FormLabel}"
											Text="区分" />
										<ComboBox Width="150"
											Margin="0,4"
											materialDesign:HintAssist.Hint="区分" DisplayMemberPath="Name"
											ItemsSource="{Binding KubunOptions}"
											SelectedValue="{Binding CurrentEdit.EnKubun, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
											SelectedValuePath="Value"
											Style="{StaticResource FormComboBox}" />
									</StackPanel>
									<StackPanel Margin="0,0,16,0"
										Orientation="Horizontal">
										<TextBlock Style="{StaticResource FormLabel}"
											Text="請求" />
										<ComboBox Width="130"
											Margin="0,4"
											materialDesign:HintAssist.Hint="請求" DisplayMemberPath="Name"
											ItemsSource="{Binding IsPayOptions}"
											SelectedValue="{Binding CurrentEdit.EnIsPay, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
											SelectedValuePath="Value"
											Style="{StaticResource FormComboBox}" />
									</StackPanel>
								</WrapPanel>

								<!--  縦並び: 得意先・倉庫・伝票担当・伝票情報・メモ  -->
								<Grid Margin="0,4,0,0">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="110" />
										<ColumnDefinition Width="420" />
										<ColumnDefinition Width="120" />
										<ColumnDefinition Width="*" />
									</Grid.ColumnDefinitions>
									<Grid.RowDefinitions>
										<RowDefinition Height="Auto" />
										<RowDefinition Height="Auto" />
										<RowDefinition Height="Auto" />
										<RowDefinition Height="Auto" />
									</Grid.RowDefinitions>

									<!--  得意先  -->
									<TextBlock Grid.Row="0"
										Style="{StaticResource FormLabel}"
										Text="得意先Id" />
									<DockPanel Grid.Row="0" Grid.Column="1"
										Margin="0,4">
										<TextBox Width="120" Height="36"
											HorizontalContentAlignment="Left"
											helpers:SearchTextBoxAssist.Command="{Binding DoSelectTokuiCommand}"
											BorderThickness="0,0,0,1" DockPanel.Dock="Left"
											Style="{StaticResource MenteSearchTextBox}"
											Text="{Binding CurrentEdit.Id_Tokui, UpdateSourceTrigger=PropertyChanged}" />
										<TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
											Foreground="{DynamicResource MaterialDesignBody}">
											<TextBlock.Text>
												<MultiBinding StringFormat="{}{0} {1}">
													<Binding Path="CurrentEdit.VTokui.Cd" />
													<Binding Path="CurrentEdit.VTokui.Mei" />
												</MultiBinding>
											</TextBlock.Text>
										</TextBlock>
									</DockPanel>

									<!--  伝票担当  -->
									<TextBlock Grid.Row="0" Grid.Column="2"
										Style="{StaticResource FormLabel}"
										Text="伝票担当Id" />
									<DockPanel Grid.Row="0" Grid.Column="3"
										Margin="0,4">
										<TextBox Width="120" Height="36"
											HorizontalContentAlignment="Left"
											helpers:SearchTextBoxAssist.Command="{Binding DoSelectShainCommand}"
											BorderThickness="0,0,0,1" DockPanel.Dock="Left"
											Style="{StaticResource MenteSearchTextBox}"
											Text="{Binding CurrentEdit.Id_Shain, UpdateSourceTrigger=PropertyChanged}" />
										<TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
											Foreground="{DynamicResource MaterialDesignBody}">
											<TextBlock.Text>
												<MultiBinding StringFormat="{}{0} {1}">
													<Binding Path="CurrentEdit.VShain.Cd" />
													<Binding Path="CurrentEdit.VShain.Mei" />
												</MultiBinding>
											</TextBlock.Text>
										</TextBlock>
									</DockPanel>

									<!--  倉庫  -->
									<TextBlock Grid.Row="1"
										Style="{StaticResource FormLabel}"
										Text="倉庫Id" />
									<DockPanel Grid.Row="1" Grid.Column="1"
										Margin="0,4">
										<TextBox Width="120" Height="36"
											HorizontalContentAlignment="Left"
											helpers:SearchTextBoxAssist.Command="{Binding DoSelectSokoCommand}"
											BorderThickness="0,0,0,1" DockPanel.Dock="Left"
											Style="{StaticResource MenteSearchTextBox}"
											Text="{Binding CurrentEdit.Id_Soko, UpdateSourceTrigger=PropertyChanged}" />
										<TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
											Foreground="{DynamicResource MaterialDesignBody}">
											<TextBlock.Text>
												<MultiBinding StringFormat="{}{0} {1}">
													<Binding Path="CurrentEdit.VSoko.Cd" />
													<Binding Path="CurrentEdit.VSoko.Mei" />
												</MultiBinding>
											</TextBlock.Text>
										</TextBlock>
									</DockPanel>

									<!--  手入力No  -->
									<TextBlock Grid.Row="1" Grid.Column="2"
										Style="{StaticResource FormLabel}"
										Text="手入力No" />
									<TextBox Grid.Row="1" Grid.Column="3"
										Width="180"
										Margin="0,4" HorizontalAlignment="Left"
										materialDesign:HintAssist.Hint="手入力No"
										Style="{StaticResource FormTextBox}"
										Text="{Binding CurrentEdit.ManualNo, UpdateSourceTrigger=PropertyChanged}" />

									<TextBlock Grid.Row="2"
										Style="{StaticResource FormLabel}"
										Text="関連No1" />
									<TextBox Grid.Row="2" Grid.Column="1"
										Width="140"
										Margin="0,4" HorizontalAlignment="Left" HorizontalContentAlignment="Right"
										materialDesign:HintAssist.Hint="関連No1"
										Style="{StaticResource FormTextBox}"
										Text="{Binding CurrentEdit.RelateNo1, UpdateSourceTrigger=PropertyChanged}" />

									<TextBlock Grid.Row="2" Grid.Column="2"
										Style="{StaticResource FormLabel}"
										Text="関連No2" />
									<StackPanel Grid.Row="2" Grid.Column="3"
										Orientation="Horizontal">
										<TextBox Width="140"
											Margin="0,4" HorizontalContentAlignment="Right"
											materialDesign:HintAssist.Hint="関連No2"
											Style="{StaticResource FormTextBox}"
											Text="{Binding CurrentEdit.RelateNo2, UpdateSourceTrigger=PropertyChanged}" />
										<TextBlock Margin="24,0,8,0"
											Style="{StaticResource FormLabel}"
											Text="掛率" />
										<TextBox Width="100"
											Margin="0,4" HorizontalContentAlignment="Right"
											materialDesign:HintAssist.Hint="掛率"
											Style="{StaticResource FormTextBox}"
											Text="{Binding CurrentEdit.Rate, UpdateSourceTrigger=PropertyChanged}" />
									</StackPanel>

									<!--  メモ  -->
									<TextBlock Grid.Row="3"
										InputMethod.IsInputMethodEnabled="True"
										Style="{StaticResource FormLabel}"
										Text="メモ" />
									<TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3"
										MinHeight="50"
										materialDesign:HintAssist.Hint="メモ" AcceptsReturn="True"
										Style="{StaticResource FormTextBox}"
										Text="{Binding CurrentEdit.Memo}"
										TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
								</Grid>
							</StackPanel>
						</ScrollViewer>
						<materialDesign:Card Grid.Column="1"
							Margin="12,10,0,10" Padding="16,12" VerticalAlignment="Top"
							materialDesign:ElevationAssist.Elevation="Dp1" UniformCornerRadius="8">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="Auto" MinWidth="72" />
									<ColumnDefinition Width="150" />
								</Grid.ColumnDefinitions>
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
								</Grid.RowDefinitions>

								<StackPanel Grid.Row="0" Grid.ColumnSpan="2"
									Margin="0,0,0,8"
									Orientation="Horizontal">
									<materialDesign:PackIcon VerticalAlignment="Center"
										Kind="ReceiptText" />
									<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
										FontSize="14" FontWeight="SemiBold" Text="伝票サマリー" />
								</StackPanel>

								<TextBlock Grid.Row="1" Grid.Column="0"
									Style="{StaticResource FormLabel}"
									Text="合計数量" />
								<TextBlock Grid.Row="1" Grid.Column="1"
									Margin="0,4" HorizontalAlignment="Right" VerticalAlignment="Center"
									FontSize="16"
									Foreground="{DynamicResource MaterialDesignBody}"
									Text="{Binding CurrentEdit.SuTotal, StringFormat={}{0:N0}}" />
								<TextBlock Grid.Row="2" Grid.Column="0"
									Style="{StaticResource FormLabel}"
									Text="合計金額" />
								<TextBlock Grid.Row="2" Grid.Column="1"
									Margin="0,4" HorizontalAlignment="Right" VerticalAlignment="Center"
									FontSize="16"
									Foreground="{DynamicResource MaterialDesignBody}"
									Text="{Binding CurrentEdit.KingakuTotal, StringFormat={}{0:N0}}" />
								<TextBlock Grid.Row="3" Grid.Column="0"
									Style="{StaticResource FormLabel}"
									Text="上代合計" />
								<TextBlock Grid.Row="3" Grid.Column="1"
									Margin="0,4" HorizontalAlignment="Right" VerticalAlignment="Center"
									FontSize="16"
									Foreground="{DynamicResource MaterialDesignBody}"
									Text="{Binding CurrentEdit.JodaiTotal, StringFormat={}{0:N0}}" />
								<TextBlock Grid.Row="4" Grid.Column="0"
									VerticalAlignment="Center"
									FontWeight="Bold"
									Foreground="{DynamicResource MaterialDesignBody}"
									Text="下代合計" />
								<TextBlock Grid.Row="4" Grid.Column="1"
									HorizontalAlignment="Right" VerticalAlignment="Center"
									FontSize="18" FontWeight="Bold"
									Foreground="{DynamicResource MaterialDesignBody}"
									Text="{Binding CurrentEdit.GedaiTotal, StringFormat={}{0:N0}}" />
							</Grid>
						</materialDesign:Card>
					</Grid>

					<StackPanel Grid.Row="2"
						Margin="8,0,8,0" HorizontalAlignment="Center"
						Orientation="Horizontal">
						<Button Margin="8,0"
							Command="{Binding AddMeisaiCommand}"
							Style="{StaticResource MaterialDesignOutlinedButton}">
							<StackPanel Orientation="Horizontal">
								<materialDesign:PackIcon VerticalAlignment="Center"
									Kind="Plus" />
								<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
									Text="明細行追加" />
							</StackPanel>
						</Button>
						<Button Margin="8,0"
							Command="{Binding DeleteMeisaiCommand}"
							Style="{StaticResource MaterialDesignOutlinedButton}">
							<StackPanel Orientation="Horizontal">
								<materialDesign:PackIcon VerticalAlignment="Center"
									Kind="Delete" />
								<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
									Text="明細行削除" />
							</StackPanel>
						</Button>
						<Button Margin="40,0,10,0"
							Command="{Binding DoInputBarcodeCommand}"
							Style="{StaticResource MaterialDesignOutlinedButton}">
							<StackPanel Orientation="Horizontal">
								<materialDesign:PackIcon VerticalAlignment="Center"
									Kind="BarcodeScan" />
								<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
									Text="バーコード入力" />
							</StackPanel>
						</Button>
						<Button Margin="8,0,0,0"
							Command="{Binding DoInputShohinColSizCommand}"
							Style="{StaticResource MaterialDesignOutlinedButton}"
							ToolTip="明細カーソル行の商品マスタに対する色サイズ一括数量入力を行います">
							<StackPanel Orientation="Horizontal">
								<materialDesign:PackIcon VerticalAlignment="Center"
									Kind="Palette" />
								<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
									Text="色サイズ一括数量入力" />
							</StackPanel>
						</Button>
					</StackPanel>

					<!--  DataGrid 明細  -->
					<DataGrid x:Name="MeisaiGrid"
						Grid.Row="3"
						Margin="0,8,0,0"
						d:ItemsSource="{d:SampleData ItemCount=5}"
