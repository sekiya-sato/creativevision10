<helpers:BaseWindow x:Class="CvWpfclient.Views._06Uriage.NyukinMatchingView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:helpers="clr-namespace:CvWpfclient.Helpers"
	xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:vm="clr-namespace:CvWpfclient.ViewModels._06Uriage"
	Title="{Binding Title}"
	Width="1440" Height="860"
	Background="{DynamicResource AppCommonBackgroundBrush}"
	FontSize="14"
	Foreground="{DynamicResource MaterialDesignBody}"
	TextOptions.TextFormattingMode="Display" WindowStartupLocation="CenterScreen"
	mc:Ignorable="d">
	<helpers:BaseWindow.DataContext>
		<vm:NyukinMatchingViewModel />
	</helpers:BaseWindow.DataContext>

	<helpers:BaseWindow.InputBindings>
		<KeyBinding Command="{Binding SearchCommand}"
			Gesture="F5" />
		<KeyBinding Command="{Binding ExecuteKesikomiCommand}"
			Gesture="F6" />
		<KeyBinding Command="{Binding ExitCommand}"
			Gesture="Esc" />
	</helpers:BaseWindow.InputBindings>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<materialDesign:ColorZone Grid.Row="0"
			Padding="12,8"
			materialDesign:ElevationAssist.Elevation="Dp4" Mode="PrimaryMid">
			<DockPanel>
				<StackPanel VerticalAlignment="Center"
					DockPanel.Dock="Right" Orientation="Horizontal">
					<TextBlock Margin="16,0,0,0" VerticalAlignment="Center"
						Text="売上計:" />
					<TextBlock Margin="4,0,0,0" VerticalAlignment="Center"
						FontWeight="SemiBold"
						Text="{Binding DenTotal, StringFormat={}{0:N0}}" />
					<TextBlock Margin="16,0,0,0" VerticalAlignment="Center"
						Text="消込計:" />
					<TextBlock Margin="4,0,0,0" VerticalAlignment="Center"
						FontWeight="SemiBold"
						Text="{Binding CheckedTotal, StringFormat={}{0:N0}}" />
					<TextBlock Margin="16,0,0,0" VerticalAlignment="Center"
						Text="入金計:" />
					<TextBlock Margin="4,0,0,0" VerticalAlignment="Center"
						FontWeight="SemiBold"
						Text="{Binding KinTotal, StringFormat={}{0:N0}}" />
				</StackPanel>
				<StackPanel Orientation="Horizontal">
					<Button Margin="0,0,8,0"
						Command="{Binding ExitCommand}"
						Style="{StaticResource ToolCommandButton}"
						ToolTip="閉じる (Esc)">
						<materialDesign:PackIcon Kind="ArrowLeft" />
					</Button>
					<materialDesign:PackIcon Width="26" Height="26"
						VerticalAlignment="Center"
						Kind="CashCheck" />
					<TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
						FontSize="18" FontWeight="SemiBold"
						Text="{Binding Title}" />
				</StackPanel>
			</DockPanel>
		</materialDesign:ColorZone>

		<Border Grid.Row="1"
			Margin="12,12,12,0" Padding="12"
			BorderBrush="{DynamicResource MaterialDesignDivider}"
			BorderThickness="1" CornerRadius="4">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="120" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" />
				</Grid.ColumnDefinitions>

				<!--  請求先（必須）  -->
				<TextBlock Grid.Row="0" Grid.Column="0"
					Margin="0,4" VerticalAlignment="Center"
					Text="請求先" />
				<TextBox Grid.Row="0" Grid.Column="1"
					Width="300" Height="32"
					Margin="0,4" HorizontalAlignment="Left" HorizontalContentAlignment="Left"
					helpers:SearchTextBoxAssist.Command="{Binding SelectPaysakiCommand}"
					BorderThickness="0,0,0,1" IsReadOnly="True"
					Style="{StaticResource MenteSearchTextBox}"
					Text="{Binding PaysakiDisplay}"
					ToolTip="必須。請求先を選択する（配下の得意先をまとめて対象にする）" />
				<TextBlock Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="2"
					Margin="8,0" VerticalAlignment="Center"
					Foreground="{DynamicResource MaterialDesignValidationErrorBrush}"
					Text="必須" />

				<!--  得意先（任意）  -->
				<TextBlock Grid.Row="1" Grid.Column="0"
					Margin="0,4" VerticalAlignment="Center"
					Text="得意先" />
				<TextBox Grid.Row="1" Grid.Column="1"
					Width="300" Height="32"
					Margin="0,4" HorizontalAlignment="Left" HorizontalContentAlignment="Left"
					helpers:SearchTextBoxAssist.Command="{Binding SelectToriCommand}"
					BorderThickness="0,0,0,1" IsReadOnly="True"
					Style="{StaticResource MenteSearchTextBox}"
					Text="{Binding ToriDisplay}"
					ToolTip="任意。指定すると売上一覧を1社へ絞る（入金は請求先配下すべてを集計する）" />
				<Button Grid.Row="1" Grid.Column="2"
					Margin="8,4,0,4"
					Command="{Binding ClearToriCommand}"
					Style="{StaticResource MaterialDesignOutlinedButton}"
					ToolTip="得意先の絞り込みを解除する">
					<TextBlock Text="解除" />
				</Button>

				<!--  掛計上日  -->
				<TextBlock Grid.Row="2" Grid.Column="0"
					Margin="0,4" VerticalAlignment="Center"
					Text="掛計上日" />
				<TextBox Grid.Row="2" Grid.Column="1"
					Width="180" Height="32"
					Margin="0,4" HorizontalAlignment="Left" HorizontalContentAlignment="Left"
					Style="{StaticResource MaterialDesignTextBox}"
					Text="{Binding KakeDayFromText, UpdateSourceTrigger=PropertyChanged}" />
				<TextBlock Grid.Row="2" Grid.Column="2"
					Margin="8,0" VerticalAlignment="Center"
					Text="～" />
				<TextBox Grid.Row="2" Grid.Column="3"
					Width="180" Height="32"
					Margin="0,4" HorizontalAlignment="Left" HorizontalContentAlignment="Left"
					Style="{StaticResource MaterialDesignTextBox}"
					Text="{Binding KakeDayToText, UpdateSourceTrigger=PropertyChanged}" />

				<!--  支払日  -->
				<TextBlock Grid.Row="3" Grid.Column="0"
					Margin="0,4" VerticalAlignment="Center"
					Text="支払日" />
				<TextBox Grid.Row="3" Grid.Column="1"
					Width="180" Height="32"
					Margin="0,4" HorizontalAlignment="Left" HorizontalContentAlignment="Left"
					Style="{StaticResource MaterialDesignTextBox}"
					Text="{Binding PayDayFromText, UpdateSourceTrigger=PropertyChanged}" />
				<TextBlock Grid.Row="3" Grid.Column="2"
					Margin="8,0" VerticalAlignment="Center"
					Text="～" />
				<TextBox Grid.Row="3" Grid.Column="3"
					Width="180" Height="32"
					Margin="0,4" HorizontalAlignment="Left" HorizontalContentAlignment="Left"
					Style="{StaticResource MaterialDesignTextBox}"
					Text="{Binding PayDayToText, UpdateSourceTrigger=PropertyChanged}"
					ToolTip="入金伝票の掛計上日(KakeDay)で絞る" />

				<StackPanel Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3"
					Margin="0,4">
					<TextBlock Text="消込は伝票単位の目印です。充当金額は保持せず、売掛残高（SummaryUriKake）は消込の有無で変わりません。" TextWrapping="Wrap" />
					<TextBlock Text="振込手数料の負担や消費税の集計単位により、売上計と入金計は一致しない場合があります。" TextWrapping="Wrap" />
					<TextBlock Foreground="{DynamicResource MaterialDesignValidationErrorBrush}"
						Text="返品・値引伝票は金額がマイナスになります（CalcFlag=-1）。" TextWrapping="Wrap" />
					<TextBlock Foreground="{DynamicResource MaterialDesignValidationErrorBrush}"
						Text="店舗売上(Tran01Tenuri)は売掛が立たないため含めません。" TextWrapping="Wrap" />
				</StackPanel>

				<StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="4"
					Margin="0,12,0,0" HorizontalAlignment="Left"
					Orientation="Horizontal">
					<TextBlock Margin="0,0,8,0" VerticalAlignment="Center"
						Text="取得件数上限" />
					<TextBox Width="80" Height="32"
						Margin="0,0,16,0"
						Style="{StaticResource MaterialDesignTextBox}"
						Text="{Binding MaxCountText, UpdateSourceTrigger=PropertyChanged}" />
					<Button Command="{Binding SearchCommand}"
						IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
						Style="{StaticResource MaterialDesignFlatMidBgButton}"
						ToolTip="一覧取得 (F5)">
						<StackPanel Orientation="Horizontal">
							<materialDesign:PackIcon VerticalAlignment="Center"
								Kind="Magnify" />
							<TextBlock Margin="8,0,0,0" VerticalAlignment="Center"
								FontSize="16" Text="一覧取得" />
						</StackPanel>
					</Button>
					<Button Margin="12,0,0,0"
						Command="{Binding ExecuteKesikomiCommand}"
						IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
						Style="{StaticResource MaterialDesignFlatMidBgButton}"
						ToolTip="チェックの変化した伝票を消込／解除する (F6)">
						<StackPanel Orientation="Horizontal">
							<materialDesign:PackIcon VerticalAlignment="Center"
								Kind="CheckDecagram" />
							<TextBlock Margin="8,0,0,0" VerticalAlignment="Center"
								FontSize="16" Text="消込実行" />
						</StackPanel>
					</Button>
					<Button Margin="12,0,0,0"
						Command="{Binding CheckAllCommand}"
						Style="{StaticResource MaterialDesignOutlinedButton}"
						ToolTip="一覧の消込Flgを全てONにする">
						<TextBlock FontSize="16" Text="全チェック" />
					</Button>
					<Button Margin="12,0,0,0"
						Command="{Binding UncheckAllCommand}"
						Style="{StaticResource MaterialDesignOutlinedButton}"
						ToolTip="一覧の消込Flgを全てOFFにする">
						<TextBlock FontSize="16" Text="全解除" />
					</Button>
					<Button Margin="12,0,0,0"
						Command="{Binding ClearConditionsCommand}"
						Style="{StaticResource MaterialDesignOutlinedButton}"
						ToolTip="検索条件をクリア">
						<TextBlock FontSize="16" Text="条件クリア" />
					</Button>
				</StackPanel>
			</Grid>
		</Border>

		<Grid Grid.Row="2"
			Margin="12">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="2*" />
				<ColumnDefinition Width="6" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>
			<DockPanel Grid.Column="0">
				<StackPanel Margin="0,0,0,6"
					DockPanel.Dock="Top" Orientation="Horizontal">
					<TextBlock FontSize="16" FontWeight="SemiBold" Text="卸売上（消込対象）" />
					<TextBlock Margin="16,0,0,0" VerticalAlignment="Center"
						Text="{Binding CheckedCount, StringFormat='チェック {0:N0} 件'}" />
					<TextBlock Margin="16,0,0,0" VerticalAlignment="Center"
						Foreground="{DynamicResource MaterialDesignValidationErrorBrush}"
						Text="{Binding ChangedCount, StringFormat='未反映の変更 {0:N0} 件'}" />
				</StackPanel>
				<DataGrid AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="False"
					ItemsSource="{Binding DenRows}"
					SelectedItem="{Binding SelectedDenRow}"
					SelectionMode="Single" SelectionUnit="FullRow" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
					<DataGrid.Columns>
						<!--  合計を即時連動させるため CheckBoxColumn ではなく TemplateColumn を使う  -->
						<DataGridTemplateColumn Width="60"
							Header="消込">
							<DataGridTemplateColumn.CellTemplate>
								<DataTemplate>
									<CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
										IsChecked="{Binding IsKesikomi, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
								</DataTemplate>
							</DataGridTemplateColumn.CellTemplate>
						</DataGridTemplateColumn>
						<DataGridTextColumn Width="80"
							Binding="{Binding Id}"
							Header="伝票No" IsReadOnly="True">
							<DataGridTextColumn.ElementStyle>
								<Style TargetType="TextBlock">
									<Setter Property="HorizontalAlignment" Value="Right" />
								</Style>
							</DataGridTextColumn.ElementStyle>
						</DataGridTextColumn>
						<DataGridTextColumn Width="90"
							Binding="{Binding KakeDay}"
							Header="掛計上日" IsReadOnly="True" />
						<DataGridTextColumn Width="260"
							Binding="{Binding ToriDisplay}"
							Header="得意先" IsReadOnly="True" />
						<DataGridTextColumn Width="90"
							Binding="{Binding KubunText}"
							Header="取引区分" IsReadOnly="True" />
						<DataGridTextColumn Width="90"
							Binding="{Binding ManualNo}"
							Header="手入力No" IsReadOnly="True" />
						<DataGridTextColumn Width="110"
							Binding="{Binding Amount, StringFormat={}{0:N0}}"
							Header="金額" IsReadOnly="True">
							<DataGridTextColumn.ElementStyle>
								<Style TargetType="TextBlock">
									<Setter Property="HorizontalAlignment" Value="Right" />
								</Style>
							</DataGridTextColumn.ElementStyle>
						</DataGridTextColumn>
					</DataGrid.Columns>
				</DataGrid>
			</DockPanel>
			<GridSplitter Grid.Column="1"
				Width="6"
				HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
				Background="{DynamicResource MaterialDesignDivider}" />
			<DockPanel Grid.Column="2">
				<TextBlock Margin="0,0,0,6"
					DockPanel.Dock="Top" FontSize="16" FontWeight="SemiBold" Text="入金（区分別集計）" />
				<DataGrid AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
					ItemsSource="{Binding KinRows}"
					SelectedItem="{Binding SelectedKinRow}"
					SelectionMode="Single" SelectionUnit="FullRow" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
					<DataGrid.Columns>
						<DataGridTextColumn Width="90"
							Binding="{Binding CodeKin}"
							Header="区分CD" />
						<DataGridTextColumn Width="180"
							Binding="{Binding MeiKin}"
							Header="区分名称" />
						<DataGridTextColumn Width="70"
							Binding="{Binding Count, StringFormat={}{0:N0}}"
							Header="件数">
							<DataGridTextColumn.ElementStyle>
								<Style TargetType="TextBlock">
									<Setter Property="HorizontalAlignment" Value="Right" />
								</Style>
							</DataGridTextColumn.ElementStyle>
						</DataGridTextColumn>
						<DataGridTextColumn Width="120"
							Binding="{Binding Amount, StringFormat={}{0:N0}}"
							Header="金額">
							<DataGridTextColumn.ElementStyle>
								<Style TargetType="TextBlock">
									<Setter Property="HorizontalAlignment" Value="Right" />
								</Style>
							</DataGridTextColumn.ElementStyle>
						</DataGridTextColumn>
					</DataGrid.Columns>
				</DataGrid>
			</DockPanel>
		</Grid>

		<Border Grid.Row="3"
			Padding="12,6"
			Background="{DynamicResource MaterialDesignChipBackground}">
			<TextBlock VerticalAlignment="Center"
				Text="{Binding Message}"
				TextTrimming="CharacterEllipsis" />
		</Border>
	</Grid>
</helpers:BaseWindow>
