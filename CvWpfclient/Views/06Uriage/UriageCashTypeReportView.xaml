<helpers:BaseWindow x:Class="CvWpfclient.Views._06Uriage.UriageCashTypeReportView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:helpers="clr-namespace:CvWpfclient.Helpers"
	xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:vm="clr-namespace:CvWpfclient.ViewModels._06Uriage"
	Title="{Binding Title}"
	Width="1200" Height="760"
	Background="{DynamicResource AppCommonBackgroundBrush}"
	FontSize="14"
	Foreground="{DynamicResource MaterialDesignBody}"
	TextOptions.TextFormattingMode="Display" WindowStartupLocation="CenterScreen"
	mc:Ignorable="d">
	<helpers:BaseWindow.DataContext>
		<vm:UriageCashTypeReportViewModel />
	</helpers:BaseWindow.DataContext>

	<helpers:BaseWindow.InputBindings>
		<KeyBinding Command="{Binding SearchCommand}"
			Gesture="F5" />
		<KeyBinding Command="{Binding ExitCommand}"
			Gesture="Esc" />
	</helpers:BaseWindow.InputBindings>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<materialDesign:ColorZone Grid.Row="0"
			Padding="12,8"
			materialDesign:ElevationAssist.Elevation="Dp4" Mode="PrimaryMid">
			<DockPanel>
				<StackPanel DockPanel.Dock="Right" VerticalAlignment="Center"
					Orientation="Horizontal">
					<TextBlock Margin="16,0,0,0" VerticalAlignment="Center"
						Text="件数:" />
					<TextBlock Margin="4,0,0,0" VerticalAlignment="Center"
						FontWeight="SemiBold"
						Text="{Binding RowCount, StringFormat={}{0:N0}}" />
					<TextBlock Margin="16,0,0,0" VerticalAlignment="Center"
						Text="売上計:" />
					<TextBlock Margin="4,0,0,0" VerticalAlignment="Center"
						FontWeight="SemiBold"
						Text="{Binding TotalKingaku, StringFormat={}{0:N0}}" />
					<TextBlock Margin="16,0,0,0" VerticalAlignment="Center"
						Text="金種計:" />
					<TextBlock Margin="4,0,0,0" VerticalAlignment="Center"
						FontWeight="SemiBold"
						Text="{Binding TotalPayment, StringFormat={}{0:N0}}" />
					<TextBlock Margin="16,0,0,0" VerticalAlignment="Center"
						Text="差額:" />
					<TextBlock Margin="4,0,0,0" VerticalAlignment="Center"
						FontWeight="SemiBold"
						Text="{Binding TotalDiff, StringFormat={}{0:N0}}" />
				</StackPanel>
				<StackPanel Orientation="Horizontal">
					<Button Margin="0,0,8,0"
						Command="{Binding ExitCommand}"
						Style="{StaticResource ToolCommandButton}"
						ToolTip="閉じる (Esc)">
						<materialDesign:PackIcon Kind="ArrowLeft" />
					</Button>
					<materialDesign:PackIcon Width="26" Height="26"
						VerticalAlignment="Center"
						Kind="Magnify" />
					<TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
						FontSize="18" FontWeight="SemiBold"
						Text="{Binding Title}" />
				</StackPanel>
			</DockPanel>
		</materialDesign:ColorZone>

		<Border Grid.Row="1"
			Margin="12,12,12,0" Padding="12"
			BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1"
			CornerRadius="4">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="120" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" />
				</Grid.ColumnDefinitions>

				<!--  売上日  -->
				<TextBlock Grid.Row="0" Grid.Column="0"
					Margin="0,4" VerticalAlignment="Center"
					Text="売上日" />
				<TextBox Grid.Row="0" Grid.Column="1"
					Width="180" Height="32" Margin="0,4"
					HorizontalAlignment="Left" HorizontalContentAlignment="Left"
					Style="{StaticResource MaterialDesignTextBox}"
					Text="{Binding DenDayFrom, UpdateSourceTrigger=PropertyChanged}" />
				<TextBlock Grid.Row="0" Grid.Column="2"
					Margin="8,0" VerticalAlignment="Center"
					Text="～" />
				<TextBox Grid.Row="0" Grid.Column="3"
					Width="180" Height="32" Margin="0,4"
					HorizontalAlignment="Left" HorizontalContentAlignment="Left"
					Style="{StaticResource MaterialDesignTextBox}"
					Text="{Binding DenDayTo, UpdateSourceTrigger=PropertyChanged}" />

				<!--  店舗  -->
				<TextBlock Grid.Row="1" Grid.Column="0"
					Margin="0,4" VerticalAlignment="Center"
					Text="店舗" />
				<TextBox Grid.Row="1" Grid.Column="1"
					Width="180" Height="32" Margin="0,4"
					HorizontalAlignment="Left" HorizontalContentAlignment="Left"
					helpers:SearchTextBoxAssist.Command="{Binding SelectShopCodeFromCommand}"
					BorderThickness="0,0,0,1"
					Style="{StaticResource MenteSearchTextBox}"
					Text="{Binding ShopCodeFrom, UpdateSourceTrigger=PropertyChanged}" />
				<TextBlock Grid.Row="1" Grid.Column="2"
					Margin="8,0" VerticalAlignment="Center"
					Text="～" />
				<TextBox Grid.Row="1" Grid.Column="3"
					Width="180" Height="32" Margin="0,4"
					HorizontalAlignment="Left" HorizontalContentAlignment="Left"
					helpers:SearchTextBoxAssist.Command="{Binding SelectShopCodeToCommand}"
					BorderThickness="0,0,0,1"
					Style="{StaticResource MenteSearchTextBox}"
					Text="{Binding ShopCodeTo, UpdateSourceTrigger=PropertyChanged}" />

				<!--  集計単位  -->
				<TextBlock Grid.Row="2" Grid.Column="0"
					Margin="0,4" VerticalAlignment="Center"
					Text="集計単位" />
				<StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3"
					Margin="0,4"
					Orientation="Horizontal">
					<RadioButton Margin="0,4"
						Content="店舗×日"
						IsChecked="{Binding IsByDay}" />
					<RadioButton Margin="16,4,0,4"
						Content="店舗計(期間合計)"
						IsChecked="{Binding IsByDay, Converter={StaticResource InverseBooleanConverter}}" />
				</StackPanel>

				<!--  対象  -->
				<TextBlock Grid.Row="3" Grid.Column="0"
					Margin="0,4" VerticalAlignment="Center"
					Text="対象" />
				<StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3"
					Margin="0,4"
					Orientation="Horizontal">
					<CheckBox Margin="0,4"
						Content="金種未設定の伝票も含む"
						IsChecked="{Binding IncludeNoPayment}"
						ToolTip="POS以外で登録された売上は金種が空になります" />
				</StackPanel>

				<StackPanel Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3"
					Margin="0,4">
					<TextBlock Foreground="{DynamicResource MaterialDesignValidationErrorBrush}"
						Text="※金種はPOSの決済内訳です。手入力の売上伝票には入らないため、売上金額と金種計が一致しないことがあります。" TextWrapping="Wrap" />
					<TextBlock Foreground="{DynamicResource MaterialDesignValidationErrorBrush}"
						Text="※金種計＝現金＋カード＋その他－釣銭。差額が0でなければ金種未設定の伝票があります。" TextWrapping="Wrap" />
				</StackPanel>

				<StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="4"
					Margin="0,12,0,0" HorizontalAlignment="Left"
					Orientation="Horizontal">
					<TextBlock Margin="0,0,8,0" VerticalAlignment="Center"
						Text="取得件数上限" />
					<TextBox Width="80" Height="32" Margin="0,0,16,0"
						Style="{StaticResource MaterialDesignTextBox}"
						Text="{Binding MaxCountText, UpdateSourceTrigger=PropertyChanged}" />
					<Button Command="{Binding SearchCommand}"
						IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
						Style="{StaticResource MaterialDesignFlatMidBgButton}"
						ToolTip="検索 (F5)">
						<StackPanel Orientation="Horizontal">
							<materialDesign:PackIcon VerticalAlignment="Center"
								Kind="Magnify" />
							<TextBlock Margin="8,0,0,0" VerticalAlignment="Center"
								FontSize="16" Text="検索" />
						</StackPanel>
					</Button>
					<Button Margin="12,0,0,0"
						Command="{Binding ClearConditionsCommand}"
						Style="{StaticResource MaterialDesignOutlinedButton}"
						ToolTip="検索条件をクリア">
						<TextBlock FontSize="16" Text="条件クリア" />
					</Button>
				</StackPanel>
			</Grid>
		</Border>

		<DataGrid Grid.Row="2"
			Margin="12"
			AutoGenerateColumns="False"
			CanUserAddRows="False" CanUserDeleteRows="False"
			IsReadOnly="True"
			ItemsSource="{Binding Rows}"
			SelectedItem="{Binding SelectedRow}"
			SelectionMode="Single" SelectionUnit="FullRow"
			VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
			<DataGrid.Columns>
				<DataGridTextColumn Width="110"
					Binding="{Binding DenDayLabel}"
					Header="売上日">
				</DataGridTextColumn>
				<DataGridTextColumn Width="80"
					Binding="{Binding ShopCode}"
					Header="店舗CD">
				</DataGridTextColumn>
				<DataGridTextColumn Width="200"
					Binding="{Binding ShopName}"
					Header="店舗名">
				</DataGridTextColumn>
				<DataGridTextColumn Width="80"
					Binding="{Binding DenCount, StringFormat={}{0:N0}}"
					Header="伝票数">
					<DataGridTextColumn.ElementStyle>
						<Style TargetType="TextBlock">
							<Setter Property="HorizontalAlignment" Value="Right" />
						</Style>
					</DataGridTextColumn.ElementStyle>
				</DataGridTextColumn>
				<DataGridTextColumn Width="120"
					Binding="{Binding Kingaku, StringFormat={}{0:N0}}"
					Header="売上金額">
					<DataGridTextColumn.ElementStyle>
						<Style TargetType="TextBlock">
							<Setter Property="HorizontalAlignment" Value="Right" />
						</Style>
					</DataGridTextColumn.ElementStyle>
				</DataGridTextColumn>
				<DataGridTextColumn Width="110"
					Binding="{Binding CashAmount, StringFormat={}{0:N0}}"
					Header="現金">
					<DataGridTextColumn.ElementStyle>
						<Style TargetType="TextBlock">
							<Setter Property="HorizontalAlignment" Value="Right" />
						</Style>
					</DataGridTextColumn.ElementStyle>
				</DataGridTextColumn>
				<DataGridTextColumn Width="110"
					Binding="{Binding CardAmount, StringFormat={}{0:N0}}"
					Header="カード">
					<DataGridTextColumn.ElementStyle>
						<Style TargetType="TextBlock">
							<Setter Property="HorizontalAlignment" Value="Right" />
						</Style>
					</DataGridTextColumn.ElementStyle>
				</DataGridTextColumn>
				<DataGridTextColumn Width="110"
					Binding="{Binding OtherAmount, StringFormat={}{0:N0}}"
					Header="その他">
					<DataGridTextColumn.ElementStyle>
						<Style TargetType="TextBlock">
							<Setter Property="HorizontalAlignment" Value="Right" />
						</Style>
					</DataGridTextColumn.ElementStyle>
				</DataGridTextColumn>
				<DataGridTextColumn Width="100"
					Binding="{Binding ChangeAmount, StringFormat={}{0:N0}}"
					Header="釣銭">
					<DataGridTextColumn.ElementStyle>
						<Style TargetType="TextBlock">
							<Setter Property="HorizontalAlignment" Value="Right" />
						</Style>
					</DataGridTextColumn.ElementStyle>
				</DataGridTextColumn>
				<DataGridTextColumn Width="120"
					Binding="{Binding PaymentTotal, StringFormat={}{0:N0}}"
					Header="金種計">
					<DataGridTextColumn.ElementStyle>
						<Style TargetType="TextBlock">
							<Setter Property="HorizontalAlignment" Value="Right" />
						</Style>
					</DataGridTextColumn.ElementStyle>
				</DataGridTextColumn>
				<DataGridTextColumn Width="110"
					Binding="{Binding Diff, StringFormat={}{0:N0}}"
					Header="差額">
					<DataGridTextColumn.ElementStyle>
						<Style TargetType="TextBlock">
							<Setter Property="HorizontalAlignment" Value="Right" />
						</Style>
					</DataGridTextColumn.ElementStyle>
				</DataGridTextColumn>
			</DataGrid.Columns>
		</DataGrid>

		<Border Grid.Row="3"
			Padding="12,6"
			Background="{DynamicResource MaterialDesignChipBackground}">
			<TextBlock VerticalAlignment="Center"
				Text="{Binding Message}" TextTrimming="CharacterEllipsis" />
		</Border>
	</Grid>
</helpers:BaseWindow>
