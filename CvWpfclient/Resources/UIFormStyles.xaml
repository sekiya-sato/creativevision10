<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:helpers="clr-namespace:CvWpfclient.Helpers" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
	<!--
		各メンテ/入力 View で重複定義されていたフォーム系スタイルを集約したもの。
		個別 View で挙動を変えたい場合のみ、同名キーをローカルで再定義してシャドウする。
	-->

	<!--  検索テキストボックス（メンテ画面共通）  -->
	<Style x:Key="MenteSearchTextBox"
		BasedOn="{StaticResource SearchTextBox}"
		TargetType="{x:Type TextBox}">
		<Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Window}}" />
		<Setter Property="Background" Value="{DynamicResource MaterialDesignPaper}" />
		<Setter Property="helpers:SearchTextBoxAssist.ButtonBackground" Value="{DynamicResource SearchButtonBackgroundBrush}" />
	</Style>

	<!--  DataGrid ヘッダースタイル（テーマカラーベース）  -->
	<Style x:Key="MenteDataGridColumnHeader"
		BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}"
		TargetType="DataGridColumnHeader">
		<Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Primary.Light}" />
		<Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary.Foreground}" />
		<Setter Property="Padding" Value="12,8" />
		<Setter Property="FontWeight" Value="SemiBold" />
	</Style>

	<!--  編集フォームのラベルスタイル  -->
	<Style x:Key="FormLabel"
		TargetType="TextBlock">
		<Setter Property="VerticalAlignment" Value="Center" />
		<Setter Property="FontWeight" Value="Medium" />
		<Setter Property="Foreground" Value="{DynamicResource MaterialDesignBodyLight}" />
		<Setter Property="Margin" Value="4,0,8,0" />
	</Style>

	<!--  編集フォームの TextBox スタイル  -->
	<Style x:Key="FormTextBox"
		BasedOn="{StaticResource MaterialDesignOutlinedTextBox}"
		TargetType="TextBox">
		<Setter Property="Margin" Value="0,4" />
		<Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}" />
		<Setter Property="materialDesign:HintAssist.FloatingScale" Value="0.7" />
		<!--  スクリーンリーダー用の名前を浮動ラベル(Hint)から供給（NumericFormTextBox も継承）  -->
		<Setter Property="AutomationProperties.Name" Value="{Binding RelativeSource={RelativeSource Self}, Path=(materialDesign:HintAssist.Hint)}" />
	</Style>

	<!--  数値入力用 TextBox スタイル  -->
	<Style x:Key="NumericFormTextBox"
		BasedOn="{StaticResource FormTextBox}"
		TargetType="TextBox">
		<Setter Property="HorizontalContentAlignment" Value="Right" />
	</Style>

	<!--  設定/変換画面のラベル  -->
	<Style x:Key="SettingLabel"
		TargetType="TextBlock">
		<Setter Property="VerticalAlignment" Value="Center" />
		<Setter Property="FontWeight" Value="Medium" />
		<Setter Property="Foreground" Value="{DynamicResource MaterialDesignBodyLight}" />
		<Setter Property="Margin" Value="0,0,16,0" />
	</Style>

	<!--  ステータス表示テキスト  -->
	<Style x:Key="StatusTextBlockStyle"
		TargetType="TextBlock">
		<Setter Property="VerticalAlignment" Value="Center" />
		<Setter Property="FontSize" Value="13" />
		<Setter Property="Foreground" Value="{DynamicResource MaterialDesignBodyLight}" />
	</Style>

	<!--  選択結果表示テキスト（範囲/商品選択）  -->
	<Style x:Key="SelectionResultText"
		TargetType="TextBlock">
		<Setter Property="MinWidth" Value="0" />
		<Setter Property="Margin" Value="12,0,8,0" />
		<Setter Property="VerticalAlignment" Value="Center" />
		<Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}" />
		<Setter Property="TextTrimming" Value="CharacterEllipsis" />
	</Style>

	<!--
		マスタ参照(V*列)の共通表示テキスト。
		Id入力欄の隣などに置き、CodeNameViewDisplayConverter で「(Id) コード 名称」を一続きに表示する。
		長い名称でも隣接コントロールを押し出さないよう MinWidth=0 + 省略記号を既定にする。
	-->
	<Style x:Key="MasterRefText"
		TargetType="TextBlock">
		<Setter Property="MinWidth" Value="0" />
		<Setter Property="Margin" Value="10,0,0,0" />
		<Setter Property="VerticalAlignment" Value="Center" />
		<Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}" />
		<Setter Property="TextTrimming" Value="CharacterEllipsis" />
	</Style>

	<!--  明細の読み取り専用テキスト  -->
	<Style x:Key="MeisaiReadOnlyTextBlock"
		TargetType="TextBlock">
		<Setter Property="VerticalAlignment" Value="Center" />
		<Setter Property="Foreground" Value="{DynamicResource MaterialDesignBodyLight}" />
		<Setter Property="Padding" Value="6,0" />
		<Setter Property="TextTrimming" Value="CharacterEllipsis" />
	</Style>

	<!--  明細の右寄せ読み取り専用テキスト（MeisaiReadOnlyTextBlock を継承）  -->
	<Style x:Key="MeisaiRightReadOnlyTextBlock"
		BasedOn="{StaticResource MeisaiReadOnlyTextBlock}"
		TargetType="TextBlock">
		<Setter Property="HorizontalAlignment" Value="Stretch" />
		<Setter Property="TextAlignment" Value="Right" />
		<Setter Property="Padding" Value="0,0,18,0" />
	</Style>

	<!--  DataGrid セル内の右寄せテキスト  -->
	<Style x:Key="DataGridRightTextBlock"
		TargetType="TextBlock">
		<Setter Property="HorizontalAlignment" Value="Stretch" />
		<Setter Property="VerticalAlignment" Value="Center" />
		<Setter Property="TextAlignment" Value="Right" />
		<Setter Property="Padding" Value="0,0,0,0" />
	</Style>

	<!--  DataGrid セル内の右寄せ TextBox  -->
	<Style x:Key="DataGridRightTextBox"
		TargetType="TextBox">
		<Setter Property="HorizontalContentAlignment" Value="Right" />
		<Setter Property="VerticalContentAlignment" Value="Center" />
		<Setter Property="Padding" Value="0,0,0,0" />
	</Style>

	<!--  期限超過を強調する一覧セル  -->
	<Style x:Key="OverdueTextBlock"
		TargetType="TextBlock">
		<Setter Property="VerticalAlignment" Value="Center" />
		<Setter Property="FontWeight" Value="SemiBold" />
		<Setter Property="Foreground" Value="{DynamicResource MaterialDesignValidationErrorBrush}" />
	</Style>

	<!--  予算画面のアクションボタン  -->
	<Style x:Key="BudgetActionButtonStyle"
		BasedOn="{StaticResource MaterialDesignOutlinedButton}"
		TargetType="Button">
		<Setter Property="Height" Value="36" />
		<Setter Property="Margin" Value="4,0" />
		<Setter Property="Padding" Value="10,0" />
	</Style>

	<!--  郵便番号検索ボタン  -->
	<Style x:Key="PostalSearchButton"
		BasedOn="{StaticResource MaterialDesignOutlinedButton}"
		TargetType="Button">
		<Setter Property="Margin" Value="8,4,0,4" />
		<Setter Property="Padding" Value="12,6" />
		<Setter Property="VerticalAlignment" Value="Center" />
	</Style>

	<!--
		ツールバー系コマンドボタン。MaterialDesignToolForegroundButton と同一の見た目・挙動に、
		ToolTip 由来のスクリーンリーダー名を付与するだけ（ToolTip 未設定なら Name は空でコンテンツ名にフォールバック）。
		アイコンのみボタンでも読み上げ可能にするため、従来 MaterialDesignToolForegroundButton を指していた箇所をこれに差し替える。
	-->
	<Style x:Key="ToolCommandButton"
		BasedOn="{StaticResource MaterialDesignToolForegroundButton}"
		TargetType="Button">
		<Setter Property="AutomationProperties.Name" Value="{Binding RelativeSource={RelativeSource Self}, Path=ToolTip}" />
	</Style>

	<!--
		入力コントロールの浮動ラベル(HintAssist.Hint)をスクリーンリーダー名として公開するスタイル群。
		見た目は BasedOn 元と同一で、AutomationProperties.Name を Hint にバインドするだけ（Hint 未設定なら空）。
		従来 Material 既定スタイルを指していた箇所をこれらに差し替える。FormTextBox と同一方針。
	-->
	<Style x:Key="FormComboBox"
		BasedOn="{StaticResource MaterialDesignOutlinedComboBox}"
		TargetType="ComboBox">
		<Setter Property="AutomationProperties.Name" Value="{Binding RelativeSource={RelativeSource Self}, Path=(materialDesign:HintAssist.Hint)}" />
	</Style>

	<Style x:Key="FormDatePicker"
		BasedOn="{StaticResource MaterialDesignFloatingHintDatePicker}"
		TargetType="DatePicker">
		<Setter Property="AutomationProperties.Name" Value="{Binding RelativeSource={RelativeSource Self}, Path=(materialDesign:HintAssist.Hint)}" />
		<Setter Property="helpers:DatePickerYmdInputBehavior.IsEnabled" Value="True" />
	</Style>

	<!--  パスワード入力：Hint（ラベル）を名前に供給。値は公開しない  -->
	<Style x:Key="FormPasswordBox"
		BasedOn="{StaticResource MaterialDesignFloatingHintPasswordBox}"
		TargetType="PasswordBox">
		<Setter Property="AutomationProperties.Name" Value="{Binding RelativeSource={RelativeSource Self}, Path=(materialDesign:HintAssist.Hint)}" />
	</Style>
</ResourceDictionary>
