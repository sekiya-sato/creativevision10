<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:helpers="clr-namespace:CvWpfclient.Helpers">
	<!--  在庫・配分照会画面で共通利用する DataGrid / 検索条件スタイル  -->
	<helpers:NumericSignBrushConverter x:Key="NumericSignBrushConverter" />

	<Style x:Key="StockQueryDataGridColumnHeader"
		BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}"
		TargetType="DataGridColumnHeader">
		<Setter Property="HorizontalContentAlignment" Value="Center" />
		<Setter Property="VerticalContentAlignment" Value="Center" />
		<Setter Property="FontWeight" Value="SemiBold" />
		<Setter Property="Padding" Value="12,8" />
		<Setter Property="Background" Value="{DynamicResource PrimaryHueMidBrush}" />
		<Setter Property="Foreground" Value="{DynamicResource PrimaryHueMidForegroundBrush}" />
		<Setter Property="TextBlock.TextAlignment" Value="Center" />
	</Style>

	<Style x:Key="StockQueryRightTextBlock"
		TargetType="TextBlock">
		<Setter Property="HorizontalAlignment" Value="Stretch" />
		<Setter Property="VerticalAlignment" Value="Center" />
		<Setter Property="TextAlignment" Value="Right" />
	</Style>

	<Style x:Key="StockQueryNumericCell"
		TargetType="TextBlock">
		<Setter Property="HorizontalAlignment" Value="Stretch" />
		<Setter Property="VerticalAlignment" Value="Center" />
		<Setter Property="TextAlignment" Value="Right" />
		<Setter Property="Foreground" Value="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource NumericSignBrushConverter}}" />
	</Style>

	<Style x:Key="StockQueryTotalCell"
		BasedOn="{StaticResource StockQueryNumericCell}"
		TargetType="TextBlock">
		<Setter Property="FontWeight" Value="SemiBold" />
	</Style>

	<Style x:Key="StockQuerySokoCell"
		TargetType="TextBlock">
		<Setter Property="VerticalAlignment" Value="Center" />
		<Setter Property="FontWeight" Value="Medium" />
	</Style>

	<Style x:Key="StockQueryConditionLabel"
		TargetType="TextBlock">
		<Setter Property="Margin" Value="0,0,0,4" />
		<Setter Property="FontSize" Value="12" />
		<Setter Property="Foreground" Value="{DynamicResource MaterialDesignBodyLight}" />
	</Style>

	<Style x:Key="StockQueryConditionSearchTextBox"
		BasedOn="{StaticResource SearchTextBox}"
		TargetType="{x:Type TextBox}">
		<Setter Property="Width" Value="130" />
		<Setter Property="Height" Value="32" />
		<Setter Property="Margin" Value="0" />
		<Setter Property="Background" Value="{DynamicResource MaterialDesignPaper}" />
		<Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}" />
		<Setter Property="helpers:SearchTextBoxAssist.ButtonBackground" Value="{DynamicResource SearchButtonBackgroundBrush}" />
	</Style>
</ResourceDictionary>
