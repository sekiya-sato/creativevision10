<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<BitmapImage x:Key="WindowIcon"
		UriSource="pack://application:,,,/cv10-purple.ico" />
	<LinearGradientBrush x:Key="OuterWindowBackground" StartPoint="0,0" EndPoint="1,1">
		<GradientStop Offset="0" Color="#403B0764" />
		<GradientStop Offset="1" Color="#15240A42" />
	</LinearGradientBrush>
	<LinearGradientBrush x:Key="CvnetMainBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
		<GradientStop Offset="0.0" Color="#FF581C87" />
		<GradientStop Offset="0.45" Color="#9333EA" />
		<GradientStop Offset="1.0" Color="#C084FC" />
	</LinearGradientBrush>
	<SolidColorBrush x:Key="MainMenuDashboardCardBackgroundBrush"
		Color="#1EF5E8FF" />
	<SolidColorBrush x:Key="MainMenuDashboardCardBorderBrush"
		Color="#55C084FC" />
	<!--  MainMenu 右クリックメニュー専用の不透明色。CvnetMainBackgroundBrushのグラデーション色をベースにする  -->
	<SolidColorBrush x:Key="MainMenuContextMenuBackgroundBrush"
		Color="#9333EA" />
	<SolidColorBrush x:Key="MainMenuContextMenuBorderBrush"
		Color="#581C87" />
	<SolidColorBrush x:Key="MainMenuContextMenuHoverBackgroundBrush"
		Color="#7E2BC7" />
</ResourceDictionary>
